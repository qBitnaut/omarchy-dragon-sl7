_bp='-mbranch-protection=standard'

prepare() {
  # Fail early if the unpacked tree is not the commit we pinned.
  test -f "iptsd-$_commit/meson.build"

  # [Touchpad] ButtonHoldMs: only emit a firmware button press once the bit
  # was held for N ms with a contact present.
  patch -d "iptsd-$_commit" -Np1 -i "$srcdir/0001-daemon-require-button-hold-time.patch"

  # [Touchpad] ButtonMaxMoveMm: reject presses while contacts move, and release
  # the button when 2+ contacts scroll.
  patch -d "iptsd-$_commit" -Np1 -i "$srcdir/0002-daemon-button-motion-gating.patch"

  # [Touchpad] LiftGraceMs: bridge short contact dropouts (same tracking id, no
  # lift / touch down). Idea from ProgrammerIn-wonderland's ELLX build.
  patch -d "iptsd-$_commit" -Np1 -i "$srcdir/0003-daemon-lift-grace.patch"

  # Touchpad mode watchdog: when spi-hid resets the pad without a uevent it
  # falls back to mouse mode; legacy reports with no touch data around them make
  # the runner switch singletouch -> multitouch again (backoff, then exit).
  patch -d "iptsd-$_commit" -Np1 -i "$srcdir/0004-runner-reenable-multitouch-on-legacy-reports.patch"

  # [Touchpad] DragStartMm / DragReleaseStillMs: latch click-and-drag across
  # firmware button dropouts (the pressure bit drops while the finger slides).
  patch -d "iptsd-$_commit" -Np1 -i "$srcdir/0005-daemon-drag-latch.patch"

  # Drag latch fixes for fast motion (follows the contact over tracker re-indexing,
  # rides out invalid / unstable frames, speed latch) and [Touchpad] DragRelatchMs.
  patch -d "iptsd-$_commit" -Np1 -i "$srcdir/0006-daemon-drag-fast-motion-relatch.patch"

  # A still drag is parked instead of released (so the finger can lift and come
  # back), and [Touchpad] DragDebug / IPTSD_SL7_DRAG_DEBUG=1 logs every latch
  # state transition.
  patch -d "iptsd-$_commit" -Np1 -i "$srcdir/0007-daemon-drag-park-and-debug-log.patch"

  # While the firmware button bit is held a lifted drag finger never ends the
  # drag: it carries on with the remaining or a newly placed contact.
  patch -d "iptsd-$_commit" -Np1 -i "$srcdir/0008-daemon-drag-keep-while-button-held.patch"

  # [Touchpad] HapticIntensity / ClickForce: Windows-style haptic feedback
  # strength and click force, sent to the pad at startup and after every
  # multitouch re-enable. Unset by default (firmware setting stays).
  patch -d "iptsd-$_commit" -Np1 -i "$srcdir/0009-touchpad-haptic-intensity-and-click-force.patch"
}

build() {
  # BTI/PAC consistency. A mixed build (some objects/libs with BTI+PAC
  # landing pads, others without, or a link step that drops the property)
  # yields a binary whose .note.gnu.property disagrees with its code and dies
  # with SIGILL even on --help (linux-surface/iptsd#1590). With LTO the final
  # code generation happens at link time, so LDFLAGS must carry the flag too.
  local v
  for v in CFLAGS CXXFLAGS LDFLAGS; do
    case "${!v}" in
      *-mbranch-protection=*) ;;
      *) export "$v=${!v} $_bp" ;;
    esac
  done
  echo "CFLAGS=$CFLAGS"
  echo "CXXFLAGS=$CXXFLAGS"
  echo "LDFLAGS=$LDFLAGS"

  # Use system libraries only (nofallback): no vendored static copies built
  # with whatever flags the wrap happens to pick.
  arch-meson "iptsd-$_commit" build \
    --wrap-mode=nofallback \
    -Dwerror=false \
    -Ddebug_tools=calibrate,dump
  meson compile -C build
}

check() {
  # Report the AArch64 BTI/PAC property note per binary. The linker keeps the
  # note only if EVERY input (crt*.o, static libs) carries it; a consistently
  # absent note means no BTI enforcement by the kernel, which cannot SIGILL.
  # Fail only on a MIXED result (some binaries marked, others not).
  local f note have_bti=0 no_bti=0 have_pac=0 no_pac=0 o
  for f in build/src/iptsd*; do
    [[ -f $f && -x $f ]] || continue
    note=$(readelf -n "$f" | grep 'AArch64 feature:' || true)
    echo "note $f: ${note:-<none>}"
    if [[ $note == *BTI* ]]; then have_bti=$((have_bti + 1)); else no_bti=$((no_bti + 1)); fi
    if [[ $note == *PAC* ]]; then have_pac=$((have_pac + 1)); else no_pac=$((no_pac + 1)); fi
  done

  # Diagnostics: which link inputs lack the property note?
  for o in /usr/lib/crt1.o /usr/lib/crti.o /usr/lib/crtn.o \
           "$(gcc -print-file-name=crtbeginS.o)" "$(gcc -print-file-name=crtendS.o)" \
           "$(gcc -print-file-name=crtbegin.o)"; do
    [[ -f $o ]] || continue
    echo "crt $o: $(readelf -n "$o" 2>/dev/null | grep 'AArch64 feature:' || echo '<no note>')"
  done
  while IFS= read -r o; do
    readelf -n "$o" 2>/dev/null | grep -q 'AArch64 feature:' || echo "no note: $o"
  done < <(find build -name '*.o' -o -name '*.a' | sort | head -n 200)

  if ((have_bti && no_bti)) || ((have_pac && no_pac)); then
    echo "mixed BTI/PAC property across binaries: flags problem" >&2
    return 1
  fi
  echo "BTI/PAC consistent across binaries (BTI=$have_bti/$((have_bti + no_bti)), PAC=$have_pac/$((have_pac + no_pac)))"
}

package() {
  meson install -C build --destdir "$pkgdir"

  # SL7 additions
  install -Dm644 91-calibration-045E-0C77.conf \
    "$pkgdir/etc/iptsd.d/91-calibration-045E-0C77.conf"
  install -Dm644 61-iptsd-sl7-hide-raw-touchpad.rules \
    "$pkgdir/usr/lib/udev/rules.d/61-iptsd-sl7-hide-raw-touchpad.rules"
  install -Dm644 51-iptsd-sl7-start.rules \
    "$pkgdir/usr/lib/udev/rules.d/51-iptsd-sl7-start.rules"
  install -Dm644 10-iptsd-sl7.conf \
    "$pkgdir/usr/lib/systemd/system/iptsd@.service.d/10-iptsd-sl7.conf"

  install -Dm644 92-iptsd-sl7-tuning.conf \
    "$pkgdir/etc/iptsd.d/92-iptsd-sl7-tuning.conf"
  install -Dm755 iptsd-sl7-calibrate "$pkgdir/usr/bin/iptsd-sl7-calibrate"
  install -Dm755 iptsd-sl7-restart "$pkgdir/usr/lib/iptsd-sl7/iptsd-sl7-restart"

  install -Dm644 "iptsd-$_commit/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
