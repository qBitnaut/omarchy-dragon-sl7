 	}
 
 	/*!
+	 * Stores the positions of all valid contacts in millimeters.
+	 *
+	 * Contact positions are normalized to 0..1, config.width / config.height are in cm.
+	 *
+	 * @param[in] contacts All currently active contacts.
+	 */
+	void track_positions(const std::vector<contacts::Contact<f64>> &contacts)
+	{
+		m_positions.clear();
+
+		if (m_blocked)
+			return;
+
+		for (const contacts::Contact<f64> &contact : contacts) {
+			if (!contact.index.has_value() || !contact.valid.value_or(true))
+				continue;
+
+			m_positions[contact.index.value()] = Vector2<f64> {
+				contact.mean.x() * m_config.width * 10,
+				contact.mean.y() * m_config.height * 10,
+			};
+		}
+	}
+
+	/*!
+	 * Largest distance (mm) any contact moved away from the button anchor.
+	 *
+	 * @return nothing if the set of contacts differs from the one in the anchor.
+	 */
+	[[nodiscard]] std::optional<f64> button_displacement() const
+	{
+		if (m_positions.size() != m_button_anchor.size())
+			return std::nullopt;
+
+		f64 max = 0;
+
+		for (const auto &[index, position] : m_positions) {
+			const auto anchor = m_button_anchor.find(index);
+
+			if (anchor == m_button_anchor.cend())
+				return std::nullopt;
+
+			max = std::max(max, (position - anchor->second).norm());
+		}
+
+		return max;
+	}
+
+	/*!
+	 * Rejects button presses that happen while contacts move.
+	 *
+	 * Before the press is confirmed, any motion (or a contact appearing / disappearing)
+	 * discards the attempt until the bit clears. After it, 2 or more moving contacts
+	 * (scrolling) release the button and suppress it until the bit clears.
+	 */
+	void track_button_motion()
+	{
+		if (m_button_max_move_mm <= 0)
+			return;
+
+		if (m_button_pending) {
+			const std::optional<f64> d = this->button_displacement();
+
+			if (!d.has_value() || d.value() >= m_button_max_move_mm) {
+				m_button_pending = false;
+				m_button_suppressed = true;
+			}
+		} else if (m_button_state) {
+			const std::optional<f64> d = this->button_displacement();
+
+			if (!d.has_value()) {
+				// A contact came or went, measure from here on.
+				m_button_anchor = m_positions;
+			} else if (m_positions.size() >= 2 && d.value() >= m_button_max_move_mm) {
+				m_button_suppressed = true;
+				this->emit_button(false);
+			}
+		}
+	}
