+	/*!
+	 * Reads the haptic settings from the config. Invalid values are logged and ignored.
+	 */
+	void load_haptics(const Config &config)
+	{
+		const f64 intensity = config.touchpad_haptic_intensity;
+
+		if (intensity > 100)
+			spdlog::warn("Ignoring HapticIntensity {}: must be 0 to 100", intensity);
+		else if (intensity >= 0)
+			m_haptic_intensity = gsl::narrow_cast<u8>(std::lround(intensity));
+
+		std::string force = config.touchpad_click_force;
+		std::transform(force.begin(), force.end(), force.begin(), [](unsigned char c) {
+			return static_cast<char>(std::tolower(c));
+		});
+
+		if (force.empty())
+			return;
+
+		// Windows stores ClickForceSensitivity as 0 / 50 / 100.
+		if (force == "low" || force == "0")
+			m_click_force = ipts::Device::ClickForce::Low;
+		else if (force == "medium" || force == "50")
+			m_click_force = ipts::Device::ClickForce::Medium;
+		else if (force == "high" || force == "100")
+			m_click_force = ipts::Device::ClickForce::High;
+		else
+			spdlog::warn("Ignoring ClickForce '{}': must be low, medium or high", force);
+	}
+
+	static std::string_view click_force_name(const ipts::Device::ClickForce force)
+	{
+		switch (force) {
+		case ipts::Device::ClickForce::Low:
+			return "low";
+		case ipts::Device::ClickForce::High:
+			return "high";
+		default:
+			return "medium";
+		}
+	}
+
+	/*!
+	 * Sends the configured haptic settings to the device.
+	 *
+	 * Does nothing if neither is configured. A device without the matching report is logged
+	 * once, a failing write is logged every time and never stops the daemon.
+	 */
+	void apply_haptics()
+	{
+		if (m_haptic_intensity.has_value()) {
+			try {
+				const auto raw = m_ipts.set_haptic_intensity(m_haptic_intensity.value());
+
+				if (raw.has_value()) {
+					spdlog::info("Applied haptic intensity {} (raw {})",
+						     m_haptic_intensity.value(), raw.value());
+				} else if (!m_haptic_intensity_missing_logged) {
+					spdlog::warn("HapticIntensity is set, but the device has no "
+						     "haptic intensity report");
+					m_haptic_intensity_missing_logged = true;
+				}
+			} catch (const std::exception &e) {
+				spdlog::warn("Failed to set haptic intensity: {}", e.what());
+			}
+		}
+
+		if (m_click_force.has_value()) {
+			try {
+				const auto raw = m_ipts.set_click_force(m_click_force.value());
+
+				if (raw.has_value()) {
+					spdlog::info("Applied click force {} (raw {})",
+						     click_force_name(m_click_force.value()), raw.value());
+				} else if (!m_click_force_missing_logged) {
+					spdlog::warn("ClickForce is set, but the device has no "
+						     "click force report");
+					m_click_force_missing_logged = true;
+				}
+			} catch (const std::exception &e) {
+				spdlog::warn("Failed to set click force: {}", e.what());
+			}
+		}
+	}
