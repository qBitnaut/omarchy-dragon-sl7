+	/*!
+	 * Sets the intensity of the haptic feedback (click strength), if the device supports it.
+	 *
+	 * The report is located by its usage (Haptics page, Intensity), the value is scaled onto
+	 * the logical range of the field.
+	 *
+	 * @param[in] percent The intensity from 0 to 100 (the Windows FeedbackIntensity).
+	 * @return The raw value that was sent, or null if the device has no such report.
+	 */
+	[[nodiscard]] std::optional<u32> set_haptic_intensity(const u8 percent) const
+	{
+		return write_feature(m_descriptor.find_haptic_intensity_report(),
+				     protocol::descriptor::USAGE_PAGE_HAPTICS,
+				     protocol::descriptor::USAGE_HAPTIC_INTENSITY,
+				     std::min<f64>(percent, 100.0) / 100.0);
+	}
+
+	/*!
+	 * Sets the click force (the pressure needed for a click), if the device supports it.
+	 *
+	 * The report is located by its usage (Digitizer page, Button Press Threshold), low /
+	 * medium / high are mapped to the minimum / middle / maximum of its logical range.
+	 *
+	 * @param[in] force The click force.
+	 * @return The raw value that was sent, or null if the device has no such report.
+	 */
+	[[nodiscard]] std::optional<u32> set_click_force(const ClickForce force) const
+	{
+		f64 fraction = 0.5;
+
+		if (force == ClickForce::Low)
+			fraction = 0.0;
+		else if (force == ClickForce::High)
+			fraction = 1.0;
+
+		return write_feature(m_descriptor.find_click_force_report(),
+				     protocol::descriptor::USAGE_PAGE_DIGITIZER,
+				     protocol::descriptor::USAGE_BUTTON_PRESS_THRESHOLD,
+				     fraction);
+	}
+
+private:
+	/*!
+	 * Writes one field of a feature report, leaving all other bits of the report at zero.
+	 *
+	 * The bit position of the field follows from the sizes of the fields in front of it, the
+	 * report ID is the first byte of the buffer and not part of the payload.
+	 *
+	 * @param[in] report The feature report that contains the field.
+	 * @param[in] page The Usage Page of the field.
+	 * @param[in] id The Usage ID of the field.
+	 * @param[in] fraction Where in the logical range of the field the value lies (0 to 1).
+	 * @return The raw value that was sent, or null if the report or the field is not usable.
+	 */
+	std::optional<u32> write_feature(const std::optional<hid::Report> &report,
+					 const u16 page,
+					 const u16 id,
+					 const f64 fraction) const
+	{
+		if (!report.has_value() || !report->report_id.has_value())
+			return std::nullopt;
+
+		usize offset = 0;
+
+		for (const hid::Field &field : report->fields) {
+			if (!field.has_usage(page, id)) {
+				offset += field.bits();
+				continue;
+			}
+
+			if (field.count != 1 || field.size == 0 || field.size > 32 ||
+			    field.logical_max < field.logical_min)
+				return std::nullopt;
+
+			const f64 span = static_cast<f64>(field.logical_max - field.logical_min);
+			const u32 value = field.logical_min + static_cast<u32>(std::lround(span * fraction));
+
+			std::vector<u8> buffer(report->bytes() + 1, 0);
+			buffer[0] = report->report_id.value();
+
+			for (u32 bit = 0; bit < field.size; bit++) {
+				if (((value >> bit) & 1u) == 0)
+					continue;
+
+				const usize pos = offset + bit;
+				buffer[1 + pos / 8] = gsl::narrow<u8>(buffer[1 + pos / 8] | (1u << (pos % 8)));
+			}
+
+			m_hid->set_feature(buffer);
+			return value;
+		}
+
+		return std::nullopt;
+	}
+
