+/*!
+ * Checks if a given report sets the click force (Button Press Threshold) of the device.
+ *
+ * @param[in] report The report to check.
+ * @return Whether the report matches the properties for a click force report.
+ */
+inline bool is_click_force(const hid::Report &report)
+{
+	return report.type == hid::Report::Type::Feature &&
+	       report.has_usage(USAGE_PAGE_DIGITIZER, USAGE_BUTTON_PRESS_THRESHOLD);
+}
+
+/*!
+ * Checks if a given report sets the intensity of the haptic feedback of the device.
+ *
+ * @param[in] report The report to check.
+ * @return Whether the report matches the properties for a haptic intensity report.
+ */
+inline bool is_haptic_intensity(const hid::Report &report)
+{
+	return report.type == hid::Report::Type::Feature &&
+	       report.has_usage(USAGE_PAGE_HAPTICS, USAGE_HAPTIC_INTENSITY);
+}
