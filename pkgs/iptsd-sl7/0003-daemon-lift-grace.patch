+
+	/*!
+	 * Distance (mm) between two contacts.
+	 */
+	[[nodiscard]] f64 distance_mm(const contacts::Contact<f64> &a,
+	                              const contacts::Contact<f64> &b) const
+	{
+		const Vector2<f64> d = a.mean - b.mean;
+
+		return std::hypot(d.x() * m_config.width * 10, d.y() * m_config.height * 10);
+	}
+
+	/*!
+	 * Smallest index that is neither used in this frame nor held by a vanished contact.
+	 */
+	[[nodiscard]] usize free_index(const std::set<usize> &used) const
+	{
+		usize index = 0;
+
+		while (used.count(index) != 0 || m_ghosts.count(index) != 0)
+			index++;
+
+		return index;
+	}
+
+	/*!
+	 * Bridges short detection dropouts of the sensor.
+	 *
+	 * A valid contact that vanishes is held at its last position for up to LiftGraceMs.
+	 * If a new contact shows up within LIFT_GRACE_RADIUS_MM of it in that time, the new
+	 * contact takes over the index of the vanished one. Neither a lift nor a touch down is
+	 * emitted, and the button gating sees an unchanged set of contacts.
+	 *
+	 * Idea (LiftGraceMs) credited to ProgrammerIn-wonderland's ELLX iptsd build.
+	 *
+	 * @param[in] raw All contacts of the current frame, as tracked.
+	 * @return The contacts to emit: the real ones with effective indices, plus held ones.
+	 */
+	[[nodiscard]] std::vector<contacts::Contact<f64>>
+	bridge_dropouts(const std::vector<contacts::Contact<f64>> &raw)
+	{
+		if (m_lift_grace_ms <= 0)
+			return raw;
+
+		const auto now = std::chrono::steady_clock::now();
+
+		// Drop held contacts that were gone for too long. They are no longer in the output,
+		// which makes search_lifted() lift them.
+		for (auto it = m_ghosts.begin(); it != m_ghosts.end();) {
+			const f64 gone =
+				std::chrono::duration<f64, std::milli>(now - it->second.last_seen).count();
+
+			if (gone > m_lift_grace_ms)
+				it = m_ghosts.erase(it);
+			else
+				++it;
+		}
+
+		std::vector<contacts::Contact<f64>> out {};
+		out.reserve(raw.size() + m_ghosts.size());
+
+		std::set<usize> raw_now {};
+		std::set<usize> used {};
+		std::map<usize, contacts::Contact<f64>> real_now {};
+
+		const auto add = [&](const contacts::Contact<f64> &contact, const usize index) {
+			contacts::Contact<f64> copy = contact;
+			copy.index = index;
+
+			used.insert(index);
+			real_now[index] = copy;
+			out.push_back(copy);
+		};
+
+		// Contacts that were already there keep their effective index.
+		for (const contacts::Contact<f64> &contact : raw) {
+			if (!contact.index.has_value()) {
+				out.push_back(contact);
+				continue;
+			}
+
+			const usize index = contact.index.value();
+			raw_now.insert(index);
+
+			if (m_bridge_raw_last.count(index) == 0)
+				continue;
+
+			const auto alias = m_alias.find(index);
+			add(contact, alias != m_alias.cend() ? alias->second : index);
+		}
+
+		// New contacts either continue a held one, or get a free effective index.
+		for (const contacts::Contact<f64> &contact : raw) {
+			if (!contact.index.has_value())
+				continue;
+
+			const usize index = contact.index.value();
+
+			if (m_bridge_raw_last.count(index) != 0)
+				continue;
+
+			auto best = m_ghosts.end();
+			f64 best_distance = LIFT_GRACE_RADIUS_MM;
+
+			if (contact.valid.value_or(true)) {
+				for (auto it = m_ghosts.begin(); it != m_ghosts.end(); ++it) {
+					const f64 d = this->distance_mm(contact, it->second.contact);
+
+					if (d <= best_distance) {
+						best = it;
+						best_distance = d;
+					}
+				}
+			}
+
+			usize effective = index;
+
+			if (best != m_ghosts.end()) {
+				effective = best->first;
+				m_ghosts.erase(best);
+			} else if (used.count(index) != 0 || m_ghosts.count(index) != 0) {
+				effective = this->free_index(used);
+			}
+
+			m_alias[index] = effective;
+			add(contact, effective);
+		}
+
+		// Mappings of contacts that are gone are no longer needed.
+		for (auto it = m_alias.begin(); it != m_alias.end();) {
+			if (raw_now.count(it->first) == 0)
+				it = m_alias.erase(it);
+			else
+				++it;
+		}
+
+		// Contacts that vanished this frame are held for a while.
+		for (const auto &[index, contact] : m_bridge_last) {
+			if (real_now.count(index) != 0 || m_ghosts.count(index) != 0)
+				continue;
+
+			if (!contact.valid.value_or(true))
+				continue;
+
+			m_ghosts[index] = Ghost {contact, m_bridge_time};
+		}
+
+		for (const auto &[index, ghost] : m_ghosts)
+			out.push_back(ghost.contact);
+
+		m_bridge_last = std::move(real_now);
+		m_bridge_raw_last = std::move(raw_now);
+		m_bridge_time = now;
+
+		return out;
+	}
