+	/*!
+	 * Forgets all held contacts and index mappings.
+	 */
+	void reset_bridge()
+	{
+		m_ghosts.clear();
+		m_alias.clear();
+		m_bridge_last.clear();
+		m_bridge_raw_last.clear();
