+	/*!
+	 * How long until a held contact has to be released, if no frame arrives.
+	 *
+	 * @return Milliseconds, or -1 if no contact is held.
+	 */
+	[[nodiscard]] i32 timeout_ms() const
+	{
+		if (m_ghosts.empty())
+			return -1;
+
+		const auto now = std::chrono::steady_clock::now();
+		f64 remaining = m_lift_grace_ms;
+
+		for (const auto &[index, ghost] : m_ghosts) {
+			const f64 gone =
+				std::chrono::duration<f64, std::milli>(now - ghost.last_seen).count();
+
+			remaining = std::min(remaining, m_lift_grace_ms - gone);
+		}
+
+		// +1: a contact is released once it was gone for more than the grace time.
+		return casts::to<i32>(std::max(0.0, std::ceil(remaining)) + 1);
+	}
+
+	/*!
+	 * Releases held contacts whose grace time is over. Called when no frame arrived in
+	 * time, as the sensor may stop sending frames once all fingers are lifted.
+	 */
+	void expire()
