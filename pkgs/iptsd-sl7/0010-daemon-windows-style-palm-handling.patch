 		m_bridge_input = raw_contacts;

 		// Bridge short detection dropouts, so they do not show up as a lift and touch down.
-		const std::vector<contacts::Contact<f64>> contacts = this->bridge_dropouts(raw_contacts);
+		const std::vector<contacts::Contact<f64>> bridged = this->bridge_dropouts(raw_contacts);
+
+		// Palm check: freeze all input, or drop only the palm contacts.
+		bool freeze = false;
+		const std::vector<contacts::Contact<f64>> contacts = this->palm_check(bridged, freeze);

 		// Find the inputs that need to be lifted
 		this->search_lifted(contacts);

-		m_blocked = this->is_blocked(contacts);
+		m_blocked = freeze;

 		if (m_blocked) {
 			// A fast moving finger can smear into a blob that fails the size / aspect
@@ -1449,19 +1469,82 @@ private:
 	}

 	/*!
-	 * Checks if the touch device should be disabled because of a palm.
+	 * Applies the palm check (DisableOnPalm) to a frame.
 	 *
-	 * @param[in] contacts All currently active contacts.
-	 * @return true if all contacts should be lifted.
+	 * A palm is a contact that fails the size / aspect checks (not valid). With
+	 * PalmMode = freeze any palm freezes all output. With PalmMode = windows (like the Windows
+	 * touchpad stack) the palm contacts are dropped from the frame, so they never become a
+	 * pointer, scroll or gesture finger and do not count as fingers, while the valid fingers
+	 * and the physical click keep working. Output is frozen only if no valid finger is left.
+	 *
+	 * @param[in] frame All currently active contacts.
+	 * @param[out] freeze Whether all contacts should be lifted and the click masked.
+	 * @return The contacts to process.
 	 */
-	[[nodiscard]] bool is_blocked(const std::vector<contacts::Contact<f64>> &contacts) const
+	[[nodiscard]] std::vector<contacts::Contact<f64>>
+	palm_check(const std::vector<contacts::Contact<f64>> &frame, bool &freeze)
 	{
-		if (!m_disable_on_palm)
-			return false;
+		freeze = false;

-		return std::any_of(contacts.cbegin(), contacts.cend(), [&](const auto &c) {
-			return !c.valid.value_or(true);
-		});
+		usize palms = 0;
+		usize fingers = 0;
+
+		if (m_disable_on_palm) {
+			for (const contacts::Contact<f64> &c : frame) {
+				if (!c.valid.value_or(true))
+					palms++;
+				else if (c.index.has_value())
+					fingers++;
+			}
+		}
+
+		// 0 = no palm, 1 = frozen, 2 = palm contacts dropped.
+		i32 state = 0;
+
+		if (palms > 0)
+			state = (!m_palm_windows || fingers == 0) ? 1 : 2;
+
+		if (m_drag_debug) {
+			const i32 key = casts::to<i32>(state * 10000 + palms * 100 + fingers);
+
+			if (key != m_palm_log_key) {
+				if (state == 0)
+					this->drag_log("palm-end", "no palm contact");
+				else if (state == 1)
+					this->drag_log("palm-freeze",
+					               fmt::format("{} palm contact(s), {} valid finger(s), mode {}: "
+					                           "output frozen, click masked",
+					                           palms,
+					                           fingers,
+					                           m_palm_windows ? "windows" : "freeze"));
+				else
+					this->drag_log("palm-drop",
+					               fmt::format("{} palm contact(s) dropped, {} valid finger(s) "
+					                           "and the click stay active",
+					                           palms,
+					                           fingers));
+
+				m_palm_log_key = key;
+			}
+		}
+
+		if (state == 1) {
+			freeze = true;
+			return frame;
+		}
+
+		if (state == 0)
+			return frame;
+
+		std::vector<contacts::Contact<f64>> out {};
+		out.reserve(frame.size());
+
+		for (const contacts::Contact<f64> &c : frame) {
+			if (c.valid.value_or(true))
+				out.push_back(c);
+		}
+
+		return out;
 	}

 	/*!
