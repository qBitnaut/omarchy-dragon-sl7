# Start iptsd@<hidraw> for the Surface Laptop 7 touchpad (045E:0C77) and
# touchscreen (045E:0C6E), HID-over-SPI (bus 001C).
#
# Upstream 50-iptsd.rules gates on "iptsd-check-device", which opens the hidraw
# node at uevent time. On resume spi-hid is still re-initialising and that
# probe can fail, so no unit is wanted and nothing retries. We match the
# parent hid device by name (BUS:VID:PID.ID, so hidraw numbering is
# irrelevant) and want the unit unconditionally. iptsd itself refuses a node
# it cannot use, and the drop-in restarts it.
#
# "change" is included because a plain `udevadm trigger` sends change, which
# upstream's ACTION=="add" rule ignores. Wanting an active unit is a no-op.
ACTION!="add|change", GOTO="iptsd_sl7_start_hid"
SUBSYSTEM!="hidraw", GOTO="iptsd_sl7_start_hid"
SUBSYSTEMS=="hid", KERNELS=="001C:045E:0C77.*|001C:045E:0C6E.*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="iptsd@dev-%k.service"
# A running iptsd survives a spi-hid reset but the device is back in mouse
# mode, so on change restart it (debounced; no-op if the unit is not active).
ACTION=="change", SUBSYSTEMS=="hid", KERNELS=="001C:045E:0C77.*|001C:045E:0C6E.*", RUN+="/usr/lib/iptsd-sl7/iptsd-sl7-restart %k"

LABEL="iptsd_sl7_start_hid"
# spi-hid binds a driver to the hid device after (re)creating it: same.
ACTION=="bind", SUBSYSTEM=="hid", KERNEL=="001C:045E:0C77.*|001C:045E:0C6E.*", RUN+="/usr/lib/iptsd-sl7/iptsd-sl7-restart %S%p"

