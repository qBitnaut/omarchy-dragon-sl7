+	/*!
+	 * The drag contact is gone, but the firmware button bit is still held: keep the drag.
+	 * Tracking moves to the newest contact (a newly placed finger, else the remaining one).
+	 * With no contact left, the drag stays latched until one lands or the bit is released.
+	 */
+	void keep_drag(const std::chrono::steady_clock::time_point now)
+	{
+		m_drag_parked = false;
+
+		if (!m_drag_keeping) {
+			m_drag_keeping = true;
+			this->drag_log("drag-keep", "contact lifted but firmware button still held");
+		}
+
+		auto best = m_positions.cend();
+		std::chrono::steady_clock::time_point newest {};
+
+		for (auto it = m_positions.cbegin(); it != m_positions.cend(); ++it) {
+			// Held contacts are the ones that vanished.
+			if (m_ghosts.count(it->first) != 0)
+				continue;
+
+			const auto seen = m_first_seen.find(it->first);
+			const auto since = seen != m_first_seen.cend() ? seen->second : now;
+
+			if (best == m_positions.cend() || since >= newest) {
+				best = it;
+				newest = since;
+			}
+		}
+
+		if (best == m_positions.cend())
+			return;
+
+		m_drag_index = best->first;
+		m_drag_pos = best->second;
+		m_drag_step_mm = 0;
+		m_drag_still_anchor = m_positions;
+		m_drag_still_since = now;
+		m_drag_keeping = false;
+		this->drag_log("drag-keep-handoff", "drag continues on the remaining or a new contact");
+	}
+
