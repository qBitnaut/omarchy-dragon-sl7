sl7-faceunlock overlay patch 4: howdy-lock-view-4.0.6.patch
LockView.qml counterpart of patch 3 (same fork base to v4.0.6, plus the
rc1-only #7806 auto-repeat fix, which has no shell API dependency): Commons
alias and Commons.Color.* (#14553), textFormat: Text.PlainText on the status
Text (3af7675a), and the auto-repeat guard in Keys.onPressed, kept ahead of the
fork's Escape-cancels-face branch. Marker: "sl7-faceunlock: lock-view sync".
--- a/LockView.qml
+++ b/LockView.qml
@@ -1,8 +1,12 @@
 import QtQuick
 import QtQuick.Effects
 import qs.Commons
+import qs.Commons as Commons
 import qs.Ui

+// sl7-faceunlock: lock-view sync (upstream 4.0.6: Commons.Color for Qt 6.12,
+// textFormat on Text, key auto-repeat dropped in the password field, #7806).
+
 Item {
   id: root

@@ -37,8 +41,8 @@
   readonly property bool showPasswordCursor: inputEnabled && !authenticatingPassword && failureMessage.length === 0
   readonly property bool errorState: failureMessage.length > 0
   readonly property var inputBorderSpec: errorState
-    ? Border.surfaceSpec("lock", "border-error", Color.lock.borderError, root.outlineThickness, "border-alpha")
-    : Border.surfaceSpec("lock", "border-active", Color.lock.borderActive, root.outlineThickness, "border-alpha")
+    ? Border.surfaceSpec("lock", "border-error", Commons.Color.lock.borderError, root.outlineThickness, "border-alpha")
+    : Border.surfaceSpec("lock", "border-active", Commons.Color.lock.borderActive, root.outlineThickness, "border-alpha")

   signal submitPassword(string password)
   signal passwordTextEdited(string password)
@@ -64,6 +68,14 @@
     passwordTextEdited("")
   }

+  // Waking a DPMS-blanked display can stall the compositor for seconds while
+  // the monitor modesets, so the wake key's release arrives late and client-side
+  // key repeat floods the field with that character. A held key has no business
+  // typing a password; only holding Backspace/Delete to clear stays useful.
+  function dropsAutoRepeat(key) {
+    return key !== Qt.Key_Backspace && key !== Qt.Key_Delete
+  }
+
   function syncPasswordText() {
     if (passwordInput.text === passwordText) return
     syncingPasswordText = true
