# Adapted from the AUR howdy-next package (nathawat); the model download hint
# is gone because howdy-next-models ships the models.

pre_install() {
	echo '[CAUTION] Keep a root shell open while configuring PAM: sudo -i'
}

post_install() {
	echo '[SETUP] This package does not touch /etc/pam.d. Add pam_howdy.so yourself,'
	echo '[SETUP] or use the face-unlock setup app, which keeps backups.'
	echo '[SETUP] Configure camera: sudo howdy config'
	echo '[SETUP] Test authentication: sudo howdy test'
	echo '[SETUP] Add a face model: sudo howdy add'
}
