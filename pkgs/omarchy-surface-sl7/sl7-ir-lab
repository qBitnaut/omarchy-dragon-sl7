#!/usr/bin/python3
"""sl7-ir-lab: a simple live view of the Surface Laptop 7 IR camera. Run it as
your normal user on the Omarchy desktop, on the normal boot:

    sl7-ir-lab

The window shows the camera live the whole time: raw GREY 644x604 frames read
from the sl7-ir-bridge loopback (/dev/v4l/by-id/sl7-ir-camera) through
`v4l2-ctl --stream-mmap --stream-to=-`, reopened whenever the bridge ends its
10 s session. Under the image: the mean and maximum of every frame, LIT or
dark, what the bridge reported for the emitter ("emitter ON: ..."), and a 10 s
graph of the mean.

The frames are lit by sl7-ir-bridge (linux-sl7 7.2.8-22 and sl7-ir-bridge
0.1.0-2 or later), which strobes the IR emitter with the sensor's GPIO 1 for
every session at Windows' timing (exposure 100 lines, frame length 1750
lines). LIT / dark is a hint from the frame maximum.

Snapshot saves the current frame as a PNG under ~/sl7-ir-lab/<timestamp>/.
Status shows `sl7-ir-emitter-test --status` (bridge, strobe parameter).
"""
import collections
import datetime
import os
import shutil
import struct
import subprocess
import sys
import threading
import time
import zlib

W = 644
H = 604
FRAME = W * H
CAM = "/dev/v4l/by-id/sl7-ir-camera"
TOOL = "/usr/bin/sl7-ir-emitter-test"
SPARK_S = 10.0
LIT_MAX = 24  # an unlit IR frame is flat dark noise (max about 17); lit ones reach 30 and more
OUTROOT = os.environ.get("SL7_IR_LAB_DIR") or os.path.join(os.path.expanduser("~"), "sl7-ir-lab")
ALPHA = b"\xff" * FRAME


def fail(msg):
    sys.stderr.write("sl7-ir-lab: %s\n" % msg)
    sys.exit(1)


try:
    import gi

    gi.require_version("Gtk", "4.0")
    from gi.repository import GLib, Gdk, Gtk
except (ImportError, ValueError) as exc:
    fail("GTK 4 with PyGObject is required (pacman -S gtk4 python-gobject): %s" % exc)
try:
    import cairo
except ImportError as exc:
    fail("pycairo is required (pacman -S python-cairo): %s" % exc)


def write_png(path, data):
    """Write one GREY W x H frame as an 8-bit grayscale PNG."""
    def chunk(tag, d):
        c = struct.pack(">I", len(d)) + tag + d
        return c + struct.pack(">I", zlib.crc32(tag + d) & 0xFFFFFFFF)

    raw = b"".join(b"\0" + data[r * W:(r + 1) * W] for r in range(H))
    with open(path, "wb") as fh:
        fh.write(b"\x89PNG\r\n\x1a\n")
        fh.write(chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 0, 0, 0, 0)))
        fh.write(chunk(b"IDAT", zlib.compress(raw, 4)))
        fh.write(chunk(b"IEND", b""))


_luts = {}


def gray_surface(data, gain=1.0):
    """GREY bytes to a Cairo RGB24 surface. Returns (surface, backing buffer)."""
    if gain > 1.01:
        key = int(gain * 4)
        lut = _luts.get(key)
        if lut is None:
            g = key / 4.0
            lut = bytes(min(255, int(v * g)) for v in range(256))
            _luts[key] = lut
        data = data.translate(lut)
    out = bytearray(FRAME * 4)
    out[0::4] = data
    out[1::4] = data
    out[2::4] = data
    out[3::4] = ALPHA
    return cairo.ImageSurface.create_for_data(out, cairo.FORMAT_RGB24, W, H, W * 4), out


class Camera:
    """Reads GREY frames from the loopback in a thread, reopening on session end."""

    def __init__(self):
        self.stop = threading.Event()
        self.lock = threading.Lock()
        self.proc = None
        self.latest = None  # (seq, bytes, mean, max)
        self.seq = 0
        self.sessions = 0
        self.status = "starting"
        self.history = collections.deque(maxlen=35 * 40)  # (t, seq, mean, max)
        self.emitter_note = ""  # the bridge's own report of the session, from its journal

    def start(self):
        threading.Thread(target=self.run, daemon=True).start()

    @staticmethod
    def release(p, wait=2.0):
        """Stop a v4l2-ctl reader gracefully: SIGTERM so it closes the device (the bridge then
        stops its stream), a wait for it to exit, SIGKILL only if it hangs."""
        if p.poll() is None:
            try:
                p.terminate()
            except OSError:
                pass
            try:
                p.wait(timeout=wait)
            except subprocess.TimeoutExpired:
                try:
                    p.kill()
                except OSError:
                    pass

    def close(self):
        self.stop.set()
        p = self.proc
        if p is not None:
            try:
                p.terminate()
            except OSError:
                pass

    def query_emitter(self):
        """What the bridge logged for the session that just started (needs journal access)."""
        time.sleep(1.5)
        try:
            r = subprocess.run(["journalctl", "-u", "sl7-ir-bridge", "-n", "40", "--no-pager", "-o", "cat"],
                               stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace",
                               timeout=4)
        except (OSError, subprocess.SubprocessError):
            return
        for line in reversed(r.stdout.splitlines()):
            if "emitter ON:" in line:
                self.emitter_note = "bridge: " + line.split("emitter ON:", 1)[1].strip()
                return
            if "running unlit" in line or "emitter OFF" in line or "IR emitter OFF" in line:
                self.emitter_note = "bridge: emitter dark (" + line.strip()[:70] + ")"
                return

    def run(self):
        while not self.stop.is_set():
            if not os.path.exists(CAM):
                self.status = "waiting for %s (is sl7-ir-bridge running?)" % CAM
                self.stop.wait(1.0)
                continue
            try:
                p = subprocess.Popen(
                    ["v4l2-ctl", "-d", CAM, "--stream-mmap", "--stream-to=-"],
                    stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            except OSError as exc:
                self.status = "cannot start v4l2-ctl: %s" % exc
                self.stop.wait(2.0)
                continue
            self.proc = p
            self.sessions += 1
            self.status = "streaming (session %d)" % self.sessions
            threading.Thread(target=self.query_emitter, daemon=True).start()
            try:
                self.read_session(p)
            finally:
                self.release(p)
                p.wait()
                self.proc = None
            if not self.stop.is_set():
                self.status = "reopening the camera"
                self.stop.wait(0.25)

    def read_session(self, p):
        buf = bytearray(FRAME)
        mv = memoryview(buf)
        f = p.stdout
        first = True
        while not self.stop.is_set():
            got = 0
            while got < FRAME:
                n = f.readinto(mv[got:])
                if not n:
                    return
                got += n
            t = time.monotonic()
            if first:  # the bridge's black frame
                first = False
                continue
            data = bytes(buf)
            mean = sum(data) / FRAME
            mx = max(data)
            with self.lock:
                self.seq += 1
                seq = self.seq
                self.latest = (seq, data, mean, mx)
                self.history.append((t, seq, mean, mx))


CSS = b"""
.toast { background: rgba(30, 30, 30, 0.92); color: #ffffff; padding: 8px 16px; border-radius: 10px; }
"""


class Lab(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.omarchy.sl7.IrLab")
        self.cam = Camera()
        self.cur = None  # (surface, buffer) of the live frame
        self.shown_seq = 0
        self.ewma_max = None
        self.busy = False
        self.toast_gen = 0

    # ---- window -------------------------------------------------------------
    def do_activate(self):
        if getattr(self, "win", None) is not None:
            self.win.present()
            return
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.win = Gtk.ApplicationWindow(application=self, title="SL7 IR Lab")
        self.win.set_default_size(800, 800)
        self.win.connect("close-request", self.on_close)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        for side in ("top", "bottom", "start", "end"):
            getattr(root, "set_margin_" + side)(8)
        self.win.set_child(root)

        top = Gtk.Box(spacing=12)
        title = Gtk.Label(label="SL7 IR Lab", xalign=0, hexpand=True)
        title.add_css_class("title-3")
        top.append(title)
        self.stretch = Gtk.CheckButton(label="Contrast stretch")
        top.append(self.stretch)
        root.append(top)

        overlay = Gtk.Overlay(vexpand=True, hexpand=True)
        self.live = Gtk.DrawingArea(vexpand=True, hexpand=True)
        self.live.set_content_width(480)
        self.live.set_content_height(450)
        self.live.set_draw_func(self.draw_live)
        overlay.set_child(self.live)

        self.toast = Gtk.Label(halign=Gtk.Align.CENTER, valign=Gtk.Align.START)
        self.toast.add_css_class("toast")
        self.toast.set_margin_top(14)
        self.toast.set_visible(False)
        overlay.add_overlay(self.toast)
        root.append(overlay)

        self.readout = Gtk.Label(xalign=0, label="waiting for the camera")
        self.readout.add_css_class("monospace")
        root.append(self.readout)

        self.spark = Gtk.DrawingArea()
        self.spark.set_content_height(90)
        self.spark.set_draw_func(self.draw_spark)
        root.append(self.spark)

        buttons = Gtk.Box(spacing=8, homogeneous=True)
        self.snap_btn = Gtk.Button(label="Snapshot")
        self.snap_btn.connect("clicked", lambda _b: self.snapshot())
        buttons.append(self.snap_btn)
        self.status_btn = Gtk.Button(label="Status")
        self.status_btn.connect("clicked", lambda _b: self.run_status())
        buttons.append(self.status_btn)
        root.append(buttons)

        self.expander = Gtk.Expander(label="Status output")
        sw = Gtk.ScrolledWindow(min_content_height=120)
        self.text = Gtk.TextView(editable=False, monospace=True, cursor_visible=False)
        self.text.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        sw.set_child(self.text)
        self.expander.set_child(sw)
        root.append(self.expander)

        self.cam.start()
        GLib.timeout_add(33, self.tick)
        self.win.present()

    def on_close(self, _win):
        self.cam.close()
        return False

    # ---- small helpers ------------------------------------------------------
    def show_toast(self, text):
        self.toast_gen += 1
        gen = self.toast_gen
        self.toast.set_text(text)
        self.toast.set_visible(True)

        def hide():
            if gen == self.toast_gen:
                self.toast.set_visible(False)
            return False

        GLib.timeout_add_seconds(4, hide)

    def append_text(self, line):
        buf = self.text.get_buffer()
        buf.insert(buf.get_end_iter(), line if line.endswith("\n") else line + "\n")
        mark = buf.create_mark(None, buf.get_end_iter(), False)
        self.text.scroll_to_mark(mark, 0.0, False, 0.0, 0.0)
        buf.delete_mark(mark)
        return False

    def gain(self):
        if not self.stretch.get_active() or not self.ewma_max:
            return 1.0
        return max(1.0, min(16.0, 255.0 / max(self.ewma_max, 1.0)))

    # ---- live view, readout, graph -----------------------------------------
    def tick(self):
        with self.cam.lock:
            latest = self.cam.latest
        if latest is not None and latest[0] != self.shown_seq:
            seq, data, mean, mx = latest
            self.shown_seq = seq
            self.ewma_max = float(mx) if self.ewma_max is None else 0.98 * self.ewma_max + 0.02 * mx
            self.cur = gray_surface(data, self.gain())
            self.live.queue_draw()
            now = time.monotonic()
            with self.cam.lock:
                fps = sum(1 for h in self.cam.history if h[0] > now - 1.0)
            self.readout.set_text("frame %d   mean %6.2f   max %3d   %d fps   %s   %s%s" % (
                seq, mean, mx, fps, self.cam.status, "LIT" if mx >= LIT_MAX else "dark",
                ("   " + self.cam.emitter_note) if self.cam.emitter_note else ""))
        else:
            with self.cam.lock:
                last_t = self.cam.history[-1][0] if self.cam.history else 0.0
            if time.monotonic() - last_t > 1.5:
                self.readout.set_text(self.cam.status)
        self.spark.queue_draw()
        return True

    def draw_live(self, _area, cr, w, h):
        cr.set_source_rgb(0.04, 0.04, 0.06)
        cr.paint()
        if self.cur is None:
            cr.set_source_rgb(0.7, 0.7, 0.7)
            cr.move_to(16, 28)
            cr.show_text(self.cam.status)
            return
        s = min(w / W, h / H)
        cr.save()
        cr.translate((w - W * s) / 2, (h - H * s) / 2)
        cr.scale(s, s)
        cr.set_source_surface(self.cur[0], 0, 0)
        cr.get_source().set_filter(cairo.FILTER_BILINEAR)
        cr.paint()
        cr.restore()

    def draw_spark(self, _area, cr, w, h):
        cr.set_source_rgb(0.07, 0.07, 0.09)
        cr.paint()
        now = time.monotonic()
        t0 = now - SPARK_S
        with self.cam.lock:
            pts = [(x[0], x[2]) for x in self.cam.history if x[0] >= t0]
        if len(pts) < 2:
            return
        lo = min(p[1] for p in pts)
        hi = max(p[1] for p in pts)
        if hi - lo < 1.0:
            mid = (hi + lo) / 2
            lo, hi = mid - 0.5, mid + 0.5
        pad = 14

        def px(t):
            return (t - t0) / SPARK_S * (w - 2)

        def py(v):
            return h - pad - (v - lo) / (hi - lo) * (h - 2 * pad)

        cr.set_source_rgb(0.4, 0.85, 0.5)
        cr.set_line_width(1.2)
        cr.move_to(px(pts[0][0]), py(pts[0][1]))
        for t, v in pts[1:]:
            cr.line_to(px(t), py(v))
        cr.stroke()
        cr.set_source_rgb(0.75, 0.75, 0.75)
        cr.set_font_size(11)
        cr.move_to(4, 11)
        cr.show_text("mean %.1f" % hi)
        cr.move_to(4, h - 3)
        cr.show_text("%.1f   (last %d s)" % (lo, SPARK_S))

    # ---- snapshot -----------------------------------------------------------
    def new_outdir(self):
        d = os.path.join(OUTROOT, datetime.datetime.now().strftime("%Y%m%dT%H%M%S"))
        os.makedirs(d, exist_ok=True)
        return d

    def snapshot(self):
        with self.cam.lock:
            latest = self.cam.latest
        if latest is None:
            self.show_toast("No frame yet: nothing to save")
            return
        try:
            d = self.new_outdir()
            path = os.path.join(d, "snapshot.png")
            write_png(path, latest[1])
        except OSError as exc:
            self.show_toast("Snapshot failed: %s" % exc)
            return
        self.show_toast("Saved " + path.replace(os.path.expanduser("~"), "~", 1))

    # ---- status -------------------------------------------------------------
    def ui(self, fn, *args):
        GLib.idle_add(fn, *args)

    def run_status(self):
        if self.busy:
            return
        self.busy = True
        self.status_btn.set_sensitive(False)
        self.text.get_buffer().set_text("")
        self.expander.set_expanded(True)

        def work():
            try:
                r = subprocess.run([TOOL, "--status"], stdin=subprocess.DEVNULL,
                                   capture_output=True, text=True, errors="replace", timeout=20)
                out = (r.stdout + r.stderr).strip()
            except (OSError, subprocess.SubprocessError) as exc:
                out = "status failed: %s" % exc
            self.ui(self.append_text, out)
            self.ui(self.status_done)

        threading.Thread(target=work, daemon=True).start()

    def status_done(self):
        self.busy = False
        self.status_btn.set_sensitive(True)
        return False


def main():
    if os.geteuid() == 0:
        fail("run it as your normal user")
    if shutil.which("v4l2-ctl") is None:
        fail("v4l2-ctl is required (v4l-utils)")
    if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        fail("no graphical session (WAYLAND_DISPLAY or DISPLAY is not set)")
    sys.exit(Lab().run(sys.argv[:1]))


if __name__ == "__main__":
    main()
