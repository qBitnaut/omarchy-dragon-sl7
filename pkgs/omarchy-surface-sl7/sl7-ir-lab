    def on_close(self, _win):
        self.cam.close()
        return False

    # ---- small helpers ------------------------------------------------------
    def update_pulses(self):
        n = "?" if self.pulses is None else str(self.pulses)
        self.pulses_lbl.set_text("Pulses and arms this boot: %s (limit %d, %d for Stage C)" % (n, MAX_PULSES, STAGE_MAX_PULSES))

    def set_busy(self, busy):
        self.busy = busy
        for b in self.pulse_btns + [self.status_btn]:
            b.set_sensitive(not busy)
        self.update_stage_buttons()

    def show_toast(self, text):
        self.toast_gen += 1
        gen = self.toast_gen
        self.toast.set_text(text)
        self.toast.set_visible(True)

        def hide():
            if gen == self.toast_gen:
                self.toast.set_visible(False)
            return False

        GLib.timeout_add_seconds(4, hide)

    def append_text(self, line):
        buf = self.text.get_buffer()
        buf.insert(buf.get_end_iter(), line if line.endswith("\n") else line + "\n")
        mark = buf.create_mark(None, buf.get_end_iter(), False)
        self.text.scroll_to_mark(mark, 0.0, False, 0.0, 0.0)
        buf.delete_mark(mark)
        return False

    def gain(self):
        if not self.stretch.get_active() or not self.ewma_max:
            return 1.0
        return max(1.0, min(16.0, 255.0 / max(self.ewma_max, 1.0)))

    # ---- live view, readout, graph -----------------------------------------
    def tick(self):
        with self.cam.lock:
            latest = self.cam.latest
        if latest is not None and latest[0] != self.shown_seq:
            seq, data, mean, mx = latest
            self.shown_seq = seq
            self.ewma_max = float(mx) if self.ewma_max is None else 0.98 * self.ewma_max + 0.02 * mx
            self.cur = gray_surface(data, self.gain())
            self.live.queue_draw()
            now = time.monotonic()
            with self.cam.lock:
                fps = sum(1 for h in self.cam.history if h[0] > now - 1.0)
            self.readout.set_text("frame %d   mean %6.2f   max %3d   %d fps   %s" % (
                seq, mean, mx, fps, self.cam.status))
        else:
            with self.cam.lock:
                last_t = self.cam.history[-1][0] if self.cam.history else 0.0
            if time.monotonic() - last_t > 1.5:
                self.readout.set_text(self.cam.status)
        self.spark.queue_draw()
        return True

    def draw_live(self, _area, cr, w, h):
        cr.set_source_rgb(0.04, 0.04, 0.06)
        cr.paint()
        if self.cur is None:
            cr.set_source_rgb(0.7, 0.7, 0.7)
            cr.move_to(16, 28)
            cr.show_text(self.cam.status)
            return
        s = min(w / W, h / H)
        cr.save()
        cr.translate((w - W * s) / 2, (h - H * s) / 2)
        cr.scale(s, s)
        cr.set_source_surface(self.cur[0], 0, 0)
        cr.get_source().set_filter(cairo.FILTER_BILINEAR)
        cr.paint()
        cr.restore()

    def draw_inset(self, _area, cr, w, h, idx):
        cr.set_source_rgb(0, 0, 0)
        cr.paint()
        if self.inset is None:
            return
        surf = self.inset[idx][0]
        s = min(w / W, h / H)
        cr.save()
        cr.translate((w - W * s) / 2, (h - H * s) / 2)
        cr.scale(s, s)
        cr.set_source_surface(surf, 0, 0)
        cr.get_source().set_filter(cairo.FILTER_BILINEAR)
        cr.paint()
        cr.restore()
        cr.set_source_rgb(1, 1, 1)
        cr.set_line_width(1)
        cr.rectangle(0.5, 0.5, w - 1, h - 1)
        cr.stroke()

    def draw_spark(self, _area, cr, w, h):
        cr.set_source_rgb(0.07, 0.07, 0.09)
        cr.paint()
        now = time.monotonic()
        t0 = now - SPARK_S
        with self.cam.lock:
            pts = [(x[0], x[2]) for x in self.cam.history if x[0] >= t0]
            marks = [m for m in self.cam.markers if m >= t0]
        if len(pts) < 2:
            return
        lo = min(p[1] for p in pts)
        hi = max(p[1] for p in pts)
        if hi - lo < 1.0:
            mid = (hi + lo) / 2
            lo, hi = mid - 0.5, mid + 0.5
        pad = 14

        def px(t):
            return (t - t0) / SPARK_S * (w - 2)

        def py(v):
            return h - pad - (v - lo) / (hi - lo) * (h - 2 * pad)

        cr.set_line_width(1.5)
        for m in marks:
            cr.set_source_rgba(1.0, 0.3, 0.3, 0.9)
            cr.move_to(px(m), 0)
            cr.line_to(px(m), h)
            cr.stroke()
        cr.set_source_rgb(0.4, 0.85, 0.5)
        cr.set_line_width(1.2)
        cr.move_to(px(pts[0][0]), py(pts[0][1]))
        for t, v in pts[1:]:
            cr.line_to(px(t), py(v))
        cr.stroke()
        cr.set_source_rgb(0.75, 0.75, 0.75)
        cr.set_font_size(11)
        cr.move_to(4, 11)
        cr.show_text("mean %.1f" % hi)
        cr.move_to(4, h - 3)
        cr.show_text("%.1f   (last %d s, red = pulse)" % (lo, SPARK_S))

    # ---- snapshot -----------------------------------------------------------
    def new_outdir(self):
        d = os.path.join(OUTROOT, datetime.datetime.now().strftime("%Y%m%dT%H%M%S"))
        os.makedirs(d, exist_ok=True)
        return d

    def snapshot(self):
        with self.cam.lock:
            latest = self.cam.latest
        if latest is None:
            self.show_toast("No frame yet: nothing to save")
            return
        try:
            d = self.new_outdir()
            path = os.path.join(d, "snapshot.png")
            write_png(path, latest[1])
        except OSError as exc:
            self.show_toast("Snapshot failed: %s" % exc)
            return
        self.show_toast("Saved " + path.replace(os.path.expanduser("~"), "~", 1))

    # ---- pulse --------------------------------------------------------------
    def ask_pulse(self, ma):
        if self.busy:
            return
        self.confirm(
            "Confirm IR pulse", "Fire IR pulse at %s mA per channel?" % ma,
            "Nobody looks at the bezel. The emitter test asks for your password if needed.",
            lambda: self.start_pulse(ma))

    def start_pulse(self, ma):
        if self.busy:
            return
        try:
            outdir = self.new_outdir()
        except OSError as exc:
            self.show_toast("Cannot create the output directory: %s" % exc)
            return
        self.set_busy(True)
        self.out_lines = []
        self.text.get_buffer().set_text("")
        self.verdict.set_text("Pulse %s mA: waiting for the emitter test (authenticate if asked)..." % ma)
        self.inset_box.set_visible(False)
        self.cam.begin_watch()
        threading.Thread(target=self.pulse_worker, args=(ma, outdir), daemon=True).start()

    def ui(self, fn, *args):
        GLib.idle_add(fn, *args)

    def pulse_worker(self, ma, outdir):
        cmd = ["pkexec", TOOL, "--i-have-read-the-plan", "--led", "ir", "max_ma_per_channel=" + ma,
               "--pulse-delay", str(PULSE_DELAY_S), "--confirmed"]
        rc = -1
        try:
            p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, text=True, errors="replace", bufsize=1)
            for line in p.stdout:
                line = line.rstrip("\n")
                self.out_lines.append(line)
                self.ui(self.append_text, line)
                if "flash_strobe <- 1" in line:
                    self.cam.mark_fire()
                    self.ui(self.verdict.set_text, "Pulse %s mA fired. Looking for a spike..." % ma)
                elif "CONFIRMED" in line:
                    self.ui(self.verdict.set_text, "Armed at %s mA: firing in about %d s..." % (ma, PULSE_DELAY_S))
                mt = re.search(r"count this boot: (\d+)", line)
                if mt:
                    self.pulses = int(mt.group(1))
                    self.ui(self.update_pulses)
            rc = p.wait()
        except OSError as exc:
            self.out_lines.append("cannot run pkexec: %s" % exc)
            self.ui(self.append_text, "cannot run pkexec: %s" % exc)
        time.sleep(1.2)  # frames after the pulse
        res = self.analyse(ma, outdir, rc)
        self.ui(self.apply_result, res)

    def analyse(self, ma, outdir, rc):
        w, hist = self.cam.end_watch()
        res = {"ma": ma, "rc": rc, "outdir": outdir, "text": "", "spike": False, "best": None}
        t_fire = w["t_fire"] if w else None
        extra = []
        if t_fire is None:
            last = self.out_lines[-1] if self.out_lines else "no output"
            res["text"] = "No pulse was fired (emitter test exit code %d): %s" % (rc, last)
        else:
            win = [x for x in hist if t_fire - 1.6 <= x[0] <= t_fire + 1.6]
            ref = [x for x in win if x[0] < t_fire - 0.3 or x[0] > t_fire + 1.0]
            if len(ref) < 10:
                ref = [x for x in win if x[0] < t_fire - 0.3]
            if len(ref) < 5:
                ref = win
            best = w["best"]
            if not ref or best is None:
                res["text"] = "Pulse fired but no frames were read around it (is the bridge streaming?)"
            else:
                m = med([x[2] for x in ref])
                sd = max(1.4826 * med([abs(x[2] - m) for x in ref]), SD_FLOOR)
                z = (best[2] - m) / sd
                pre = w["pre"]
                base = pre[1] if pre else None
                res["spike"] = z > SPIKE_SD
                if res["spike"]:
                    res["text"] = "SPIKE +%.1f sd at frame %d (mean %.1f vs median %.1f, max %d)" % (
                        z, best[0], best[2], m, best[3])
                else:
                    res["text"] = "no spike (peak +%.1f sd at frame %d, below %.0f sd; mean %.1f vs median %.1f)" % (
                        z, best[0], SPIKE_SD, best[2], m)
                res["best"] = (best, base, pre[0] if pre else None)
                try:
                    with open(os.path.join(outdir, "frames.csv"), "w") as fh:
                        fh.write("frame,t_rel_fire_s,mean,max\n")
                        for x in win:
                            fh.write("%d,%.3f,%.3f,%d\n" % (x[1], x[0] - t_fire, x[2], x[3]))
                    write_png(os.path.join(outdir, "brightest.png"), best[1])
                    if base:
                        write_png(os.path.join(outdir, "baseline.png"), base)
                except OSError as exc:
                    extra.append("could not save everything: %s" % exc)
        snap = self.strobe_snapshot()
        if snap:
            self.out_lines.append("---- kernel strobe snapshot ----")
            self.out_lines.extend(snap)
            self.ui(self.append_text, "---- kernel strobe snapshot ----\n" + "\n".join(snap))
        else:
            note = "(no 'SL7 IR strobe snapshot' kernel lines readable as this user; linux-sl7 7.2.8-20 or later logs them)"
            self.ui(self.append_text, note)
        try:
            with open(os.path.join(outdir, "tool_output.txt"), "w") as fh:
                fh.write("\n".join(self.out_lines) + "\n")
            with open(os.path.join(outdir, "summary.txt"), "w") as fh:
                fh.write("pulse %s mA per channel, exit code %d\n%s\n" % (ma, rc, res["text"]))
        except OSError:
            pass
        if extra:
            res["text"] += "  [" + "; ".join(extra) + "]"
        return res

    def strobe_snapshot(self):
        try:
            r = subprocess.run(["journalctl", "-k", "--since", "-2min", "--no-pager", "-o", "cat"],
                               capture_output=True, text=True, errors="replace", timeout=10)
        except (OSError, subprocess.SubprocessError):
            return []
        return [ln for ln in r.stdout.splitlines() if "SL7 IR strobe snapshot" in ln]

    def apply_result(self, res):
        self.set_busy(False)
        txt = "Pulse %s mA: %s" % (res["ma"], res["text"])
        if res["rc"] not in (0, -1) and res["best"] is None:
            self.expander.set_expanded(True)
        self.verdict.set_text(txt + "   [%s]" % res["outdir"].replace(os.path.expanduser("~"), "~", 1))
        if res["best"] is not None:
            best, base, base_seq = res["best"]
            g = self.gain()
            self.inset = (
                gray_surface(base if base else best[1], g),
                gray_surface(best[1], g),
            )
            self.inset_caps[0].set_text("baseline" + (" (frame %d)" % base_seq if base_seq else ""))
            self.inset_caps[1].set_text("brightest (frame %d)" % best[0])
            self.inset_box.set_visible(True)
            for a in self.inset_areas:
                a.queue_draw()
            self.inset_gen += 1
            gen = self.inset_gen

            def hide():
                if gen == self.inset_gen:
                    self.inset_box.set_visible(False)
                return False

            GLib.timeout_add_seconds(INSET_SHOW_S, hide)
        self.show_toast(res["text"][:80])
        return False

    # ---- stage C --------------------------------------------------------------
    def build_stage_section(self, root):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        head = Gtk.Label(
            label="Stage C (IR emitter, at most 25 mA per channel, hardware timer always on). Each stage "
                  "unlocks the next; press Status to read the records.", xalign=0, wrap=True)
        head.add_css_class("caption")
        box.append(head)
        row = Gtk.Box(spacing=8, homogeneous=True)
        self.stage_btns = {}
        self.stage_state_lbls = {}
        for name, label, _text, _prev in STAGES:
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            b = Gtk.Button(label=label)
            b.connect("clicked", lambda _b, n=name: self.ask_stage(n))
            lbl = Gtk.Label(label="?")
            lbl.add_css_class("caption")
            col.append(b)
            col.append(lbl)
            row.append(col)
            self.stage_btns[name] = b
            self.stage_state_lbls[name] = lbl
        box.append(row)
        self.stage_verdict = Gtk.Label(xalign=0, wrap=True, label="No stage run yet.")
        self.stage_verdict.add_css_class("verdict")
        box.append(self.stage_verdict)
        sw = Gtk.ScrolledWindow(min_content_height=110)
        self.stage_view = Gtk.TextView(editable=False, monospace=True, cursor_visible=False)
        self.stage_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        sw.set_child(self.stage_view)
        box.append(sw)
        self.stage_graph = Gtk.DrawingArea()
        self.stage_graph.set_content_height(70)
        self.stage_graph.set_draw_func(self.draw_stage)
        box.append(self.stage_graph)
        root.append(box)
        self.update_stage_buttons()

    def update_stage_buttons(self):
        for name, _label, _text, prev in STAGES:
            ok = prev is None or self.stage_state.get(prev) == "OK"
            self.stage_btns[name].set_sensitive(ok and not self.busy)
            state = self.stage_state.get(name)
            self.stage_state_lbls[name].set_text(state if state else "?")
            if ok:
                self.stage_btns[name].set_tooltip_text(None)
            else:
                self.stage_btns[name].set_tooltip_text("Needs %s recorded OK first" % prev)

    def parse_stage_status(self, out):
        found = False
        for m in re.finditer(r"^stage-c (\S+): (\S+)", out, re.M):
            self.stage_state[m.group(1)] = m.group(2)
            found = True
        if found:
            self.update_stage_buttons()

    def stage_text(self, line):
        buf = self.stage_view.get_buffer()
        buf.insert(buf.get_end_iter(), line if line.endswith("\n") else line + "\n")
        mark = buf.create_mark(None, buf.get_end_iter(), False)
        self.stage_view.scroll_to_mark(mark, 0.0, False, 0.0, 0.0)
        buf.delete_mark(mark)
        return False

    def confirm(self, title, question, detail, on_fire):
        dlg = Gtk.Window(title=title, transient_for=self.win, modal=True, resizable=False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for side in ("top", "bottom", "start", "end"):
            getattr(box, "set_margin_" + side)(18)
        box.append(Gtk.Label(label=question, wrap=True, max_width_chars=56))
        box.append(Gtk.Label(label=detail, wrap=True, max_width_chars=56))
        row = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel")
        fire = Gtk.Button(label="Fire")
        fire.add_css_class("destructive-action")
        row.append(cancel)
        row.append(fire)
        box.append(row)
        dlg.set_child(box)
        dlg.set_default_widget(cancel)
        cancel.connect("clicked", lambda _b: dlg.close())

        def go(_b):
            dlg.close()
            on_fire()

        fire.connect("clicked", go)
        keys = Gtk.EventControllerKey()

        def on_key(_c, keyval, _code, _state):
            if keyval == Gdk.KEY_Escape:
                dlg.close()
                return True
            return False

        keys.connect("key-pressed", on_key)
        dlg.add_controller(keys)
        dlg.present()
        cancel.grab_focus()

    def ask_stage(self, name):
        if self.busy:
            return
        label, text = next((l, t) for n, l, t, _p in STAGES if n == name)
        self.confirm(
            "Confirm Stage C", "Run stage %s?" % label,
            text + "\n\nNobody looks at the bezel. The live view pauses while the test owns the "
                   "camera. The test asks for your password if needed.",
            lambda: self.start_stage(name))

    def start_stage(self, name):
        if self.busy:
            return
        try:
            outdir = self.new_outdir()
        except OSError as exc:
            self.show_toast("Cannot create the output directory: %s" % exc)
            return
        self.set_busy(True)
        self.out_lines = []
        self.stage_lines = []
        self.text.get_buffer().set_text("")
        self.stage_view.get_buffer().set_text("")
        self.stage_series = []
        self.stage_events = []
        self.stage_graph.queue_draw()
        self.inset_box.set_visible(False)
        self.stage_verdict.set_text("Stage %s: waiting for the emitter test (authenticate if asked); live view paused..." % name)
        self.cam.pause()
        threading.Thread(target=self.stage_worker, args=(name, outdir), daemon=True).start()

    def stage_worker(self, name, outdir):
        cmd = ["pkexec", TOOL, "--i-have-read-the-plan", "--stage", name, "--confirmed"]
        rc = -1
        res = {"name": name, "rc": rc, "result": None, "summary": "", "csv": None, "outdir": outdir}
        try:
            p = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, text=True, errors="replace", bufsize=1)
            for line in p.stdout:
                line = line.rstrip("\n")
                self.out_lines.append(line)
                self.ui(self.append_text, line)
                mt = STAGE_LINE.search(line)
                if mt:
                    sline = mt.group(1)
                    self.ui(self.stage_text, sline)
                    mr = re.match(r"STAGE_RESULT stage=\S+ result=(\S+)", sline)
                    if mr:
                        res["result"] = mr.group(1)
                    ms = re.match(r"STAGE_SUMMARY (.*)", sline)
                    if ms:
                        res["summary"] = ms.group(1)
                    mc = re.match(r"STAGE_FRAMES csv=(\S+)", sline)
                    if mc:
                        res["csv"] = mc.group(1)
                if "FIRE " in line or "hw_strobe_arm <- 1" in line:
                    self.ui(self.stage_verdict.set_text, "Stage %s: the emitter was fired / armed; reading the registers..." % name)
                mt = re.search(r"count this boot: (\d+)", line)
                if mt:
                    self.pulses = int(mt.group(1))
                    self.ui(self.update_pulses)
            rc = p.wait()
        except OSError as exc:
            self.out_lines.append("cannot run pkexec: %s" % exc)
            self.ui(self.append_text, "cannot run pkexec: %s" % exc)
        res["rc"] = rc
        if res["result"] is None:
            last = self.out_lines[-1] if self.out_lines else "no output"
            res["summary"] = "The stage did not run (exit code %d): %s" % (rc, last)
        series, events = [], []
        if res["csv"]:
            try:
                with open(res["csv"]) as fh:
                    for ln in fh:
                        f = ln.rstrip("\n").split(",")
                        if len(f) >= 3 and f[0] == "F":
                            series.append((float(f[1]), float(f[2])))
                        elif len(f) >= 5 and f[0] == "E":
                            events.append((float(f[1]), f[4]))
            except (OSError, ValueError):
                pass
        res["series"], res["events"] = series, events
        try:
            with open(os.path.join(outdir, "tool_output.txt"), "w") as fh:
                fh.write("\n".join(self.out_lines) + "\n")
            with open(os.path.join(outdir, "summary.txt"), "w") as fh:
                fh.write("stage %s, exit code %d, result %s\n%s\n" % (name, rc, res["result"], res["summary"]))
        except OSError:
            pass
        self.ui(self.apply_stage_result, res)
        # refresh the records for the buttons (pkexec keeps the authentication for a few minutes)
        try:
            r = subprocess.run(["pkexec", TOOL, "--status"], stdin=subprocess.DEVNULL, capture_output=True,
                               text=True, errors="replace", timeout=120)
            self.ui(self.parse_stage_status, r.stdout)
        except (OSError, subprocess.SubprocessError):
            pass

    def apply_stage_result(self, res):
        self.cam.resume()
        self.set_busy(False)
        self.stage_series = res["series"]
        self.stage_events = res["events"]
        if self.stage_series:
            self.cam.inject(self.stage_series, self.stage_events)
        self.stage_graph.queue_draw()
        if res["result"] == "OK":
            head = "Stage %s: PASS (OK)" % res["name"]
        elif res["result"] == "FAIL":
            head = "Stage %s: FAIL (STOP)" % res["name"]
        else:
            head = "Stage %s:" % res["name"]
        self.stage_verdict.set_text("%s  %s   [%s]" % (head, res["summary"], res["outdir"].replace(os.path.expanduser("~"), "~", 1)))
        if res["result"] == "FAIL":
            self.expander.set_expanded(True)
        self.show_toast(head)
        return False

    def draw_stage(self, _area, cr, w, h):
        cr.set_source_rgb(0.07, 0.07, 0.09)
        cr.paint()
        cr.set_font_size(11)
        if len(self.stage_series) < 2:
            cr.set_source_rgb(0.75, 0.75, 0.75)
            cr.move_to(4, 14)
            cr.show_text("Frame means of the last stage run appear here (red = software pulse or arm, blue = disarm).")
            return
        t0 = self.stage_series[0][0]
        t1 = self.stage_series[-1][0]
        span = max(t1 - t0, 0.001)
        lo = min(v for _t, v in self.stage_series)
        hi = max(v for _t, v in self.stage_series)
        if hi - lo < 1.0:
            mid = (hi + lo) / 2
            lo, hi = mid - 0.5, mid + 0.5
        pad = 14

        def px(t):
            return (t - t0) / span * (w - 2)

        def py(v):
            return h - pad - (v - lo) / (hi - lo) * (h - 2 * pad)

        cr.set_line_width(1.5)
        for t, label in self.stage_events:
            if t < t0 or t > t1:
                continue
            if label == "disarm":
                cr.set_source_rgba(0.3, 0.55, 1.0, 0.9)
            else:
                cr.set_source_rgba(1.0, 0.3, 0.3, 0.9)
            cr.move_to(px(t), 0)
            cr.line_to(px(t), h)
            cr.stroke()
        cr.set_source_rgb(0.4, 0.85, 0.5)
        cr.set_line_width(1.2)
        cr.move_to(px(self.stage_series[0][0]), py(self.stage_series[0][1]))
        for t, v in self.stage_series[1:]:
            cr.line_to(px(t), py(v))
        cr.stroke()
        cr.set_source_rgb(0.75, 0.75, 0.75)
        cr.move_to(4, 11)
        cr.show_text("mean %.1f" % hi)
        cr.move_to(4, h - 3)
        cr.show_text("%.1f   (stage run, %.1f s)" % (lo, span))

    # ---- status -------------------------------------------------------------
    def run_status(self):
        if self.busy:
            return
        self.set_busy(True)
        self.text.get_buffer().set_text("")
        self.expander.set_expanded(True)
        self.append_text("pkexec %s --status" % TOOL)

        def work():
            try:
                r = subprocess.run(["pkexec", TOOL, "--status"], stdin=subprocess.DEVNULL,
                                   capture_output=True, text=True, errors="replace", timeout=120)
                out = (r.stdout + r.stderr).strip()
            except (OSError, subprocess.SubprocessError) as exc:
                out = "status failed: %s" % exc
            mt = re.search(r"pulses fired this boot: (\d+)", out)
            if mt:
                self.pulses = int(mt.group(1))
                self.ui(self.update_pulses)
            self.ui(self.parse_stage_status, out)
            self.ui(self.append_text, out)
            self.ui(self.set_busy, False)

        threading.Thread(target=work, daemon=True).start()


def main():
    if os.geteuid() == 0:
        fail("run it as your normal user (it uses pkexec for the emitter test)")
    for prog in ("v4l2-ctl", "pkexec"):
        if shutil.which(prog) is None:
            fail("%s is required (v4l-utils provides v4l2-ctl, polkit provides pkexec)" % prog)
    if not os.path.exists(TOOL):
        fail("%s is not installed (omarchy-surface-sl7)" % TOOL)
    if not (os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")):
        fail("no graphical session (WAYLAND_DISPLAY or DISPLAY is not set)")
    sys.exit(Lab().run(sys.argv[:1]))


if __name__ == "__main__":
    main()
