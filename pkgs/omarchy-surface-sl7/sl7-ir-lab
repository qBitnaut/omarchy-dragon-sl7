def med(values):
    s = sorted(values)
    n = len(s)
    if not n:
        return 0.0
    return s[n // 2] if n % 2 else (s[n // 2 - 1] + s[n // 2]) / 2.0


def write_png(path, data):
    """Write one GREY W x H frame as an 8-bit grayscale PNG."""
    def chunk(tag, d):
        c = struct.pack(">I", len(d)) + tag + d
        return c + struct.pack(">I", zlib.crc32(tag + d) & 0xFFFFFFFF)

    raw = b"".join(b"\0" + data[r * W:(r + 1) * W] for r in range(H))
    with open(path, "wb") as fh:
        fh.write(b"\x89PNG\r\n\x1a\n")
        fh.write(chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 0, 0, 0, 0)))
        fh.write(chunk(b"IDAT", zlib.compress(raw, 4)))
        fh.write(chunk(b"IEND", b""))


_luts = {}


def gray_surface(data, gain=1.0):
    """GREY bytes to a Cairo RGB24 surface. Returns (surface, backing buffer)."""
    if gain > 1.01:
        key = int(gain * 4)
        lut = _luts.get(key)
        if lut is None:
            g = key / 4.0
            lut = bytes(min(255, int(v * g)) for v in range(256))
            _luts[key] = lut
        data = data.translate(lut)
    out = bytearray(FRAME * 4)
    out[0::4] = data
    out[1::4] = data
    out[2::4] = data
    out[3::4] = ALPHA
    return cairo.ImageSurface.create_for_data(out, cairo.FORMAT_RGB24, W, H, W * 4), out


class Camera:
    """Reads GREY frames from the loopback in a thread, reopening on session end."""

    def __init__(self):
        self.lock = threading.Lock()
        self.stop = threading.Event()
        self.proc = None
        self.latest = None  # (seq, bytes, mean, max)
        self.seq = 0
        self.sessions = 0
        self.status = "starting"
        self.history = collections.deque(maxlen=35 * 40)  # (t, seq, mean, max)
        self.ring = collections.deque(maxlen=12)  # (seq, bytes)
        self.markers = collections.deque(maxlen=32)  # monotonic fire times
        self.watch = None  # pulse tracking, see begin_watch
        self.paused = threading.Event()

    def start(self):
        threading.Thread(target=self.run, daemon=True).start()

    def close(self):
        self.stop.set()
        p = self.proc
        if p is not None:
            try:
                p.kill()
            except OSError:
                pass

    def pause(self):
        """Release the camera (a stage test starts the sensor itself) and wait until it is released."""
        self.paused.set()
        self.status = "paused: a Stage C test owns the camera"
        p = self.proc
        if p is not None:
            try:
                p.kill()
            except OSError:
                pass
        for _ in range(60):
            if self.proc is None:
                break
            time.sleep(0.05)

    def resume(self):
        self.status = "reconnecting"
        self.paused.clear()

    def inject(self, series, events):
        """Frame means measured by the stage tool (CLOCK_MONOTONIC like time.monotonic())."""
        with self.lock:
            for t, mean in series:
                self.seq += 1
                self.history.append((t, self.seq, mean, int(mean)))
            for t, label in events:
                self.markers.append(t)

    def run(self):
        while not self.stop.is_set():
            if self.paused.is_set():
                self.stop.wait(0.1)
                continue
            if not os.path.exists(CAM):
                self.status = "waiting for %s (is sl7-ir-bridge running?)" % CAM
                self.stop.wait(1.0)
                continue
            try:
                p = subprocess.Popen(
                    ["v4l2-ctl", "-d", CAM, "--stream-mmap", "--stream-to=-"],
                    stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            except OSError as exc:
                self.status = "cannot start v4l2-ctl: %s" % exc
                self.stop.wait(2.0)
                continue
            self.proc = p
            self.sessions += 1
            self.status = "streaming (session %d)" % self.sessions
            try:
                self.read_session(p)
            finally:
                try:
                    p.kill()
                except OSError:
                    pass
                p.wait()
                self.proc = None
            if not self.stop.is_set() and not self.paused.is_set():
                self.status = "reopening the camera"
                self.stop.wait(0.25)

    def read_session(self, p):
        buf = bytearray(FRAME)
        mv = memoryview(buf)
        f = p.stdout
        first = True
        while not self.stop.is_set():
            got = 0
            while got < FRAME:
                n = f.readinto(mv[got:])
                if not n:
                    return
                got += n
            t = time.monotonic()
            if first:  # the bridge's black frame
                first = False
                continue
            data = bytes(buf)
            mean = sum(data) / FRAME
            mx = max(data)
            with self.lock:
                self.seq += 1
                seq = self.seq
                self.latest = (seq, data, mean, mx)
                self.history.append((t, seq, mean, mx))
                self.ring.append((seq, data))
                w = self.watch
                if w is not None and w["t_fire"] is not None and w["t_fire"] - 0.1 <= t <= w["t_fire"] + 1.0:
                    if w["best"] is None or mean > w["best"][2]:
                        w["best"] = (seq, data, mean, mx)

    def begin_watch(self):
        with self.lock:
            self.watch = {"t_fire": None, "best": None, "pre": None}

    def mark_fire(self):
        t = time.monotonic()
        with self.lock:
            if self.watch is not None:
                self.watch["t_fire"] = t
                if self.ring:
                    self.watch["pre"] = self.ring[-3 if len(self.ring) >= 3 else -1]
            self.markers.append(t)

    def end_watch(self):
        with self.lock:
            w, self.watch = self.watch, None
            return w, list(self.history)


CSS = b"""
.toast { background: rgba(30, 30, 30, 0.92); color: #ffffff; padding: 8px 16px; border-radius: 10px; }
.verdict { font-weight: bold; }
