        self.cam = Camera()
        self.cur = None  # (surface, buffer) of the live frame
        self.shown_seq = 0
        self.ewma_max = None
        self.pulses = None
        self.busy = False
        self.out_lines = []
        self.inset = None  # (base surface/buf, peak surface/buf, captions)
        self.inset_gen = 0
        self.toast_gen = 0
        self.stage_state = {}  # stage name -> OK / FAIL / none / stale (from --status)
        self.stage_series = []  # (t, mean) of the last stage run
        self.stage_events = []  # (t, label)
        self.stage_lines = []

    # ---- window -------------------------------------------------------------
