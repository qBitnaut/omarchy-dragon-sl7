#!/bin/bash
# Install linux-sl7's romulus13/romulus15 device trees where Omarchy looks
# for them, and make the UKI list them.
#
# linux-sl7 keeps its DTBs in /usr/lib/modules/<kver>/dtbs/qcom (it writes
# nothing to /boot). Omarchy's qualcomm/dtb-uki.sh globs /boot/dtbs/qcom, where
# linux-aarch64's romulus DTBs lack the touchpad/touchscreen nodes. So:
#   1. copy the newest linux-sl7 romulus13/15 DTBs over those two files in
#      /boot/dtbs/qcom (the ALARM original is kept once as <name>.dtb.alarm-orig,
#      which the *.dtb glob ignores);
#   2. write the DeviceTreeAuto block in /etc/kernel/uki.conf from
#      /boot/dtbs/qcom, with the same markers as dtb-uki.sh. dtb-uki.sh lists
#      every x1* tree there (a superset); both writers see the same romulus
#      DTBs, so whichever runs last is correct. -el2 trees are never listed.
# Run by 85-omarchy-surface-sl7-dtbs.hook after linux-sl7 or linux-aarch64
# installs/upgrades. Usage: update-uki-dtbs [--print]
set -euo pipefail

modules_root=${OMARCHY_SL7_MODULES_DIR:-/usr/lib/modules}
uki_config=${OMARCHY_QUALCOMM_UKI_CONFIG:-/etc/kernel/uki.conf}
boot_dtb_dir=${OMARCHY_QUALCOMM_DTB_DIR:-/boot/dtbs/qcom}
boards=(x1e80100-microsoft-romulus13 x1e80100-microsoft-romulus15)
managed_begin="# BEGIN OMARCHY QUALCOMM DEVICE TREES"
managed_end="# END OMARCHY QUALCOMM DEVICE TREES"

print_only=0
case ${1:-} in
  --print) print_only=1 ;;
  "") ;;
  *)
    echo "usage: ${0##*/} [--print]" >&2
    exit 2
    ;;
esac

# Newest installed kernel that belongs to linux-sl7.
kvers=()
for dir in "$modules_root"/*/; do
  dir=${dir%/}
  if [[ -f $dir/pkgbase && $(<"$dir/pkgbase") == linux-sl7 &&
    -f $dir/dtbs/qcom/${boards[0]}.dtb ]]; then
    kvers+=("${dir##*/}")
  fi
done
if ((${#kvers[@]} == 0)); then
  echo "omarchy-surface-sl7: no linux-sl7 device trees under $modules_root; UKI config unchanged" >&2
  exit 0
fi
kver=$(printf '%s\n' "${kvers[@]}" | sort -V | tail -n 1)

if ((!print_only)); then
  mkdir -p "$boot_dtb_dir"
  for board in "${boards[@]}"; do
    src=$modules_root/$kver/dtbs/qcom/$board.dtb
    dst=$boot_dtb_dir/$board.dtb
    [[ -f $src ]] || continue
    if [[ -f $dst ]] && ! cmp -s "$src" "$dst"; then
      [[ -e $dst.alarm-orig ]] || cp -p "$dst" "$dst.alarm-orig"
    fi
    cmp -s "$src" "$dst" 2>/dev/null || install -m644 "$src" "$dst"
  done
fi

dtbs=()
for board in "${boards[@]}"; do
  if ((print_only)); then dtb=$modules_root/$kver/dtbs/qcom/$board.dtb; else dtb=$boot_dtb_dir/$board.dtb; fi
  [[ -f $dtb ]] && dtbs+=("$dtb")
done

# Existing config minus our previous block.
rest=""
if [[ -f $uki_config ]]; then
  rest=$(awk -v begin="$managed_begin" -v end="$managed_end" '
    $0 == begin { managed = 1; next }
    managed && $0 == end { managed = 0; next }
    !managed { print }
  ' "$uki_config")
fi

# A second [UKI] header may be rejected by ukify's config parser; only emit
# one when the file does not already end inside a [UKI] section.
last_section=$(grep -E '^\[.*\]$' <<<"$rest" | tail -n 1 || true)
header="[UKI]"
[[ $last_section == "[UKI]" ]] && header=""

block=$(
  echo "$managed_begin"
  echo "# Generated by omarchy-surface-sl7 (romulus DTBs from linux-sl7 $kver)."
  echo "# systemd-stub selects a device tree from SMBIOS data."
  [[ -n $header ]] && echo "$header"
  echo "DeviceTreeAuto=${dtbs[*]}"
  echo "$managed_end"
)

if ((print_only)); then
  echo "$block"
  exit 0
fi

mkdir -p "$(dirname "$uki_config")"
uki_tmp=$(mktemp "${uki_config}.XXXXXX")
trap 'rm -f "$uki_tmp"' EXIT

[[ -n $rest ]] && echo "$rest" >"$uki_tmp"
echo "$block" >>"$uki_tmp"
chmod 0644 "$uki_tmp"
mv -f "$uki_tmp" "$uki_config"
trap - EXIT
echo "omarchy-surface-sl7: ${#dtbs[@]} device trees from linux-sl7 $kver listed in $uki_config"
