#!/bin/bash
# Point the UKI's DeviceTreeAuto at linux-sl7's romulus13 and romulus15 device
# trees (never the -el2 variants).
#
# Omarchy's install/hardware/qualcomm/dtb-uki.sh globs /boot/dtbs/qcom, but
# linux-sl7 installs its DTBs at /usr/lib/modules/<kver>/dtbs/qcom and writes
# nothing to /boot, so that glob finds nothing and the UKI would carry no
# .dtbauto sections. This writes the same managed block (same markers) to the
# same file, so a later dtb-uki.sh run replaces it instead of duplicating it.
# DeviceTreeAuto needs literal paths, hence the re-run on every linux-sl7
# upgrade (85-omarchy-surface-sl7-dtbs.hook).
#
# Usage: update-uki-dtbs [--print]
set -euo pipefail

modules_root=${OMARCHY_SL7_MODULES_DIR:-/usr/lib/modules}
uki_config=${OMARCHY_QUALCOMM_UKI_CONFIG:-/etc/kernel/uki.conf}
boards=(x1e80100-microsoft-romulus13 x1e80100-microsoft-romulus15)
managed_begin="# BEGIN OMARCHY QUALCOMM DEVICE TREES"
managed_end="# END OMARCHY QUALCOMM DEVICE TREES"

print_only=0
case ${1:-} in
  --print) print_only=1 ;;
  "") ;;
  *)
    echo "usage: ${0##*/} [--print]" >&2
    exit 2
    ;;
esac

# Newest installed kernel that belongs to linux-sl7.
kvers=()
for dir in "$modules_root"/*/; do
  dir=${dir%/}
  if [[ -f $dir/pkgbase && $(<"$dir/pkgbase") == linux-sl7 &&
    -f $dir/dtbs/qcom/${boards[0]}.dtb ]]; then
    kvers+=("${dir##*/}")
  fi
done
if ((${#kvers[@]} == 0)); then
  echo "omarchy-surface-sl7: no linux-sl7 device trees under $modules_root; UKI config unchanged" >&2
  exit 0
fi
kver=$(printf '%s\n' "${kvers[@]}" | sort -V | tail -n 1)

dtbs=()
for board in "${boards[@]}"; do
  dtb=$modules_root/$kver/dtbs/qcom/$board.dtb
  [[ -f $dtb ]] && dtbs+=("$dtb")
done

# Existing config minus our previous block.
rest=""
if [[ -f $uki_config ]]; then
  rest=$(awk -v begin="$managed_begin" -v end="$managed_end" '
    $0 == begin { managed = 1; next }
    managed && $0 == end { managed = 0; next }
    !managed { print }
  ' "$uki_config")
fi

# A second [UKI] header may be rejected by ukify's config parser; only emit
# one when the file does not already end inside a [UKI] section.
last_section=$(grep -E '^\[.*\]$' <<<"$rest" | tail -n 1 || true)
header="[UKI]"
[[ $last_section == "[UKI]" ]] && header=""

block=$(
  echo "$managed_begin"
  echo "# Generated by omarchy-surface-sl7 for linux-sl7 $kver."
  echo "# systemd-stub selects a device tree from SMBIOS data."
  [[ -n $header ]] && echo "$header"
  echo "DeviceTreeAuto=${dtbs[*]}"
  echo "$managed_end"
)

if ((print_only)); then
  echo "$block"
  exit 0
fi

mkdir -p "$(dirname "$uki_config")"
uki_tmp=$(mktemp "${uki_config}.XXXXXX")
trap 'rm -f "$uki_tmp"' EXIT

[[ -n $rest ]] && echo "$rest" >"$uki_tmp"
echo "$block" >>"$uki_tmp"
chmod 0644 "$uki_tmp"
mv -f "$uki_tmp" "$uki_config"
trap - EXIT
echo "omarchy-surface-sl7: ${#dtbs[@]} device trees from linux-sl7 $kver listed in $uki_config"
