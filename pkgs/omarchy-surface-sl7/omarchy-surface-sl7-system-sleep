#!/bin/bash
# systemd system-sleep hook (installed as
# /usr/lib/systemd/system-sleep/omarchy-surface-sl7).
#
# After resume the SL7 touchpad's virtual device goes static while the raw
# HID node keeps sending data (recon run 5): iptsd is still running but the
# device needs its heatmap mode re-enabled. Restarting iptsd@ does that.
# iptsd's own system-sleep hook only re-triggers udev "add", which does not
# restart a unit that is already running.
#
# The helper runs detached (never blocks resume) and itself waits for the
# hidraw nodes to reappear, since their numbers can change.
case ${1:-} in
  post)
    helper=/usr/lib/omarchy-surface-sl7/restart-iptsd
    if command -v systemd-run >/dev/null 2>&1; then
      systemd-run --quiet --no-block --on-active=1 \
        "$helper" ||
        { "$helper" >/dev/null 2>&1 & }
    else
      "$helper" || true
    fi
    # The charger may have been (un)plugged while asleep, and no udev event
    # is guaranteed on resume: re-apply the AC/battery caps shortly after.
    if [[ -x /usr/bin/omarchy-sl7-powermode ]]; then
      if command -v systemd-run >/dev/null 2>&1; then
        systemd-run --quiet --no-block --on-active=3 \
          /usr/bin/omarchy-sl7-powermode --system auto ||
          { /usr/bin/omarchy-sl7-powermode --system auto >/dev/null 2>&1 & }
      else
        /usr/bin/omarchy-sl7-powermode --system auto >/dev/null 2>&1 &
      fi
    fi
    ;;
esac
exit 0
