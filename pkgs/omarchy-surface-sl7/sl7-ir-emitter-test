# Flash register offsets read for the instrumentation (from the base 0xee00).
readonly FLASH_BASE=0xee00
readonly DUMP_REGS=(0x06 0x07 0x08 0x09 0x0c 0x0d 0x0e 0x0f 0x10 0x18 0x3e 0x41 0x42 0x45 0x46 0x49 0x4a 0x4d 0x4e 0x50 0x51 0x52 0x53)

usage() {
  sed -n '2,/^set -uo/{/^set -uo/!p}' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

log() {
  local line
  line="$(date -Is) ${me}[$$]: $*"
  printf '%s\n' "$line"
  if [[ -d ${logf%/*} ]]; then
    printf '%s\n' "$line" 2>/dev/null >>"$logf" || true
  fi
  if ((!fake)) && command -v logger >/dev/null 2>&1; then
    logger -t "$me" -- "$*" 2>/dev/null || true
  fi
}

# Every ir:flash-* LED: flash_strobe=0. Safe to call repeatedly.
disarm_all() {
  local d
  ((armed_touch)) || return 0
  for d in "$leds"/ir:flash-*; do
    # hardware strobe arm first (the flash sysfs files refuse writes while it is armed)
    if [[ -e $d/hw_strobe_arm ]]; then
      printf '%s' 0 >"$d/hw_strobe_arm" 2>/dev/null &&
        log "DISARM ${d##*/}/hw_strobe_arm <- 0" ||
        log "DISARM FAILED ${d##*/}/hw_strobe_arm"
    fi
    [[ -e $d/flash_strobe ]] || continue
    printf '%s' 0 >"$d/flash_strobe" 2>/dev/null &&
      log "DISARM ${d##*/}/flash_strobe <- 0" ||
      log "DISARM FAILED ${d##*/}/flash_strobe"
  done
  return 0
}

# Capture helpers (only used by --watch / --watch-only-test).
stop_capture() {
  if [[ -n $cap_pid ]] && kill -0 "$cap_pid" 2>/dev/null; then
    kill "$cap_pid" 2>/dev/null || true
    wait "$cap_pid" 2>/dev/null || true
  fi
  cap_pid=
}

# Driver limit back to its default (the emitter is already off).
restore_limit() {
  ((param_touched)) || return 0
  param_touched=0
  printf '%s' "$IR_LIMIT_DEFAULT_UA" >"$irparam" 2>/dev/null &&
    log "RESTORE ${irparam#"$R"} <- $IR_LIMIT_DEFAULT_UA" ||
    log "RESTORE FAILED ${irparam#"$R"} (reload leds_qcom_flash or reboot to reset it)"
  return 0
}

# Manual exposure (IR sensor, vd55g subdev) for the pulses, restored afterwards.
ctrl_field() { # TEXT NAME FIELD
  grep -E "^[[:space:]]*$2 " <<<"$1" | head -n1 | grep -oE "$3=-?[0-9]+" | head -n1 | cut -d= -f2
}

expo_manual_on() {
  local n name ctrls max v
  if ! command -v v4l2-ctl >/dev/null 2>&1; then
    log "WARN manual exposure skipped: v4l2-ctl is not installed"
    return 0
  fi
  for n in "$subdev_sys"/v4l-subdev*; do
    [[ -e $n/name ]] || continue
    name=$(rd "$n/name")
    if [[ $name == *vd55g* ]]; then
      expo_dev=$R/dev/${n##*/}
      break
    fi
  done
  if [[ -z $expo_dev ]]; then
    log "WARN manual exposure skipped: no vd55g subdev found in ${subdev_sys#"$R"}"
    return 0
  fi
  if ! ctrls=$(v4l2-ctl -d "$expo_dev" --list-ctrls 2>&1); then
    log "WARN manual exposure skipped: cannot list the controls of ${expo_dev#"$R"}: $ctrls"
    expo_dev=
    return 0
  fi
  expo_saved_ae=$(ctrl_field "$ctrls" auto_exposure value)
  expo_saved_exp=$(ctrl_field "$ctrls" exposure value)
  max=$(ctrl_field "$ctrls" exposure max)
  [[ $max =~ ^[0-9]+$ ]] || max=1796
  if [[ -z $expo_saved_ae || -z $expo_saved_exp ]]; then
    log "WARN manual exposure skipped: auto_exposure/exposure controls not found on ${expo_dev#"$R"}"
    expo_dev=
    return 0
  fi
  log "EXPOSURE ${expo_dev#"$R"} ($name): saved auto_exposure=$expo_saved_ae exposure=$expo_saved_exp, setting manual and exposure=$max"
  expo_touched=1
  v4l2-ctl -d "$expo_dev" --set-ctrl auto_exposure=1 >/dev/null 2>&1 || log "WARN could not set auto_exposure=1"
  v4l2-ctl -d "$expo_dev" --set-ctrl exposure="$max" >/dev/null 2>&1 || log "WARN could not set exposure=$max"
  v=$(v4l2-ctl -d "$expo_dev" --get-ctrl auto_exposure,exposure 2>&1 | tr '\n' ' ')
  log "EXPOSURE read back: $v"
  return 0
}

expo_restore() {
  ((expo_touched)) || return 0
  expo_touched=0
  v4l2-ctl -d "$expo_dev" --set-ctrl auto_exposure="$expo_saved_ae" >/dev/null 2>&1
  if [[ $expo_saved_ae == 1 ]]; then v4l2-ctl -d "$expo_dev" --set-ctrl exposure="$expo_saved_exp" >/dev/null 2>&1; fi
  log "EXPOSURE restored on ${expo_dev#"$R"}: auto_exposure=$expo_saved_ae exposure=$expo_saved_exp"
  return 0
}

# Flash register dump through the regmap debugfs: the PMIC regmap is the one
# whose registers 0xee04 and 0xee05 read 0x18 and 0x07. Every line of the file
# is 9 bytes ("eeXX: VV\n"), so one register is dd bs=9 skip=<address>.
dd_line() { dd if="$1" bs=9 skip=$(($2)) count=1 2>/dev/null | tr -d '\n'; }

find_regmap() {
  local d f a b
  for d in "$debugfs_regmap"/*/; do
    f=${d%/}/registers
    [[ -r $f ]] || continue
    a=$(dd_line "$f" 0xee04)
    b=$(dd_line "$f" 0xee05)
    if [[ $a == "ee04: 18"* && $b == "ee05: 07"* ]]; then
      regmap_file=$f
      log "REGMAP flash registers via ${f#"$R"} (0xee04=18, 0xee05=07)"
      return 0
    fi
  done
  log "WARN no regmap debugfs with 0xee04=18 and 0xee05=07 under ${debugfs_regmap#"$R"} (debugfs not mounted?): no REGDUMP lines"
  return 0
}

regdump() { # WHEN
  local off l v out=""
  [[ -n $regmap_file ]] || return 0
  for off in "${DUMP_REGS[@]}"; do
    l=$(dd_line "$regmap_file" $((FLASH_BASE + off)))
    v=${l#*: }
    v=${v//[[:space:]]/}
    out+=" $(printf '%02x' "$off")=${v:-??}"
  done
  log "REGDUMP ($1, offsets from $FLASH_BASE):$out"
}

