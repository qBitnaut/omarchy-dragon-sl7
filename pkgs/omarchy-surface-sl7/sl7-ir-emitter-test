# Frame statistics and comparisons. grab: a frame grabber that reads the bridge
# loopback and writes one line per frame (index, CLOCK_MONOTONIC arrival time, mean,
# 99th percentile of every 7th pixel), no image is ever kept. cmp: two grabs, same
# exposure, led_mode 0 against led_mode 1. frames: one grab against events (software
# pulses, or hardware arm and disarm times), all times from the kernel log
# (t_mono, CLOCK_MONOTONIC like the frame times).
read -r -d '' STAGE_PY <<'PYEOF'
import collections
import signal
import subprocess
import sys
import time

K = 5.0
MEAN_FLOOR = 0.5
P99_FLOOR = 4.0
SKIP = 2


def med(v):
    s = sorted(v)
    n = len(s)
    if not n:
        return 0.0
    return s[n // 2] if n % 2 else (s[n // 2 - 1] + s[n // 2]) / 2.0


def robust(v):
    m = med(v)
    return m, 1.4826 * med([abs(x - m) for x in v])


def read_frames(path):
    rows = []
    try:
        with open(path) as fh:
            for ln in fh:
                f = ln.split()
                if len(f) != 5 or f[0] != "F":
                    continue
                try:
                    rows.append((int(f[1]), float(f[2]), float(f[3]), int(f[4])))
                except ValueError:
                    continue
    except OSError:
        pass
    return [r for r in rows if r[0] >= 1 + SKIP]


def grab():
    w, h, dev, out = int(sys.argv[2]), int(sys.argv[3]), sys.argv[4], sys.argv[5]
    fsz = w * h
    proc = subprocess.Popen(
        ["v4l2-ctl", "-d", dev, "--stream-mmap", "--stream-to=-"],
        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    stop = []

    def term(_sig, _frm):
        stop.append(1)
        try:
            proc.kill()
        except OSError:
            pass

    signal.signal(signal.SIGTERM, term)
    signal.signal(signal.SIGINT, term)
    buf = bytearray(fsz)
    mv = memoryview(buf)
    idx = 0
    with open(out, "a", buffering=1) as fh:
        while not stop:
            got = 0
            while got < fsz:
                n = proc.stdout.readinto(mv[got:])
                if not n:
                    break
                got += n
            if got < fsz:
                break
            t = time.monotonic()
            data = bytes(buf)
            mean = sum(data) / fsz
            sub = data[::7]
            cnt = collections.Counter(sub)
            thr = 0.99 * len(sub)
            cum = 0
            p99 = 0
            for k in sorted(cnt):
                cum += cnt[k]
                if cum >= thr:
                    p99 = k
                    break
            fh.write("F %d %.6f %.4f %d\n" % (idx, t, mean, p99))
            idx += 1
        fh.write("END %d\n" % idx)
    try:
        proc.kill()
    except OSError:
        pass
    proc.wait()


def cmp_mode():
    label, bfile, tfile = sys.argv[2], sys.argv[3], sys.argv[4]
    b = read_frames(bfile)
    t = read_frames(tfile)
    if len(b) < 5 or len(t) < 5:
        print("STAGE_CMP label=%s verdict=INSUFFICIENT base_frames=%d test_frames=%d" % (
            label, len(b), len(t)))
        return
    bm, bsd = robust([r[2] for r in b])
    bp, bpsd = robust([r[3] for r in b])
    thr_m = bm + max(K * bsd, MEAN_FLOOR)
    thr_p = bp + max(K * bpsd, P99_FLOOR)
    tm = med([r[2] for r in t])
    tp = med([r[3] for r in t])
    over = sum(1 for r in t if r[2] > thr_m or r[3] > thr_p)
    lit = tm > thr_m or tp > thr_p
    print("STAGE_CMP label=%s verdict=%s base_frames=%d test_frames=%d base_mean=%.3f "
          "test_mean=%.3f thr_mean=%.3f base_p99=%.1f test_p99=%.1f thr_p99=%.1f frames_over=%d" % (
              label, "LIT" if lit else "DARK", len(b), len(t), bm, tm, thr_m, bp, tp, thr_p, over))


def frames_mode():
    grabf, evf, csvp, kind = sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]
    rows = read_frames(grabf)
    ev = []
    try:
        with open(evf) as fh:
            for ln in fh:
                f = ln.split()
                if len(f) >= 3 and f[0] == "E":
                    try:
                        ev.append((float(f[1]), f[2]))
                    except ValueError:
                        continue
    except OSError:
        pass
    ev.sort()
    if len(rows) < 8:
        print("STAGE_ANALYSIS kind=%s verdict=INSUFFICIENT usable_frames=%d" % (kind, len(rows)))
        return
    period = med([rows[i + 1][1] - rows[i][1] for i in range(len(rows) - 1)])
    wins = []
    if kind == "pulse":
        for t, lab in ev:
            if lab == "pulse":
                wins.append((t - 0.01, t + 0.02 + 1.5 * period, t))
    else:
        pend = None
        for t, lab in ev:
            if lab == "arm":
                pend = t
            elif lab == "disarm" and pend is not None:
                wins.append((pend - 0.01, t + 1.5 * period, pend))
                pend = None
        if pend is not None:
            wins.append((pend - 0.01, pend + 1.0 + 1.5 * period, pend))
    inwin = [any(a <= r[1] <= b for a, b, _ in wins) for r in rows]
    base = [r for r, w in zip(rows, inwin) if not w]
    if len(base) < 5:
        print("STAGE_ANALYSIS kind=%s verdict=INSUFFICIENT baseline_frames=%d" % (kind, len(base)))
        return
    bm, bsd = robust([r[2] for r in base])
    bp, bpsd = robust([r[3] for r in base])
    thr_m = max(K * bsd, MEAN_FLOOR)
    thr_p = max(K * bpsd, P99_FLOOR)
    spikes = 0
    for i, (a, b, t) in enumerate(wins, 1):
        fr = [r for r in rows if a <= r[1] <= b]
        if fr:
            dm = max(r[2] for r in fr) - bm
            dp = max(r[3] for r in fr) - bp
        else:
            dm = dp = 0.0
        spike = bool(fr) and (dm > thr_m or dp > thr_p)
        spikes += 1 if spike else 0
        if kind == "pulse":
            prev = [r[1] for r in rows if r[1] <= t]
            nxt = [r[1] for r in rows if r[1] > t]
            if prev and nxt and period > 0:
                phase = "%.2f" % ((t - prev[-1]) / period)
                gaps = "prev_ms=%.1f next_ms=%.1f" % ((t - prev[-1]) * 1000, (nxt[0] - t) * 1000)
            else:
                phase = "na"
                gaps = "prev_ms=na next_ms=na"
            print("STAGE_PULSE_FRAMES i=%d t_mono=%.6f phase=%s %s window_frames=%d d_mean=%+.3f "
                  "d_p99=%+.1f spike=%s" % (i, t, phase, gaps, len(fr), dm, dp, "yes" if spike else "no"))
        else:
            print("STAGE_ARM_FRAMES i=%d from=%.6f to=%.6f window_frames=%d d_mean=%+.3f "
                  "d_p99=%+.1f spike=%s" % (i, a, b, len(fr), dm, dp, "yes" if spike else "no"))
    if csvp:
        try:
            with open(csvp, "w") as fh:
                fh.write("kind,t_mono,mean,p99,label\n")
                for r in rows:
                    fh.write("F,%.6f,%.4f,%d,\n" % (r[1], r[2], r[3]))
                for t, lab in ev:
                    fh.write("E,%.6f,,,%s\n" % (t, lab))
        except OSError:
            csvp = ""
    print("STAGE_ANALYSIS kind=%s verdict=DONE windows=%d spikes=%d baseline_frames=%d base_mean=%.3f "
          "base_sd=%.3f period_ms=%.1f csv=%s" % (kind, len(wins), spikes, len(base), bm, bsd,
                                                 period * 1000, csvp))


MODES = {"grab": grab, "cmp": cmp_mode, "frames": frames_mode}
if len(sys.argv) < 2 or sys.argv[1] not in MODES:
    sys.exit("usage: grab|cmp|frames ...")
MODES[sys.argv[1]]()
PYEOF

# Register decoders. STATUS1 (4ch): bit 2k short circuit, bit 2k+1 open circuit of
# channel k+1 (driver fault_get, and the 0x82 = CH1 + CH4 open of the first strobe).
# STATUS2: the over-temperature and supply bits of the driver. STATUS3: bit 2k timer
# expired of channel k+1. INT_RT_STS: bit 4 ramp-up done, bit 3 ramp-down done, bit 0 fault
# (names assumed from the 0x49 read at the first strobe, not from a datasheet).
hexv() { # HEX (1 or 2 digits) -> decimal, -1 when empty or not hex
  if [[ ${1:-} =~ ^[0-9a-f]{1,2}$ ]]; then printf '%d' "$((16#$1))"; else printf '%d' -1; fi
}

dec_named() { # HEX NAME0 .. NAME7
  local hex=$1 v i out=""
  local -a names
  shift
  names=("$@")
  v=$(hexv "$hex")
  if ((v < 0)); then
    printf '%s' '?'
    return 0
  fi
  for i in 0 1 2 3 4 5 6 7; do
    if ((v & (1 << i))); then out+="${names[i]:-bit$i}, "; fi
  done
  out=${out%, }
  printf '%s' "${out:-clear}"
}
dec_s1() { dec_named "$1" "CH1 short" "CH1 open" "CH2 short" "CH2 open" "CH3 short" "CH3 open" "CH4 short" "CH4 open"; }
dec_s2() { dec_named "$1" "VPH low" "BCL ibat" "BOB ilim S1" "BOB ilim S2" "over-temp 2" "over-temp 1" "BOB thermal overload"; }
dec_s3() { dec_named "$1" "CH1 timer expired" "bit1" "CH2 timer expired" "bit3" "CH3 timer expired" "bit5" "CH4 timer expired" "bit7"; }
dec_rt() { dec_named "$1" "fault" "bit1" "bit2" "ramp-down done" "ramp-up done" "bit5" "bit6" "bit7"; }

show_reg() { # WHEN S1 S2 S3 RT (two hex digits each, or empty)
  log "STAGE_REG $1 | STATUS1 0x${2:-??}: $(dec_s1 "${2:-}") | STATUS2 0x${3:-??}: $(dec_s2 "${3:-}") | STATUS3 0x${4:-??}: $(dec_s3 "${4:-}") | INT_RT_STS 0x${5:-??}: $(dec_rt "${5:-}")"
}

regget() { # OFFSET -> two hex digits through the regmap debugfs, empty when unavailable
  local l v
  [[ -n $regmap_file ]] || return 0
  l=$(dd_line "$regmap_file" $((FLASH_BASE + $1)))
  v=${l#*: }
  v=${v//[[:space:]]/}
  printf '%s' "$v"
}

sample_regs() { # WHEN: STATUS1, STATUS2, STATUS3, INT_RT_STS into g_s1 g_s2 g_s3 g_rt
  g_s1=$(regget 0x06)
  g_s2=$(regget 0x07)
  g_s3=$(regget 0x09)
  g_rt=$(regget 0x10)
  show_reg "$1" "$g_s1" "$g_s2" "$g_s3" "$g_rt"
}

# Unsafe: a short-circuit bit (an even STATUS1 bit) or any STATUS2 bit. Returns 0 when unsafe.
unsafe_s1s2() { # S1 S2
  local a b
  a=$(hexv "${1:-}")
  b=$(hexv "${2:-}")
  if ((a >= 0 && (a & 0x55))); then return 0; fi
  if ((b > 0)); then return 0; fi
  return 1
}

count_pulse() { # a software pulse or a hardware strobe arm
  pulses=$((pulses + 1))
  printf '%s\n' "$pulses" >"$rundir/pulses" || die 6 "cannot record the pulse count in $rundir/pulses"
  log "COUNT pulses this boot: $pulses (limit $STAGE_MAX_PULSES_PER_BOOT for --stage runs)"
}

stage_ev() { # evidence line: logged and kept in the stage record
  stage_evidence+=("$*")
  log "EVIDENCE $*"
}

# ---- stage records ------------------------------------------------------------
stage_result() { # NAME -> OK, FAIL, stale (another kernel) or none
  local f=$stage_dir/$1 res kern
  if [[ ! -f $f || -L $f ]]; then
    printf '%s' none
    return 0
  fi
  res=$(sed -n 's/^result=//p' "$f" | head -n1)
  kern=$(sed -n 's/^kernel=//p' "$f" | head -n1)
  if [[ $kern != "$(uname -r)" ]]; then
    printf '%s' stale
    return 0
  fi
  printf '%s' "${res:-none}"
}

stage_prev() { # NAME -> the stage that must have passed first
  case $1 in
    c0b) echo c0a ;;
    c1-sw) echo c0b ;;
    c1-hw) echo c1-sw ;;
    t0b) echo c1-hw ;;
    *) echo "" ;;
  esac
}

stage_finish() { # OK|FAIL SUMMARY: log, record in the stage directory
  local res=$1 summary=$2 tmp ts
  stage_recorded=1
  [[ $res == OK ]] && stage_rc=0 || stage_rc=5
  log "STAGE_RESULT stage=$stage result=$res"
  log "STAGE_SUMMARY $summary"
  if ! mkdir -p "$stage_dir" 2>/dev/null; then
    log "WARN cannot create ${stage_dir#"$R"}: the result is not recorded"
    return 0
  fi
  chmod 0755 "$stage_dir" 2>/dev/null || true
  ts=$(date +%Y%m%dT%H%M%S)
  if ! tmp=$(mktemp "$stage_dir/.new.XXXXXX" 2>/dev/null); then
    log "WARN cannot write a record in ${stage_dir#"$R"}: the result is not recorded"
    return 0
  fi
  {
    printf 'result=%s\n' "$res"
    printf 'time=%s\n' "$(date -Is)"
    printf 'kernel=%s\n' "$(uname -r)"
    printf 'boot_id=%s\n' "$(rd "$R/proc/sys/kernel/random/boot_id")"
    printf 'summary=%s\n' "$summary"
    printf 'evidence=%s\n' "${stage_evidence[@]}"
  } >"$tmp"
  chmod 0644 "$tmp"
  mv -f -- "$tmp" "$stage_dir/$stage"
  cp -- "$stage_dir/$stage" "$stage_dir/$stage.$ts.txt" 2>/dev/null || true
  log "RECORDED ${stage_dir#"$R"}/$stage (result $res)"
  return 0
}

stage_record_abort() { # on_exit: a stage that touched hardware and did not finish is a FAIL
  ((stage_started && !stage_recorded)) || return 0
  stage_finish FAIL "aborted before the stage completed: ${last_die:-signal or error}"
  return 0
}

# ---- the IR sensor (vd55g subdev), the frame grabber, the kernel log ------------
sd_find() {
  local n name
  for n in "$subdev_sys"/v4l-subdev*; do
    [[ -e $n/name ]] || continue
    name=$(rd "$n/name")
    if [[ $name == *vd55g* ]]; then
      sd_dev=$R/dev/${n##*/}
      sd_sysdir=$n
      return 0
    fi
  done
  return 1
}

sd_ctl_get() { # NAME: the value only (menu controls print "1 (Manual Mode)")
  v4l2-ctl -d "$sd_dev" --get-ctrl "$1" 2>/dev/null | sed -n 's/^[^:]*: *\([^ ]*\).*/\1/p' | head -n1
}

sd_ctl_set() { # NAME VALUE: set, read back, abort when the read back differs
  local got
  v4l2-ctl -d "$sd_dev" --set-ctrl "$1=$2" >/dev/null 2>&1 || die 6 "cannot set $1=$2 on ${sd_dev#"$R"}"
  got=$(sd_ctl_get "$1")
  log "SENSOR set $1=$2, read back '$got'"
  [[ $got == "$2" ]] || die 6 "$1 reads back '$got' after setting $2 (a driver range clamp?)"
}

sd_wait_idle() { # up to 10 s for the sensor to runtime-suspend: no stream, the GPIO is not driven
  local st v i
  st=$sd_sysdir/device/power/runtime_status
  v=$(rd "$st")
  if [[ -z $v || $v == unsupported ]]; then
    log "WARN cannot read ${st#"$R"} ('$v'): waiting 4 s for the camera to go idle instead"
    sleep 4
    return 0
  fi
  for ((i = 0; i < 100; i++)); do
    [[ $(rd "$st") == suspended ]] && return 0
    sleep 0.1
  done
  die 8 "the IR sensor is still $(rd "$st") after 10 s: another program streams the IR camera (the sl7-ir-lab live view, a browser, the bridge?). Close it and retry. Nothing was fired."
}

sd_open() { # find the subdev, save controls
  local ctrls vbdef
  sd_find || die 4 "no vd55g subdev in ${subdev_sys#"$R"}"
  command -v v4l2-ctl >/dev/null 2>&1 || die 8 "v4l2-ctl is required (pacman -S v4l-utils)"
  ctrls=$(v4l2-ctl -d "$sd_dev" --list-ctrls 2>&1) || die 4 "cannot list the controls of ${sd_dev#"$R"}: $ctrls"
  [[ $ctrls == *led_mode* ]] || die 4 "no led_mode control on ${sd_dev#"$R"}: vd55g.illuminator is not effective (kernel 7.2.8-21 or later, IR test boot)"
  sd_saved_ae=$(ctrl_field "$ctrls" auto_exposure value)
  sd_saved_exp=$(ctrl_field "$ctrls" exposure value)
  sd_saved_vb=$(ctrl_field "$ctrls" vertical_blanking value)
  sd_saved_led=$(ctrl_field "$ctrls" led_mode value)
  vbdef=$(ctrl_field "$ctrls" vertical_blanking default)
  if [[ -z $sd_saved_ae || -z $sd_saved_exp || -z $sd_saved_vb || -z $sd_saved_led || ! $vbdef =~ ^[0-9]+$ ]]; then
    die 4 "auto_exposure, exposure, vertical_blanking or led_mode not found on ${sd_dev#"$R"}"
  fi
  sd_h=$((SENSOR_FRAME_DEF - vbdef))
  ((sd_h == SENSOR_ACTIVE_H)) || die 4 "vertical_blanking default $vbdef implies an active height of $sd_h lines, expected $SENSOR_ACTIVE_H"
  log "SENSOR ${sd_dev#"$R"}: saved auto_exposure=$sd_saved_ae exposure=$sd_saved_exp vertical_blanking=$sd_saved_vb led_mode=$sd_saved_led, active height $sd_h"
}

sd_setup() { # LED_MODE EXPOSURE FRAME_LENGTH: frame length first, exposure last (the flash mode halves its range)
  local vb=$(($3 - sd_h))
  sd_touched=1
  sd_ctl_set auto_exposure 1
  sd_ctl_set vertical_blanking "$vb"
  sd_ctl_set led_mode "$1"
  sd_ctl_set exposure "$2"
}

# Restore, in this order: (the strobe is already off) led_mode 0, stream off, then
# exposure, blanking and auto exposure back to what they were.
stage_sensor_restore() {
  ((sd_touched)) || return 0
  sd_touched=0
  if v4l2-ctl -d "$sd_dev" --set-ctrl led_mode=0 >/dev/null 2>&1; then
    log "RESTORE led_mode <- 0"
  else
    log "RESTORE FAILED led_mode (the next stream may drive GPIO 1 with the strobe off: reboot to be sure)"
  fi
  grab_stop
  v4l2-ctl -d "$sd_dev" --set-ctrl exposure="$sd_saved_exp" >/dev/null 2>&1 || log "RESTORE FAILED exposure"
  v4l2-ctl -d "$sd_dev" --set-ctrl vertical_blanking="$sd_saved_vb" >/dev/null 2>&1 || log "RESTORE FAILED vertical_blanking"
  v4l2-ctl -d "$sd_dev" --set-ctrl auto_exposure="$sd_saved_ae" >/dev/null 2>&1 || log "RESTORE FAILED auto_exposure"
  log "RESTORE sensor: led_mode 0, stream off, exposure=$sd_saved_exp vertical_blanking=$sd_saved_vb auto_exposure=$sd_saved_ae"
  return 0
}

grab_start() { # FILE
  grabfile=$1
  : >"$grabfile" || die 8 "cannot create $grabfile"
  python3 -c "$STAGE_PY" grab "$CAM_W" "$CAM_H" "$camdev" "$grabfile" &
  grab_pid=$!
}

grab_stop() {
  local i
  if [[ -n $grab_pid ]] && kill -0 "$grab_pid" 2>/dev/null; then
    kill -TERM "$grab_pid" 2>/dev/null || true
    for ((i = 0; i < 40; i++)); do
      kill -0 "$grab_pid" 2>/dev/null || break
      sleep 0.05
    done
    kill -KILL "$grab_pid" 2>/dev/null || true
    wait "$grab_pid" 2>/dev/null || true
  fi
  grab_pid=
}

grab_wait() { # MIN_INDEX TIMEOUT_S: block until the grab file has a frame with at least this index
  local want=$1 i=0 max=$(($2 * 20)) last idx
  while :; do
    last=$(tail -n 1 -- "$grabfile" 2>/dev/null || true)
    if [[ $last == "F "* ]]; then
      read -r _ idx _ <<<"$last"
      if ((idx >= want)); then return 0; fi
    fi
    kill -0 "$grab_pid" 2>/dev/null || die 8 "the frame grabber ended before frame $want (see journalctl -u sl7-ir-bridge)"
    ((++i > max)) && die 8 "no camera frames within $2 s (frame $want wanted; check journalctl -u sl7-ir-bridge)"
    sleep 0.05
  done
}

watch_prereqs() { # the same checks as --watch, for the stages that read the camera
  command -v python3 >/dev/null 2>&1 || die 8 "python3 is required for the frame statistics"
  command -v v4l2-ctl >/dev/null 2>&1 || die 8 "v4l2-ctl is required (pacman -S v4l-utils)"
  systemctl is-active --quiet sl7-ir-bridge.service || die 8 "sl7-ir-bridge.service is not active (the stage reads the IR camera through it). Nothing was fired."
  [[ -c $camdev ]] || die 8 "${camdev#"$R"} does not exist (is v4l2loopback loaded and the bridge running?)"
}

mark_klog() { # sets mark: a line in the kernel log, everything after it belongs to this step
  mark="sl7-ir-emitter-test mark $$ $(date +%s.%N)"
  printf '%s\n' "$mark" >/dev/kmsg 2>/dev/null || log "WARN cannot write the marker to /dev/kmsg"
}

klog_since() { # MARK: the kernel log after the marker line
  dmesg 2>/dev/null | awk -v m="$1" 'index($0, m) { f = 1; next } f'
}

events_from_klog() { # KIND (pulse|arm) KLOGTEXT OUTFILE: "E <t_mono> <label>" lines
  local kind=$1 text=$2 out=$3 line re='t_mono ([0-9]+[.][0-9]+)'
  : >"$out"
  while IFS= read -r line; do
    [[ $line =~ $re ]] || continue
    if [[ $kind == pulse && $line == *"(t0, after CHAN_EN set,"* ]]; then
      printf 'E %s pulse\n' "${BASH_REMATCH[1]}" >>"$out"
    elif [[ $kind == arm && $line == *"hardware strobe ARMED"* ]]; then
      printf 'E %s arm\n' "${BASH_REMATCH[1]}" >>"$out"
    elif [[ $kind == arm && $line == *"hardware strobe DISARMED"* ]]; then
      printf 'E %s disarm\n' "${BASH_REMATCH[1]}" >>"$out"
    fi
  done <<<"$text"
}

getreg() { # SNAPSHOT_LINES LABEL REG -> two hex digits of that register in the last snapshot with that label
  local line re=" $3=([0-9a-f]{2})"
  line=$(grep -F "($2," <<<"$1" | tail -n 1)
  if [[ $line =~ $re ]]; then printf '%s' "${BASH_REMATCH[1]}"; fi
}

# The poll of a hardware strobe arm (kernel patch 0096): union of the values read in the
# first 30 ms, and the INT_RT_STS idle value before the arm.
hw_eval() { # KLOGTEXT
  local line re='union 06=([0-9a-f]{2}) 07=([0-9a-f]{2}) 09=([0-9a-f]{2}) 10=([0-9a-f]{2})'
  k_have=0
  k_u1=
  k_u2=
  k_u3=
  k_urt=
  k_idle_rt=
  line=$(grep -F 'HW-strobe poll:' <<<"$1" | tail -n 1)
  if [[ $line =~ $re ]]; then
    k_u1=${BASH_REMATCH[1]}
    k_u2=${BASH_REMATCH[2]}
    k_u3=${BASH_REMATCH[3]}
    k_urt=${BASH_REMATCH[4]}
    k_have=1
  fi
  line=$(grep -F '(hw arm: idle before arm,' <<<"$1" | tail -n 1)
  re=' 10=([0-9a-f]{2})'
  if [[ $line =~ $re ]]; then k_idle_rt=${BASH_REMATCH[1]}; fi
}

fault_text="" # flash_fault tokens other than the safety timer
fault_soft() { # WHEN: like check_fault, but sets fault_text instead of aborting
  local f t bad=""
  f=$(rd "$led/flash_fault")
  log "READ  $ledname/flash_fault ($1) = '$f'"
  for t in $f; do [[ $t == "$ONLY_FAULT" ]] || bad="$bad $t"; done
  fault_text=$bad
}

stage_prep() { # PER_CHANNEL_UA: driver limit, current and timer for this step; strobe off
  local ua=$1
  ((ua <= STAGE_MAX_CH_UA)) || die 5 "internal: $ua uA per channel is above the stage limit of $STAGE_MAX_CH_UA"
  wr "$irparam" "$ua"
  param_touched=1
  rdback "$irparam" "$ua"
  wr "$led/flash_strobe" 0
  wr "$led/flash_brightness" $((ua * nch))
  rdback "$led/flash_brightness" $((ua * nch))
  wr "$led/flash_timeout" "$FIRE_TIMEOUT_US"
  rdback "$led/flash_timeout" "$FIRE_TIMEOUT_US"
}

stage_banner() {
  local what="" detail=""
  case $stage in
    c0a)
      what="STAGE C0a: hardware strobe armed, sensor NOT streaming (negative control)"
      detail="One arm of ir:flash-14 at 12.5 mA per channel for about 0.7 s, 10 ms hardware timer.
  PASS: STATUS1 stays 0 and no ramp or fault bit appears. 0x82, a ramp or a fault: STOP."
      ;;
    c0b)
      what="STAGE C0b: sensor strobes GPIO 1, PMIC NOT armed (negative control)"
      detail="No PMIC current at all. The sensor streams with led_mode=1 (short exposure, then
  long exposure), compared with led_mode=0. PASS: no brightness change. Lit: STOP."
      ;;
    c1-sw)
      what="STAGE C1 (SW, T3): GPIO 1 strobing with a long exposure, 8 software pulses"
      detail="8 pulses of ir:flash-14 at 25 mA per channel, 10 ms, 300 to 700 ms apart.
  STOP on any short-circuit bit in STATUS1, or STATUS2 not 0."
      ;;
    c1-hw)
      what="STAGE C1 (HW, T4): hardware strobe armed while the sensor strobes GPIO 1"
      detail="Two arms of ir:flash-14, 12.5 then 25 mA per channel, about 0.7 s each, 10 ms hardware timer,
  exposure 100 lines (1.6 ms). STOP on any short-circuit bit in STATUS1, or STATUS2 not 0."
      ;;
    t0b)
      what="STAGE T0b: ir:flash-23 (channels 2 and 3), one software pulse"
      detail="One pulse of 12.5 mA per channel, 10 ms. Expected: STATUS1 0x28 (CH2 and CH3 open)."
      ;;
  esac
  cat <<EOF

  $what
  $detail

  Read the checklist. Every stage is at most 25 mA per channel, the hardware timer is always on.

    [ ] Nobody looks at the bezel. The laptop faces a matte white card or a wall at 30 cm or more.
    [ ] The glass over the emitter is not cracked or scratched.
    [ ] Nothing else uses the IR camera (the sl7-ir-lab live view pauses itself).
    [ ] The owner approved Stage B (the approval file exists).

  Log: ${logf#"$R"}
  Result record: ${stage_dir#"$R"}/$stage

EOF
}

# ---- c0a: hardware strobe armed, sensor not streaming ---------------------------
stage_c0a() {
  local i reasons="" tmark ktxt
  if sd_find; then sd_wait_idle; else log "WARN no vd55g subdev found: cannot check that the sensor is idle"; fi
  stage_prep 12500
  [[ -e $led/hw_strobe_arm ]] || die 4 "$ledname has no hw_strobe_arm attribute (linux-sl7 7.2.8-21 or later)"
  mark_klog
  tmark=$mark
  sample_regs "c0a idle, before arm"
  stage_started=1
  count_pulse
  log "FIRE hardware strobe arm $ledname: $fire_ua uA total ($per_ch_ua uA x $nch), timer 10 ms (count this boot: $pulses)"
  wr "$led/hw_strobe_arm" 1
  for ((i = 1; i <= 4; i++)); do
    sleep 0.15
    sample_regs "c0a armed, sample $i"
    if unsafe_s1s2 "$g_s1" "$g_s2"; then
      reasons+="sample $i: STATUS1 0x$g_s1 STATUS2 0x$g_s2; "
      break
    fi
  done
  wr "$led/hw_strobe_arm" 0
  sample_regs "c0a after disarm"
  sleep 0.2
  ktxt=$(klog_since "$tmark")
  hw_eval "$ktxt"
  if ((!k_have)); then
    reasons+="no kernel poll line (is linux-sl7 7.2.8-21 running, and is dmesg readable?); "
  else
    stage_ev "kernel poll union STATUS1=0x$k_u1 STATUS2=0x$k_u2 STATUS3=0x$k_u3 INT_RT_STS=0x$k_urt (idle INT_RT_STS 0x${k_idle_rt:-??})"
    show_reg "c0a kernel poll union (first 30 ms)" "$k_u1" "$k_u2" "$k_u3" "$k_urt"
    [[ $(hexv "$k_u1") -eq 0 ]] || reasons+="STATUS1 0x$k_u1 ($(dec_s1 "$k_u1")); "
    [[ $(hexv "$k_u2") -eq 0 ]] || reasons+="STATUS2 0x$k_u2; "
    if (($(hexv "$k_urt") & 0x10)); then reasons+="ramp-up bit in INT_RT_STS 0x$k_urt; "; fi
    if [[ -n $k_idle_rt ]] && (($(hexv "$k_urt") & ~$(hexv "$k_idle_rt") & 0xff)); then
      reasons+="INT_RT_STS 0x$k_urt gained bits over the idle 0x$k_idle_rt ($(dec_rt "$k_urt")); "
    fi
  fi
  if [[ -z $reasons ]]; then
    stage_finish OK "hardware strobe armed about 0.7 s at 12.5 mA per channel, sensor idle: STATUS1 0, no ramp or fault. The strobe input is not floating high."
  else
    log "STOP c0a: $reasons"
    stage_finish FAIL "STOP: $reasons"
  fi
}

# ---- c0b: sensor strobes GPIO 1, PMIC not armed ----------------------------------
c0b_phase() { # LABEL EXPOSURE FRAME_LENGTH MIN_INDEX TIMEOUT: base (led_mode 0) then test (led_mode 1)
  local label=$1 expo=$2 flen=$3 idx=$4 tmo=$5 base tst out
  base=$watchdir/c0b-$label-base.txt
  tst=$watchdir/c0b-$label-test.txt
  sd_wait_idle
  sd_setup 0 "$expo" "$flen"
  log "C0B $label: baseline, led_mode 0, exposure $expo lines, frame $flen lines"
  grab_start "$base"
  grab_wait "$idx" "$tmo"
  grab_stop
  sd_wait_idle
  sd_ctl_set led_mode 1
  stage_started=1
  log "C0B $label: test, led_mode 1 set before the stream starts, PMIC not armed"
  grab_start "$tst"
  grab_wait "$idx" "$tmo"
  grab_stop
  sd_ctl_set led_mode 0
  out=$(python3 -c "$STAGE_PY" cmp "$label" "$base" "$tst" 2>&1) || true
  log "$out"
  c0b_out+="$out"$'\n'
}

stage_c0b() {
  c0b_out=""
  sd_open
  watch_prereqs
  mkdir -p "$rundir" && watchdir=$(mktemp -d "$rundir/watch.XXXXXX") || die 8 "cannot create a private directory under ${rundir#"$R"}"
  chmod 0700 "$watchdir" 2>/dev/null || true
  stage_prep 12500
  c0b_phase short "$SHORT_EXPO" "$SHORT_FRAME" 45 10
  c0b_phase long "$LONG_EXPO" "$LONG_FRAME" 9 12
  stage_ev "c0b: $(tr '\n' ' ' <<<"$c0b_out")"
  if grep -q 'verdict=LIT' <<<"$c0b_out"; then
    log "STOP c0b: the sensor strobe alone changed the brightness"
    stage_finish FAIL "STOP: GPIO 1 drives the emitter on its own (brightness changed with the PMIC not armed). Re-plan: the current limits would not apply."
  elif grep -q 'verdict=INSUFFICIENT' <<<"$c0b_out" || [[ $(grep -c 'verdict=DARK' <<<"$c0b_out") -ne 2 ]]; then
    stage_finish FAIL "not enough frames for a verdict (see the STAGE_CMP lines); run it again"
  else
    stage_finish OK "no brightness change with led_mode 1 and the PMIC not armed, short and long exposure"
  fi
}

# ---- c1-sw: software pulses while the sensor strobes GPIO 1 -----------------------
stage_c1_sw() {
  local i gap_ms tmark ktxt snaps m s1 s2 rt s3 line lbl stop_msg="" clear_n=0 ramp_n=0 spike_n=0
  local -a lbls=("t0" "t0+1ms" "t0+3ms" "t0+15ms")
  local ev csvf ana re_s3=' 09=([0-9a-f]{2})' re_sp='spikes=([0-9]+)'
  sd_open
  watch_prereqs
  mkdir -p "$rundir" && watchdir=$(mktemp -d "$rundir/watch.XXXXXX") || die 8 "cannot create a private directory under ${rundir#"$R"}"
  chmod 0700 "$watchdir" 2>/dev/null || true
  stage_prep 25000
  sd_wait_idle
  sd_setup 1 "$LONG_EXPO" "$LONG_FRAME"
  mark_klog
  tmark=$mark
  grab_start "$watchdir/c1sw.txt"
  grab_wait 9 15
  stage_started=1
  sample_regs "c1-sw idle, streaming with GPIO 1 strobing"
  for ((i = 1; i <= stage_pulses; i++)); do
    gap_ms=$((300 + RANDOM % 401))
    sleep "$(printf '%d.%03d' $((gap_ms / 1000)) $((gap_ms % 1000)))"
    wr "$led/flash_strobe" 0
    wr "$led/flash_brightness" "$fire_ua"
    rdback "$led/flash_brightness" "$fire_ua"
    wr "$led/flash_timeout" "$FIRE_TIMEOUT_US"
    rdback "$led/flash_timeout" "$FIRE_TIMEOUT_US"
    fault_soft "armed"
    [[ -z $fault_text ]] || { stop_msg="fault on $ledname before pulse $i:$fault_text"; break; }
    count_pulse
    log "FIRE $ledname $fire_ua uA ($per_ch_ua uA x $nch), pulse $i/$stage_pulses after a ${gap_ms} ms gap (count this boot: $pulses)"
    wr "$led/flash_strobe" 1
    sleep "$POST_STROBE_WAIT_S"
    wr "$led/flash_strobe" 0
    snaps=$(dmesg 2>/dev/null | grep -F 'SL7 IR strobe snapshot' | tail -n 8)
    local s1l="" s2l="" rtl="" unsafe=0 have=0 clear=yes ramp=no
    for lbl in "${lbls[@]}"; do
      s1=$(getreg "$snaps" "$lbl" 06)
      s2=$(getreg "$snaps" "$lbl" 07)
      rt=$(getreg "$snaps" "$lbl" 10)
      s1l+="${s1:-??},"
      s2l+="${s2:-??},"
      rtl+="${rt:-??},"
      if [[ -n $s1 ]]; then
        have=1
        [[ $(hexv "$s1") -eq 0 ]] || clear=no
      fi
      if unsafe_s1s2 "$s1" "$s2"; then unsafe=1; fi
      if (($(hexv "$rt") & 0x10)); then ramp=yes; fi
    done
    line=$(grep -F 'STATUS3 at t0+15ms' <<<"$snaps" | tail -n 1)
    s3=""
    if [[ $line =~ $re_s3 ]]; then s3=${BASH_REMATCH[1]}; fi
    m=$(getreg "$snaps" "t0+3ms" 06)
    log "STAGE_PULSE i=$i gap_ms=$gap_ms STATUS1[t0,+1,+3,+15ms]=${s1l%,} STATUS2=${s2l%,} INT_RT_STS=${rtl%,} STATUS3@15ms=${s3:-??} s1_clear=$clear rampup=$ramp | STATUS1@+3ms: $(dec_s1 "$m") | STATUS3@+15ms: $(dec_s3 "$s3")"
    stage_ev "pulse $i: STATUS1 ${s1l%,} STATUS2 ${s2l%,} INT_RT_STS ${rtl%,} STATUS3@15ms ${s3:-??}"
    if ((!have)); then
      stop_msg="no kernel snapshot for pulse $i (linux-sl7 7.2.8-21 running? dmesg readable?): cannot verify it was safe"
      break
    fi
    if ((unsafe)); then
      stop_msg="pulse $i: a short-circuit bit in STATUS1 (${s1l%,}) or STATUS2 not 0 (${s2l%,})"
      break
    fi
    [[ $clear == yes ]] && clear_n=$((clear_n + 1))
    [[ $ramp == yes ]] && ramp_n=$((ramp_n + 1))
    fault_soft "after"
    [[ -z $fault_text ]] || { stop_msg="fault on $ledname after pulse $i:$fault_text"; break; }
  done
  wr "$led/flash_strobe" 0
  sleep 1.2
  grab_stop
  ktxt=$(klog_since "$tmark")
  ev=$watchdir/events.txt
  events_from_klog pulse "$ktxt" "$ev"
  csvf=${logf%.log}-stage-$stage-$(date +%Y%m%dT%H%M%S).csv
  ana=$(python3 -c "$STAGE_PY" frames "$watchdir/c1sw.txt" "$ev" "$csvf" pulse 2>&1) || true
  while IFS= read -r line; do [[ -z $line ]] || log "$line"; done <<<"$ana"
  if [[ $ana =~ $re_sp ]]; then spike_n=${BASH_REMATCH[1]}; fi
  log "STAGE_FRAMES csv=$csvf"
  if [[ -n $stop_msg ]]; then
    log "STOP c1-sw: $stop_msg"
    stage_finish FAIL "STOP: $stop_msg"
  else
    stage_finish OK "$stage_pulses pulses at 25 mA per channel with GPIO 1 strobing: STATUS1 == 0 on $clear_n, ramp-up bit on $ramp_n, brightness spike on $spike_n (no stop condition)"
  fi
}

# ---- c1-hw: hardware strobe armed, sensor strobing -------------------------------
stage_c1_hw() {
  local ua tmark ktxt ev csvf ana line i k stop_msg="" subsum="" spike_n=0 re_sp='spikes=([0-9]+)'
  [[ -e $led/hw_strobe_arm ]] || die 4 "$ledname has no hw_strobe_arm attribute (linux-sl7 7.2.8-21 or later)"
  sd_open
  watch_prereqs
  mkdir -p "$rundir" && watchdir=$(mktemp -d "$rundir/watch.XXXXXX") || die 8 "cannot create a private directory under ${rundir#"$R"}"
  chmod 0700 "$watchdir" 2>/dev/null || true
  sd_wait_idle
  sd_setup 1 "$SHORT_EXPO" "$SHORT_FRAME"
  mark_klog
  tmark=$mark
  grab_start "$watchdir/c1hw.txt"
  grab_wait 40 10
  stage_started=1
  sample_regs "c1-hw idle, streaming with GPIO 1 strobing, PMIC not armed"
  for ua in 12500 25000; do
    stage_prep "$ua"
    fault_soft "armed"
    [[ -z $fault_text ]] || { stop_msg="fault on $ledname before the $((ua / 1000)) mA arm:$fault_text"; break; }
    mark_klog
    count_pulse
    log "FIRE hardware strobe arm $ledname: $((ua * nch)) uA total ($ua uA x $nch), timer 10 ms (count this boot: $pulses)"
    wr "$led/hw_strobe_arm" 1
    for ((i = 1; i <= 3; i++)); do
      sleep 0.15
      sample_regs "c1-hw $((ua / 1000)).$(((ua % 1000) / 100)) mA armed, sample $i"
      if unsafe_s1s2 "$g_s1" "$g_s2"; then
        stop_msg="armed at $ua uA per channel: STATUS1 0x$g_s1 or STATUS2 0x$g_s2"
        break
      fi
    done
    sleep 0.1
    wr "$led/hw_strobe_arm" 0
    sample_regs "c1-hw $ua uA after disarm"
    sleep 0.2
    ktxt=$(klog_since "$mark")
    hw_eval "$ktxt"
    if ((!k_have)); then
      stop_msg=${stop_msg:-"no kernel poll line for the $ua uA arm (linux-sl7 7.2.8-21 running, dmesg readable?)"}
    else
      show_reg "c1-hw $ua uA per channel, kernel poll union (first 30 ms)" "$k_u1" "$k_u2" "$k_u3" "$k_urt"
      if unsafe_s1s2 "$k_u1" "$k_u2"; then
        stop_msg=${stop_msg:-"$ua uA per channel: short-circuit bit in STATUS1 0x$k_u1 or STATUS2 0x$k_u2 in the first 30 ms"}
      fi
      k=no
      if (($(hexv "$k_urt") & 0x10)); then k=yes; fi
      subsum+="$((ua / 1000)) mA/ch: STATUS1 union 0x$k_u1, STATUS3 union 0x$k_u3, ramp-up $k; "
      stage_ev "hw arm $ua uA/ch: poll union STATUS1=0x$k_u1 STATUS2=0x$k_u2 STATUS3=0x$k_u3 INT_RT_STS=0x$k_urt"
    fi
    [[ -z $stop_msg ]] || break
    sleep 0.5
  done
  wr "$led/hw_strobe_arm" 0
  sleep 0.6
  grab_stop
  ktxt=$(klog_since "$tmark")
  ev=$watchdir/events.txt
  events_from_klog arm "$ktxt" "$ev"
  csvf=${logf%.log}-stage-$stage-$(date +%Y%m%dT%H%M%S).csv
  ana=$(python3 -c "$STAGE_PY" frames "$watchdir/c1hw.txt" "$ev" "$csvf" arm 2>&1) || true
  while IFS= read -r line; do [[ -z $line ]] || log "$line"; done <<<"$ana"
  if [[ $ana =~ $re_sp ]]; then spike_n=${BASH_REMATCH[1]}; fi
  log "STAGE_FRAMES csv=$csvf"
  if [[ -n $stop_msg ]]; then
    log "STOP c1-hw: $stop_msg"
    stage_finish FAIL "STOP: $stop_msg"
  else
    stage_finish OK "hardware strobe armed twice with the sensor strobing: ${subsum}brightness spike in $spike_n of 2 arm windows (no stop condition)"
  fi
}

# ---- t0b: ir:flash-23, one software pulse ----------------------------------------
stage_t0b() {
  local snaps lbl s1 s2 rt s1l="" s2l="" unsafe=0 have=0 ok28=no stop_msg="" m
  stage_prep 12500
  fault_soft "armed"
  [[ -z $fault_text ]] || die 5 "fault on $ledname before the pulse:$fault_text"
  sample_regs "t0b idle"
  stage_started=1
  count_pulse
  log "FIRE $ledname $fire_ua uA ($per_ch_ua uA x $nch), 10 ms (count this boot: $pulses)"
  wr "$led/flash_strobe" 1
  sleep "$POST_STROBE_WAIT_S"
  wr "$led/flash_strobe" 0
  snaps=$(dmesg 2>/dev/null | grep -F 'SL7 IR strobe snapshot' | tail -n 8)
  for lbl in "t0+1ms" "t0+3ms" "t0+15ms"; do
    s1=$(getreg "$snaps" "$lbl" 06)
    s2=$(getreg "$snaps" "$lbl" 07)
    rt=$(getreg "$snaps" "$lbl" 10)
    s1l+="${s1:-??},"
    s2l+="${s2:-??},"
    [[ -z $s1 ]] || have=1
    if unsafe_s1s2 "$s1" "$s2"; then unsafe=1; fi
    [[ $s1 == 28 ]] && ok28=yes
    show_reg "t0b $lbl" "$s1" "$s2" "" "$rt"
  done
  m=$(getreg "$snaps" "t0+3ms" 06)
  log "STAGE_PULSE i=1 STATUS1[+1,+3,+15ms]=${s1l%,} STATUS2=${s2l%,} expected_0x28=$ok28 | STATUS1@+3ms: $(dec_s1 "$m")"
  stage_ev "t0b STATUS1 ${s1l%,} STATUS2 ${s2l%,}"
  if ((!have)); then
    stop_msg="no kernel snapshot (linux-sl7 7.2.8-21 running? dmesg readable?)"
  elif ((unsafe)); then
    stop_msg="a short-circuit bit in STATUS1 (${s1l%,}) or STATUS2 not 0 (${s2l%,})"
  fi
  if [[ -n $stop_msg ]]; then
    log "STOP t0b: $stop_msg"
    stage_finish FAIL "STOP: $stop_msg"
  elif [[ $ok28 == yes ]]; then
    stage_finish OK "ir:flash-23 at 12.5 mA per channel: STATUS1 0x28 (CH2 and CH3 open) as expected, so the open-circuit reading of CH1 and CH4 (0x82) is decoded the same way"
  else
    stage_finish FAIL "unexpected STATUS1 ${s1l%,} (expected 0x28, CH2 and CH3 open): the decode of 0x82 on CH1 and CH4 needs another look"
  fi
}

run_stage() {
  local want answer
  if ((!have_tty && !confirmed)); then
    die 7 "an interactive terminal is required for the confirmation (or --confirmed from sl7-ir-lab)"
  fi
  stage_banner
  log "START stage=$stage per_channel_ua=$per_ch_ua nch=$nch led=$ledname user=${SUDO_USER:-$(id -un)} kernel=$(uname -r) cmdline='$(rd "$cmdline")'"
  if ((confirmed)); then
    log "CONFIRMED by the sl7-ir-lab confirm button"
  else
    want="FIRE STAGE ${stage^^}"
    printf 'Type "%s" to run, anything else aborts: ' "$want"
    answer=
    read -r -t 180 answer || answer=
    echo
    [[ $answer == "$want" ]] || die 7 "not confirmed (typed '$answer')"
    log "CONFIRMED by typed phrase"
  fi
  find_regmap
  case $stage in
    c0a) stage_c0a ;;
    c0b) stage_c0b ;;
    c1-sw) stage_c1_sw ;;
    c1-hw) stage_c1_hw ;;
    t0b) stage_t0b ;;
  esac
  log "DONE stage $stage"
  return 0
}

# Emitter first (strobe off), then the stage sensor state (led_mode 0, stream off, exposure and
# blanking back), exposure and the limit, then the capture, then the raw frames (never kept).
on_exit() {
  disarm_all
  stage_sensor_restore
  expo_restore
  restore_limit
  stop_capture
  stage_record_abort
  if [[ -n $watchdir && $watchdir == "$rundir"/watch.* ]]; then rm -rf -- "$watchdir"; fi
  if [[ -n $tee_pid ]]; then
    exec >&- 2>&-
    wait "$tee_pid" 2>/dev/null || true
  fi
}
trap on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

die() { # CODE MESSAGE
  local code=$1
  shift
  last_die="$*"
  log "REFUSED/ABORT ($code): $*"
  exit "$code"
}

# wr FILE VALUE: logged write, aborts on failure.
wr() {
  local file=$1 value=$2
  armed_touch=1
  log "WRITE ${file#"$R"} <- $value"
  printf '%s' "$value" >"$file" 2>/dev/null || die 6 "write to ${file#"$R"} failed"
}

# rdback FILE EXPECTED: logged read back, aborts on mismatch.
rdback() {
  local file=$1 want=$2 got
  got=$({ tr -d '[:space:]' <"$file"; } 2>/dev/null || true)
  log "READ  ${file#"$R"} = $got (expected $want)"
  [[ $got == "$want" ]] || die 6 "read back of ${file#"$R"} is '$got', expected '$want'"
}

# The redirection of the file is inside the group, so a missing file prints nothing
# (with "cmd <file 2>/dev/null" the shell reports the open error before 2> applies).
rd() { { tr -d '\n' <"$1"; } 2>/dev/null || true; }

cmdline_has() { grep -qE "(^| )$1( |\$)" "$cmdline" 2>/dev/null; }

print_status() {
  local d n
  echo "== sl7-ir-emitter-test status (read-only)"
  if [[ -f $approval && ! -L $approval ]]; then
    echo "Stage B approval file: PRESENT ($approval)"
  else
    echo "Stage B approval file: absent ($approval): the tool refuses to fire"
  fi
  if cmdline_has 'sl7[.]ir_test=1'; then echo "cmdline sl7.ir_test=1: yes"; else echo "cmdline sl7.ir_test=1: no (not the IR test entry)"; fi
  if cmdline_has 'panic=5'; then echo "cmdline panic=5: yes"; else echo "cmdline panic=5: no"; fi
  if [[ -r $modparam ]]; then
    echo "leds_qcom_flash: loaded, ir_test=$(rd "$modparam")"
  elif [[ -e $modparam ]]; then
    echo "leds_qcom_flash: loaded (ir_test is root-only; run with sudo to read it)"
  else
    echo "leds_qcom_flash: not loaded"
  fi
  if [[ -r $irparam ]]; then
    echo "leds_qcom_flash ir_max_ua: $(rd "$irparam") uA per channel (default $IR_LIMIT_DEFAULT_UA, driver hard cap $CH_UA_HARD_MAX)"
  elif [[ -e $irparam ]]; then
    echo "leds_qcom_flash ir_max_ua: present (run with sudo to read it)"
  fi
  n=0
  for d in "$leds"/ir:flash-*; do
    [[ -d $d ]] || continue
    n=$((n + 1))
    echo "${d##*/}: max_flash_brightness=$(rd "$d/max_flash_brightness") max_flash_timeout=$(rd "$d/max_flash_timeout")" \
      "flash_brightness=$(rd "$d/flash_brightness") flash_timeout=$(rd "$d/flash_timeout")" \
      "flash_strobe=$(rd "$d/flash_strobe") flash_fault='$(rd "$d/flash_fault")'"
  done
  echo "ir:flash-* LEDs: $n (expected 2, ir:flash-14 and ir:flash-23, on the IR test entry of linux-sl7 7.2.8-21 or later; 1 on 7.2.8-19 and -20; 4 on 7.2.8-18 or earlier; 0 otherwise)"
  if [[ -r $rundir/pulses ]]; then echo "pulses fired this boot: $(rd "$rundir/pulses") (limit $MAX_PULSES_PER_BOOT, $STAGE_MAX_PULSES_PER_BOOT for --stage runs)"; fi
  if [[ -r $illumparam ]]; then
    echo "vd55g illuminator: $(rd "$illumparam") (Y on the IR test boot: GPIO 1 strobe and led_mode honoured)"
  else
    echo "vd55g illuminator: parameter not present (vd55g not loaded, or a kernel before linux-sl7 7.2.8-21)"
  fi
  for d in "$leds"/ir:flash-*; do
    [[ -d $d ]] || continue
    if [[ -e $d/hw_strobe_arm ]]; then echo "${d##*/}: hw_strobe_arm present"; fi
  done
  echo "Stage C records (OK / FAIL / none; stale = recorded on another kernel):"
  for d in c0a c0b c1-sw c1-hw t0b; do
    echo "stage-c $d: $(stage_result "$d")"
  done
}

while (($#)); do
  case $1 in
    --i-have-read-the-plan) read_plan=1 ;;
    --channel) channel=${2:-}; channel_given=1; shift ;;
    --led) led_kind=${2:-}; shift ;;
    max_ma_per_channel=*) max_ma_arg=${1#max_ma_per_channel=} ;;
    --repeat) repeat=${2:-}; shift ;;
    --status) status_only=1 ;;
    --watch) watch=1 ;;
    --watch-only-test) watch_only=1 ;;
    --remove-snapshot) remove_snap=1 ;;
    --no-manual-exposure) expo_opt=off ;;
    --pulse-delay) pulse_delay=${2:-}; shift ;;
    --confirmed) confirmed=1 ;;
    --stage) stage=${2:-}; shift ;;
    -h | --help) usage ;;
    *) echo "sl7-ir-emitter-test: unknown argument: $1" >&2; usage ;;
  esac
  shift
done

if ((status_only)); then
  print_status
  exit 0
fi

if [[ ! $pulse_delay =~ ^[0-5]$ ]]; then
  echo "sl7-ir-emitter-test: --pulse-delay takes a whole number of seconds, 0..5" >&2
  usage
fi
if ((remove_snap)); then
  if ((watch || watch_only || channel_given || confirmed)) || [[ -n $stage || -n $led_kind || -n $max_ma_arg || $repeat != 1 ]]; then
    echo "sl7-ir-emitter-test: --remove-snapshot takes no other option (it fires nothing)" >&2
    usage
  fi
elif ((watch_only)); then
  if ((watch || channel_given || confirmed)) || [[ -n $stage || -n $led_kind || -n $max_ma_arg || $repeat != 1 ]]; then
    echo "sl7-ir-emitter-test: --watch-only-test takes no --channel, --led, max_ma_per_channel=, --repeat or --watch (it fires nothing)" >&2
    usage
  fi
elif [[ -n $stage ]]; then
  [[ $read_plan -eq 1 ]] || { echo "sl7-ir-emitter-test: --i-have-read-the-plan is required" >&2; usage; }
  if ((watch || channel_given)) || [[ -n $led_kind || -n $max_ma_arg || $repeat != 1 ]]; then
    echo "sl7-ir-emitter-test: --stage takes no --channel, --led, max_ma_per_channel=, --repeat or --watch (each stage sets its own current, at most 25 mA per channel)" >&2
    usage
  fi
  ((!fake)) || { echo "sl7-ir-emitter-test: --stage can not run against SL7_IR_TEST_ROOT" >&2; exit 2; }
  case $stage in
    c0a) stage_pulses=1; per_ch_ua=12500; step_label=12.5; ledid=14 ;;
    c0b) stage_pulses=0; per_ch_ua=12500; step_label=12.5; ledid=14 ;;
    c1-sw) stage_pulses=8; per_ch_ua=25000; step_label=25; ledid=14 ;;
    c1-hw) stage_pulses=2; per_ch_ua=25000; step_label=25; ledid=14 ;;
    t0b) stage_pulses=1; per_ch_ua=12500; step_label=12.5; ledid=23 ;;
    *) echo "sl7-ir-emitter-test: --stage takes: c0a, c0b, c1-sw, c1-hw or t0b (got '$stage')" >&2; usage ;;
  esac
  ((per_ch_ua <= STAGE_MAX_CH_UA)) || { echo "sl7-ir-emitter-test: internal error: stage current above the 25 mA per channel limit" >&2; exit 2; }
  led_kind=ir
  nch=$IR_NCH
  fire_ua=$((per_ch_ua * nch))
  ledname=ir:flash-$ledid
  max_total_ua=$((IR_NCH * CH_UA_HARD_MAX))
  repeat=$stage_pulses
else
  [[ $read_plan -eq 1 ]] || { echo "sl7-ir-emitter-test: --i-have-read-the-plan is required" >&2; usage; }
  if [[ -n $led_kind ]]; then
    ((!channel_given)) || { echo "sl7-ir-emitter-test: --led ir and --channel N are exclusive" >&2; usage; }
    [[ $led_kind == ir ]] || { echo "sl7-ir-emitter-test: --led takes only: ir" >&2; usage; }
    case $max_ma_arg in
      '' | 12.5) per_ch_ua=12500; step_label=12.5 ;;
      25) per_ch_ua=25000; step_label=25 ;;
      50) per_ch_ua=50000; step_label=50 ;;
      100) per_ch_ua=100000; step_label=100 ;;
      *) echo "sl7-ir-emitter-test: max_ma_per_channel= must be 12.5, 25, 50 or 100 (got '$max_ma_arg')" >&2; usage ;;
    esac
    ((per_ch_ua <= CH_UA_HARD_MAX)) || { echo "sl7-ir-emitter-test: internal error: per-channel current above the hard cap" >&2; exit 2; }
    if ((confirmed && per_ch_ua >= CH_UA_HARD_MAX)); then
      echo "sl7-ir-emitter-test: --confirmed covers 12.5, 25 and 50 mA per channel only; 100 mA needs the typed phrases" >&2
      exit 2
    fi
    nch=$IR_NCH
    ledid=$IR_LED_ID
  else
    [[ $channel =~ ^[1-4]$ ]] || { echo "sl7-ir-emitter-test: --led ir or --channel N (1..4) is required" >&2; usage; }
    [[ -z $max_ma_arg ]] || { echo "sl7-ir-emitter-test: max_ma_per_channel= needs --led ir (--channel is always 12.5 mA)" >&2; usage; }
    ((!confirmed)) || { echo "sl7-ir-emitter-test: --confirmed needs --led ir (--channel keeps the typed phrase)" >&2; exit 2; }
    per_ch_ua=$CH_UA_BASE
    step_label=12.5
    nch=1
    ledid=$channel
  fi
  fire_ua=$((per_ch_ua * nch))
  ledname=ir:flash-$ledid
  max_total_ua=$((nch == 1 ? CH_UA_BASE : IR_NCH * CH_UA_HARD_MAX))
  [[ $repeat =~ ^[1-9][0-9]*$ ]] && ((repeat <= MAX_REPEAT)) || { echo "sl7-ir-emitter-test: --repeat must be 1..$MAX_REPEAT" >&2; usage; }
fi

# Everything from here on is also written to /var/tmp/sl7-ir-<time>.txt.
vlog=$R/var/tmp/sl7-ir-$(date +%Y%m%dT%H%M%S).txt
if mkdir -p "${vlog%/*}" 2>/dev/null && (umask 022; : >"$vlog") 2>/dev/null; then
  exec > >(tee -a "$vlog") 2>&1
  tee_pid=$!
  echo "sl7-ir-emitter-test: output also goes to ${vlog#"$R"}"
fi

# ---- gate 1: Stage B approval (the Stage A refusal) -------------------------
# --watch-only-test and --remove-snapshot fire nothing: no approval needed.
if ((!watch_only && !remove_snap)); then
  if [[ ! -e $approval && ! -L $approval ]]; then
    die 3 "Stage B is not approved: $approval does not exist. Only the owner creates it, by hand, after reading the plan. Nothing was touched."
  fi
  [[ -f $approval && ! -L $approval ]] || die 3 "$approval is not a regular file (or is a symlink)"
  if ((!fake)); then
    [[ $(stat -c %u -- "$approval") -eq 0 ]] || die 3 "$approval is not owned by root"
    (( 8#$(stat -c %a -- "$approval") & 8#022 )) && die 3 "$approval is writable by group or others"
  fi
fi

# ---- gate 2: root and the IR test boot --------------------------------------
if ((!fake && EUID != 0)); then
  die 4 "run as root (sudo sl7-ir-emitter-test ...)"
fi
cmdline_has 'sl7[.]ir_test=1' || die 4 "not the IR test boot entry: sl7.ir_test=1 is not on the kernel command line"
cmdline_has 'panic=5' || die 4 "panic=5 is not on the kernel command line (the IR test entry sets it)"
[[ -r $modparam && $(rd "$modparam") == Y ]] || die 4 "leds_qcom_flash is not loaded with ir_test=Y"


# ---- --remove-snapshot: unload, read the all-off snapshot, load back --------
if ((remove_snap)); then
  since=$(date '+%Y-%m-%d %H:%M:%S')
  log "START remove-snapshot: modprobe -r leds_qcom_flash (remove switches every channel off), then back"
  modprobe -r leds_qcom_flash || die 4 "modprobe -r leds_qcom_flash failed (module in use?)"
  sleep 1
  snap=$(journalctl -k --since "$since" --no-pager -o cat 2>/dev/null | grep -F "remove, after all-off" || true)
  if [[ -z $snap ]]; then
    snap=$(dmesg 2>/dev/null | grep -F "remove, after all-off" | tail -n 60 || true)
    log "NOTE the journal had no remove snapshot since $since, showing the dmesg tail (may include an older removal)"
  fi
  echo "---- kernel log: remove, after all-off ----"
  printf '%s\n' "${snap:-(no snapshot lines found)}"
  echo "---- end ----"
  modprobe leds_qcom_flash || log "WARN modprobe leds_qcom_flash (load back) failed: reboot to restore the IR LED"
  sleep 1
  log "DONE remove-snapshot: module loaded back, ir_test=$(rd "$modparam")"
  exit 0
fi

check_fault() { # WHEN
  local f t bad=""
  f=$(rd "$led/flash_fault")
  log "READ  $ledname/flash_fault ($1) = '$f'"
  for t in $f; do [[ $t == "$ONLY_FAULT" ]] || bad="$bad $t"; done
  [[ -z $bad ]] || die 5 "fault on $ledname ($1):$bad"
}

if ((!watch_only)); then
  led=$leds/$ledname
  [[ -d $led ]] || die 4 "no LED $ledname in $leds (--led ir needs linux-sl7 7.2.8-19 or later, --channel needs 7.2.8-18 or earlier)"
  if [[ -n $led_kind ]]; then
    [[ -r $irparam && $(rd "$irparam") =~ ^[0-9]+$ ]] || die 4 "${irparam#"$R"} is missing or unreadable (the kernel needs patch 0091, linux-sl7 7.2.8-19 or later)"
    log "READ  ${irparam#"$R"} = $(rd "$irparam") (will be set to $per_ch_ua for this run)"
  fi

  # ---- gate 3: hardware as expected, before any write -----------------------
  for d in "$leds"/ir:flash-*; do
    [[ -d $d ]] || continue
    [[ $(rd "$d/flash_strobe") == 0 ]] || die 4 "${d##*/} reports flash_strobe=$(rd "$d/flash_strobe") before the test"
  done
  max_ua=$(rd "$led/max_flash_brightness")
  max_us=$(rd "$led/max_flash_timeout")
  [[ $max_ua =~ ^[0-9]+$ ]] && ((max_ua <= max_total_ua)) || die 4 "max_flash_brightness is '$max_ua', expected <= $max_total_ua"
  ((max_ua >= fire_ua)) || die 4 "max_flash_brightness is $max_ua, below the $fire_ua uA of this run"
  [[ $max_us =~ ^[0-9]+$ ]] && ((max_us <= FIRE_TIMEOUT_US)) || die 4 "max_flash_timeout is '$max_us', expected <= $FIRE_TIMEOUT_US"
  check_fault "before"
fi

# ---- limits: one run at a time, pulses per boot -----------------------------
mkdir -p "$rundir" && chmod 0700 "$rundir" 2>/dev/null || true
exec 9>"$rundir/lock"
flock -n 9 || die 5 "another sl7-ir-emitter-test is running"
pulses=$(rd "$rundir/pulses")
[[ $pulses =~ ^[0-9]+$ ]] || pulses=0
pulse_cap=$MAX_PULSES_PER_BOOT
if ((!watch_only)); then
  pulse_cap=$MAX_PULSES_PER_BOOT
  if [[ -n $stage ]]; then pulse_cap=$STAGE_MAX_PULSES_PER_BOOT; fi
  ((pulses + repeat <= pulse_cap)) || die 5 "pulse limit for this boot: $pulses fired or armed, $repeat requested, limit $pulse_cap. Reboot to reset."
fi

# ---- --stage: gates, then the stage -----------------------------------------
if [[ -n $stage ]]; then
  stage_prev_name=$(stage_prev "$stage")
  if [[ -n $stage_prev_name && $(stage_result "$stage_prev_name") != OK ]]; then
    die 3 "stage $stage needs stage $stage_prev_name recorded OK for this kernel first (it is: $(stage_result "$stage_prev_name")). Run: sl7-ir-emitter-test --i-have-read-the-plan --stage $stage_prev_name"
  fi
  if [[ $stage != c0a && $stage != t0b ]]; then
    [[ -r $illumparam && $(rd "$illumparam") == Y ]] || die 4 "vd55g is not loaded with illuminator=Y (IR test boot of linux-sl7 7.2.8-21 or later, with omarchy-surface-sl7 39 or later)"
  fi
  case $stage in
    c0a | c1-hw) [[ -e $led/hw_strobe_arm ]] || die 4 "$ledname has no hw_strobe_arm attribute (linux-sl7 7.2.8-21 or later)" ;;
  esac
  run_stage
  exit "$stage_rc"
fi

# ---- --watch: detector prerequisites, checked before the prompt -------------
if ((watch || watch_only)); then
  command -v python3 >/dev/null 2>&1 || die 8 "python3 is required for the frame statistics"
  command -v v4l2-ctl >/dev/null 2>&1 || die 8 "v4l2-ctl is required (pacman -S v4l-utils)"
  if ((!fake)) && ! systemctl is-active --quiet sl7-ir-bridge.service; then
    die 8 "sl7-ir-bridge.service is not active (the detector reads the IR camera through it). Check: systemctl status sl7-ir-bridge; journalctl -u sl7-ir-bridge. Nothing was fired."
  fi
  if ((fake)); then [[ -e $camdev ]] || die 8 "${camdev#"$R"} does not exist"; else [[ -c $camdev ]] || die 8 "${camdev#"$R"} does not exist (is v4l2loopback loaded and the bridge running?)"; fi
  camfmt=$(v4l2-ctl -d "$camdev" --get-fmt-video 2>&1) || die 8 "cannot query the format of ${camdev#"$R"}: $camfmt"
  if ! grep -qE "Width/Height *: *$CAM_W/$CAM_H" <<<"$camfmt" || ! grep -q "'GREY'" <<<"$camfmt" || ! grep -qE "Bytes per Line *: *$CAM_W\$" <<<"$camfmt"; then
    die 8 "${camdev#"$R"} is not GREY ${CAM_W}x${CAM_H} with stride $CAM_W (the bridge's tight format): $(tr -s '[:space:]' ' ' <<<"$camfmt")"
  fi
fi

# ---- --watch helpers ---------------------------------------------------------
# Frame statistics: mean and p99 per frame, robust baseline, flags, verdict. The
# raw frames are only read, never written anywhere else.
read -r -d '' WATCH_PY <<'PYEOF'
import collections
import re
import sys
import time

W, H = int(sys.argv[1]), int(sys.argv[2])
cap, caplog = sys.argv[3], sys.argv[4]
ready_idx = int(sys.argv[5])
t_ready = float(sys.argv[6])
csvp, mode, chan = sys.argv[7], sys.argv[8], sys.argv[9]
fires = [float(x) for x in sys.argv[10:]]

K = 5.0
LEAD_SKIP = 8
NOMINAL_FPS = 35.0
WIN_BEFORE, WIN_AFTER = 0.035, 0.15
FLOOR_MEAN, FLOOR_P99 = 0.02, 0.5
fsz = W * H


def med(v):
    s = sorted(v)
    n = len(s)
    return s[n // 2] if n % 2 else (s[n // 2 - 1] + s[n // 2]) / 2.0


def robust(v, floor):
    m = med(v)
    return m, max(1.4826 * med([abs(x - m) for x in v]), floor)


def fail(msg):
    print("ERROR " + msg)
    sys.exit(3)


means, p99s = [], []
partial = 0
thr = 0.99 * fsz
with open(cap, "rb") as f:
    while True:
        b = f.read(fsz)
        if len(b) < fsz:
            partial = len(b)
            break
        c = collections.Counter(b)
        means.append(sum(k * v for k, v in c.items()) / fsz)
        cum = 0
        for k in sorted(c):
            cum += c[k]
            if cum >= thr:
                p99s.append(k)
                break
n = len(means)
if n < 2 + LEAD_SKIP + 10:
    fail("only %d whole frames in the capture (%d trailing bytes)" % (n, partial))
if mode == "pulses" and not fires:
    fail("no FIRE times given")

# Frame times in the CLOCK_BOOTTIME domain of /proc/uptime. Preferred: the
# monotonic timestamps v4l2-ctl --verbose prints per frame (shifted by the
# boottime-monotonic offset, which is 0 unless the machine suspended). Fallback:
# nominal fps anchored at the moment the lead frames were complete.
tsv = []
try:
    with open(caplog, errors="replace") as fh:
        tsv = [float(x) for x in re.findall(r"\bts: *(\d+\.\d+)", fh.read())]
except OSError:
    pass
off = time.clock_gettime(time.CLOCK_BOOTTIME) - time.monotonic()
t = None
tmode = "nominal-%dfps-anchored-at-lead-ready (timestamps unusable)" % NOMINAL_FPS
fps = NOMINAL_FPS
if len(tsv) == n:
    tb = [x + off for x in tsv]
    if (all(tb[i + 1] >= tb[i] for i in range(1, n - 1)) and tb[-1] > tb[1]
            and abs(tb[ready_idx] - t_ready) < 0.5):
        t = tb
        fps = (n - 2) / (tb[-1] - tb[1])
        tmode = "v4l2-timestamps"
if t is None:
    t = [t_ready + (k - ready_idx) / fps for k in range(n)]

if mode == "pulses":
    lead_end = min(fires) - WIN_BEFORE - 0.05
    lead = [k for k in range(1 + LEAD_SKIP, n) if t[k] < lead_end]
else:
    lead = list(range(1 + LEAD_SKIP, min(n, ready_idx + 1)))
if len(lead) < 10:
    fail("only %d usable lead frames before the first pulse" % len(lead))

bm, sm = robust([means[k] for k in lead], FLOOR_MEAN)
bp, sp = robust([p99s[k] for k in lead], FLOOR_P99)
half = len(lead) // 2
drift = (med([means[k] for k in lead[half:]])
         - med([means[k] for k in lead[:half]]))
dm = [x - bm for x in means]
dp = [x - bp for x in p99s]
fm = [k >= 1 + LEAD_SKIP and dm[k] > K * sm for k in range(n)]
fp = [k >= 1 + LEAD_SKIP and dp[k] > K * sp for k in range(n)]
flag = [fm[k] or fp[k] for k in range(n)]

wins = []
for f in fires:
    wins.append([k for k in range(1 + LEAD_SKIP, n)
                 if f - WIN_BEFORE <= t[k] <= f + WIN_AFTER])
inwin = {}
for i, ks in enumerate(wins, 1):
    for k in ks:
        inwin.setdefault(k, []).append(i)

t0 = min(fires) if fires else t_ready
show = sorted(set(inwin) | set(k for k in range(n) if flag[k]))
print("frame  t-rel     mean   d(mean)  [sd]     p99  d(p99)  [sd]   marks")
for k in show:
    marks = "".join("P%d " % i for i in inwin.get(k, []))
    marks += ("M" if fm[k] else "") + ("Q" if fp[k] else "")
    print("%5d %+8.3fs %8.3f %+8.3f %+7.1f %6d %+7.1f %+7.1f   %s" % (
        k, t[k] - t0, means[k], dm[k], dm[k] / sm, p99s[k], dp[k], dp[k] / sp,
        marks))

if csvp:
    with open(csvp, "w") as fh:
        fh.write("frame,t_boottime,mean,p99,d_mean,d_p99,flag\n")
        for k in range(n):
            fh.write("%d,%.4f,%.4f,%d,%.4f,%.1f,%d\n" % (
                k, t[k], means[k], p99s[k], dm[k], dp[k], int(flag[k])))
    print("SUMMARY per-frame statistics (no images): %s" % csvp)

print("SUMMARY capture: %d frames (frame 0 = bridge black frame, skipped), "
      "%d trailing bytes, fps %.2f, timing %s" % (n, partial, fps, tmode))
print("SUMMARY baseline: %d lead frames, mean %.3f (robust sd %.3f), p99 %.1f "
      "(robust sd %.2f), lead drift %+.3f, threshold %.0f sd" % (
          len(lead), bm, sm, bp, sp, drift, K))

if mode == "pulses":
    hits = 0
    for i, (f, ks) in enumerate(zip(fires, wins), 1):
        hit = any(flag[k] for k in ks)
        hits += int(hit)
        if ks:
            xm = max(dm[k] for k in ks)
            xp = max(dp[k] for k in ks)
            cov = "" if t[-1] >= f + WIN_AFTER - 1.0 / fps else " (capture ended inside the window)"
            info = "frames %d-%d, max d(mean) %+.3f (%.1f sd), max d(p99) %+.1f (%.1f sd)%s" % (
                ks[0], ks[-1], xm, xm / sm, xp, xp / sp, cov)
        else:
            info = "no frame in the window (not covered by the capture)"
        print("SUMMARY pulse %d/%d at t=%.3f: %s: %s" % (
            i, len(fires), f, "SPIKE" if hit else "no spike", info))
    outside = sum(1 for k in range(n) if flag[k] and k not in inwin)
    print("SUMMARY flagged frames outside the pulse windows: %d%s" % (
        outside, " (baseline is noisy, treat the verdict with care)" if outside >= 3 else ""))
    verdict = "DETECTED" if hits == len(fires) else ("WEAK" if hits else "NONE")
    print("VERDICT channel %s: %s (%d of %d pulses spiked)" % (
        chan, verdict, hits, len(fires)))
else:
    nf = sum(1 for k in range(1 + LEAD_SKIP, n) if flag[k])
    rng = max(means[k] for k in range(1 + LEAD_SKIP, n)) - min(
        means[k] for k in range(1 + LEAD_SKIP, n))
    print("SUMMARY watch-only: %d of %d frames flagged, mean range %.3f, "
          "p99 range %d" % (
              nf, n - 1 - LEAD_SKIP, rng,
              max(p99s[1 + LEAD_SKIP:]) - min(p99s[1 + LEAD_SKIP:])))
    print("VERDICT watch-only baseline: %s" % ("STABLE" if nf == 0 else "UNSTABLE"))
PYEOF

now() { local u _; read -r u _ </proc/uptime; printf '%s' "$u"; } # CLOCK_BOOTTIME s

start_capture() { # FRAMES
  local frames=$1
  ((frames > WATCH_MAX_FRAMES)) && frames=$WATCH_MAX_FRAMES
  watchdir=$(mktemp -d "$rundir/watch.XXXXXX") || die 8 "cannot create a private directory under ${rundir#"$R"}"
  chmod 0700 "$watchdir" 2>/dev/null || true
  cap=$watchdir/cap.raw
  caplog=$watchdir/cap.log
  t_launch=$(now)
  log "WATCH capture start t_boottime=$t_launch frames=$frames dev=${camdev#"$R"} (raw frames in ${watchdir#"$R"}, deleted on exit, never saved as images)"
  timeout -k 1 "$WATCH_TIMEOUT_S" v4l2-ctl -d "$camdev" --stream-mmap --stream-count="$frames" \
    --stream-to="$cap" --verbose >"$caplog" 2>&1 &
  cap_pid=$!
}

# Block until the black frame plus WATCH_LEAD_FRAMES real frames are in the file.
wait_lead() {
  local need=$(((1 + WATCH_LEAD_FRAMES) * FRAME_BYTES)) size i=0 max=$((WATCH_READY_TIMEOUT_S * 50))
  while :; do
    size=$(stat -c %s -- "$cap" 2>/dev/null || echo 0)
    ((size >= need)) && break
    kill -0 "$cap_pid" 2>/dev/null ||
      die 8 "the capture ended before the lead frames arrived ($size bytes; v4l2-ctl said: $(tail -n 2 "$caplog" 2>/dev/null | tr '\n' ' ')). Nothing was fired."
    ((++i > max)) && die 8 "no camera frames within ${WATCH_READY_TIMEOUT_S} s ($size bytes; check journalctl -u sl7-ir-bridge). Nothing was fired."
    sleep 0.02
  done
  t_ready=$(now)
  log "WATCH lead frames ready: $((1 + WATCH_LEAD_FRAMES)) frames (1 black + $WATCH_LEAD_FRAMES), t_boottime=$t_ready, $((size / FRAME_BYTES)) frames on disk"
}

finish_capture() {
  local rc=0
  [[ -n $cap_pid ]] || return 0
  wait "$cap_pid" || rc=$?
  cap_pid=
  log "WATCH capture ended rc=$rc ($(($(stat -c %s -- "$cap" 2>/dev/null || echo 0) / FRAME_BYTES)) whole frames; rc 124 = $WATCH_TIMEOUT_S s timeout)"
}

run_analysis() { # MODE CHANNEL [FIRE_TS...]
  local mode=$1 ch=$2 csv="" out line rc=0
  shift 2
  if [[ -d ${logf%/*} ]]; then
    csv=${logf%.log}-frames-$(date -u +%Y%m%dT%H%M%SZ)-$mode${ch:+-ch$ch}.csv
  fi
  out=$(python3 -c "$WATCH_PY" "$CAM_W" "$CAM_H" "$cap" "$caplog" "$WATCH_LEAD_FRAMES" "$t_ready" "$csv" "$mode" "$ch" "$@" 2>&1) || rc=$?
  while IFS= read -r line; do
    case $line in
      SUMMARY\ * | VERDICT\ *) log "$line" ;;
      *) printf '%s\n' "$line" ;;
    esac
  done <<<"$out"
  ((rc == 0)) || die 8 "the frame analysis failed (rc $rc); any pulses were already fired and are counted. The raw capture is deleted."
}

# ---- --watch-only-test: no photons, no confirmation --------------------------
if ((watch_only)); then
  log "START watch-only-test (no pulses) user=${SUDO_USER:-$(id -un)} kernel=$(uname -r) cmdline='$(rd "$cmdline")'"
  echo "Capturing now, no pulses. Keep the view as for the pulse test: white paper about 5 cm in front of the camera, dim room, do not move."
  start_capture $((1 + WATCH_LEAD_FRAMES + WATCH_ONLY_AFTER_FRAMES))
  wait_lead
  finish_capture
  run_analysis only ""
  log "DONE watch-only-test. Raw capture deleted."
  exit 0
fi

# ---- confirmation -----------------------------------------------------------
# --confirmed (12.5, 25, 50 mA --led ir only, enforced above) was confirmed by
# the caller's dialog and needs no terminal; every typed phrase does.
if ((!fake && !have_tty && !confirmed)); then
  die 7 "an interactive terminal is required for the confirmation"
fi
# Total current in tenths of mA (12.5 mA = 125) and the charge of one pulse in
# uC (mA x ms), for the banner only.
fire_dma=$((fire_ua / 100))
fire_ma_txt="$((fire_dma / 10)).$((fire_dma % 10))"
pulse_uc=$((fire_ua * FIRE_TIMEOUT_US / 1000000))
if [[ -n $led_kind ]]; then
  what="IR EMITTER TEST: ganged LED ir:flash-14 (channels 1 + 4), $step_label mA per channel"
  detail="$repeat pulse(s) of $fire_ma_txt mA total x $((FIRE_TIMEOUT_US / 1000)) ms, $pulse_uc uC each
  (Windows: 700 mA x 1.59 ms = 1110 uC per lit frame)"
else
  what="IR EMITTER TEST: CHANNEL $channel"
  detail="$repeat pulse(s) of $fire_ma_txt mA x $((FIRE_TIMEOUT_US / 1000)) ms, $pulse_uc uC each
  (Windows: 700 mA x 1.59 ms = 1110 uC per lit frame)"
fi
cat <<EOF

  $what
  $detail

  Read the checklist. This lights an infrared emitter that nobody has
  characterised. The pulse is 10 ms of hardware time at most.

    [ ] Nobody looks at the bezel. The laptop faces a matte white card or a
        wall at 30 cm or more.
    [ ] The phone records off-axis, 20 cm or more away (a TV remote showed
        up on its camera: the phone sees IR).
    [ ] The glass over the emitter is not cracked or scratched.
    [ ] The sensor detector is running (--watch, or AE off and per-frame mean
        logged by hand).
    [ ] The owner approved Stage B (the approval file exists).

  Log: ${logf#"$R"}

EOF
if ((watch)); then
  cat <<EOF
  --watch (IR camera detector, nothing is saved but per-frame statistics):

    [ ] White paper about 5 cm in front of the camera, angled so light from
        beside the lens bounces back into it.
    [ ] Dim room. Do not move the laptop or the paper until the run ends.
    [ ] sl7-ir-bridge is active (checked) and nothing else uses the camera.

  Capture starts after you confirm; the pulses fire about 1 s later.

EOF
fi
log "START led=$ledname per_channel_ua=$per_ch_ua total_ua=$fire_ua repeat=$repeat user=${SUDO_USER:-$(id -un)} kernel=$(uname -r) cmdline='$(rd "$cmdline")'"
if ((confirmed)); then
  # sl7-ir-lab asked first with a confirm button (12.5, 25 and 50 mA per channel only).
  log "CONFIRMED by the sl7-ir-lab confirm button"
else
  if [[ -n $led_kind ]]; then want="FIRE IR ${step_label}MA"; else want="FIRE CHANNEL $channel"; fi
  printf 'Type "%s" to fire, anything else aborts: ' "$want"
  answer=
  read -r -t 180 answer || answer=
  echo
  [[ $answer == "$want" ]] || die 7 "not confirmed (typed '$answer')"
  log "CONFIRMED by typed phrase"
fi
if ((per_ch_ua >= CH_UA_HARD_MAX)); then
  want2="ACCEPT 100 MA PER CHANNEL"
  echo "100 mA per channel is the driver's hard cap: 200 mA total, $pulse_uc uC per pulse, more charge than Windows per lit frame."
  printf 'Type "%s" to confirm, anything else aborts: ' "$want2"
  answer=
  read -r -t 180 answer || answer=
  echo
  [[ $answer == "$want2" ]] || die 7 "100 mA not confirmed (typed '$answer')"
  log "CONFIRMED 100 mA per channel by the second typed phrase"
fi
if [[ -n $led_kind ]]; then
  # The driver limit first, before anything is armed; its read back must match.
  wr "$irparam" "$per_ch_ua"
  param_touched=1
  rdback "$irparam" "$per_ch_ua"
fi

# ---- fire -------------------------------------------------------------------
find_regmap
if [[ -n $led_kind && $expo_opt == on ]]; then expo_manual_on; fi
if ((pulse_delay > 0)); then
  # After the confirmation and every gate: only gives a caller (sl7-ir-lab) time to start its capture.
  log "WAIT ${pulse_delay} s before the first pulse (--pulse-delay)"
  sleep "$pulse_delay"
fi
fire_ts=()
if ((watch)); then
  # lead + (gaps of ~1.2 s + one pulse of ~0.3 s + the tail) at 40 fps (above the bridge's 35)
  start_capture $((1 + WATCH_LEAD_FRAMES + ((repeat - 1) * 12 + 3 + WATCH_TAIL_S * 10) * 4))
  wait_lead
fi
i=0
while ((i < repeat)); do
  i=$((i + 1))
  if ((i > 1)); then sleep "$PRE_PULSE_GAP_S"; fi
  log "PULSE $i/$repeat $ledname: $fire_ua uA total ($per_ch_ua uA x $nch), $FIRE_TIMEOUT_US us"
  wr "$led/flash_strobe" 0
  wr "$led/flash_brightness" "$fire_ua"
  rdback "$led/flash_brightness" "$fire_ua"
  wr "$led/flash_timeout" "$FIRE_TIMEOUT_US"
  rdback "$led/flash_timeout" "$FIRE_TIMEOUT_US"
  check_fault "armed"
  regdump "idle, armed values written, before strobe"
  pulses=$((pulses + 1))
  printf '%s\n' "$pulses" >"$rundir/pulses" || die 6 "cannot record the pulse count in $rundir/pulses"
  log "FIRE $ledname $fire_ua uA (count this boot: $pulses)"
  if ((watch)); then read -r fire_now _ </proc/uptime; fire_ts+=("$fire_now"); fi
  wr "$led/flash_strobe" 1
  sleep "$POST_STROBE_WAIT_S"
  # Still strobed: fault and registers BEFORE the strobe is switched off.
  log "READ  $ledname/flash_fault (strobe still set, before disarm) = '$(rd "$led/flash_fault")'"
  regdump "strobe still set, before flash_strobe=0"
  wr "$led/flash_strobe" 0
  regdump "after flash_strobe=0"
  if ((watch)); then log "FIRE_T pulse $i/$repeat t_boottime=${fire_now} (capture start t_boottime=$t_launch, lead ready t_boottime=$t_ready)"; fi
  check_fault "after"
done
if ((watch)); then
  sleep "$WATCH_TAIL_S"
  finish_capture
  run_analysis pulses "$ledid" "${fire_ts[@]}"
fi
log "DONE $ledname at $fire_ua uA total, $repeat pulse(s). Compare the detector verdict (--watch) and the phone clip for this step."
echo
echo "Next: note whether the sensor or the phone saw it (3/3 pulses well above the baseline noise)."
if [[ -n $led_kind ]]; then
  echo "One step at a time: 12.5, then 25, then 50 mA per channel (max_ma_per_channel=). Stop at the first step the camera sees. Decision rules: EMITTER-PLAN.md, stage B."
else
  echo "One channel at a time: reboot or wait, then repeat with the next --channel N. Decision rules: EMITTER-PLAN.md, stage B."
fi
exit 0
