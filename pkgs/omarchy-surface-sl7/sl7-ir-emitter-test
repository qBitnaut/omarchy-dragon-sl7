R=${SL7_IR_TEST_ROOT:-}
if [[ -n $R ]]; then
  R=${R%/}
  if [[ -z $R || $(realpath -m -- "$R") == / || ! -d $R ]]; then
    echo "sl7-ir-emitter-test: SL7_IR_TEST_ROOT must be an existing directory other than /" >&2
    exit 2
  fi
