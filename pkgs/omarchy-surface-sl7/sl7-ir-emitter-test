#!/bin/bash
# sl7-ir-emitter-test: Stage B (measurement M2) of the SL7 IR emitter plan. It
# fires ONE 12.5 mA x 10 ms pulse on ONE PM8550 flash channel through the LED
# class sysfs, to find out which channel drives the IR illuminator.
#
# DISABLED BY DEFAULT. It refuses to do anything until the file
#
#     /etc/omarchy-surface-sl7/ir-stage-b-approved
#
# exists. Nothing ships that file; only Chris creates it, by hand, after reading
# research/omarchy-dragon-sl7/ir/EMITTER-PLAN.md. This tool never creates or
# removes it.
#
#   sl7-ir-emitter-test --status
#       Read-only. Shows the gate state and the ir:flash-N LEDs. No approval
#       needed, writes nothing.
#
#   sudo sl7-ir-emitter-test --i-have-read-the-plan --channel N [--repeat R]
#       N = 1..4 (ir:flash-N, led-sources = N). R = 1..3 pulses, 1 s apart
#       (default 1). Needs all of:
#         - the approval file above (regular file, root-owned, not writable by
#           group or others, not a symlink)
#         - booted on the "linux-sl7 (IR test)" entry: sl7.ir_test=1 and panic=5
#           on /proc/cmdline, leds_qcom_flash loaded with ir_test=Y
#         - root, an interactive terminal, and the typed phrase
#           "FIRE CHANNEL N" at the confirmation prompt
#       Per pulse it writes, in this order: flash_strobe=0, flash_brightness=
#       12500, flash_timeout=10000 (each read back), then flash_strobe=1, waits
#       50 ms (the PMIC safety timer ended the pulse after 10 ms) and writes
#       flash_strobe=0. Then it reads flash_fault: anything but
#       flash-timeout-exceeded stops the run. On any error, signal or exit every
#       ir:flash-* LED gets flash_strobe=0.
#
# The limits are constants in this file (12500 uA, 10000 us, at most 3 pulses
# per run, at most 12 per boot); there is no option to raise them. The driver
# clamps independently (patch 0080: 700 mA, 100 ms) and the DT limits are the
# same 12.5 mA / 10 ms. Raising any of them is a later, reviewed step.
#
# Every action is logged to /var/log/sl7-ir-emitter-test.log and the journal
# (tag sl7-ir-emitter-test), and echoed.
#
# Exit codes: 0 done, 2 usage, 3 Stage B not approved, 4 not the IR test boot
# or hardware not as expected, 5 fault or limit, 6 sysfs write/readback failed,
# 7 not confirmed.
#
# SL7_IR_TEST_ROOT=DIR runs the whole tool against a fake tree under DIR (proc,
# sys, etc, run, var) for testing: every path below is prefixed with it and
# root, tty and ownership checks are relaxed. DIR / is refused.
set -uo pipefail

readonly FIRE_UA=12500
readonly FIRE_TIMEOUT_US=10000
readonly MAX_REPEAT=3
readonly MAX_PULSES_PER_BOOT=12
readonly PRE_PULSE_GAP_S=1
readonly POST_STROBE_WAIT_S=0.05
readonly ONLY_FAULT=flash-timeout-exceeded

fake=0
R=${SL7_IR_TEST_ROOT:-}
if [[ -n $R ]]; then
  R=${R%/}
  if [[ -z $R || $(realpath -m -- "$R") == / || ! -d $R ]]; then
    echo "sl7-ir-emitter-test: SL7_IR_TEST_ROOT must be an existing directory other than /" >&2
    exit 2
  fi
  fake=1
fi

cmdline=$R/proc/cmdline
leds=$R/sys/class/leds
modparam=$R/sys/module/leds_qcom_flash/parameters/ir_test
approval=$R/etc/omarchy-surface-sl7/ir-stage-b-approved
logf=$R/var/log/sl7-ir-emitter-test.log
rundir=$R/run/sl7-ir-emitter-test

me=sl7-ir-emitter-test
channel=
repeat=1
read_plan=0
status_only=0
armed_touch=0

usage() {
  sed -n '2,/^set -uo/{/^set -uo/!p}' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

log() {
  local line
  line="$(date -Is) ${me}[$$]: $*"
  printf '%s\n' "$line"
  if [[ -d ${logf%/*} ]]; then
    printf '%s\n' "$line" 2>/dev/null >>"$logf" || true
  fi
  if ((!fake)) && command -v logger >/dev/null 2>&1; then
    logger -t "$me" -- "$*" 2>/dev/null || true
  fi
}

# Every ir:flash-* LED: flash_strobe=0. Safe to call repeatedly.
disarm_all() {
  local d
  ((armed_touch)) || return 0
  for d in "$leds"/ir:flash-*; do
    [[ -e $d/flash_strobe ]] || continue
    printf '%s' 0 >"$d/flash_strobe" 2>/dev/null &&
      log "DISARM ${d##*/}/flash_strobe <- 0" ||
      log "DISARM FAILED ${d##*/}/flash_strobe"
  done
  return 0
}
trap disarm_all EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

die() { # CODE MESSAGE
  local code=$1
  shift
  log "REFUSED/ABORT ($code): $*"
  exit "$code"
}

# wr FILE VALUE: logged write, aborts on failure.
wr() {
  local file=$1 value=$2
  armed_touch=1
  log "WRITE ${file#"$R"} <- $value"
  printf '%s' "$value" >"$file" 2>/dev/null || die 6 "write to ${file#"$R"} failed"
}

# rdback FILE EXPECTED: logged read back, aborts on mismatch.
rdback() {
  local file=$1 want=$2 got
  got=$(tr -d '[:space:]' <"$file" 2>/dev/null || true)
  log "READ  ${file#"$R"} = $got (expected $want)"
  [[ $got == "$want" ]] || die 6 "read back of ${file#"$R"} is '$got', expected '$want'"
}

rd() { tr -d '\n' <"$1" 2>/dev/null || true; }

cmdline_has() { grep -qE "(^| )$1( |\$)" "$cmdline" 2>/dev/null; }

print_status() {
  local d n
  echo "== sl7-ir-emitter-test status (read-only)"
  if [[ -f $approval && ! -L $approval ]]; then
    echo "Stage B approval file: PRESENT ($approval)"
  else
    echo "Stage B approval file: absent ($approval): the tool refuses to fire"
  fi
  if cmdline_has 'sl7[.]ir_test=1'; then echo "cmdline sl7.ir_test=1: yes"; else echo "cmdline sl7.ir_test=1: no (not the IR test entry)"; fi
  if cmdline_has 'panic=5'; then echo "cmdline panic=5: yes"; else echo "cmdline panic=5: no"; fi
  if [[ -r $modparam ]]; then
    echo "leds_qcom_flash: loaded, ir_test=$(rd "$modparam")"
  else
    echo "leds_qcom_flash: not loaded"
  fi
  n=0
  for d in "$leds"/ir:flash-*; do
    [[ -d $d ]] || continue
    n=$((n + 1))
    echo "${d##*/}: max_flash_brightness=$(rd "$d/max_flash_brightness") max_flash_timeout=$(rd "$d/max_flash_timeout")" \
      "flash_brightness=$(rd "$d/flash_brightness") flash_timeout=$(rd "$d/flash_timeout")" \
      "flash_strobe=$(rd "$d/flash_strobe") flash_fault='$(rd "$d/flash_fault")'"
  done
  echo "ir:flash-* LEDs: $n (expected 4 on the IR test entry, 0 otherwise)"
  if [[ -r $rundir/pulses ]]; then echo "pulses fired this boot: $(rd "$rundir/pulses") (limit $MAX_PULSES_PER_BOOT)"; fi
}

while (($#)); do
  case $1 in
    --i-have-read-the-plan) read_plan=1 ;;
    --channel) channel=${2:-}; shift ;;
    --repeat) repeat=${2:-}; shift ;;
    --status) status_only=1 ;;
    -h | --help) usage ;;
    *) echo "sl7-ir-emitter-test: unknown argument: $1" >&2; usage ;;
  esac
  shift
done

if ((status_only)); then
  print_status
  exit 0
fi

[[ $read_plan -eq 1 ]] || { echo "sl7-ir-emitter-test: --i-have-read-the-plan is required" >&2; usage; }
[[ $channel =~ ^[1-4]$ ]] || { echo "sl7-ir-emitter-test: --channel N (1..4) is required" >&2; usage; }
[[ $repeat =~ ^[1-9][0-9]*$ ]] && ((repeat <= MAX_REPEAT)) || { echo "sl7-ir-emitter-test: --repeat must be 1..$MAX_REPEAT" >&2; usage; }

# ---- gate 1: Stage B approval (the Stage A refusal) -------------------------
if [[ ! -e $approval && ! -L $approval ]]; then
  die 3 "Stage B is not approved: $approval does not exist. Only Chris creates it, by hand, after reading the plan. Nothing was touched."
fi
[[ -f $approval && ! -L $approval ]] || die 3 "$approval is not a regular file (or is a symlink)"
if ((!fake)); then
  [[ $(stat -c %u -- "$approval") -eq 0 ]] || die 3 "$approval is not owned by root"
  (( 8#$(stat -c %a -- "$approval") & 8#022 )) && die 3 "$approval is writable by group or others"
fi

# ---- gate 2: root and the IR test boot --------------------------------------
if ((!fake && EUID != 0)); then
  die 4 "run as root (sudo sl7-ir-emitter-test ...)"
fi
cmdline_has 'sl7[.]ir_test=1' || die 4 "not the IR test boot entry: sl7.ir_test=1 is not on the kernel command line"
cmdline_has 'panic=5' || die 4 "panic=5 is not on the kernel command line (the IR test entry sets it)"
[[ -r $modparam && $(rd "$modparam") == Y ]] || die 4 "leds_qcom_flash is not loaded with ir_test=Y"

led=$leds/ir:flash-$channel
[[ -d $led ]] || die 4 "no LED ir:flash-$channel in $leds"

# ---- gate 3: hardware as expected, before any write -------------------------
for d in "$leds"/ir:flash-*; do
  [[ -d $d ]] || continue
  [[ $(rd "$d/flash_strobe") == 0 ]] || die 4 "${d##*/} reports flash_strobe=$(rd "$d/flash_strobe") before the test"
done
max_ua=$(rd "$led/max_flash_brightness")
max_us=$(rd "$led/max_flash_timeout")
[[ $max_ua =~ ^[0-9]+$ ]] && ((max_ua <= FIRE_UA)) || die 4 "max_flash_brightness is '$max_ua', expected <= $FIRE_UA"
[[ $max_us =~ ^[0-9]+$ ]] && ((max_us <= FIRE_TIMEOUT_US)) || die 4 "max_flash_timeout is '$max_us', expected <= $FIRE_TIMEOUT_US"

check_fault() { # WHEN
  local f t bad=""
  f=$(rd "$led/flash_fault")
  log "READ  ir:flash-$channel/flash_fault ($1) = '$f'"
  for t in $f; do [[ $t == "$ONLY_FAULT" ]] || bad="$bad $t"; done
  [[ -z $bad ]] || die 5 "fault on ir:flash-$channel ($1):$bad"
}
check_fault "before"

# ---- limits: one run at a time, pulses per boot -----------------------------
mkdir -p "$rundir" && chmod 0700 "$rundir" 2>/dev/null || true
exec 9>"$rundir/lock"
flock -n 9 || die 5 "another sl7-ir-emitter-test is running"
pulses=$(rd "$rundir/pulses")
[[ $pulses =~ ^[0-9]+$ ]] || pulses=0
((pulses + repeat <= MAX_PULSES_PER_BOOT)) || die 5 "pulse limit for this boot: $pulses fired, $repeat requested, limit $MAX_PULSES_PER_BOOT. Reboot to reset."

# ---- confirmation -----------------------------------------------------------
if ((!fake)) && [[ ! -t 0 || ! -t 1 ]]; then
  die 7 "an interactive terminal is required for the confirmation"
fi
cat <<EOF

  IR EMITTER TEST: CHANNEL $channel  ($repeat pulse(s) of $((FIRE_UA / 1000)).5 mA x $((FIRE_TIMEOUT_US / 1000)) ms)

  Read the checklist. This lights an infrared emitter that nobody has
  characterised. The values are 1.8 % of Windows' current for 10 ms.

    [ ] Nobody looks at the bezel. The laptop faces a matte white card or a
        wall at 30 cm or more.
    [ ] The phone records off-axis, 20 cm or more away (a TV remote showed
        up on its camera: the phone sees IR).
    [ ] The glass over the emitter is not cracked or scratched.
    [ ] The sensor detector is running (AE off, per-frame mean logged).
    [ ] Chris approved Stage B (the approval file exists).

  Log: ${logf#"$R"}

EOF
log "START channel=$channel repeat=$repeat user=${SUDO_USER:-$(id -un)} kernel=$(uname -r) cmdline='$(rd "$cmdline")'"
want="FIRE CHANNEL $channel"
printf 'Type "%s" to fire, anything else aborts: ' "$want"
answer=
read -r -t 180 answer || answer=
echo
[[ $answer == "$want" ]] || die 7 "not confirmed (typed '$answer')"
log "CONFIRMED by typed phrase"

# ---- fire -------------------------------------------------------------------
i=0
while ((i < repeat)); do
  i=$((i + 1))
  if ((i > 1)); then sleep "$PRE_PULSE_GAP_S"; fi
  log "PULSE $i/$repeat channel $channel: $FIRE_UA uA, $FIRE_TIMEOUT_US us"
  wr "$led/flash_strobe" 0
  wr "$led/flash_brightness" "$FIRE_UA"
  rdback "$led/flash_brightness" "$FIRE_UA"
  wr "$led/flash_timeout" "$FIRE_TIMEOUT_US"
  rdback "$led/flash_timeout" "$FIRE_TIMEOUT_US"
  check_fault "armed"
  pulses=$((pulses + 1))
  printf '%s\n' "$pulses" >"$rundir/pulses" || die 6 "cannot record the pulse count in $rundir/pulses"
  log "FIRE ir:flash-$channel (count this boot: $pulses)"
  wr "$led/flash_strobe" 1
  sleep "$POST_STROBE_WAIT_S"
  wr "$led/flash_strobe" 0
  check_fault "after"
done
log "DONE channel $channel, $repeat pulse(s). Compare the detector frame means and the phone clip for this channel."
echo
echo "Next: note whether the sensor or the phone saw it (3/3 pulses well above the baseline noise)."
echo "One channel at a time: reboot or wait, then repeat with the next --channel N. Decision rules: EMITTER-PLAN.md, stage B."
exit 0
