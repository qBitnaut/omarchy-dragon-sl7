#!/bin/bash
# sl7-ir-emitter-test: RETIRED. The PMIC flash-LED emitter tests (--led ir,
# --channel, --stage, --watch, --remove-snapshot) are gone: the PM8550 IR flash
# LED path proved to have no load (open circuit) and is not needed. The IR
# emitter is lit by the vd55g sensor's GPIO 1 strobe through sl7-ir-bridge on
# the normal boot (linux-sl7 patch 0098); face unlock and sl7-ir-lab use that.
#
#   sl7-ir-emitter-test --status    read-only; shows the bridge, the sensor
#                                   strobe parameter and that no PMIC IR LED
#                                   is bound. Needs no root.
#
# Any other option exits 2 with a message pointing at the bridge.
set -uo pipefail

R=${SL7_IR_TEST_ROOT:-}
R=${R%/}

rd() { { tr -d '\n' <"$1"; } 2>/dev/null || true; }

print_status() {
  local d n=0 st
  echo "== sl7-ir-emitter-test status (read-only; the PMIC emitter tests are retired)"
  if command -v systemctl >/dev/null 2>&1; then
    st=$(systemctl is-active sl7-ir-bridge 2>/dev/null || true)
    echo "sl7-ir-bridge: ${st:-unknown}"
  fi
  if [[ -r $R/sys/module/vd55g/parameters/illuminator ]]; then
    echo "vd55g illuminator: $(rd "$R/sys/module/vd55g/parameters/illuminator") (Y: the GPIO 1 strobe lights the emitter)"
  else
    echo "vd55g illuminator: parameter not present (vd55g not loaded, or a kernel before linux-sl7 7.2.8-22)"
  fi
  if [[ -e $R/sys/module/leds_qcom_flash ]]; then
    echo "leds_qcom_flash: loaded"
  else
    echo "leds_qcom_flash: not loaded (expected: the IR LEDs never bind)"
  fi
  for d in "$R"/sys/class/leds/ir:flash-*; do
    [[ -d $d ]] && n=$((n + 1))
  done
  echo "ir:flash-* LEDs: $n (expected 0)"
}

case ${1:-} in
  --status)
    print_status
    ;;
  -h | --help | "")
    sed -n '2,/^set -uo/{/^set -uo/!p}' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
  *)
    echo "sl7-ir-emitter-test: the PMIC IR emitter tests are retired (no load on that path)." >&2
    echo "  The IR emitter is lit by the sensor's GPIO 1 strobe through sl7-ir-bridge on the normal boot;" >&2
    echo "  use face unlock or sl7-ir-lab. Only --status remains." >&2
    exit 2
    ;;
esac
