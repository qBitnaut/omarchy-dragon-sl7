#!/bin/bash
# Compatibility wrapper: the PSR test entry is now the "psr" preset of
# omarchy-sl7-test-entry. PSR is KNOWN BROKEN on the Sharp LQ138P1JX61 (the
# panel turns off when idle and returns only when something paints).
#
#   omarchy-sl7-psr-entry enable|disable|status
set -euo pipefail

case ${1:-} in
  --hook) exec /usr/bin/omarchy-sl7-test-entry --hook ;;
  enable | disable | status) ;;
  *)
    echo "usage: ${0##*/} {enable|disable|status}  (see omarchy-sl7-test-entry)" >&2
    exit 2
    ;;
esac
echo "NOTE: PSR (msm.psr_enabled=1) is known broken on this panel: black screen when idle." >&2
case $1 in
  status) exec /usr/bin/omarchy-sl7-test-entry status psr ;;
  *) exec /usr/bin/omarchy-sl7-test-entry "$1" psr ;;
esac
