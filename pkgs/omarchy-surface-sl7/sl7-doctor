#!/bin/bash
# Read-only health check for the Surface Laptop 7 add-on. Exit 1 if any check fails.
set -u

fw_root=${SL7_FIRMWARE_ROOT:-/usr/lib/firmware}
limine_default=${OMARCHY_SL7_LIMINE_DEFAULT:-/etc/default/limine}
uki_config=${OMARCHY_QUALCOMM_UKI_CONFIG:-/etc/kernel/uki.conf}
mkinitcpio_dir=${OMARCHY_SL7_MKINITCPIO_DIR:-/etc/mkinitcpio.conf.d}
compatible=${OMARCHY_SL7_COMPATIBLE:-/sys/firmware/devicetree/base/compatible}
cpufreq=${OMARCHY_SL7_CPUFREQ:-/sys/devices/system/cpu/cpufreq}
pacman_conf=${OMARCHY_SL7_PACMAN_CONF:-/etc/pacman.conf}
keyring_dir=${OMARCHY_SL7_KEYRING_DIR:-/usr/share/pacman/keyrings}
pacman_gnupg=${OMARCHY_SL7_GNUPGHOME:-/etc/pacman.d/gnupg}
user_hook=${OMARCHY_SL7_USER_HOOK:-$HOME/.config/omarchy/hooks/pre-refresh-pacman.d/10-omarchy-sl7-repo}

fails=0
pass() { printf 'PASS  %s\n' "$1"; }
fail() { printf 'FAIL  %s\n' "$1"; fails=$((fails + 1)); }
warn() { printf 'WARN  %s\n' "$1"; }
check() { # description, command...
  local d=$1
  shift
  if "$@" >/dev/null 2>&1; then pass "$d"; else fail "$d"; fi
}

kernel=$(uname -r)
check "running kernel is linux-sl7 ($kernel)" \
  grep -qx linux-sl7 "/usr/lib/modules/$kernel/pkgbase"

check "device tree is romulus13" \
  bash -c "tr '\\0' '\\n' <'$compatible' | grep -qx 'microsoft,romulus13'"

policies=$(find "$cpufreq" -maxdepth 1 -name 'policy*' 2>/dev/null | wc -l)
if ((policies == 3)); then pass "3 cpufreq policies"; else fail "cpufreq policies: $policies (want 3)"; fi

if command -v lsinitcpio >/dev/null 2>&1; then
  initrd_list=""
  for img in "/boot/initramfs-linux-sl7.img" /boot/initramfs-linux-sl7*.img; do
    [[ -f $img ]] && { initrd_list=$(lsinitcpio "$img" 2>/dev/null); break; }
  done
  if [[ -z $initrd_list ]]; then
    for efi in /boot/EFI/Linux/*sl7*.efi /boot/efi/EFI/Linux/*sl7*.efi; do
      [[ -f $efi ]] && { warn "only a UKI found ($efi); extract the initrd to check modules"; break; }
    done
  elif grep -q 'surface_aggregator' <<<"$initrd_list" && grep -q 'surface_hid' <<<"$initrd_list"; then
    pass "SAM modules in the linux-sl7 initramfs"
  else
    fail "SAM modules missing from the linux-sl7 initramfs"
  fi
else
  warn "lsinitcpio not found; SAM initramfs check skipped"
fi

fw_ok() { # path under qcom/
  local sfx d
  for d in "$fw_root/updates" "$fw_root"; do
    for sfx in '' .zst .xz; do
      [[ -f $d/$1$sfx ]] && return 0
    done
  done
  return 1
}
ms=qcom/x1e80100/microsoft
for f in $ms/qcdxkmsuc8380.mbn $ms/Romulus/qcadsp8380.mbn $ms/Romulus/qccdsp8380.mbn; do
  if fw_ok "$f"; then pass "firmware ${f##*/}"; else fail "firmware ${f##*/} missing (omarchy-surface-sl7-firmware)"; fi
done

for id in 0C77 0C6E; do
  active=0 seen=0
  for node in /sys/class/hidraw/hidraw*; do
    [[ -r $node/device/uevent ]] || continue
    grep -Eiq "^HID_ID=[0-9A-F]+:0000045E:0000$id\$" "$node/device/uevent" || continue
    seen=1
    # Name-agnostic: any active iptsd@ unit whose instance is this hidraw node.
    for unit in $(systemctl list-units --plain --no-legend --state=active 'iptsd@*.service' | awk '{print $1}'); do
      [[ $unit == "iptsd@dev-${node##*/}.service" ]] && active=1
    done
  done
  if ((active)); then pass "iptsd active for 045E:$id"
  elif ((seen)); then fail "no active iptsd@ unit for 045E:$id (sudo /usr/lib/omarchy-surface-sl7/restart-iptsd)"
  else fail "no hidraw node for 045E:$id (device not enumerated)"; fi
done

if grep -Eq '^[[:space:]]*BOOT_ORDER="?linux-sl7([ ,"]|$)' "$limine_default" 2>/dev/null; then
  pass "BOOT_ORDER starts with linux-sl7"
else
  fail "BOOT_ORDER does not start with linux-sl7 ($limine_default)"
fi

if grep -q '^DeviceTreeAuto=.*x1e80100-microsoft-romulus13\.dtb' "$uki_config" 2>/dev/null; then
  pass "uki.conf DeviceTreeAuto lists romulus13"
else
  fail "uki.conf DeviceTreeAuto lacks romulus13"
fi

if [[ -e $mkinitcpio_dir/surface_device_modules.conf ]]; then
  fail "$mkinitcpio_dir/surface_device_modules.conf is active"
else
  pass "no surface_device_modules.conf active"
fi

if fw_ok ath12k/WCN7850/hw2.0/board-2.bin; then
  ath_bin=
  for sfx in '' .zst .xz; do
    [[ -f $fw_root/updates/ath12k/WCN7850/hw2.0/board-2.bin$sfx ]] && ath_bin=$fw_root/updates/ath12k/WCN7850/hw2.0/board-2.bin$sfx && break
  done
  sl7_name='subsystem-vendor=17cb,subsystem-device=1107,qmi-chip-id=2,qmi-board-id=255'
  if [[ -n $ath_bin && $ath_bin != *.zst && $ath_bin != *.xz ]] && grep -aqF "$sl7_name" "$ath_bin"; then
    pass "ath12k WCN7850 board-2.bin has the SL7 (updates/ override)"
  else
    fail "ath12k WCN7850 board-2.bin lacks the SL7 (run /usr/lib/omarchy-surface-sl7/ath12k-board-update)"
  fi
else
  fail "ath12k WCN7850 board-2.bin missing (linux-firmware-atheros)"
fi

check "Pro Audio guard installed" \
  test -f /usr/share/wireplumber/scripts/omarchy-surface-sl7/guard-pro-audio.lua \
  -a -f /usr/share/wireplumber/wireplumber.conf.d/50-omarchy-surface-sl7.conf

# omarchy-sl7 package repository: configured, ahead of [omarchy] and ALARM, key trusted.
if command -v pacman-conf >/dev/null 2>&1; then
  repos=$(pacman-conf --config "$pacman_conf" --repo-list 2>/dev/null)
  if grep -qx omarchy-sl7 <<<"$repos" && pacman-conf --config "$pacman_conf" --repo=omarchy-sl7 2>/dev/null | grep -q '^Server'; then
    pass "omarchy-sl7 repository configured"
    first=$(grep -nxE 'omarchy-sl7|omarchy|alarm|core|extra' <<<"$repos" | head -n1)
    if [[ ${first#*:} == omarchy-sl7 ]]; then
      pass "omarchy-sl7 is listed before omarchy, alarm, core and extra"
    else
      fail "omarchy-sl7 is not the first repository (run: sudo omarchy-sl7-repo-ensure)"
    fi
  else
    fail "omarchy-sl7 repository not configured in $pacman_conf (run: sudo omarchy-sl7-repo-ensure, or omarchy-sl7-bootstrap)"
  fi
else
  warn "pacman-conf not found; repository check skipped"
fi

sl7_fprs=$(cut -d: -f1 "$keyring_dir/omarchy-sl7-trusted" 2>/dev/null | grep -E '^[0-9A-Fa-f]{40}$')
if [[ -z $sl7_fprs ]]; then
  warn "omarchy-sl7-keyring ships no signing key yet (placeholder build)"
else
  key_ok=0
  for f in $sl7_fprs; do
    v=$(gpg --homedir "$pacman_gnupg" --batch --no-auto-check-trustdb --with-colons --list-keys "$f" 2>/dev/null |
      awk -F: '$1 == "pub" { print $2; exit }')
    [[ $v == f || $v == u ]] && key_ok=1
  done
  if ((key_ok)); then pass "omarchy-sl7 signing key trusted by pacman"; else fail "omarchy-sl7 signing key not trusted (pacman-key --populate omarchy-sl7)"; fi
fi

if [[ -e $user_hook ]]; then
  pass "omarchy refresh pacman hook installed for $(id -un)"
else
  warn "no omarchy refresh pacman hook for $(id -un) (omarchy-sl7-repo-ensure --user-hook)"
fi

# Battery visible to Omarchy: UPower must list the qcom-battmgr battery and
# Omarchy's own scripts must find it (temporary patch for omacom/omarchy#13029).
if [[ -d ${OMARCHY_SL7_POWER_SUPPLY:-/sys/class/power_supply}/qcom-battmgr-bat ]] || [[ -n ${OMARCHY_SL7_BATTERY_CHECK:-} ]]; then
  if command -v upower >/dev/null 2>&1; then
    if upower -e 2>/dev/null | grep -q 'battery_qcom_battmgr_bat'; then
      pass "UPower lists the qcom-battmgr battery"
    else
      fail "UPower does not list qcom-battmgr-bat (check upower.service and scope/type attributes)"
    fi
    if command -v omarchy-battery-status >/dev/null 2>&1; then
      if omarchy-battery-status --shell 2>/dev/null | grep -q '^percentage'; then
        pass "omarchy-battery-status reports the battery"
      else
        fail "omarchy-battery-status finds no battery (rerun: sudo /usr/lib/omarchy-surface-sl7/omarchy-sl7-battery-patch)"
      fi
    fi
  else
    warn "upower not found; battery visibility check skipped"
  fi
  if command -v omarchy-battery-present >/dev/null 2>&1; then
    check "omarchy-battery-present finds the battery" omarchy-battery-present
  fi
fi

# AC/battery power mode: current source, applied caps, and whether they match.
powermode=${OMARCHY_SL7_POWERMODE:-/usr/bin/omarchy-sl7-powermode}
if [[ -x $powermode ]]; then
  pm_out=$("$powermode" status 2>&1)
  pm_rc=$?
  while IFS= read -r line; do printf 'INFO  powermode: %s\n' "$line"; done <<<"$pm_out"
  if ((pm_rc == 0)); then
    pass "power mode matches the power source"
  else
    fail "power mode does not match the power source (sudo $powermode auto)"
  fi
else
  warn "omarchy-sl7-powermode not installed; power mode check skipped"
fi

# eDP Panel Self Refresh (optional "linux-sl7 (PSR test)" boot entry, see
# omarchy-sl7-psr-entry). Informational only: PSR off is the normal state.
psr_param=${OMARCHY_SL7_MSM_PSR:-/sys/module/msm/parameters/psr_enabled}
psr_cmdline=${OMARCHY_SL7_PROC_CMDLINE:-/proc/cmdline}
if [[ -r $psr_param ]]; then
  printf 'INFO  PSR: msm.psr_enabled=%s (running kernel)\n' "$(<"$psr_param")"
else
  printf 'INFO  PSR: msm.psr_enabled not exposed by the running kernel\n'
fi
if grep -qw 'msm.psr_enabled=1' "$psr_cmdline" 2>/dev/null; then
  printf 'INFO  PSR: booted via the PSR test entry (msm.psr_enabled=1 on the cmdline)\n'
else
  printf 'INFO  PSR: normal boot entry (no msm.psr_enabled=1 on the cmdline)\n'
fi
psr_found=0
dri_debugfs=${OMARCHY_SL7_DRI_DEBUGFS:-/sys/kernel/debug/dri}
for f in "$dri_debugfs"/*/eDP-1/psr_* "$dri_debugfs"/*/*/*psr*; do
  [[ -f $f ]] || continue
  psr_found=1
  if [[ -r $f ]]; then
    printf 'INFO  PSR: %s: %s\n' "$f" "$(head -c 200 "$f" 2>/dev/null | tr '\n' ' ')"
  else
    printf 'INFO  PSR: %s exists (readable as root only)\n' "$f"
  fi
done
((psr_found)) || printf 'INFO  PSR: no PSR debugfs node visible (debugfs needs root, or the kernel does not expose one)\n'
if [[ -r /dev/kmsg || -n ${OMARCHY_SL7_DMESG:-} ]]; then
  psr_log=$(${OMARCHY_SL7_DMESG:-dmesg} 2>/dev/null | grep -i -E 'psr|self.refresh' | tail -n 3 || true)
  [[ -n $psr_log ]] && while IFS= read -r line; do printf 'INFO  PSR dmesg: %s\n' "$line"; done <<<"$psr_log"
fi
psr_entry=${OMARCHY_SL7_PSR_ENTRY:-/usr/bin/omarchy-sl7-psr-entry}
if [[ -x $psr_entry ]]; then
  while IFS= read -r line; do printf 'INFO  PSR entry: %s\n' "$line"; done < <("$psr_entry" status 2>&1 | cut -c1-160 | head -n 4)
fi

((fails == 0)) && echo "sl7-doctor: all checks passed" || echo "sl7-doctor: $fails check(s) failed"
((fails == 0))
