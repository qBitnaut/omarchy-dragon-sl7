#!/bin/bash
# Read-only health check for the Surface Laptop 7 add-on. Exit 1 if any check fails.
set -u

fw_root=${SL7_FIRMWARE_ROOT:-/usr/lib/firmware}
limine_default=${OMARCHY_SL7_LIMINE_DEFAULT:-/etc/default/limine}
uki_config=${OMARCHY_QUALCOMM_UKI_CONFIG:-/etc/kernel/uki.conf}
mkinitcpio_dir=${OMARCHY_SL7_MKINITCPIO_DIR:-/etc/mkinitcpio.conf.d}
compatible=${OMARCHY_SL7_COMPATIBLE:-/sys/firmware/devicetree/base/compatible}
cpufreq=${OMARCHY_SL7_CPUFREQ:-/sys/devices/system/cpu/cpufreq}
pacman_conf=${OMARCHY_SL7_PACMAN_CONF:-/etc/pacman.conf}
keyring_dir=${OMARCHY_SL7_KEYRING_DIR:-/usr/share/pacman/keyrings}
pacman_gnupg=${OMARCHY_SL7_GNUPGHOME:-/etc/pacman.d/gnupg}
user_hook=${OMARCHY_SL7_USER_HOOK:-$HOME/.config/omarchy/hooks/pre-refresh-pacman.d/10-omarchy-sl7-repo}

fails=0
pass() { printf 'PASS  %s\n' "$1"; }
fail() { printf 'FAIL  %s\n' "$1"; fails=$((fails + 1)); }
warn() { printf 'WARN  %s\n' "$1"; }
check() { # description, command...
  local d=$1
  shift
  if "$@" >/dev/null 2>&1; then pass "$d"; else fail "$d"; fi
}

kernel=$(uname -r)
check "running kernel is linux-sl7 ($kernel)" \
  grep -qx linux-sl7 "/usr/lib/modules/$kernel/pkgbase"

check "device tree is romulus13" \
  bash -c "tr '\\0' '\\n' <'$compatible' | grep -qx 'microsoft,romulus13'"

policies=$(find "$cpufreq" -maxdepth 1 -name 'policy*' 2>/dev/null | wc -l)
if ((policies == 3)); then pass "3 cpufreq policies"; else fail "cpufreq policies: $policies (want 3)"; fi

if command -v lsinitcpio >/dev/null 2>&1; then
  initrd_list=""
  for img in "/boot/initramfs-linux-sl7.img" /boot/initramfs-linux-sl7*.img; do
    [[ -f $img ]] && { initrd_list=$(lsinitcpio "$img" 2>/dev/null); break; }
  done
  if [[ -z $initrd_list ]]; then
    for efi in /boot/EFI/Linux/*sl7*.efi /boot/efi/EFI/Linux/*sl7*.efi; do
      [[ -f $efi ]] && { warn "only a UKI found ($efi); extract the initrd to check modules"; break; }
    done
  elif grep -q 'surface_aggregator' <<<"$initrd_list" && grep -q 'surface_hid' <<<"$initrd_list"; then
    pass "SAM modules in the linux-sl7 initramfs"
  else
    fail "SAM modules missing from the linux-sl7 initramfs"
  fi
else
  warn "lsinitcpio not found; SAM initramfs check skipped"
fi

fw_ok() { # path under qcom/
  local sfx d
  for d in "$fw_root/updates" "$fw_root"; do
    for sfx in '' .zst .xz; do
      [[ -f $d/$1$sfx ]] && return 0
    done
  done
  return 1
}
ms=qcom/x1e80100/microsoft
for f in $ms/qcdxkmsuc8380.mbn $ms/Romulus/qcadsp8380.mbn $ms/Romulus/qccdsp8380.mbn; do
  if fw_ok "$f"; then pass "firmware ${f##*/}"; else fail "firmware ${f##*/} missing (omarchy-surface-sl7-firmware)"; fi
done

for id in 0C77 0C6E; do
  active=0 seen=0
  for node in /sys/class/hidraw/hidraw*; do
    [[ -r $node/device/uevent ]] || continue
    grep -Eiq "^HID_ID=[0-9A-F]+:0000045E:0000$id\$" "$node/device/uevent" || continue
    seen=1
    # Name-agnostic: any active iptsd@ unit whose instance is this hidraw node.
    for unit in $(systemctl list-units --plain --no-legend --state=active 'iptsd@*.service' | awk '{print $1}'); do
      [[ $unit == "iptsd@dev-${node##*/}.service" ]] && active=1
    done
  done
  if ((active)); then
    pass "iptsd active for 045E:$id"
    # spi-hid can reset after iptsd enabled multitouch; iptsd keeps running but
    # the device is back in mouse mode (no 2-finger scroll).
    n=${node##*/}
    ats=$(systemctl show -p ActiveEnterTimestampMonotonic --value "iptsd@dev-$n.service" 2>/dev/null)
    last=$(journalctl -k -b -o json --output-fields=__MONOTONIC_TIMESTAMP --grep 'spi_hid.*(timed out|Failed to create hid device|reset)' 2>/dev/null |
      jq -rs 'map(.__MONOTONIC_TIMESTAMP|tonumber)|max // empty' 2>/dev/null)
    if [[ $ats =~ ^[0-9]+$ && $last =~ ^[0-9]+$ ]] && ((last > ats)); then
      warn "spi-hid reset after iptsd started for 045E:$id; touchpad may be in mouse mode (sudo /usr/lib/omarchy-surface-sl7/restart-iptsd)"
    fi
  elif ((seen)); then fail "no active iptsd@ unit for 045E:$id (sudo /usr/lib/omarchy-surface-sl7/restart-iptsd)"
  else fail "no hidraw node for 045E:$id (device not enumerated)"; fi
done

# iptsd's mode watchdog (iptsd-sl7 patch 0004) re-enables multitouch by itself when
# the touchpad falls back to mouse mode; surface that it had to.
recov=$(journalctl -b -o cat --no-pager -u 'iptsd@*.service' --grep 'sent legacy reports without touch data' 2>/dev/null | wc -l)
if [[ $recov =~ ^[0-9]+$ ]] && ((recov > 0)); then
  warn "touchpad fell back to mouse mode $recov time(s) this boot; iptsd re-enabled multitouch itself (spi-hid reset?)"
fi
if journalctl -b -o cat --no-pager -u 'iptsd@*.service' --grep 'keeps sending legacy reports' 2>/dev/null | grep -q .; then
  warn "iptsd gave up re-enabling touchpad multitouch at least once this boot and was restarted by systemd"
fi

# Tap-to-click is off by default (appended once to ~/.config/hypr/input.lua).
if [[ -x /usr/bin/omarchy-sl7-touchpad-defaults && -d $HOME/.config/hypr ]]; then
  if /usr/bin/omarchy-sl7-touchpad-defaults --check >/dev/null 2>&1; then
    pass "tap-to-click default applied (or set by you in input.lua)"
  else
    warn "tap-to-click default not applied yet (run: omarchy-sl7-touchpad-defaults)"
  fi
fi

if grep -Eq '^[[:space:]]*BOOT_ORDER="?linux-sl7([ ,"]|$)' "$limine_default" 2>/dev/null; then
  pass "BOOT_ORDER starts with linux-sl7"
else
  fail "BOOT_ORDER does not start with linux-sl7 ($limine_default)"
fi

if grep -q '^DeviceTreeAuto=.*x1e80100-microsoft-romulus13\.dtb' "$uki_config" 2>/dev/null; then
  pass "uki.conf DeviceTreeAuto lists romulus13"
else
  fail "uki.conf DeviceTreeAuto lacks romulus13"
fi

if [[ -e $mkinitcpio_dir/surface_device_modules.conf ]]; then
  fail "$mkinitcpio_dir/surface_device_modules.conf is active"
else
  pass "no surface_device_modules.conf active"
fi

if fw_ok ath12k/WCN7850/hw2.0/board-2.bin; then
  ath_bin=
  for sfx in '' .zst .xz; do
    [[ -f $fw_root/updates/ath12k/WCN7850/hw2.0/board-2.bin$sfx ]] && ath_bin=$fw_root/updates/ath12k/WCN7850/hw2.0/board-2.bin$sfx && break
  done
  sl7_name='subsystem-vendor=17cb,subsystem-device=1107,qmi-chip-id=2,qmi-board-id=255'
  if [[ -n $ath_bin && $ath_bin != *.zst && $ath_bin != *.xz ]] && grep -aqF "$sl7_name" "$ath_bin"; then
    pass "ath12k WCN7850 board-2.bin has the SL7 (updates/ override)"
  else
    fail "ath12k WCN7850 board-2.bin lacks the SL7 (run /usr/lib/omarchy-surface-sl7/ath12k-board-update)"
  fi
else
  fail "ath12k WCN7850 board-2.bin missing (linux-firmware-atheros)"
fi

check "Pro Audio guard installed" \
  test -f /usr/share/wireplumber/scripts/omarchy-surface-sl7/guard-pro-audio.lua \
  -a -f /usr/share/wireplumber/wireplumber.conf.d/50-omarchy-surface-sl7.conf

# omarchy-sl7 package repository: configured, ahead of [omarchy] and ALARM, key trusted.
if command -v pacman-conf >/dev/null 2>&1; then
  repos=$(pacman-conf --config "$pacman_conf" --repo-list 2>/dev/null)
  if grep -qx omarchy-sl7 <<<"$repos" && pacman-conf --config "$pacman_conf" --repo=omarchy-sl7 2>/dev/null | grep -q '^Server'; then
    pass "omarchy-sl7 repository configured"
    first=$(grep -nxE 'omarchy-sl7|omarchy|alarm|core|extra' <<<"$repos" | head -n1)
    if [[ ${first#*:} == omarchy-sl7 ]]; then
      pass "omarchy-sl7 is listed before omarchy, alarm, core and extra"
    else
      fail "omarchy-sl7 is not the first repository (run: sudo omarchy-sl7-repo-ensure)"
    fi
  else
    fail "omarchy-sl7 repository not configured in $pacman_conf (run: sudo omarchy-sl7-repo-ensure, or omarchy-sl7-bootstrap)"
  fi
else
  warn "pacman-conf not found; repository check skipped"
fi

sl7_fprs=$(cut -d: -f1 "$keyring_dir/omarchy-sl7-trusted" 2>/dev/null | grep -E '^[0-9A-Fa-f]{40}$')
if [[ -z $sl7_fprs ]]; then
  warn "omarchy-sl7-keyring ships no signing key yet (placeholder build)"
else
  key_ok=0
  for f in $sl7_fprs; do
    v=$(gpg --homedir "$pacman_gnupg" --batch --no-auto-check-trustdb --with-colons --list-keys "$f" 2>/dev/null |
      awk -F: '$1 == "pub" { print $2; exit }')
    [[ $v == f || $v == u ]] && key_ok=1
  done
  if ((key_ok)); then pass "omarchy-sl7 signing key trusted by pacman"; else fail "omarchy-sl7 signing key not trusted (pacman-key --populate omarchy-sl7)"; fi
fi

if [[ -e $user_hook ]]; then
  pass "omarchy refresh pacman hook installed for $(id -un)"
else
  warn "no omarchy refresh pacman hook for $(id -un) (omarchy-sl7-repo-ensure --user-hook)"
fi

# Battery visible to Omarchy: UPower must list the qcom-battmgr battery and
# Omarchy's own scripts must find it (temporary patch for omacom/omarchy#13029).
if [[ -d ${OMARCHY_SL7_POWER_SUPPLY:-/sys/class/power_supply}/qcom-battmgr-bat ]] || [[ -n ${OMARCHY_SL7_BATTERY_CHECK:-} ]]; then
  if command -v upower >/dev/null 2>&1; then
    if upower -e 2>/dev/null | grep -q 'battery_qcom_battmgr_bat'; then
      pass "UPower lists the qcom-battmgr battery"
    else
      fail "UPower does not list qcom-battmgr-bat (check upower.service and scope/type attributes)"
    fi
    if command -v omarchy-battery-status >/dev/null 2>&1; then
      if omarchy-battery-status --shell 2>/dev/null | grep -q '^percentage'; then
        pass "omarchy-battery-status reports the battery"
      else
        fail "omarchy-battery-status finds no battery (rerun: sudo /usr/lib/omarchy-surface-sl7/omarchy-sl7-battery-patch)"
      fi
    fi
  else
    warn "upower not found; battery visibility check skipped"
  fi
  if command -v omarchy-battery-present >/dev/null 2>&1; then
    check "omarchy-battery-present finds the battery" omarchy-battery-present
  fi
fi

# AC/battery power mode: current source, applied caps, and whether they match.
powermode=${OMARCHY_SL7_POWERMODE:-/usr/bin/omarchy-sl7-powermode}
if [[ -x $powermode ]]; then
  pm_out=$("$powermode" status 2>&1)
  pm_rc=$?
  while IFS= read -r line; do printf 'INFO  powermode: %s\n' "$line"; done <<<"$pm_out"
  if ((pm_rc == 0)); then
    pass "power mode matches the power source"
  else
    fail "power mode does not match the power source (sudo $powermode auto)"
  fi
else
  warn "omarchy-sl7-powermode not installed; power mode check skipped"
fi

# Wi-Fi power save on battery (WARN: the radio idles at full power otherwise).
# NetworkManager applies Omarchy's wifi.powersave=2 on every association unless
# the zz-omarchy-sl7-wifi-powersave.conf drop-in and the dispatcher script win.
wifi_net=${OMARCHY_SL7_NET:-/sys/class/net}
wifi_ps_dir=${OMARCHY_SL7_POWER_SUPPLY:-/sys/class/power_supply}
wifi_conf=${OMARCHY_SL7_POWER_CONF:-/etc/omarchy-surface-sl7/power.conf}
read -r wifi_enable wifi_policy < <(
  ENABLE=yes
  WIFI_PS=yes
  # shellcheck source=/dev/null
  [[ -r $wifi_conf ]] && . "$wifi_conf"
  echo "$ENABLE $WIFI_PS"
)
wifi_on_ac=0
wifi_have_source=0
for supply in "$wifi_ps_dir"/*; do
  [[ -r $supply/type && -r $supply/online ]] || continue
  case $(<"$supply/type") in
    Mains | USB*)
      wifi_have_source=1
      [[ $(<"$supply/online") == 1 ]] && wifi_on_ac=1
      ;;
  esac
done
for wifi_w in "$wifi_net"/*/wireless; do
  [[ -d $wifi_w ]] || continue
  wifi_dev=$(basename "$(dirname "$wifi_w")")
  if ! command -v iw >/dev/null 2>&1; then
    warn "Wi-Fi power save: iw not installed, $wifi_dev not checked"
    continue
  fi
  wifi_cur=$(iw dev "$wifi_dev" get power_save 2>/dev/null | awk '/Power save/ {print $3}')
  if [[ $wifi_enable != yes || $wifi_policy != yes ]]; then
    printf 'INFO  Wi-Fi power save: %s is %s (policy off in power.conf)\n' "$wifi_dev" "${wifi_cur:-unknown}"
  elif ((!wifi_have_source)); then
    printf 'INFO  Wi-Fi power save: %s is %s (power source unknown)\n' "$wifi_dev" "${wifi_cur:-unknown}"
  elif ((wifi_on_ac)); then
    printf 'INFO  Wi-Fi power save: %s is %s (on AC, off is expected)\n' "$wifi_dev" "${wifi_cur:-unknown}"
  elif [[ $wifi_cur == on ]]; then
    pass "Wi-Fi power save is on for $wifi_dev (battery)"
  else
    warn "Wi-Fi power save is ${wifi_cur:-unknown} for $wifi_dev on battery (want on): check /usr/lib/NetworkManager/conf.d/zz-omarchy-sl7-wifi-powersave.conf and /usr/lib/NetworkManager/dispatcher.d/90-omarchy-sl7-wifi-powersave, then sudo omarchy-sl7-powermode auto"
  fi
done

# eDP Panel Self Refresh (optional "linux-sl7 (PSR test)" boot entry, see
# omarchy-sl7-test-entry). Informational only: PSR off is the normal state, and
# PSR is KNOWN BROKEN on this panel (it turns black when idle).
psr_param=${OMARCHY_SL7_MSM_PSR:-/sys/module/msm/parameters/psr_enabled}
psr_cmdline=${OMARCHY_SL7_PROC_CMDLINE:-/proc/cmdline}
if [[ -r $psr_param ]]; then
  printf 'INFO  PSR: msm.psr_enabled=%s (running kernel)\n' "$(<"$psr_param")"
else
  printf 'INFO  PSR: msm.psr_enabled not exposed by the running kernel\n'
fi
if grep -qw 'msm.psr_enabled=1' "$psr_cmdline" 2>/dev/null; then
  printf 'INFO  PSR: booted via the PSR test entry (msm.psr_enabled=1 on the cmdline); PSR is known broken on this panel (black screen when idle)\n'
else
  printf 'INFO  PSR: normal boot entry (no msm.psr_enabled=1 on the cmdline)\n'
fi
psr_found=0
dri_debugfs=${OMARCHY_SL7_DRI_DEBUGFS:-/sys/kernel/debug/dri}
for f in "$dri_debugfs"/*/eDP-1/psr_* "$dri_debugfs"/*/*/*psr*; do
  [[ -f $f ]] || continue
  psr_found=1
  if [[ -r $f ]]; then
    printf 'INFO  PSR: %s: %s\n' "$f" "$(head -c 200 "$f" 2>/dev/null | tr '\n' ' ')"
  else
    printf 'INFO  PSR: %s exists (readable as root only)\n' "$f"
  fi
done
((psr_found)) || printf 'INFO  PSR: no PSR debugfs node visible (debugfs needs root, or the kernel does not expose one)\n'
if [[ -r /dev/kmsg || -n ${OMARCHY_SL7_DMESG:-} ]]; then
  psr_log=$(${OMARCHY_SL7_DMESG:-dmesg} 2>/dev/null | grep -i -E 'psr|self.refresh' | tail -n 3 || true)
  [[ -n $psr_log ]] && while IFS= read -r line; do printf 'INFO  PSR dmesg: %s\n' "$line"; done <<<"$psr_log"
fi
test_entry=${OMARCHY_SL7_TEST_ENTRY:-/usr/bin/omarchy-sl7-test-entry}
if [[ -x $test_entry ]]; then
  while IFS= read -r line; do printf 'INFO  test entry: %s\n' "$line"; done < <("$test_entry" list 2>&1 | cut -c1-160 | head -n 6)
fi

# eDP variable refresh (linux-sl7 patch 0024). On by default: the omarchy-
# surface-sl7 limine drop-in adds msm.vrr_enabled=1 to the normal entry. State
# is INFO; WARN only when the default entry lacks the parameter.
vrr_param=${OMARCHY_SL7_MSM_VRR:-/sys/module/msm/parameters/vrr_enabled}
if [[ -r $vrr_param ]]; then
  printf 'INFO  VRR: msm.vrr_enabled=%s (running kernel)\n' "$(<"$vrr_param")"
else
  printf 'INFO  VRR: msm.vrr_enabled not exposed by the running kernel (no patch 0024)\n'
fi
if grep -qw 'msm.vrr_enabled=1' "$psr_cmdline" 2>/dev/null; then
  printf 'INFO  VRR: msm.vrr_enabled=1 is on the running kernel command line\n'
else
  printf 'INFO  VRR: msm.vrr_enabled=1 is not on the running kernel command line\n'
fi
vrr_conf=${OMARCHY_SL7_LIMINE_CONF:-}
if [[ -z $vrr_conf ]]; then
  for f in /boot/limine.conf /efi/limine.conf /boot/efi/limine.conf /limine/limine.conf; do
    [[ -r $f ]] && { vrr_conf=$f; break; }
  done
fi
if [[ -n $vrr_conf && -r $vrr_conf ]]; then
  # cmdline of the plain linux-sl7 entry (generated test entries excluded)
  vrr_entry=$(awk '
    function done_sec() { if (id) { print (have ? cmd : "-"); found = 1; exit } }
    /^[ \t]*\/+[^\/]/ { done_sec(); id = 0; have = 0; cmd = ""; skip = 0; next }
    index($0, "### BEGIN omarchy-sl7") == 1 { skip = 1 }
    index($0, "### END omarchy-sl7") == 1 { skip = 0; next }
    skip { next }
    /^[ \t]*comment:[ \t]*kernel-id=linux-sl7[ \t]*$/ { id = 1 }
    /^[ \t]*(kernel_)?cmdline:/ { have = 1; cmd = $0 }
    END { if (!found) done_sec() }' "$vrr_conf" 2>/dev/null) || vrr_entry=
  if [[ -z $vrr_entry ]]; then
    printf 'INFO  VRR: no linux-sl7 entry found in %s; default entry not checked\n' "$vrr_conf"
  elif grep -qw 'msm.vrr_enabled=1' <<<"$vrr_entry"; then
    printf 'INFO  VRR: msm.vrr_enabled=1 is on the default linux-sl7 entry in %s\n' "$vrr_conf"
  elif [[ $vrr_entry == - ]]; then
    printf 'INFO  VRR: the linux-sl7 entry in %s has no cmdline line (UKI cmdline); default entry not checked\n' "$vrr_conf"
  else
    warn "VRR: msm.vrr_enabled=1 is missing on the default linux-sl7 entry (edited /etc/limine-entry-tool.d/omarchy-surface-sl7.conf, or a .pacnew not merged? then: sudo limine-mkinitcpio and reboot)"
  fi
else
  printf 'INFO  VRR: limine.conf not readable as this user; default entry not checked (run as root)\n'
fi
modetest=${OMARCHY_SL7_MODETEST:-modetest}
if command -v "$modetest" >/dev/null 2>&1; then
  vrr_cap=$("$modetest" -M msm -c 2>/dev/null | awk '
    /^[0-9]+[ \t]+[0-9]+[ \t]+(connected|disconnected)/ { cur = ($0 ~ /eDP/); f = 0 }
    cur && /vrr_capable/ { f = 1; next }
    f && /value:/ { print $2; exit }') || true
  if [[ -n $vrr_cap ]]; then
    printf 'INFO  VRR: eDP vrr_capable=%s (modetest)\n' "$vrr_cap"
  else
    printf 'INFO  VRR: eDP connector exposes no vrr_capable property (modetest)\n'
  fi
else
  printf 'INFO  VRR: modetest (libdrm) not installed; vrr_capable not checked\n'
fi
vrr_state=
for f in "$dri_debugfs"/*/state; do
  [[ -r $f ]] || continue
  vrr_state=$(grep -h 'vrr_enabled' "$f" 2>/dev/null | sort | uniq -c | tr '\n' ' ' | tr -s ' ') || true
  break
done
[[ -n $vrr_state ]] && printf 'INFO  VRR: debugfs state: %s\n' "$vrr_state"
if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 && [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  vrr_hypr=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.name | startswith("eDP")) | "\(.name) vrr=\(.vrr) refresh=\(.refreshRate)"' 2>/dev/null | head -n 1) || true
  [[ -n $vrr_hypr ]] && printf 'INFO  VRR: Hyprland %s (misc.vrr %s)\n' "$vrr_hypr" "$(hyprctl getoption misc:vrr -j 2>/dev/null | jq -r '.int // "?"' 2>/dev/null)"
fi

# Iris hardware video codec (linux-sl7 patch 0086, V4L2 stateful decoder and
# encoder). Read-only and never a failure: software decode still works.
iris_fw=qcom/x1e80100/microsoft/Romulus/qcvss8380.mbn
v4l_sys=${OMARCHY_SL7_V4L_SYSFS:-/sys/class/video4linux}
dt_base=${OMARCHY_SL7_DT_BASE:-/sys/firmware/devicetree/base}
iris_fw_ok=0
if fw_ok "$iris_fw"; then
  iris_fw_ok=1
  printf 'INFO  Iris: firmware %s installed\n' "${iris_fw##*/}"
else
  warn "Iris: firmware ${iris_fw##*/} missing; no hardware video (sudo omarchy-surface-sl7-firmware --from-msi ...)"
fi
iris_dt=
for node in "$dt_base"/soc@0/video-codec@*; do
  [[ -r $node/status ]] && iris_dt=$(tr -d '\0' <"$node/status")
done
case $iris_dt in
  okay) printf 'INFO  Iris: video-codec node is enabled in the running device tree\n' ;;
  '') printf 'INFO  Iris: no video-codec node found in the running device tree\n' ;;
  *) printf 'INFO  Iris: video-codec node status is "%s" in the running device tree (kernel without patch 0086?)\n' "$iris_dt" ;;
esac
iris_dec=0 iris_enc=0
for node in "$v4l_sys"/video*; do
  [[ -r $node/name ]] || continue
  case $(<"$node/name") in
    *iris*decoder*) iris_dec=1 ;;
    *iris*encoder*) iris_enc=1 ;;
  esac
done
if ((iris_dec && iris_enc)); then
  printf 'INFO  Iris: V4L2 decoder and encoder present (/sys/class/video4linux)\n'
elif [[ $iris_dt == okay ]] && ((iris_fw_ok)); then
  warn "Iris: node enabled and firmware installed but no iris decoder/encoder in /dev/video* (dmesg | grep -i iris)"
else
  printf 'INFO  Iris: no iris V4L2 decoder/encoder device (decode stays in software)\n'
fi
if command -v v4l2-ctl >/dev/null 2>&1; then
  while IFS= read -r line; do printf 'INFO  Iris: v4l2-ctl: %s\n' "$line"; done \
    < <(v4l2-ctl --list-devices 2>/dev/null | awk '/^[^[:space:]]/ { show = ($0 ~ /[Ii]ris/) } show && NF { sub(/^[[:space:]]+/, ""); print }' | head -n 6)
else
  printf 'INFO  Iris: v4l2-ctl (v4l-utils) not installed; checked /sys/class/video4linux only\n'
fi

((fails == 0)) && echo "sl7-doctor: all checks passed" || echo "sl7-doctor: $fails check(s) failed"
((fails == 0))
