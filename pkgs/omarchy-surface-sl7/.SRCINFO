pkgbase = omarchy-surface-sl7
	pkgdesc = Omarchy add-on for the Microsoft Surface Laptop 7 (Snapdragon X): initramfs, UKI device trees, touch resume, firmware installer
	pkgver = 0.1.0
	pkgrel = 51
	url = https://github.com/qBitnaut/omarchy-dragon-sl7
	install = omarchy-surface-sl7.install
	arch = aarch64
	groups = omarchy-platform-qualcomm
	license = MIT
	license = ISC
	depends = omarchy
	depends = omarchy-sl7-keyring
	depends = linux-sl7>=7.2.8-3
	depends = iptsd-sl7>=3.1.0.r20260717-11
	depends = linux-firmware-qcom
	depends = linux-firmware-atheros
	depends = qcom-firmware-extract
	depends = mkinitcpio
	depends = systemd
	depends = python
	depends = bash
	depends = jq
	depends = glib2
	depends = coreutils
	depends = gawk
	depends = grep
	optdepends = limine-mkinitcpio-hook: rebuilds the UKI and Limine entries (Omarchy default)
	optdepends = msitools: --from-msi in omarchy-surface-sl7-firmware
	optdepends = iw: Wi-Fi power save on battery (omarchy-sl7-powermode) and the opt-in policy
	optdepends = socat: omarchy-sl7-powermode re-applies 60 Hz after a Hyprland config reload
	optdepends = brightnessctl: sl7-powertest pins the backlight
	optdepends = mpv: sl7-powertest video
	optdepends = bluez-utils: bluetoothctl in sl7-mac status
	optdepends = v4l-utils: media-ctl and v4l2-ctl for sl7-ir-probe and sl7-ir-lab
	optdepends = pciutils: lspci in sl7-sleepstats --trace
	optdepends = libcamera-tools: cam and qcam to test the webcam, and sl7-camera-check
	optdepends = libcamera>=0.7.2-4.1: the OV02C10 sensor helper (omarchy-sl7 repository build) for the webcam
	optdepends = pipewire-libcamera: the webcam in browsers and video calls
	optdepends = imagemagick: PNG output in sl7-camera-check
	optdepends = gtk4: the sl7-ir-lab window
	optdepends = python-gobject: the sl7-ir-lab window (PyGObject)
	optdepends = python-cairo: the sl7-ir-lab live view and graph
