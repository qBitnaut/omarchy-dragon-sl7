#!/usr/bin/env python3
"""Battery power test harness for the Surface Laptop 7 (qcom-battmgr).

  sl7-powertest idle  [--minutes N]
  sl7-powertest video FILE [--minutes N] [--hwdec MODE]
  sl7-powertest suspend
  sl7-powertest compare A.jsonl B.jsonl

idle and video take --rails to also log the firmware power rails (hwmon
qcom_pld_power, see sl7-powermeter --describe) beside the gauge.

Run as your own user, on battery, with the charger unplugged. The tool only
reads sysfs; the settings it changes for the run (screen brightness, and the
idle/sleep inhibitor) are restored when it exits, also on Ctrl-C.

Watts are the time integral of power_now (trapezoid over the samples, one
every 2 s), reported as the mean with its standard error. power_now is fresh
on every read (qcom_battmgr has no cache). The energy_now delta is kept as a
cross-check: current firmware reports energy_now quantized to whole percent of
energy_full (about 496 mWh per step on the SL7), so the tool detects the step
size from the run and prints the gauge figure with its true bound,
+/-step/window. With fewer than 3 steps the gauge figure is labelled "too
coarse for this window" and is not used for the verdict.

The clock starts immediately. --gauge-sync restores the old behaviour of
starting and stopping the clock on a gauge step; it only makes sense when the
steps are small (older firmware, about 10 mWh) and can wait up to 300 s.
"""

import argparse
import hashlib
import json
import math
import os
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

MIN_GAUGE_STEPS = 3  # fewer energy_now steps than this: gauge figure too coarse to use
SUSPEND_CYCLE_MWH = 24.0  # fixed cost per suspend cycle (Dell 7441; re-measure)
SYNC_TIMEOUT_S = 300.0
SYNC_PROGRESS_S = 30.0  # progress line interval while waiting for a gauge update
SYNC_STALE_S = 60.0  # --gauge-sync only: with fine (10 mWh) steps at ~2.3 W longer means frozen
POLL_S = 0.5
RAILS_HWMON = "qcom_pld_power"  # optional firmware power rails, read-only hwmon

ROOT = os.environ.get("SL7_SYSROOT", "")  # test hook: prefix for /sys, /proc/cmdline, /run


def p(path):
    return Path(ROOT + path)


def read(path, default=None):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return default


def read_int(path):
    v = read(path)
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def run(cmd, timeout=5):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


# --- battery / power source ---------------------------------------------------


def supplies():
    base = p("/sys/class/power_supply")
    return sorted(d for d in base.glob("*") if d.is_dir())


def find_battery():
    bats = [d for d in supplies() if read(d / "type") == "Battery"]
    scoped = [d for d in bats if read(d / "scope") != "Device"]
    bats = scoped or bats
    pref = [d for d in bats if d.name == "qcom-battmgr-bat"]
    return (pref or bats or [None])[0], len(bats)


def ac_online():
    for d in supplies():
        if read(d / "type") in ("Mains", "USB") or (read(d / "type") or "").startswith("USB"):
            if read(d / "online") == "1":
                return True
    return False


def energy_mwh(bat):
    v = read_int(bat / "energy_now")
    return None if v is None else v / 1000.0


class Rails:
    """Optional: the firmware's one-second power rails, logged beside the gauge.

    Read only, and independent of the gauge and of power_now: logged for
    comparison only. A missing hwmon device just means no rails.
    """

    def __init__(self, hw):
        self.hw = hw
        self.chans = sorted((int(f.name[5:-6]), read(f) or f.name[:-6])
                            for f in hw.glob("power[0-9]*_label") if f.name[5:-6].isdigit())

    @staticmethod
    def find():
        for d in sorted(p("/sys/class/hwmon").glob("hwmon*")):
            if read(d / "name") == RAILS_HWMON:
                return Rails(d)
        return None

    def read(self):
        out = {}
        for n, label in self.chans:
            v = read_int(self.hw / ("power%d_average" % n))  # ENODATA reads as None
            out[label] = None if v is None else round(v / 1e6, 3)
        return out


# --- environment capture --------------------------------------------------------


def hypr_monitors():
    out = run(["hyprctl", "monitors", "-j"])
    if not out:
        return None
    try:
        return json.loads(out)
    except ValueError:
        return None


def display_mode(mons):
    if not mons:
        return None
    for m in mons:
        if m.get("name", "").startswith("eDP"):
            return "%sx%s@%.2f" % (m.get("width"), m.get("height"), m.get("refreshRate", 0))
    return None


def wifi_ifaces():
    return sorted(d.parent.name for d in p("/sys/class/net").glob("*/wireless"))


def wifi_power_save():
    out = {}
    for dev in wifi_ifaces():
        txt = run(["iw", "dev", dev, "get", "power_save"])
        out[dev] = txt.split(":")[-1].strip() if txt else None
    return out


def wifi_ssid():
    for dev in wifi_ifaces():
        txt = run(["iw", "dev", dev, "link"])
        for line in (txt or "").splitlines():
            if line.strip().startswith("SSID:"):
                return line.split(":", 1)[1].strip()
    return None


def policies():
    return sorted(p("/sys/devices/system/cpu/cpufreq").glob("policy*"), key=lambda d: int(d.name[6:]))


def gpu_devices():
    return sorted(p("/sys/class/devfreq").glob("*gpu*"))


def bluetooth_state():
    states = []
    for d in sorted(p("/sys/class/rfkill").glob("rfkill*")):
        if read(d / "type") == "bluetooth":
            states.append("blocked" if read(d / "soft") == "1" or read(d / "hard") == "1" else "on")
    return states or None


def capture_config(brightness, extra):
    mons = hypr_monitors()
    cfg = {
        "kernel": read(p("/proc/sys/kernel/osrelease")) or os.uname().release,
        "cmdline": read(p("/proc/cmdline")),
        "display": display_mode(mons),
        "monitors": sorted(m.get("name", "?") for m in mons) if mons else None,
        "governor": {d.name: read(d / "scaling_governor") for d in policies()},
        "cpu_max_khz": {d.name: read_int(d / "scaling_max_freq") for d in policies()},
        "gpu_max_hz": {d.name: read_int(d / "max_freq") for d in gpu_devices()},
        "wifi_power_save": wifi_power_save(),
        "wifi_ssid": wifi_ssid(),
        "bluetooth": bluetooth_state(),
        "brightness": brightness,
        "powermode": read(p("/run/omarchy-surface-sl7/mode")),
    }
    cfg.update(extra)
    return cfg


def config_hash(cfg):
    blob = json.dumps(cfg, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(blob.encode()).hexdigest()[:12]


# --- brightness -------------------------------------------------------------------


class Brightness:
    """Pin the backlight for the run and put it back afterwards."""

    def __init__(self, pct):
        self.pct = pct
        self.orig = None
        self.max = None

    def _info(self):
        out = run(["brightnessctl", "-m", "-c", "backlight", "info"])
        if not out:
            return None
        f = out.strip().splitlines()[0].split(",")
        return int(f[2]), int(f[4])

    def pin(self):
        info = self._info()
        if not info:
            return None
        self.orig, self.max = info
        run(["brightnessctl", "-q", "-c", "backlight", "set", "%d%%" % self.pct])
        now = self._info()
        return {"percent": self.pct, "raw": now[0] if now else None, "max": self.max}

    def restore(self):
        if self.orig is not None:
            run(["brightnessctl", "-q", "-c", "backlight", "set", str(self.orig)])
            self.orig = None


class StayAwake:
    """Omarchy's own keep-awake toggle (omarchy-toggle-idle).

    The Quickshell idle service honours only this toggle's state file, not
    systemd-inhibit, so the screensaver would otherwise start mid-run. The
    prior state is recorded and put back by restore().
    """

    def __init__(self):
        self.prior = None  # True when keep-awake was already on

    @staticmethod
    def _cmd():
        return None if ROOT else shutil.which("omarchy-toggle-idle")

    def enable(self):
        exe = self._cmd()
        if exe is None:
            return False
        out = run([exe, "status"])
        try:
            self.prior = bool(json.loads(out)["enabled"])
        except (TypeError, ValueError, KeyError):
            self.prior = None
            return False
        if not self.prior:
            run([exe, "stay-awake"])
        return True

    def restore(self):
        exe = self._cmd()
        if exe is not None and self.prior is False:
            run([exe, "allow-idle"])
        self.prior = None


class SyncWait:
    """Progress and frozen-gauge hints while waiting for energy_now to change."""

    def __init__(self, label, since, energy):
        self.label, self.since, self.energy = label, since, energy
        self.next_progress = since + SYNC_PROGRESS_S
        self.hinted = False

    def tick(self, now, energy):
        waited = now - self.since
        if now >= self.next_progress:
            self.next_progress += SYNC_PROGRESS_S
            print("%s gauge sync: energy_now %s mWh, unchanged for %d s"
                  % (self.label, "?" if energy is None else "%.0f" % energy, waited))
        if waited >= SYNC_STALE_S and not self.hinted:
            self.hinted = True
            if self.label == "end":
                print("end gauge sync: the gauge looks frozen (no change for %d s). Plugging the charger "
                      "in ends the run now; the window ends at the last gauge step either way." % waited)
            else:
                print("%s gauge sync: the gauge looks frozen (no change for %d s). Plug the charger in for "
                      "~10 s and unplug it to wake the gauge; the run will continue automatically when it "
                      "updates." % (self.label, waited))


# --- samplers -----------------------------------------------------------------------


class CpuIdle:
    def __init__(self):
        self.prev = None

    def read(self):
        acc = {}
        for st in p("/sys/devices/system/cpu").glob("cpu[0-9]*/cpuidle/state*"):
            name = read(st / "name") or st.name
            t, u = read_int(st / "time"), read_int(st / "usage")
            if t is None or u is None:
                continue
            a = acc.setdefault(name, [0, 0])
            a[0] += t
            a[1] += u
        return acc

    def delta(self):
        cur = self.read()
        if self.prev is None:
            self.prev = cur
            return None
        d = {
            n: {"time_us": cur[n][0] - self.prev.get(n, [0, 0])[0], "usage": cur[n][1] - self.prev.get(n, [0, 0])[1]}
            for n in cur
        }
        self.prev = cur
        return d


class TopProcs:
    def __init__(self):
        self.prev = None
        self.prev_t = None
        self.me = os.getpid()
        self.tck = os.sysconf("SC_CLK_TCK")

    def snapshot(self):
        snap = {}
        for d in Path("/proc").iterdir():
            if not d.name.isdigit() or int(d.name) == self.me:
                continue
            try:
                s = (d / "stat").read_text()
            except OSError:
                continue
            comm = s[s.index("(") + 1 : s.rindex(")")]
            rest = s[s.rindex(")") + 2 :].split()
            snap[int(d.name)] = (comm, int(rest[11]) + int(rest[12]))
        return snap

    def top(self, n=5):
        now, snap = time.monotonic(), self.snapshot()
        res = None
        if self.prev is not None:
            dt = now - self.prev_t
            rows = []
            for pid, (comm, ticks) in snap.items():
                if pid in self.prev:
                    d = ticks - self.prev[pid][1]
                    if d > 0:
                        rows.append((d, pid, comm))
            rows.sort(reverse=True)
            res = [
                {"pid": pid, "comm": comm, "cpu_pct": round(100.0 * d / self.tck / dt, 1)}
                for d, pid, comm in rows[:n]
            ]
        self.prev, self.prev_t = snap, now
        return res


def sample(bat, idle, mons_now, rails=None):
    pw = read_int(bat / "power_now")
    rec = {
        "type": "sample",
        "t": round(time.time(), 3),
        "energy_mwh": energy_mwh(bat),
        "power_w": None if pw is None else round(abs(pw) / 1e6, 3),
        "capacity": read_int(bat / "capacity"),
        "status": read(bat / "status"),
        "cpu_khz": {d.name: read_int(d / "scaling_cur_freq") for d in policies()},
        "cpuidle": idle.delta(),
        "gpu_hz": {d.name: read_int(d / "cur_freq") for d in gpu_devices()},
        "display": display_mode(mons_now),
    }
    if rails is not None:
        rec["rails_w"] = rails.read()
    return rec


# --- the run ---------------------------------------------------------------------------


class Abort(Exception):
    pass


def _sig(signum, _frame):
    raise Abort("signal %d" % signum)


def mean(vals):
    vals = [v for v in vals if v is not None]
    return sum(vals) / len(vals) if vals else None


def integrate(win):
    """Trapezoid integral of power_now: (mean W, standard error W, n, span s) or None.

    The standard error is the sample spread over sqrt(n_eff), where n_eff is
    reduced by the lag-1 autocorrelation so that smooth drift is not counted as
    many independent samples. It covers sampling noise only, not a bias in the
    gauge's power_now.
    """
    pts = [(x["t"], x["power_w"]) for x in win if x.get("power_w") is not None]
    if len(pts) < 2:
        return None
    span = pts[-1][0] - pts[0][0]
    if span <= 0:
        return None
    area = sum((pts[i][1] + pts[i + 1][1]) / 2.0 * (pts[i + 1][0] - pts[i][0]) for i in range(len(pts) - 1))
    vals = [v for _, v in pts]
    n = len(vals)
    m = sum(vals) / n
    ss = sum((v - m) ** 2 for v in vals)
    var = ss / (n - 1)
    r = sum((vals[i] - m) * (vals[i + 1] - m) for i in range(n - 1)) / ss if ss > 0 else 0.0
    r = min(max(r, 0.0), 0.95)
    n_eff = n * (1.0 - r) / (1.0 + r)
    return area / span, math.sqrt(var / n_eff), n, span


def detect_step(energies, e_full_mwh):
    """Gauge step size and step count from the energy_now values seen in a run.

    Returns (step_mwh or None, steps). The step is the smallest nonzero change;
    when that matches energy_full/100 (whole-percent firmware) it is snapped to
    exactly that. With no change at all it is energy_full/100 only if the
    readings sit on a whole-percent grid, else unknown.
    """
    pct = e_full_mwh / 100.0 if e_full_mwh else None
    vals = [e for e in energies if e is not None]
    deltas = [abs(b - a) for a, b in zip(vals, vals[1:]) if abs(b - a) > 0.5]
    if deltas:
        step = min(deltas)
        if pct and abs(step - pct) <= 0.05 * pct:
            step = pct
        return step, sum(max(1, round(d / step)) for d in deltas)
    if pct and vals and all(abs(v / pct - round(v / pct)) * pct <= 1.5 for v in vals):
        return pct, 0
    return None, 0


def summarize(samples, t0, t1, e0, e1, cfg, hsh, meta):
    win = [s for s in samples if t0 <= s["t"] <= t1]
    hours = (t1 - t0) / 3600.0
    s = {
        "type": "summary",
        "valid": meta["valid"],
        "notes": meta["notes"],
        "workload": meta["workload"],
        "label": meta.get("label"),
        "config_hash": hsh,
        "window_s": round(t1 - t0, 1),
        "energy_start_mwh": e0,
        "energy_end_mwh": e1,
        "gauge_sync": meta.get("gauge_sync", False),
    }
    integ = integrate(win)
    if integ is not None:
        s["watts"] = round(integ[0], 3)
        s["error_w"] = round(integ[1], 3)
        s["method"] = "power_now integral"
        s["power_samples"] = integ[2]
    if hours > 0 and e0 is not None and e1 is not None:
        step, steps = detect_step([e0] + [x["energy_mwh"] for x in win] + [e1], meta.get("energy_full_mwh"))
        s["gauge_watts"] = round((e0 - e1) / 1000.0 / hours, 3)
        s["gauge_step_mwh"] = None if step is None else round(step, 2)
        s["gauge_steps"] = steps
        s["gauge_error_w"] = None if step is None else round(step / 1000.0 / hours, 3)
        s["gauge_usable"] = step is not None and steps >= MIN_GAUGE_STEPS
    s["power_now_mean_w"] = None if not win else round(mean([x["power_w"] for x in win]) or 0, 3)
    s["samples"] = len(win)
    s["capacity_start"] = win[0]["capacity"] if win else None
    s["capacity_end"] = win[-1]["capacity"] if win else None
    pols = sorted({k for x in win for k in x["cpu_khz"]})
    s["cpu_mean_khz"] = {k: round(mean([x["cpu_khz"].get(k) for x in win]) or 0) for k in pols}
    gpus = sorted({k for x in win for k in x["gpu_hz"]})
    s["gpu_mean_hz"] = {k: round(mean([x["gpu_hz"].get(k) for x in win]) or 0) for k in gpus}
    states = {}
    for x in win:
        for n, v in (x["cpuidle"] or {}).items():
            a = states.setdefault(n, [0, 0])
            a[0] += v["time_us"]
            a[1] += v["usage"]
    ncpu = len(list(p("/sys/devices/system/cpu").glob("cpu[0-9]*/cpuidle"))) or 1
    wall_us = (win[-1]["t"] - win[0]["t"]) * 1e6 * ncpu if len(win) > 1 else 0
    s["cpuidle_residency_pct"] = {n: round(100.0 * a[0] / wall_us, 1) if wall_us else None for n, a in states.items()}
    s["cpuidle_entries"] = {n: a[1] for n, a in states.items()}
    rail_vals = {}
    for x in win:
        for k, v in (x.get("rails_w") or {}).items():
            if v is not None:
                rail_vals.setdefault(k, []).append(v)
    if rail_vals:
        s["rails_mean_w"] = {k: round(mean(v), 3) for k, v in rail_vals.items()}
    s["config"] = cfg
    return s


def fmt_gauge(s):
    step, err = s.get("gauge_step_mwh"), s.get("gauge_error_w")
    bound = "step unknown" if step is None else "+/- %.3f W bound (one %.1f mWh step per window)" % (err, step)
    txt = "%.3f W, %s, %d step%s seen" % (s["gauge_watts"], bound, s["gauge_steps"],
                                          "" if s["gauge_steps"] == 1 else "s")
    if not s.get("gauge_usable"):
        txt += "; too coarse for this window (needs %d+ steps), not used for the verdict" % MIN_GAUGE_STEPS
    return txt


def fmt_summary(s):
    lines = []
    tag = "" if s["valid"] else "  [INVALID: %s]" % "; ".join(s["notes"])
    lines.append("%s%s  config %s" % (s["workload"], tag, s["config_hash"]))
    if "watts" in s:
        lines.append(
            "  %.3f W +/- %.3f W (power_now integral, %.1f min, %d samples; +/- is the standard error)"
            % (s["watts"], s["error_w"], s["window_s"] / 60.0, s.get("power_samples", 0))
        )
    if "gauge_watts" in s:
        lines.append("  gauge cross-check: " + fmt_gauge(s))
        lines.append("  energy %.0f -> %.0f mWh" % (s["energy_start_mwh"], s["energy_end_mwh"]))
    if s["valid"] and s["notes"]:
        lines.append("  notes: " + "; ".join(s["notes"]))
    if s.get("cpu_mean_khz"):
        lines.append("  mean cpu MHz: " + " ".join("%s=%d" % (k, v / 1000) for k, v in s["cpu_mean_khz"].items()))
    if s.get("rails_mean_w"):
        lines.append("  mean rails W (firmware, not the gauge): "
                     + " ".join("%s=%.2f" % (k, v) for k, v in s["rails_mean_w"].items()))
    if s.get("cpuidle_residency_pct"):
        lines.append(
            "  cpuidle residency: " + " ".join("%s=%s%%" % (k, v) for k, v in s["cpuidle_residency_pct"].items())
        )
    return "\n".join(lines)


def workload_run(args, workload, launcher=None):
    bat, nbat = find_battery()
    if bat is None:
        sys.exit("sl7-powertest: no battery found under /sys/class/power_supply")
    if nbat > 1:
        print("warning: %d batteries listed; using %s" % (nbat, bat.name), file=sys.stderr)
    if ac_online() or read(bat / "status") != "Discharging":
        sys.exit(
            "sl7-powertest: the charger must be unplugged and the battery Discharging "
            "(charger online: %s, battery status: %s). Unplug it and wait a few seconds."
            % ("yes" if ac_online() else "no", read(bat / "status"))
        )
    if energy_mwh(bat) is None:
        sys.exit("sl7-powertest: %s/energy_now is not readable" % bat)
    cap = read_int(bat / "capacity")
    notes = []
    if cap is not None and cap < 15:
        sys.exit("sl7-powertest: battery at %d%%; charge above 30%% first" % cap)
    if cap is not None and not 30 <= cap <= 90:
        notes.append("battery at %d%% (recommended 30-90%%)" % cap)
    rails = None
    if args.rails:
        rails = Rails.find()
        if rails is None:
            notes.append("--rails given but no %s hwmon device (needs linux-sl7 7.2.8-12 or newer); no rails logged"
                         % RAILS_HWMON)
    if args.minutes < 10:
        notes.append("%.1f min run: short; the power_now error is larger and the gauge cross-check "
                     "will be too coarse (it needs 3+ energy_now steps)" % args.minutes)

    outdir = Path(os.environ.get("SL7_POWERTEST_DIR", Path.home() / ".local/state/sl7-powertest"))
    outdir.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    label = ("-" + args.label) if args.label else ""
    path = outdir / ("%s-%s%s.jsonl" % (stamp, workload, label))

    bright = Brightness(args.brightness)
    mpv = None
    out = open(path, "w", buffering=1)
    samples = []
    meta = {"workload": workload, "label": args.label, "valid": False, "notes": notes,
            "gauge_sync": args.gauge_sync}
    full = read_int(bat / "energy_full")
    meta["energy_full_mwh"] = None if full is None else full / 1000.0
    t0 = t1 = e0 = e1 = None
    cfg = {}
    hsh = ""
    old = {s: signal.signal(s, _sig) for s in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP)}
    awake = StayAwake()
    try:
        awake_on = awake.enable()
        if not awake_on and not ROOT:
            notes.append("omarchy keep-awake toggle unavailable; the screensaver may interrupt the run")
        pinned = bright.pin()
        if pinned is None:
            notes.append("brightness not pinned (brightnessctl failed)")
        extra = launcher.config() if launcher else {}
        extra["inhibited"] = bool(os.environ.get("SL7_POWERTEST_INHIBITED"))
        extra["keep_awake"] = awake_on
        extra["rails"] = rails is not None
        cfg = capture_config(pinned, extra)
        hsh = config_hash(cfg)
        out.write(json.dumps({"type": "config", "t": round(time.time(), 3), "workload": workload,
                              "label": args.label, "minutes": args.minutes, "hash": hsh, "config": cfg}) + "\n")
        if launcher:
            mpv = launcher.start()
        time.sleep(2.0)  # let brightness and the workload settle

        idle, top = CpuIdle(), TopProcs()
        top.top()
        idle.delta()
        gauge_sync = args.gauge_sync
        e_seen = energy_mwh(bat)
        started = time.monotonic()
        next_sample = next_minute = started
        e_ref = e_last = e_seen
        run_until = None
        sync_end_from = started
        woke = False
        t_step = e_step = None  # --gauge-sync: wall time and value of the last gauge step

        def take_sample(ph):
            rec = sample(bat, idle, hypr_monitors(), rails)
            rec["phase"] = ph
            samples.append(rec)
            out.write(json.dumps(rec) + "\n")
            return rec

        if gauge_sync:
            phase = "sync-start"
            print("%s: waiting for a fresh gauge update (up to %d s)..." % (workload, SYNC_TIMEOUT_S))
            wait = SyncWait("start", started, e_seen)
        else:
            phase = "run"
            t0, e0 = time.time(), e_seen
            run_until = started + args.minutes * 60.0
            next_minute = started + 60.0
            print("clock started: %.0f mWh at %s, running %.1f min, power_now every %g s"
                  % (e0, time.strftime("%H:%M:%S"), args.minutes, args.sample))
        while True:
            now = time.monotonic()
            if ac_online() or read(bat / "status") == "Charging":
                if phase == "run":
                    raise Abort("charger plugged in during the run")
                if phase == "sync-end":
                    # Charging would add energy; end the window at the last gauge step.
                    notes.append("charger plugged in during the end sync; window ends at the last gauge step")
                    t1, e1 = t_step, e_step
                    break
                # Gauge-wake nudge during a sync wait: tolerated. Once unplugged, the
                # baseline is retaken from the gauge and the wait starts over.
                if not woke:
                    print("charger seen during gauge sync; unplug it to continue (the wait restarts)")
                woke = True
                time.sleep(POLL_S)
                continue
            if woke:
                woke = False
                e_ref = e_last = energy_mwh(bat)
                wait = SyncWait("start" if phase == "sync-start" else "end", now, e_ref)
                if phase == "sync-start":
                    started = now
                else:
                    sync_end_from = now
                print("charger unplugged; waiting for a fresh gauge update from %s mWh"
                      % ("?" if e_ref is None else "%.0f" % e_ref))
            if mpv is not None and mpv.poll() is not None:
                raise Abort("mpv exited early (code %s)" % mpv.returncode)
            e = energy_mwh(bat) if gauge_sync else None  # every read is a live battmgr request
            if e is not None and e_last is not None and e > e_last + 0.5:
                raise Abort("energy_now rose (charging?)")
            if e is not None:
                if phase != "sync-start" and e != e_last:
                    t_step, e_step = time.time(), e
                e_last = e
            if phase == "sync-start":
                if e is not None and e != e_ref:
                    t0, e0 = time.time(), e
                    t_step, e_step = t0, e0
                    run_until = now + args.minutes * 60.0
                    next_minute = now + 60.0
                    phase = "run"
                    print("clock started: %.0f mWh at %s, running %.1f min" % (e0, time.strftime("%H:%M:%S"), args.minutes))
                elif now - started > SYNC_TIMEOUT_S:
                    raise Abort("energy_now never updated (gauge stale?)")
                else:
                    wait.tick(now, e)
            elif phase == "run":
                if now >= run_until:
                    if gauge_sync:
                        e_ref = e
                        phase = "sync-end"
                        sync_end_from = now
                        wait = SyncWait("end", now, e)
                        print("run done; waiting for a fresh gauge update to stop the clock...")
                    else:
                        rec = take_sample("run")  # closes the integral and reads the end energy
                        t1 = rec["t"]
                        e1 = rec["energy_mwh"] if rec["energy_mwh"] is not None else e_last
                        break
            elif phase == "sync-end":
                if e is not None and e != e_ref:
                    t1, e1 = time.time(), e
                    break
                if now - sync_end_from > SYNC_TIMEOUT_S:
                    notes.append("end gauge sync timed out; window ends at the last gauge step")
                    t1, e1 = t_step, e_step
                    break
                wait.tick(now, e)
            if now >= next_sample:
                rec = take_sample(phase)
                if not gauge_sync and rec["energy_mwh"] is not None:
                    if e_last is not None and rec["energy_mwh"] > e_last + 0.5:
                        raise Abort("energy_now rose (charging?)")
                    e_last = rec["energy_mwh"]
                next_sample += args.sample
                if next_sample < now:
                    next_sample = now + args.sample
            if now >= next_minute and phase != "sync-start":
                out.write(json.dumps({"type": "minute", "t": round(time.time(), 3), "phase": phase,
                                      "top": top.top(), "wifi_power_save": wifi_power_save(),
                                      "display": display_mode(hypr_monitors())}) + "\n")
                next_minute += 60.0
            time.sleep(POLL_S)
        meta["valid"] = True
    except Abort as exc:
        notes.append("aborted: %s" % exc)
        t1 = t1 or time.time()
        if t0 is None:
            t0 = t1
    finally:
        for s, h in old.items():
            signal.signal(s, h)
        if launcher:
            launcher.stop()
        bright.restore()
        awake.restore()
    summ = summarize(samples, t0 or time.time(), t1 or time.time(), e0, e1, cfg, hsh, meta)
    out.write(json.dumps(summ) + "\n")
    out.close()
    (path.with_suffix(".summary.json")).write_text(json.dumps(summ, indent=2) + "\n")
    print()
    print(fmt_summary(summ))
    print("  log: %s" % path)
    return 0 if meta["valid"] else 1


class Mpv:
    def __init__(self, args):
        self.args = args
        self.proc = None

    def cmdline(self):
        cmd = ["mpv", "--loop-file=inf", "--no-terminal", "--mute=yes", "--hwdec=%s" % self.args.hwdec]
        if not self.args.windowed:
            cmd.append("--fullscreen")
        return cmd + list(self.args.mpv_args) + [self.args.file]

    def config(self):
        return {"video": os.path.basename(self.args.file), "mpv": self.cmdline()[:-1]}

    def start(self):
        self.proc = subprocess.Popen(self.cmdline(), start_new_session=True,
                                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return self.proc

    def stop(self):
        if self.proc and self.proc.poll() is None:
            try:
                os.killpg(self.proc.pid, signal.SIGTERM)
                self.proc.wait(timeout=5)
            except (OSError, subprocess.TimeoutExpired):
                self.proc.kill()


# --- suspend / compare ---------------------------------------------------------------------


def cmd_suspend(_args):
    bat, _ = find_battery()
    print("""sl7-powertest suspend: guidance (nothing is changed or suspended by this command)

Use `sudo sl7-sleepstats --suspend-test`; it does the steps below for you and
reports the gauge bound. power_now cannot be sampled while suspended, so only
the energy_now delta is available, and the SL7 firmware quantizes it to whole
percent of energy_full (about 496 mWh per step).

By hand, with the charger unplugged and the battery between 30%% and 90%%:
  1. Pin the brightness you will use afterwards and close anything busy.
  2. Note energy_now and the time:
       watch -n1 'date +%%T; cat %s/energy_now'
  3. systemctl suspend. Wake it by hand (power button); the SL7 RTC has no alarm.
  4. Note energy_now and the time again.
  5. W = (start - end) / hours asleep, with a bound of +/- one gauge step per
     hour asleep (about +/-0.5 W per hour of sleep at 496 mWh). Sleep 4+ hours
     for +/-0.12 W, overnight for better; short suspends tell you nothing.
Change one variable per run and repeat each setting three times, alternating.
Use `sl7-powertest idle` for the awake baseline."""
          % (bat if bat else "/sys/class/power_supply/qcom-battmgr-bat"))
    if bat is None:
        print("\nwarning: no battery found", file=sys.stderr)
    elif ac_online():
        print("\nnote: a charger is currently connected.")
    return 0


def load_summary(path):
    last = None
    try:
        with open(path) as fh:
            for line in fh:
                try:
                    rec = json.loads(line)
                except ValueError:
                    continue
                if rec.get("type") == "summary":
                    last = rec
    except OSError as exc:
        sys.exit("sl7-powertest: %s" % exc)
    if last is None:
        sys.exit("sl7-powertest: no summary record in %s (run aborted?)" % path)
    return last


def flatten(d, prefix=""):
    out = {}
    for k, v in d.items():
        key = prefix + k
        if isinstance(v, dict):
            out.update(flatten(v, key + "."))
        else:
            out[key] = v
    return out


def cmd_compare(args):
    a, b = load_summary(args.a), load_summary(args.b)
    for name, s in (("A", a), ("B", b)):
        print("%s: %s  %s  config %s%s" % (name, s["workload"], s.get("label") or "", s["config_hash"],
                                          "" if s["valid"] else "  [INVALID]"))
        if "watts" in s:
            legacy = "" if s.get("method") else "  (legacy gauge run; +/- is the old step bound)"
            print("   %.3f W +/- %.3f   (%d min, %.0f%% -> %.0f%%, %s)%s" % (
                s["watts"], s["error_w"], round(s["window_s"] / 60), s["capacity_start"] or 0,
                s["capacity_end"] or 0, s.get("method", "gauge"), legacy))
        if "gauge_watts" in s:
            print("   gauge cross-check: " + fmt_gauge(s))
    if "watts" in a and "watts" in b:
        d = b["watts"] - a["watts"]
        err = math.hypot(a["error_w"], b["error_w"])
        pct = 100.0 * d / a["watts"] if a["watts"] else 0.0
        print("\nB - A = %+.3f W (%+.1f%%), combined standard error +/-%.3f W" % (d, pct, err))
        print("verdict: " + ("difference exceeds 2x the combined standard error" if abs(d) > 2 * err
                             else "within 2x the combined standard error; not a distinguishable change"))
        if a["workload"] != b["workload"]:
            print("warning: different workloads (%s vs %s)" % (a["workload"], b["workload"]))
    fa, fb = flatten(a.get("config", {})), flatten(b.get("config", {}))
    diffs = [(k, fa.get(k), fb.get(k)) for k in sorted(set(fa) | set(fb)) if fa.get(k) != fb.get(k)]
    print("\nconfig differences:" + (" none" if not diffs else ""))
    for k, x, y in diffs:
        print("  %s: %s -> %s" % (k, x, y))
    for key, title in (("cpu_mean_khz", "mean cpu MHz"), ("cpuidle_residency_pct", "cpuidle residency %"),
                       ("rails_mean_w", "mean rails W (firmware)")):
        ka, kb = a.get(key) or {}, b.get(key) or {}
        if ka or kb:
            print("\n%s:" % title)
            for k in sorted(set(ka) | set(kb)):
                va, vb = ka.get(k), kb.get(k)
                f = (lambda v: "-" if v is None else ("%.0f" % (v / 1000) if key == "cpu_mean_khz"
                                                       else "%.2f" % v if key == "rails_mean_w" else "%.1f" % v))
                print("  %-12s %8s -> %8s" % (k, f(va), f(vb)))
    return 0


# --- main -------------------------------------------------------------------------------------


def reexec_inhibited():
    """Run under systemd-inhibit so hypridle neither dims, locks nor sleeps."""
    if os.environ.get("SL7_POWERTEST_INHIBITED") or ROOT:
        return
    exe = None
    for d in os.environ.get("PATH", "").split(":"):
        if os.access(os.path.join(d, "systemd-inhibit"), os.X_OK):
            exe = os.path.join(d, "systemd-inhibit")
            break
    if exe is None:
        print("warning: systemd-inhibit not found; the idle timer may dim or lock the screen", file=sys.stderr)
        return
    os.environ["SL7_POWERTEST_INHIBITED"] = "1"
    os.execv(exe, [exe, "--what=idle:sleep", "--who=sl7-powertest", "--why=power measurement run",
                   sys.executable, os.path.abspath(__file__)] + sys.argv[1:])


def main():
    ap = argparse.ArgumentParser(prog="sl7-powertest", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def common(sp):
        sp.add_argument("--minutes", type=float, default=20.0, help="run length (default 20)")
        sp.add_argument("--brightness", type=int, default=30, metavar="PCT",
                        help="backlight percent held for the run (default 30)")
        sp.add_argument("--label", help="tag for the file name, e.g. before / after")
        sp.add_argument("--rails", action="store_true",
                        help="also log the firmware power rails (hwmon qcom_pld_power) if present")
        sp.add_argument("--gauge-sync", action="store_true",
                        help="start and stop the clock on an energy_now step (only for fine steps; "
                             "can wait up to 300 s and abort with whole-percent firmware)")
        sp.add_argument("--sample", type=float, default=2.0, help=argparse.SUPPRESS)

    sp = sub.add_parser("idle", help="idle desktop")
    common(sp)
    sp = sub.add_parser("video", help="loop a video file in mpv")
    sp.add_argument("file")
    common(sp)
    sp.add_argument("--hwdec", default="no", help="mpv --hwdec value (default no)")
    sp.add_argument("--windowed", action="store_true", help="do not use fullscreen")
    sp.add_argument("mpv_args", nargs="*", help="extra mpv arguments (after --)")
    sub.add_parser("suspend", help="print the suspend measurement procedure")
    sp = sub.add_parser("compare", help="compare two runs")
    sp.add_argument("a")
    sp.add_argument("b")
    args = ap.parse_args()

    if args.cmd == "suspend":
        return cmd_suspend(args)
    if args.cmd == "compare":
        return cmd_compare(args)
    if not 1 <= args.brightness <= 100:
        sys.exit("sl7-powertest: --brightness must be 1-100")
    if args.cmd == "video" and not os.path.isfile(args.file):
        sys.exit("sl7-powertest: no such file: %s" % args.file)
    reexec_inhibited()
    return workload_run(args, args.cmd, Mpv(args) if args.cmd == "video" else None)


if __name__ == "__main__":
    sys.exit(main())
