#!/usr/bin/env python3
"""Build a libcamera software-ISP tuning file for the Surface Laptop 7 front
camera (OmniVision OV02C10) from Microsoft's own tuning, on this machine.

Microsoft's driver package for the SL7 carries the camera tuning as a Qualcomm
Chromatix binary, com.surface.tuned.ffc_ov02c10.bin. That file is Microsoft's and
is never part of this package or this repository. This tool reads the copy you
downloaded, takes the colour correction matrices (CCMs) and the colour
temperature ranges they apply to, softens them toward identity (--blend) and
writes /etc/libcamera/ipa/simple/ov02c10.yaml, which libcamera's software ISP
reads for the "ov02c10" sensor. Nothing leaves the machine.

How the binary is read (the file has no public documentation, so this is
pattern based and validated, and the tool refuses when anything is off):
  * a CCM is 12 consecutive little-endian float32 values: nine matrix entries
    (row major) and three zero offsets. Each row sums to 1 (white stays white),
    every value is within +-4 and the diagonal is positive;
  * the CCMs of one illuminant set sit back to back, 48 bytes apart, one per
    colour temperature range, lowest temperature first;
  * the ranges are stored just in front of the first matrix as 24-byte records
    (low K float32, high K float32, 0, id, flag, id). A set is accepted only if
    the ranges form an increasing chain from about 1 K to at least 8000 K with
    exactly one range per matrix. Between two ranges Chromatix interpolates
    linearly from one matrix to the next; this tool reproduces that by emitting
    the matrix at both ends of its range, because libcamera interpolates
    between its entries by colour temperature and holds the end values.
"""
import argparse
import glob
import hashlib
import math
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile

PROG = os.path.basename(sys.argv[0])
BIN_NAME = "com.surface.tuned.ffc_ov02c10.bin"
KNOWN_SHA256 = {
    "5a66898fa9fb1273776e509186e24847acda2de48911c8097459503b669d665b": "Surface Laptop 7 driver MSI 26.053.36539.0",
}
CACHE_DIR = "/var/lib/omarchy-surface-sl7/camera"
OUTPUT = "/etc/libcamera/ipa/simple/ov02c10.yaml"
IPA_SO = "/usr/lib/libcamera/ipa/ipa_soft_simple.so"
MARKER = "# Generated by sl7-camera-tuning"

REC = 48
TRIG = 24


def die(msg, code=1):
    print("%s: %s" % (PROG, msg), file=sys.stderr)
    sys.exit(code)


QUIET = False


def info(msg):
    """Progress output; silenced by --quiet (warnings and errors are not)."""
    if not QUIET:
        print(msg)


def warn(msg):
    print("%s: warning: %s" % (PROG, msg), file=sys.stderr)


# --------------------------------------------------------------------------
# Chromatix parsing
# --------------------------------------------------------------------------

def f32(buf, off):
    return struct.unpack_from("<f", buf, off)[0]


def find_ccms(buf):
    """All (offset, 9 floats) that look like a CCM followed by a zero offset."""
    pat = re.compile(rb"(?s)(?=.{3}[\x3f\x40].{15}[\x3f\x40].{15}[\x3f\x40]\x00{12})")
    out = []
    for m in pat.finditer(buf):
        off = m.start()
        v = struct.unpack_from("<12f", buf, off)
        if not all(math.isfinite(x) and abs(x) < 4.0 for x in v):
            continue
        if v[9] or v[10] or v[11]:
            continue
        if not (v[0] > 0.5 and v[4] > 0.5 and v[8] > 0.5):
            continue
        if any(abs(sum(v[i:i + 3]) - 1.0) > 0.02 for i in (0, 3, 6)):
            continue
        if all(abs(v[i] - 1.0) < 1e-3 for i in (0, 4, 8)):
            continue
        out.append((off, v[:9]))
    return out


def runs(ccms):
    """Groups of three or more matrices stored back to back."""
    res = []
    for off, m in ccms:
        if res and off - res[-1][-1][0] == REC:
            res[-1].append((off, m))
        else:
            res.append([(off, m)])
    return [r for r in res if len(r) >= 3]


def trigger_ranges(buf, start, n):
    """The colour-temperature ranges stored in front of a run of n matrices.

    Returns the maximal increasing chain of (lo, hi) records that ends at the
    run, or None unless it starts near 1 K, ends above 8000 K and has exactly n
    members (one matrix per range).
    """
    recs = []
    off = start - TRIG
    while off >= 0 and len(recs) < 32:
        lo, hi = f32(buf, off), f32(buf, off + 4)
        z = struct.unpack_from("<I", buf, off + 8)[0]
        if z != 0 or not (math.isfinite(lo) and math.isfinite(hi)) or not (0.0 < lo < hi <= 100000.0):
            break
        recs.append((lo, hi))
        off -= TRIG
    recs.reverse()
    chain = recs[-1:]
    for rec in reversed(recs[:-1]):
        if rec[1] <= chain[0][0]:
            chain.insert(0, rec)
        else:
            break
    if len(chain) != n or chain[0][0] > 10.0 or chain[-1][1] < 8000.0:
        return None
    return chain


def parse_sets(buf):
    """Validated illuminant sets: [{offset, ranges, ccms}], in file order."""
    sets = []
    for r in runs(find_ccms(buf)):
        rng = trigger_ranges(buf, r[0][0], len(r))
        if rng is None:
            continue
        sets.append({"offset": r[0][0], "ranges": rng, "ccms": [m for _o, m in r]})
    return sets


# --------------------------------------------------------------------------
# Tuning file
# --------------------------------------------------------------------------

def blend_ccm(m, b):
    ident = (1, 0, 0, 0, 1, 0, 0, 0, 1)
    return [b * x + (1.0 - b) * i for x, i in zip(m, ident)]


def ct_entries(sset, blend):
    """(ct, ccm) pairs reproducing Chromatix's flat-then-interpolate behaviour."""
    pts = []
    last = len(sset["ccms"]) - 1
    for i, ((lo, hi), m) in enumerate(zip(sset["ranges"], sset["ccms"])):
        mm = blend_ccm(m, blend)
        if i > 0:
            pts.append((int(round(lo)), mm))
        if i < last:
            pts.append((int(round(hi)), mm))
    pts.sort(key=lambda p: p[0])
    for (a, _x), (b, _y) in zip(pts, pts[1:]):
        if a == b:
            die("two matrices share colour temperature %d K; refusing" % a)
    return pts


def render(sset, blend, black_level, contrast, saturation, meta):
    lines = [
        MARKER,
        "# Derived on this machine from Microsoft's tuning for the Surface Laptop 7 camera.",
        "# Do not redistribute. Regenerate with: sudo sl7-camera-tuning [--blend X] [--set N] [--contrast X] [--saturation X]",
        "# sl7-camera-tuning: set=%d blend=%.2f source-sha256=%s" % (meta["set"], blend, meta["sha256"]),
        "%YAML 1.1",
        "---",
        "version: 1",
        "algorithms:",
    ]
    if black_level is not None:
        lines += ["  - BlackLevel:", "      blackLevel: %d" % black_level]
    else:
        lines += ["  - BlackLevel:"]
    lines += ["  - Awb:", "  - Ccm:", "      ccms:"]
    for ct, m in ct_entries(sset, blend):
        lines.append("        - ct: %d" % ct)
        lines.append("          ccm: [ %s," % ", ".join("%.6f" % x for x in m[0:3]))
        lines.append("                 %s," % ", ".join("%.6f" % x for x in m[3:6]))
        lines.append("                 %s ]" % ", ".join("%.6f" % x for x in m[6:9]))
    lines += ["  - Adjust:", "      contrast: %.2f" % contrast, "      saturation: %.2f" % saturation]
    lines += ["  - Agc:", "..."]
    return "\n".join(lines) + "\n"


# --------------------------------------------------------------------------
# Locating the Microsoft file
# --------------------------------------------------------------------------

def sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def extract_from_msi(msi, tmp):
    if shutil.which("msiextract") is None:
        die("msiextract not found; install msitools (pacman -S msitools)")
    info("Extracting %s (this takes a minute)" % msi)
    subprocess.run(["msiextract", "-C", tmp, msi], check=True, stdout=subprocess.DEVNULL)
    found = []
    for root, _dirs, files in os.walk(tmp):
        if BIN_NAME in files:
            found.append(os.path.join(root, BIN_NAME))
    if not found:
        die("%s is not in the MSI; is this the Surface Laptop 7 driver package?" % BIN_NAME)
    return sorted(found)[0]


def msi_candidates():
    homes = [os.getcwd()]
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user:
        homes.append(os.path.expanduser("~" + sudo_user + "/Downloads"))
    homes.append(os.path.expanduser("~/Downloads"))
    out = []
    for d in homes:
        out += glob.glob(os.path.join(d, "SurfaceLaptop7*.msi"))
    return out


def cache_copy(src):
    dst = os.path.join(CACHE_DIR, BIN_NAME)
    if os.path.abspath(src) == dst:
        return
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        shutil.copyfile(src, dst + ".new")
        os.chmod(dst + ".new", 0o644)
        os.replace(dst + ".new", dst)
        info("Kept a local copy: %s" % dst)
    except OSError as e:
        warn("could not keep a local copy in %s: %s" % (CACHE_DIR, e))


# --------------------------------------------------------------------------
# Actions
# --------------------------------------------------------------------------

def helper_present():
    try:
        with open(IPA_SO, "rb") as f:
            return b"ov02c10" in f.read()
    except OSError:
        return None


def status(out):
    print("Tuning file: %s" % out)
    if not os.path.exists(out):
        print("  not installed (libcamera uses uncalibrated.yaml: no colour correction)")
    else:
        with open(out) as f:
            text = f.read()
        if MARKER not in text:
            print("  present, but not written by %s" % PROG)
        else:
            m = re.search(r"# sl7-camera-tuning: set=(\d+) blend=([0-9.]+) source-sha256=([0-9a-f]+)", text)
            if m:
                print("  written by %s: set %s, blend %s" % (PROG, m.group(1), m.group(2)))
                print("  source: %s" % KNOWN_SHA256.get(m.group(3), "unrecognised driver package (%s...)" % m.group(3)[:12]))
    cached = os.path.join(CACHE_DIR, BIN_NAME)
    print("Local copy of Microsoft's file: %s" % ("present (%s)" % cached if os.path.exists(cached) else "absent"))
    h = helper_present()
    if h is None:
        print("libcamera software ISP module: not found (%s)" % IPA_SO)
    elif h:
        print("OV02C10 sensor helper in libcamera: present")
    else:
        print("OV02C10 sensor helper in libcamera: MISSING (install libcamera 0.7.2-4.1 or later from the omarchy-sl7 repository)")
    return 0


def remove(out, force, purge):
    if os.path.exists(out):
        with open(out) as f:
            ours = MARKER in f.read()
        if not ours and not force:
            die("%s was not written by %s; use --force to remove it anyway" % (out, PROG))
        os.remove(out)
        print("Removed %s" % out)
        orig = out + ".orig"
        if os.path.exists(orig):
            os.replace(orig, out)
            print("Restored %s" % out)
    else:
        print("Nothing to remove: %s does not exist" % out)
    if purge:
        cached = os.path.join(CACHE_DIR, BIN_NAME)
        if os.path.exists(cached):
            os.remove(cached)
            print("Removed %s" % cached)
    print("Restart the camera users: systemctl --user restart pipewire wireplumber")
    return 0


def load_sets(args, tmp):
    src = None
    if args.bin:
        src = args.bin
    elif args.from_msi:
        src = extract_from_msi(args.from_msi, tmp)
    else:
        cached = os.path.join(CACHE_DIR, BIN_NAME)
        if os.path.exists(cached):
            src = cached
        else:
            msis = msi_candidates()
            if msis:
                src = extract_from_msi(msis[0], tmp)
    if src is None:
        die("no Microsoft tuning file found. Download the Surface Laptop 7 driver MSI "
            "(see omarchy-surface-sl7-firmware --help) and run: sudo %s --from-msi FILE.msi" % PROG)
    if not os.path.isfile(src):
        die("%s not found" % src)
    size = os.path.getsize(src)
    if not (1 << 20) <= size <= (64 << 20):
        die("%s has an unexpected size (%d bytes); refusing" % (src, size))
    digest = sha256_of(src)
    if digest in KNOWN_SHA256:
        info("Source: %s (%s)" % (src, KNOWN_SHA256[digest]))
    else:
        warn("%s is not the driver package this tool was written against (sha256 %s); "
             "the content is validated below, check the result" % (src, digest))
    with open(src, "rb") as f:
        buf = f.read()
    sets = parse_sets(buf)
    if not sets:
        die("no valid colour correction sets found in %s; refusing to write anything" % src)
    return src, digest, sets


def describe(sets):
    for i, s in enumerate(sets, 1):
        print("Set %d (file offset %d): %d colour temperature ranges" % (i, s["offset"], len(s["ranges"])))
        for (lo, hi), m in zip(s["ranges"], s["ccms"]):
            print("   %6.0f-%6.0f K   [%s]" % (lo, hi, " ".join("%7.4f" % x for x in m)))


def main():
    ap = argparse.ArgumentParser(
        prog=PROG,
        description="Write a libcamera tuning file for the Surface Laptop 7 front camera from Microsoft's "
                    "driver package, on this machine. Needs root, except with --dry-run, --list and --status.")
    ap.add_argument("--blend", type=float, default=0.6, metavar="X",
                    help="strength of Microsoft's matrices, 0 (none) to 1 (full); default 0.6 (chosen on the SL7)")
    ap.add_argument("--set", type=int, default=1, metavar="N",
                    help="which illuminant set to use (see --list); default 1")
    ap.add_argument("--black-level", type=int, default=None, metavar="N",
                    help="override the black level, 16-bit scale (4096 = 64 of 1023); default: the libcamera sensor helper's")
    ap.add_argument("--contrast", type=float, default=1.2, metavar="X",
                    help="default contrast, 0 to 2 (1 = none); needs libcamera 0.7.2-4.2 or later, "
                         "applications can still override it; default 1.2")
    ap.add_argument("--saturation", type=float, default=1.05, metavar="X",
                    help="default saturation, 0 to 2 (1 = none); needs libcamera 0.7.2-4.2 or later, "
                         "applications can still override it; default 1.05 (chosen on the SL7)")
    ap.add_argument("--bin", metavar="FILE", help="the extracted %s" % BIN_NAME)
    ap.add_argument("--from-msi", metavar="FILE", help="the Surface Laptop 7 driver MSI (needs msitools)")
    ap.add_argument("--if-missing", action="store_true",
                    help="do nothing (exit 0, one log line) if the tuning file already exists, so a file you "
                         "tuned or wrote is never overwritten; used by the package scriptlet and the firmware installer")
    ap.add_argument("--quiet", action="store_true",
                    help="print only warnings and errors (with --if-missing the skip line is silenced too)")
    ap.add_argument("--list", action="store_true", help="print the sets found, with their matrices, and exit")
    ap.add_argument("--dry-run", action="store_true", help="print the tuning file instead of writing it")
    ap.add_argument("--status", action="store_true", help="show what is installed")
    ap.add_argument("--remove", action="store_true", help="remove the tuning file (libcamera falls back to its defaults)")
    ap.add_argument("--purge", action="store_true", help="with --remove: also delete the kept copy of Microsoft's file")
    ap.add_argument("--force", action="store_true", help="overwrite or remove a tuning file not written by this tool")
    ap.add_argument("--output", default=OUTPUT, metavar="FILE", help="tuning file to write (default %s)" % OUTPUT)
    args = ap.parse_args()
    global QUIET
    QUIET = args.quiet

    if not (0.0 <= args.blend <= 1.0):
        die("--blend must be between 0 and 1")
    if not (0.0 <= args.contrast <= 2.0):
        die("--contrast must be between 0 and 2")
    if not (0.0 <= args.saturation <= 2.0):
        die("--saturation must be between 0 and 2")
    if args.black_level is not None and not (0 <= args.black_level <= 32767):
        die("--black-level must be between 0 and 32767")

    if args.status:
        return status(args.output)
    readonly = args.list or args.dry_run
    if args.if_missing and not (readonly or args.remove) and os.path.exists(args.output):
        info("%s: %s already exists; leaving it alone" % (PROG, args.output))
        return 0
    if os.geteuid() != 0 and not readonly:
        die("run as root (sudo %s ...), or use --dry-run / --list / --status" % PROG)
    if args.remove:
        return remove(args.output, args.force, args.purge)

    with tempfile.TemporaryDirectory(prefix=PROG + ".", dir=os.environ.get("TMPDIR", "/var/tmp")) as tmp:
        src, digest, sets = load_sets(args, tmp)
        if args.list:
            describe(sets)
            return 0
        if not (1 <= args.set <= len(sets)):
            die("--set must be between 1 and %d" % len(sets))
        text = render(sets[args.set - 1], args.blend, args.black_level, args.contrast, args.saturation,
                      {"set": args.set, "sha256": digest})
        if args.dry_run:
            print("--- would write %s ---" % args.output)
            sys.stdout.write(text)
            return 0
        if os.path.exists(args.output):
            with open(args.output) as f:
                ours = MARKER in f.read()
            if not ours:
                if not args.force:
                    die("%s exists and was not written by %s; use --force to replace it (the old file is kept as .orig)"
                        % (args.output, PROG))
                shutil.copyfile(args.output, args.output + ".orig")
        os.makedirs(os.path.dirname(args.output), exist_ok=True)
        with open(args.output + ".new", "w") as f:
            f.write(text)
        os.chmod(args.output + ".new", 0o644)
        os.replace(args.output + ".new", args.output)
        info("Wrote %s (set %d, blend %.2f)" % (args.output, args.set, args.blend))
        cache_copy(src)

    if helper_present() is False:
        warn("the installed libcamera has no OV02C10 sensor helper; install libcamera 0.7.2-4.1 or later "
             "from the omarchy-sl7 repository (sudo pacman -Syu)")
    info("Restart the camera users so they reload it: systemctl --user restart pipewire wireplumber")
    info("Check the result with: sl7-camera-check")
    return 0


if __name__ == "__main__":
    sys.exit(main())
