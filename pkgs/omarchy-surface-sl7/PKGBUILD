            '0c78d78e67521251e605b019edd1f42e8452cdee4705a6818670f165f43d611a')

package() {
  local lib="$pkgdir/usr/lib/omarchy-surface-sl7"

  # 1. initramfs: modules + firmware hook
  install -Dm644 zz-omarchy-surface-sl7.conf \
    "$pkgdir/etc/mkinitcpio.conf.d/zz-omarchy-surface-sl7.conf"
  install -Dm644 sl7-firmware "$pkgdir/usr/lib/initcpio/install/sl7-firmware"

  # 2. neutralise Omarchy's x86 Surface keyboard module list
  install -Dm755 neutralize-surface-keyboard "$lib/neutralize-surface-keyboard"
  install -Dm644 70-omarchy-surface-sl7-keyboard.hook \
    "$pkgdir/usr/share/libalpm/hooks/70-omarchy-surface-sl7-keyboard.hook"

  # 2b. ...and again at boot: omarchy-apply-hardware regenerates the file after
  # our pacman hook has run during install (idempotent, skipped when absent)
  install -Dm644 omarchy-surface-sl7-neutralize.service \
    "$pkgdir/usr/lib/systemd/system/omarchy-surface-sl7-neutralize.service"
  install -dm755 "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
  ln -s ../omarchy-surface-sl7-neutralize.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/omarchy-surface-sl7-neutralize.service"

  # 2c. Wi-Fi: WCN7850 board-2.bin override carrying the SL7 board names.
  # ath12k-bdencoder: qca-swiss-army-knife @ 6df4dae (ISC), vendored unmodified.
  install -Dm755 ath12k-board-update "$lib/ath12k-board-update"
  install -Dm755 sl7-ath12k-board "$lib/sl7-ath12k-board"
  install -Dm755 ath12k-bdencoder "$lib/ath12k-bdencoder"
  install -Dm644 60-omarchy-surface-sl7-ath12k.hook \
    "$pkgdir/usr/share/libalpm/hooks/60-omarchy-surface-sl7-ath12k.hook"
  install -Dm644 LICENSE.ath12k-bdencoder \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.ath12k-bdencoder"

  # 3. kernel command line, UKI, device trees
  install -Dm644 omarchy-surface-sl7.limine.conf \
    "$pkgdir/etc/limine-entry-tool.d/omarchy-surface-sl7.conf"
  install -Dm755 update-uki-dtbs "$lib/update-uki-dtbs"
  install -Dm755 set-boot-order "$lib/set-boot-order"
  install -Dm755 sl7-doctor "$pkgdir/usr/bin/sl7-doctor"
  install -Dm644 85-omarchy-surface-sl7-dtbs.hook \
    "$pkgdir/usr/share/libalpm/hooks/85-omarchy-surface-sl7-dtbs.hook"

  # 4. touch: restart iptsd@ after resume
  install -Dm755 restart-iptsd "$lib/restart-iptsd"
  # boot-settle safety net: re-enable multitouch once after boot
  install -Dm644 omarchy-surface-sl7-touch-settle.service \
    "$pkgdir/usr/lib/systemd/system/omarchy-surface-sl7-touch-settle.service"
  install -Dm644 omarchy-surface-sl7-touch-settle.timer \
    "$pkgdir/usr/lib/systemd/system/omarchy-surface-sl7-touch-settle.timer"
  install -dm755 "$pkgdir/usr/lib/systemd/system/timers.target.wants"
  ln -s ../omarchy-surface-sl7-touch-settle.timer \
    "$pkgdir/usr/lib/systemd/system/timers.target.wants/omarchy-surface-sl7-touch-settle.timer"
  install -Dm755 omarchy-surface-sl7-system-sleep \
    "$pkgdir/usr/lib/systemd/system-sleep/omarchy-surface-sl7"

  # 5. factory Wi-Fi/Bluetooth MAC (valeronm/sl7-mac, MIT)
  local mac="$srcdir/sl7-mac-$_slmac_commit"
  install -Dm755 "$mac/sl7-mac" "$pkgdir/usr/bin/sl7-mac"
  install -Dm755 "$mac/mgmt-set-addr.py" "$pkgdir/usr/lib/sl7-mac/mgmt-set-addr.py"
  install -Dm644 "$mac/sl7-wifi-mac.service" \
    "$pkgdir/usr/lib/systemd/system/sl7-wifi-mac.service"
  install -Dm644 "$mac/sl7-bt-mac.service" \
    "$pkgdir/usr/lib/systemd/system/sl7-bt-mac.service"
  install -Dm644 "$mac/99-sl7-bt-mac.rules" \
    "$pkgdir/usr/lib/udev/rules.d/99-sl7-bt-mac.rules"
  install -Dm644 "$mac/sl7-mac.1" "$pkgdir/usr/share/man/man1/sl7-mac.1"
  install -Dm644 "$mac/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.sl7-mac"
  # Enabled by default; mask the two units to opt out (see README).
  install -dm755 "$pkgdir/usr/lib/systemd/system/sysinit.target.wants"
  ln -s ../sl7-wifi-mac.service \
    "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/sl7-wifi-mac.service"

  # 6. audio safety: no Pro Audio on the speaker card
  install -Dm644 50-omarchy-surface-sl7-wireplumber.conf \
    "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/50-omarchy-surface-sl7.conf"
  install -Dm644 guard-pro-audio.lua \
    "$pkgdir/usr/share/wireplumber/scripts/omarchy-surface-sl7/guard-pro-audio.lua"

  # 7. firmware installer (no firmware in this package)
  install -Dm755 omarchy-surface-sl7-firmware "$pkgdir/usr/bin/omarchy-surface-sl7-firmware"

  # 8. power
  install -Dm644 99-omarchy-surface-sl7-power.rules \
    "$pkgdir/usr/lib/udev/rules.d/99-omarchy-surface-sl7-power.rules"
  install -Dm755 power-event "$lib/power-event"
  install -Dm755 omarchy-surface-sl7-power "$pkgdir/usr/bin/omarchy-surface-sl7-power"

  # 8b. AC/battery power mode: root part (udev via power-event, boot, resume),
  # user part (Hyprland watcher, enabled for graphical-session.target), config
  install -Dm755 omarchy-sl7-powermode "$pkgdir/usr/bin/omarchy-sl7-powermode"
  install -Dm644 power.conf "$pkgdir/etc/omarchy-surface-sl7/power.conf"
  install -Dm644 omarchy-surface-sl7-powermode.service \
    "$pkgdir/usr/lib/systemd/system/omarchy-surface-sl7-powermode.service"
  ln -s ../omarchy-surface-sl7-powermode.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/omarchy-surface-sl7-powermode.service"
  install -Dm644 omarchy-sl7-powermode.user.service \
    "$pkgdir/usr/lib/systemd/user/omarchy-sl7-powermode.service"
  install -dm755 "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants"
  ln -s ../omarchy-sl7-powermode.service \
    "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/omarchy-sl7-powermode.service"

  # 8b2. touchpad defaults: tap-to-click off, appended once per user to
  # ~/.config/hypr/input.lua by a user service (new and existing installs)
  install -Dm755 omarchy-sl7-touchpad-defaults "$pkgdir/usr/bin/omarchy-sl7-touchpad-defaults"
  install -Dm644 omarchy-sl7-touchpad-defaults.user.service \
    "$pkgdir/usr/lib/systemd/user/omarchy-sl7-touchpad-defaults.service"
  ln -s ../omarchy-sl7-touchpad-defaults.service \
    "$pkgdir/usr/lib/systemd/user/graphical-session.target.wants/omarchy-sl7-touchpad-defaults.service"

  # 8c. measurement harness
  install -Dm755 sl7-powertest "$pkgdir/usr/bin/sl7-powertest"

  # 8d. optional kernel test boot entries (PSR: known broken, VRR: experimental;
  # disabled until `omarchy-sl7-test-entry enable NAME`): the post hook
  # re-creates them after limine-entry-tool rewrites limine.conf.
  # omarchy-sl7-psr-entry is a wrapper kept for the old command name.
  install -Dm755 omarchy-sl7-test-entry "$pkgdir/usr/bin/omarchy-sl7-test-entry"
  install -Dm755 omarchy-sl7-psr-entry "$pkgdir/usr/bin/omarchy-sl7-psr-entry"
  install -Dm755 80-omarchy-sl7-test-entry.post-hook \
    "$pkgdir/etc/boot/hooks/post.d/80-omarchy-sl7-test-entry"

  # 8e. camera Phase A probe (read-only; --sweep-mclk only changes a module parameter)
  install -Dm755 sl7-ir-probe "$pkgdir/usr/bin/sl7-ir-probe"

  # 9. omarchy-sl7 package repository: config, the script that keeps it Included
  # above [core]/[alarm]/[omarchy], its pacman hook and boot service, and the
  # `omarchy refresh pacman` hook (Omarchy reads hooks only from
  # ~/.config/omarchy/hooks, so it goes to /etc/skel and, via
  # omarchy-sl7-repo-ensure --provision-users, to existing users).
  install -Dm644 omarchy-sl7.conf "$pkgdir/etc/pacman.d/omarchy-sl7.conf"
  install -Dm755 omarchy-sl7-repo-ensure "$pkgdir/usr/bin/omarchy-sl7-repo-ensure"
  install -Dm644 80-omarchy-sl7-repo.hook \
    "$pkgdir/usr/share/libalpm/hooks/80-omarchy-sl7-repo.hook"
  install -Dm644 omarchy-sl7-repo.service \
    "$pkgdir/usr/lib/systemd/system/omarchy-sl7-repo.service"
  ln -s ../omarchy-sl7-repo.service \
    "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/omarchy-sl7-repo.service"
  install -Dm755 10-omarchy-sl7-repo \
    "$pkgdir/usr/share/$pkgname/pre-refresh-pacman.d/10-omarchy-sl7-repo"
  install -Dm755 10-omarchy-sl7-repo \
    "$pkgdir/etc/skel/.config/omarchy/hooks/pre-refresh-pacman.d/10-omarchy-sl7-repo"

  # 9b. TEMPORARY: qcom-battmgr battery for Omarchy's BAT*-only scripts
  # (omacom/omarchy#13029). Drop with the hook when that merges.
  install -Dm755 omarchy-sl7-battery-patch "$lib/omarchy-sl7-battery-patch"
  install -Dm644 82-omarchy-sl7-battery.hook \
    "$pkgdir/usr/share/libalpm/hooks/82-omarchy-sl7-battery.hook"

  # 10. reference copy of the upstreamable Omarchy hardware leaf
  install -Dm644 surface-laptop-7.sh \
    "$pkgdir/usr/share/doc/$pkgname/upstream/install/hardware/microsoft/surface-laptop-7.sh"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
