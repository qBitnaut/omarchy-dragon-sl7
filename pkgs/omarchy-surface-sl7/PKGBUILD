package() {
  local lib="$pkgdir/usr/lib/omarchy-surface-sl7"

  # 1. initramfs: modules + firmware hook
  install -Dm644 zz-omarchy-surface-sl7.conf \
    "$pkgdir/etc/mkinitcpio.conf.d/zz-omarchy-surface-sl7.conf"
  install -Dm644 sl7-firmware "$pkgdir/usr/lib/initcpio/install/sl7-firmware"

  # 2. neutralise Omarchy's x86 Surface keyboard module list
  install -Dm755 neutralize-surface-keyboard "$lib/neutralize-surface-keyboard"
  install -Dm644 70-omarchy-surface-sl7-keyboard.hook \
    "$pkgdir/usr/share/libalpm/hooks/70-omarchy-surface-sl7-keyboard.hook"

  # 3. kernel command line, UKI, device trees
  install -Dm644 omarchy-surface-sl7.limine.conf \
    "$pkgdir/etc/limine-entry-tool.d/omarchy-surface-sl7.conf"
  install -Dm755 update-uki-dtbs "$lib/update-uki-dtbs"
  install -Dm644 85-omarchy-surface-sl7-dtbs.hook \
    "$pkgdir/usr/share/libalpm/hooks/85-omarchy-surface-sl7-dtbs.hook"

  # 4. touch: restart iptsd@ after resume
  install -Dm755 restart-iptsd "$lib/restart-iptsd"
  install -Dm755 omarchy-surface-sl7-system-sleep \
    "$pkgdir/usr/lib/systemd/system-sleep/omarchy-surface-sl7"

  # 5. factory Wi-Fi/Bluetooth MAC (valeronm/sl7-mac, MIT)
  local mac="$srcdir/sl7-mac-$_slmac_commit"
  install -Dm755 "$mac/sl7-mac" "$pkgdir/usr/bin/sl7-mac"
  install -Dm755 "$mac/mgmt-set-addr.py" "$pkgdir/usr/lib/sl7-mac/mgmt-set-addr.py"
  install -Dm644 "$mac/sl7-wifi-mac.service" \
    "$pkgdir/usr/lib/systemd/system/sl7-wifi-mac.service"
  install -Dm644 "$mac/sl7-bt-mac.service" \
    "$pkgdir/usr/lib/systemd/system/sl7-bt-mac.service"
  install -Dm644 "$mac/99-sl7-bt-mac.rules" \
    "$pkgdir/usr/lib/udev/rules.d/99-sl7-bt-mac.rules"
  install -Dm644 "$mac/sl7-mac.1" "$pkgdir/usr/share/man/man1/sl7-mac.1"
  install -Dm644 "$mac/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.sl7-mac"
  # Enabled by default; mask the two units to opt out (see README).
  install -dm755 "$pkgdir/usr/lib/systemd/system/sysinit.target.wants"
  ln -s ../sl7-wifi-mac.service \
    "$pkgdir/usr/lib/systemd/system/sysinit.target.wants/sl7-wifi-mac.service"

  # 6. audio safety: no Pro Audio on the speaker card
  install -Dm644 50-omarchy-surface-sl7-wireplumber.conf \
    "$pkgdir/usr/share/wireplumber/wireplumber.conf.d/50-omarchy-surface-sl7.conf"
  install -Dm644 guard-pro-audio.lua \
    "$pkgdir/usr/share/wireplumber/scripts/omarchy-surface-sl7/guard-pro-audio.lua"

  # 7. firmware installer (no firmware in this package)
  install -Dm755 omarchy-surface-sl7-firmware "$pkgdir/usr/bin/omarchy-surface-sl7-firmware"

  # 8. power
  install -Dm644 99-omarchy-surface-sl7-power.rules \
    "$pkgdir/usr/lib/udev/rules.d/99-omarchy-surface-sl7-power.rules"
  install -Dm755 power-event "$lib/power-event"
  install -Dm755 omarchy-surface-sl7-power "$pkgdir/usr/bin/omarchy-surface-sl7-power"

  # 9. reference copy of the upstreamable Omarchy hardware leaf
  install -Dm644 surface-laptop-7.sh \
    "$pkgdir/usr/share/doc/$pkgname/upstream/install/hardware/microsoft/surface-laptop-7.sh"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
