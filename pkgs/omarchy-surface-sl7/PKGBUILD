# Maintainer: Chris <19711592+qBitnaut@users.noreply.github.com>
#
# Omarchy add-on for the Microsoft Surface Laptop 7 (Snapdragon X, romulus13 /
# romulus15). Pure files, hooks and drop-ins: it works installed by pacman
# (pacstrap or later) and needs no change to Omarchy itself.

pkgname=omarchy-surface-sl7
pkgver=0.1.0
pkgrel=1
pkgdesc='Omarchy add-on for the Microsoft Surface Laptop 7 (Snapdragon X): initramfs, UKI device trees, touch resume, firmware installer'
arch=('aarch64')
url='https://github.com/qBitnaut/omarchy-dragon-sl7'
license=('MIT')
groups=('omarchy-platform-qualcomm')
depends=('omarchy' 'linux-sl7' 'iptsd-sl7' 'linux-firmware-qcom'
         'mkinitcpio' 'systemd' 'python' 'bash' 'coreutils' 'gawk' 'grep')
optdepends=('limine-mkinitcpio-hook: rebuilds the UKI and Limine entries (Omarchy default)'
            'msitools: --from-msi in omarchy-surface-sl7-firmware'
            'iw: opt-in Wi-Fi power save policy'
            'bluez-utils: bluetoothctl in sl7-mac status')
backup=('etc/mkinitcpio.conf.d/zz-omarchy-surface-sl7.conf'
        'etc/limine-entry-tool.d/omarchy-surface-sl7.conf')
install=omarchy-surface-sl7.install

# valeronm/sl7-mac (MIT): factory Wi-Fi/Bluetooth MAC from UEFI, pinned.
_slmac_commit=b0a562f27e79fc3dd35a0617eba1e96deee000d1  # 2026-07-21
source=("sl7-mac-$_slmac_commit.tar.gz::https://github.com/valeronm/sl7-mac/archive/$_slmac_commit.tar.gz"
        'zz-omarchy-surface-sl7.conf'
        'sl7-firmware'
        'omarchy-surface-sl7.limine.conf'
        '70-omarchy-surface-sl7-keyboard.hook'
        '85-omarchy-surface-sl7-dtbs.hook'
        'neutralize-surface-keyboard'
        'update-uki-dtbs'
        'omarchy-surface-sl7-system-sleep'
        'restart-iptsd'
        'omarchy-surface-sl7-firmware'
        '50-omarchy-surface-sl7-wireplumber.conf'
        'guard-pro-audio.lua'
        '99-omarchy-surface-sl7-power.rules'
        'power-event'
        'omarchy-surface-sl7-power'
        'LICENSE'
        'README.md'
        'surface-laptop-7.sh')
