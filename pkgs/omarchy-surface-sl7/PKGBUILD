        '80-omarchy-sl7-repo.hook'
        'omarchy-sl7-repo.service'
        '10-omarchy-sl7-repo'
        '82-omarchy-sl7-battery.hook'
        'omarchy-sl7-battery-patch'
        'omarchy-sl7-powermode'
