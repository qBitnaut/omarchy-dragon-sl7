# Maintainer: qBitnaut <19711592+qBitnaut@users.noreply.github.com>
#
# Omarchy add-on for the Microsoft Surface Laptop 7 (Snapdragon X, romulus13 /
# romulus15). Pure files, hooks and drop-ins: it works installed by pacman
# (pacstrap or later) and needs no change to Omarchy itself.

pkgname=omarchy-surface-sl7
pkgver=0.1.0
pkgrel=40
pkgdesc='Omarchy add-on for the Microsoft Surface Laptop 7 (Snapdragon X): initramfs, UKI device trees, touch resume, firmware installer'
arch=('aarch64')
url='https://github.com/qBitnaut/omarchy-dragon-sl7'
license=('MIT' 'ISC')
groups=('omarchy-platform-qualcomm')
depends=('omarchy' 'omarchy-sl7-keyring' 'linux-sl7>=7.2.8-3' 'iptsd-sl7>=3.1.0.r20260717-11' 'linux-firmware-qcom' 'linux-firmware-atheros' 'qcom-firmware-extract'
         'mkinitcpio' 'systemd' 'python' 'bash' 'jq' 'glib2' 'coreutils' 'gawk' 'grep')
optdepends=('limine-mkinitcpio-hook: rebuilds the UKI and Limine entries (Omarchy default)'
            'msitools: --from-msi in omarchy-surface-sl7-firmware'
            'iw: Wi-Fi power save on battery (omarchy-sl7-powermode) and the opt-in policy'
            'socat: omarchy-sl7-powermode re-applies 60 Hz after a Hyprland config reload'
            'brightnessctl: sl7-powertest pins the backlight'
            'mpv: sl7-powertest video'
            'bluez-utils: bluetoothctl in sl7-mac status'
            'v4l-utils: media-ctl and v4l2-ctl for sl7-ir-probe and sl7-ir-lab'
            'pciutils: lspci in sl7-sleepstats --trace'
            'libcamera-tools: cam and qcam to test the webcam'
            'pipewire-libcamera: the webcam in browsers and video calls'
            'gtk4: the sl7-ir-lab window'
            'python-gobject: the sl7-ir-lab window (PyGObject)'
            'python-cairo: the sl7-ir-lab live view and graph'
            'polkit: pkexec for sl7-ir-lab and the sl7-ir-emitter-test polkit action')
backup=('etc/mkinitcpio.conf.d/zz-omarchy-surface-sl7.conf'
        'etc/limine-entry-tool.d/omarchy-surface-sl7.conf'
        'etc/pacman.d/omarchy-sl7.conf'
        'etc/omarchy-surface-sl7/power.conf'
        'etc/omarchy-surface-sl7/usb-rpm.conf')
install=omarchy-surface-sl7.install

# valeronm/sl7-mac (MIT): factory Wi-Fi/Bluetooth MAC from UEFI, pinned.
_slmac_commit=b0a562f27e79fc3dd35a0617eba1e96deee000d1  # 2026-07-21
source=("sl7-mac-$_slmac_commit.tar.gz::https://github.com/valeronm/sl7-mac/archive/$_slmac_commit.tar.gz"
        'zz-omarchy-surface-sl7.conf'
        'sl7-firmware'
        'omarchy-surface-sl7.limine.conf'
        '70-omarchy-surface-sl7-keyboard.hook'
        '85-omarchy-surface-sl7-dtbs.hook'
        'neutralize-surface-keyboard'
        'omarchy-surface-sl7-neutralize.service'
        '60-omarchy-surface-sl7-ath12k.hook'
        'ath12k-board-update'
        'sl7-ath12k-board'
        'ath12k-bdencoder'
        'LICENSE.ath12k-bdencoder'
        'update-uki-dtbs'
