#!/bin/bash
# Power mode switcher for the Surface Laptop 7 (X1E, qcom-battmgr): the knobs follow the
# power source (AC or battery) and the power-profiles-daemon ActiveProfile.
#
#   omarchy-sl7-powermode [--system|--user] auto|battery|ac|status
#   omarchy-sl7-powermode --system watch   (root daemon, omarchy-surface-sl7-powermode.service)
#   omarchy-sl7-powermode watch            (user daemon, see omarchy-sl7-powermode.service)
#
# Levels, from (source, profile):
#   power-saver (either source)  saver   stricter caps (CPU_MAX_FREQ_POWERSAVER, GPU lowest,
#                                        optional parking, 60 Hz, no animations/blur)
#   performance (either source)  perf    uncapped, like AC
#   balanced / unknown / no PPD   battery on battery (today's caps), ac on AC (uncapped)
#
# System part (root; run by udev through power-event, at boot, after resume and by the
# watcher on a profile change): per-policy scaling_max_freq cap, GPU devfreq max_freq cap,
# Wi-Fi power save, platform profile, and cluster parking through sl7-park.
# User part (your session): eDP refresh rate, optionally animations and blur, through
# "hyprctl eval" at runtime only; monitors.lua is never touched. Without a flag, root runs
# the system part and anyone else the user part. Policy lives in
# /etc/omarchy-surface-sl7/power.conf.
#
# The script only READS the PPD profile; it never sets it. (Omarchy's shell runs
# omarchy-powerprofiles-set on UPower OnBattery changes, and sl7-batteryd may switch to
# power-saver at a low charge; PPD has no real backend on ARM, so the profile alone
# changes nothing until this script acts on it.)
set -u

conf=${OMARCHY_SL7_POWER_CONF:-/etc/omarchy-surface-sl7/power.conf}
ps=${OMARCHY_SL7_POWER_SUPPLY:-/sys/class/power_supply}
cpufreq=${OMARCHY_SL7_CPUFREQ:-/sys/devices/system/cpu/cpufreq}
devfreq=${OMARCHY_SL7_DEVFREQ:-/sys/class/devfreq}
netdir=${OMARCHY_SL7_NET:-/sys/class/net}
pp_class=${OMARCHY_SL7_PLATFORM_PROFILE_CLASS:-/sys/class/platform-profile}
pp_acpi=${OMARCHY_SL7_PLATFORM_PROFILE_ACPI:-/sys/firmware/acpi/platform_profile}
run_dir=${OMARCHY_SL7_RUN_DIR:-/run/omarchy-surface-sl7}
user_state=${OMARCHY_SL7_USER_STATE:-${XDG_RUNTIME_DIR:-/tmp}/omarchy-sl7-powermode}

# Defaults mirror power.conf.
ENABLE=yes
CPU_MAX_FREQ_BATTERY=2188800
GPU_MAX_FREQ_BATTERY=auto
WIFI_PS=yes
PLATFORM_PROFILE_BATTERY=low-power
PLATFORM_PROFILE_AC=balanced
REFRESH_ON_BATTERY=60
EDP_OUTPUT=eDP-1
DISABLE_ANIMATIONS_ON_BATTERY=no
DISABLE_BLUR_ON_BATTERY=no
HYPRLAND_VRR=1
PARK_ON_BATTERY=no
PROFILE_AWARE=yes
CPU_MAX_FREQ_POWERSAVER=1708800
GPU_MAX_FREQ_POWERSAVER=lowest
PARK_POWERSAVER=no
REFRESH_POWERSAVER=off
DISABLE_ANIMATIONS_POWERSAVER=yes
DISABLE_BLUR_POWERSAVER=yes
PLATFORM_PROFILE_PERFORMANCE=
park_cmd=${OMARCHY_SL7_PARK:-sl7-park}
cmdline=${OMARCHY_SL7_PROC_CMDLINE:-/proc/cmdline}
load_conf() {
  # shellcheck disable=SC1090
  [[ -r $conf ]] && . "$conf"
  return 0
}
load_conf

usage() {
  echo "usage: ${0##*/} [--system|--user] auto|battery|ac|status" >&2
  echo "       ${0##*/} [--system] watch" >&2
  exit 2
}

say() {
  echo "$*"
  [[ -t 1 ]] || logger -t omarchy-sl7-powermode -- "$*" 2>/dev/null || true
}

# --- power source ------------------------------------------------------------

# Prints "ac" or "battery". Any online Mains/USB supply means AC; with no
# readable source, fall back to the battery's own status.
detect_source() {
  local s have=0
  for s in "$ps"/*; do
    [[ -r $s/type && -r $s/online ]] || continue
    case $(<"$s/type") in
      Mains | USB*)
        have=1
        if [[ $(<"$s/online") == 1 ]]; then echo ac; return; fi
        ;;
    esac
  done
  if ((have)); then echo battery; return; fi
  for s in "$ps"/*; do
    [[ -r $s/type && -r $s/status ]] || continue
    if [[ $(<"$s/type") == Battery ]]; then
      if [[ $(<"$s/status") == Discharging ]]; then echo battery; else echo ac; fi
      return
    fi
  done
  echo ac
}

# --- power profile and level ---------------------------------------------------

# Prints the PPD ActiveProfile (power-saver, balanced, performance), or nothing when PPD
# is not running or PROFILE_AWARE is not yes. OMARCHY_SL7_PROFILE overrides it (tests).
detect_profile() {
  local dest path out
  [[ $PROFILE_AWARE == yes ]] || return 0
  if [[ -n ${OMARCHY_SL7_PROFILE+x} ]]; then
    echo "$OMARCHY_SL7_PROFILE"
    return 0
  fi
  command -v busctl >/dev/null 2>&1 || return 0
  for dest in org.freedesktop.UPower.PowerProfiles net.hadess.PowerProfiles; do
    path=/${dest//./\/}
    out=$(timeout 3 busctl --system get-property "$dest" "$path" "$dest" ActiveProfile 2>/dev/null) || continue
    out=${out#*\"}
    echo "${out%\"*}"
    return 0
  done
  return 0
}

# effective_level SOURCE PROFILE -> saver | perf | battery | ac
effective_level() {
  case ${2:-} in
    power-saver) echo saver ;;
    performance) echo perf ;;
    *) echo "$1" ;;
  esac
}

uncapped() { [[ $1 == ac || $1 == perf ]]; }

# CPU cap in kHz for a level, or nothing (leave the CPU alone / uncapped).
cpu_cap_khz() {
  case $1 in
    saver)
      if is_num "$CPU_MAX_FREQ_POWERSAVER"; then echo "$CPU_MAX_FREQ_POWERSAVER"; return 0; fi
      is_num "$CPU_MAX_FREQ_BATTERY" && echo "$CPU_MAX_FREQ_BATTERY"
      ;;
    battery)
      is_num "$CPU_MAX_FREQ_BATTERY" && echo "$CPU_MAX_FREQ_BATTERY"
      ;;
  esac
  return 0
}

# GPU cap in Hz for a level from the ascending frequency list in $2..; nothing = leave alone.
gpu_target() {
  local level=$1 v
  shift
  local -a fr=("$@")
  local n=${#fr[@]}
  ((n)) || return 0
  if uncapped "$level"; then
    echo "${fr[n - 1]}"
    return 0
  fi
  if [[ $level == saver ]]; then
    case $GPU_MAX_FREQ_POWERSAVER in
      lowest) echo "${fr[0]}"; return 0 ;;
      auto) echo "${fr[n / 2]}"; return 0 ;;
      '') ;;
      *) if is_num "$GPU_MAX_FREQ_POWERSAVER"; then echo "$GPU_MAX_FREQ_POWERSAVER"; return 0; fi ;;
    esac
  fi
  v=$GPU_MAX_FREQ_BATTERY
  case $v in
    '') return 0 ;;
    auto) echo "${fr[n / 2]}" ;;
    *) is_num "$v" && echo "$v" ;;
  esac
  return 0
}

# --- system part ---------------------------------------------------------------

# put FILE VALUE: write only when different. Returns 0 if written or equal.
put() {
  local f=$1 v=$2
  [[ -w $f ]] || { echo "cannot write $f" >&2; return 1; }
  [[ $(<"$f") == "$v" ]] && return 0
  if printf '%s\n' "$v" >"$f" 2>/dev/null; then
    say "set $f = $v"
  else
    echo "write failed: $f = $v" >&2
    return 1
  fi
}

is_num() { [[ ${1:-} =~ ^[0-9]+$ ]]; }

sys_cpu() { # level
  local pol min max cap want
  want=$(cpu_cap_khz "$1")
  for pol in "$cpufreq"/policy*; do
    [[ -r $pol/cpuinfo_max_freq && -w $pol/scaling_max_freq ]] || continue
    max=$(<"$pol/cpuinfo_max_freq")
    min=0
    [[ -r $pol/cpuinfo_min_freq ]] && min=$(<"$pol/cpuinfo_min_freq")
    cap=$max
    if ! uncapped "$1"; then
      [[ -n $want ]] || return 0
      cap=$want
      ((cap > max)) && cap=$max
      ((cap < min)) && cap=$min
    fi
    put "$pol/scaling_max_freq" "$cap" || true
  done
}

gpu_freqs() { # prints available frequencies, ascending, one per line
  tr -s ' \n' '\n\n' <"$1/available_frequencies" 2>/dev/null | grep -E '^[0-9]+$' | sort -n
}

sys_gpu() { # level
  local d freqs cap
  for d in "$devfreq"/*gpu*; do
    [[ -w $d/max_freq && -r $d/available_frequencies ]] || continue
    mapfile -t freqs < <(gpu_freqs "$d")
    ((${#freqs[@]})) || continue
    cap=$(gpu_target "$1" "${freqs[@]}")
    [[ -n $cap ]] || continue
    put "$d/max_freq" "$cap" || true
  done
}

sys_wifi() { # level
  local w dev want cur
  [[ $WIFI_PS == yes ]] || return 0
  command -v iw >/dev/null 2>&1 || return 0
  if uncapped "$1"; then want=off; else want=on; fi
  for w in "$netdir"/*/wireless; do
    [[ -d $w ]] || continue
    dev=$(basename "$(dirname "$w")")
    cur=$(iw dev "$dev" get power_save 2>/dev/null | awk '/Power save/ {print $3}')
    [[ $cur == "$want" ]] && continue
    iw dev "$dev" set power_save "$want" && say "wifi $dev power_save $want" || true
  done
}

# Echo the files that hold the platform profile (legacy ACPI file wins).
pp_files() {
  local f
  if [[ -e $pp_acpi ]]; then echo "$pp_acpi"; return; fi
  for f in "$pp_class"/*/profile; do
    [[ -e $f ]] && echo "$f"
  done
}

pp_choices() { # profile file -> choices
  if [[ $1 == "$pp_acpi" ]]; then
    cat "${pp_acpi}_choices" 2>/dev/null
  else
    cat "$(dirname "$1")/choices" 2>/dev/null
  fi
}

sys_platform_profile() { # level
  local want f
  case $1 in
    battery | saver) want=$PLATFORM_PROFILE_BATTERY ;;
    perf) want=${PLATFORM_PROFILE_PERFORMANCE:-$PLATFORM_PROFILE_AC} ;;
    *) want=$PLATFORM_PROFILE_AC ;;
  esac
  [[ -n $want ]] || return 0
  while IFS= read -r f; do
    [[ -n $f && -w $f ]] || continue
    [[ " $(pp_choices "$f") " == *" $want "* ]] || continue
    put "$f" "$want" || true
  done < <(pp_files)
}

# Opt-in cluster parking (user.slice and system.slice confined to CPUs of
# cluster 0 on battery). sl7-park reads PARK_ON_BATTERY itself, parks only when
# it is "yes" on battery, and restores on AC or when it is off (a no-op when it
# never parked), so this is called on every switch. Never fatal.
sys_park() { # level
  local arg=battery
  command -v "$park_cmd" >/dev/null 2>&1 || return 0
  if uncapped "$1"; then arg=ac; fi
  if [[ $1 == saver && $PARK_POWERSAVER == yes ]]; then
    OMARCHY_SL7_PARK_FORCE=yes "$park_cmd" apply battery || echo "sl7-park apply battery failed" >&2
    return 0
  fi
  "$park_cmd" apply "$arg" || echo "sl7-park apply $arg failed" >&2
  return 0
}

apply_system() { # battery|ac (the source)
  local profile level
  profile=$(detect_profile)
  level=$(effective_level "$1" "$profile")
  sys_cpu "$level"
  sys_gpu "$level"
  sys_wifi "$level"
  sys_platform_profile "$level"
  sys_park "$level"
  if mkdir -p "$run_dir" 2>/dev/null; then
    printf '%s\n' "$1" >"$run_dir/mode" 2>/dev/null
    printf '%s\n' "$profile" >"$run_dir/profile" 2>/dev/null
    printf '%s\n' "$level" >"$run_dir/level" 2>/dev/null
  fi
  return 0
}

# Serialises the udev, resume, boot and watcher callers.
apply_system_locked() {
  if mkdir -p "$run_dir" 2>/dev/null && command -v flock >/dev/null 2>&1; then
    (
      flock -w 30 9 || exit 0
      apply_system "$1"
    ) 9>"$run_dir/lock"
  else
    apply_system "$1"
  fi
}

# --- user part (Hyprland) ------------------------------------------------------

hypr_env() {
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && return 0
  local d rt=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
  d=$(find "$rt/hypr" -maxdepth 2 -name .socket.sock -printf '%T@ %h\n' 2>/dev/null |
    sort -rn | head -n1 | cut -d' ' -f2-)
  [[ -n $d ]] || return 1
  HYPRLAND_INSTANCE_SIGNATURE=$(basename "$d")
  export HYPRLAND_INSTANCE_SIGNATURE
}

hypr_socket2() {
  echo "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"
}

# hypr_bool OPTION -> "true"/"false"
hypr_bool() {
  hyprctl getoption "$1" -j 2>/dev/null | jq -r '.bool // empty' 2>/dev/null
}

user_refresh() { # level
  local mon info w h x y scale cur want mode saved hz=
  mon=$EDP_OUTPUT
  [[ $mon =~ ^[A-Za-z0-9._-]+$ ]] || { echo "unsafe EDP_OUTPUT" >&2; return 0; }
  info=$(hyprctl monitors -j 2>/dev/null | jq -c --arg m "$mon" '.[] | select(.name == $m)') || return 0
  [[ -n $info ]] || return 0
  read -r w h x y scale cur < <(jq -r '[.width, .height, .x, .y, .scale, .refreshRate] | @tsv' <<<"$info")
  saved=$user_state/refresh
  case $1 in
    saver) hz=$REFRESH_POWERSAVER ;;  # empty or off: leave the refresh rate alone
    battery) hz=$REFRESH_ON_BATTERY ;;
  esac
  if [[ $1 == saver || $1 == battery ]]; then
    [[ -n $hz && $hz != off ]] || return 0
    mode=$(jq -r --argjson want "$hz" --arg res "${w}x${h}" '
      [.availableModes[] | capture("^(?<r>[0-9]+x[0-9]+)@(?<hz>[0-9.]+)Hz$")
        | select(.r == $res) | .hz | tonumber | select((. - $want) < 1 and ($want - .) < 1)]
      | first // empty' <<<"$info")
    [[ -n $mode ]] || { echo "no ${hz} Hz mode at ${w}x${h} on $mon" >&2; return 0; }
    # Already there (within half a Hz): nothing to do.
    awk -v a="$cur" -v b="$mode" 'BEGIN { d = a - b; exit !(d < 0.5 && d > -0.5) }' && return 0
    mkdir -p "$user_state"
    [[ -e $saved ]] || printf '%s\n' "$cur" >"$saved"
    want=$mode
  else
    [[ -r $saved ]] || return 0
    want=$(<"$saved")
    rm -f "$saved"
    is_num "${want%.*}" || return 0
  fi
  hyprctl eval "hl.monitor({ output = \"$mon\", mode = \"${w}x${h}@${want}\", position = \"${x}x${y}\", scale = $scale })" >/dev/null &&
    echo "display $mon ${w}x${h}@${want}"
}

# user_toggle off|restore NAME OPTION LUA_PREFIX LUA_SUFFIX
user_toggle() { # off|restore name option lua_prefix lua_suffix
  local mode=$1 name=$2 opt=$3 pre=$4 suf=$5 f cur
  f=$user_state/$name
  if [[ $mode == off ]]; then
    cur=$(hypr_bool "$opt")
    [[ $cur == true ]] || return 0
    mkdir -p "$user_state"
    printf '%s\n' "$cur" >"$f"
    hyprctl eval "${pre}false${suf}" >/dev/null && echo "hyprland $name off"
  else
    [[ -r $f ]] || return 0
    cur=$(<"$f")
    rm -f "$f"
    [[ $cur == true || $cur == false ]] || return 0
    hyprctl eval "${pre}${cur}${suf}" >/dev/null && echo "hyprland $name $cur"
  fi
}

# When the kernel has VRR on (msm.vrr_enabled=1 on the command line, the
# default from the omarchy-surface-sl7 limine drop-in), turn Hyprland's VRR on
# (misc.vrr: 0 off, 1 always, 2 fullscreen only) and re-apply it after a config
# reload. HYPRLAND_VRR empty or 0 leaves Hyprland alone; without the kernel
# parameter nothing is touched either.
user_vrr() {
  local cur
  grep -qw 'msm.vrr_enabled=1' "$cmdline" 2>/dev/null || return 0
  [[ $HYPRLAND_VRR =~ ^[12]$ ]] || return 0
  cur=$(hyprctl getoption misc:vrr -j 2>/dev/null | jq -r '.int // empty' 2>/dev/null)
  [[ $cur == "$HYPRLAND_VRR" ]] && return 0
  hyprctl eval "hl.config({ misc = { vrr = $HYPRLAND_VRR } })" >/dev/null &&
    echo "hyprland misc.vrr $HYPRLAND_VRR (msm.vrr_enabled=1)"
}

apply_user() { # battery|ac (the source)
  local profile level off_anim=0 off_blur=0 act
  command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 || {
    echo "hyprctl/jq not found; skipping display part" >&2
    return 0
  }
  hypr_env || { echo "no running Hyprland instance; skipping display part" >&2; return 0; }
  profile=$(detect_profile)
  level=$(effective_level "$1" "$profile")
  case $level in
    saver)
      [[ $DISABLE_ANIMATIONS_POWERSAVER == yes || $DISABLE_ANIMATIONS_ON_BATTERY == yes ]] && off_anim=1
      [[ $DISABLE_BLUR_POWERSAVER == yes || $DISABLE_BLUR_ON_BATTERY == yes ]] && off_blur=1
      ;;
    battery)
      [[ $DISABLE_ANIMATIONS_ON_BATTERY == yes ]] && off_anim=1
      [[ $DISABLE_BLUR_ON_BATTERY == yes ]] && off_blur=1
      ;;
  esac
  user_refresh "$level"
  user_vrr
  if ((off_anim)) || [[ -e $user_state/animations ]]; then
    act=restore
    ((off_anim)) && act=off
    user_toggle "$act" animations animations:enabled 'hl.config({ animations = { enabled = ' ' } })'
  fi
  if ((off_blur)) || [[ -e $user_state/blur ]]; then
    act=restore
    ((off_blur)) && act=off
    user_toggle "$act" blur decoration:blur:enabled 'hl.config({ decoration = { blur = { enabled = ' ' } } })'
  fi
  return 0
}

# --- status ----------------------------------------------------------------------

# Prints a report; exit 1 when ENABLE=yes and the applied caps disagree with
# the current power source.
status() {
  local src bad=0 pol cur max want d freqs n w dev f mon profile level
  src=$(detect_source)
  profile=$(detect_profile)
  level=$(effective_level "$src" "$profile")
  echo "power source: $src"
  echo "power profile: ${profile:-none (PPD not running or PROFILE_AWARE=no)}"
  echo "level: $level (applied: mode $(cat "$run_dir/mode" 2>/dev/null || echo unset), profile $(cat "$run_dir/profile" 2>/dev/null || echo unset), level $(cat "$run_dir/level" 2>/dev/null || echo unset); ENABLE=$ENABLE, config $conf)"
  for pol in "$cpufreq"/policy*; do
    [[ -r $pol/scaling_max_freq ]] || continue
    cur=$(<"$pol/scaling_max_freq")
    max=$(<"$pol/cpuinfo_max_freq")
    echo "cpu ${pol##*/}: scaling_max_freq $cur kHz (hardware max $max)"
    if [[ $ENABLE == yes ]]; then
      want=$(cpu_cap_khz "$level")
      if uncapped "$level"; then
        want=$max
      elif [[ -n $want ]]; then
        ((want > max)) && want=$max
      fi
      if [[ -n $want ]]; then
        [[ $cur == "$want" ]] || bad=1
      fi
    fi
  done
  for d in "$devfreq"/*gpu*; do
    [[ -r $d/max_freq && -r $d/available_frequencies ]] || continue
    mapfile -t freqs < <(gpu_freqs "$d")
    n=${#freqs[@]}
    cur=$(<"$d/max_freq")
    echo "gpu ${d##*/}: max_freq $cur Hz (highest ${freqs[n - 1]:-?})"
    if [[ $ENABLE == yes && $n -gt 0 ]]; then
      want=$(gpu_target "$level" "${freqs[@]}")
      if [[ -n $want ]]; then
        [[ $cur == "$want" ]] || bad=1
      fi
    fi
  done
  [[ -d $devfreq ]] && ! compgen -G "$devfreq/*gpu*" >/dev/null && echo "gpu: no devfreq device"
  for w in "$netdir"/*/wireless; do
    [[ -d $w ]] || continue
    dev=$(basename "$(dirname "$w")")
    if command -v iw >/dev/null 2>&1; then
      cur=$(iw dev "$dev" get power_save 2>/dev/null | awk '/Power save/ {print $3}')
      echo "wifi $dev: power_save ${cur:-unknown}"
      if [[ $ENABLE == yes && $WIFI_PS == yes && -n $cur ]]; then
        if uncapped "$level"; then want=off; else want=on; fi
        [[ $cur == "$want" ]] || echo "wifi $dev: WARN power_save is $cur, want $want (NetworkManager re-applied its setting? see sl7-doctor)"
      fi
    else
      echo "wifi $dev: iw not installed"
    fi
  done
  f=$(pp_files | head -n1)
  if [[ -n $f ]]; then
    echo "platform profile: $(<"$f") (choices: $(pp_choices "$f"))"
  else
    echo "platform profile: none"
  fi
  if command -v "$park_cmd" >/dev/null 2>&1; then
    echo "park: PARK_ON_BATTERY=$PARK_ON_BATTERY, $("$park_cmd" status 2>/dev/null | grep -E '^state:' | head -n1)"
  fi
  mon=$EDP_OUTPUT
  if command -v hyprctl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 && hypr_env 2>/dev/null &&
    [[ $mon =~ ^[A-Za-z0-9._-]+$ ]]; then
    cur=$(hyprctl monitors -j 2>/dev/null | jq -r --arg m "$mon" '.[] | select(.name == $m) | "\(.width)x\(.height)@\(.refreshRate)"')
    [[ -n $cur ]] && echo "display $mon: $cur"
    if grep -qw 'msm.vrr_enabled=1' "$cmdline" 2>/dev/null; then
      echo "vrr: msm.vrr_enabled=1; misc.vrr $(hyprctl getoption misc:vrr -j 2>/dev/null | jq -r '.int // "?"'), $mon vrr active: $(hyprctl monitors -j 2>/dev/null | jq -r --arg m "$mon" '.[] | select(.name == $m) | .vrr')"
    fi
  fi
  if ((bad)); then
    echo "MISMATCH: applied settings do not match the power source and profile (sudo omarchy-sl7-powermode auto)"
    return 1
  fi
  return 0
}

# --- watchers ---------------------------------------------------------------------

# User watcher: one long-lived process: UPower OnBattery changes and PPD ActiveProfile
# changes (D-Bus signals, no polling) and Hyprland config reloads / monitor changes (a
# reload re-reads monitors.lua and would undo the 60 Hz mode). The source of truth stays
# sysfs and PPD; the signals only say when to look.
# Re-read the config each time; ENABLE=no behaves like AC and ignores the profile (restores).
watch_apply() {
  local mode
  load_conf
  mode=$(detect_source)
  if [[ $ENABLE != yes ]]; then
    mode=ac
    PROFILE_AWARE=no
  fi
  apply_user "$mode"
}

watch() {
  local sock
  hypr_env || { echo "no running Hyprland instance; nothing to watch" >&2; exit 0; }
  sock=$(hypr_socket2)
  watch_apply
  exec 3< <(
    gdbus monitor --system --dest org.freedesktop.UPower --object-path /org/freedesktop/UPower 2>/dev/null |
      grep --line-buffered "'OnBattery'" &
    gdbus monitor --system --dest org.freedesktop.UPower.PowerProfiles 2>/dev/null |
      grep --line-buffered "'ActiveProfile'" &
    if command -v socat >/dev/null 2>&1; then
      socat -u "UNIX-CONNECT:$sock" - 2>/dev/null |
        grep --line-buffered -E '^(configreloaded|monitoradded(v2)?)>>' &
    fi
    wait
  )
  while IFS= read -r _ <&3; do
    # Coalesce bursts (a reload fires several events).
    while read -r -t 1 _ <&3; do :; done
    watch_apply
  done
  echo "event stream ended" >&2
  exit 1
}

# Root watcher (omarchy-surface-sl7-powermode.service): applies once at start, then again
# whenever power-profiles-daemon's ActiveProfile changes. Plug/unplug and resume reach
# apply_system through udev (power-event) and the system-sleep hook as before. It sits in
# a pipe read between events, so it costs nothing while idle.
sys_apply_now() {
  local mode
  load_conf
  [[ $ENABLE == yes ]] || return 0
  mode=$(detect_source)
  apply_system_locked "$mode"
}

sys_watch() {
  ((EUID == 0)) || [[ -n ${OMARCHY_SL7_ALLOW_NONROOT:-} ]] || { echo "system watch needs root" >&2; exit 1; }
  sys_apply_now
  while :; do
    gdbus monitor --system --dest org.freedesktop.UPower.PowerProfiles 2>/dev/null |
      grep --line-buffered "'ActiveProfile'" |
      while IFS= read -r _; do
        # Coalesce bursts.
        while read -r -t 1 _; do :; done
        sys_apply_now
      done
    # The monitor ended (PPD restarted or the bus went away): look again, then re-subscribe.
    sleep 30
    sys_apply_now
  done
}

# --- main --------------------------------------------------------------------------

part=
case ${1:-} in
  --system) part=system; shift ;;
  --user) part=user; shift ;;
esac
cmd=${1:-}
[[ $# -eq 1 ]] || usage

if [[ -z $part ]]; then
  if ((EUID == 0)); then part=system; else part=user; fi
fi

case $cmd in
  watch)
    if [[ $part == system ]]; then sys_watch; else watch; fi
    ;;
  status) status ;;
  auto | battery | ac)
    mode=$cmd
    if [[ $cmd == auto ]]; then
      [[ $ENABLE == yes ]] || exit 0
      mode=$(detect_source)
    fi
    if [[ $part == system ]]; then
      ((EUID == 0)) || [[ -n ${OMARCHY_SL7_ALLOW_NONROOT:-} ]] || { echo "system part needs root (sudo ${0##*/} $cmd)" >&2; exit 1; }
      apply_system_locked "$mode"
    else
      apply_user "$mode"
      ((EUID == 0)) || echo "user part only; caps, Wi-Fi and platform profile need: sudo ${0##*/} --system $cmd" >&2
    fi
    ;;
  *) usage ;;
esac
