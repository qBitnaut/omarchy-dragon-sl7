#!/bin/bash
# Phase A probe for the Surface Laptop 7 cameras: CAMSS, CCI and CSIPHY probe
# state, the IR sensor (ST VD55G0, ACPI SMO55F0 / MSHW0472, i2c 0x10 on CCI0)
# and the front RGB camera (OmniVision OV02C10, i2c 0x36 on CCI1).
#
# Read-only by default. It never touches the illuminator: no LED class device,
# no flash strobe, no sensor GPIO. With --sweep-mclk (or --mclk-hz without it)
# it additionally changes the vd55g module parameters mclk_index/mclk_hz (a
# linux-sl7 debug hack) and rebinds the sensor: the parameters are read at
# probe, so unbind and bind is enough, no module reload.
#
#   sl7-ir-probe [--frames N] [--out DIR] [--no-capture] [--y10] [--debug]
#                [--sweep-mclk] [--mclk-hz HZ]
#
# IR: Y8/GREY 644x604 if the sensor offers Y8_1X8, else Y10_1X10 / Y10P
# (--y10 forces 10 bit), CSID0 -> VFE0 RDI0. RGB: the sensor's own Bayer code
# (OV02C10: SGRBG10_1X10 / pgAA), 10 frames, CSID1 -> VFE1 RDI0, INFO only.
# --debug: dynamic debug for camss/csiphy/vd55g/mc, vb2 debug=2, interrupt
# counter deltas around each capture; everything is switched off afterwards.
# Captures go to ~/sl7-ir-test (30 IR frames by default).
# Needs: v4l-utils (media-ctl, v4l2-ctl) for the topology and the capture;
# root (it re-runs itself with sudo) for dmesg, --debug and the MCLK options.
set -u

frames=30
out=${SL7_IR_OUT:-${SUDO_USER:+$(getent passwd "$SUDO_USER" | cut -d: -f6)/sl7-ir-test}}
out=${out:-$HOME/sl7-ir-test}
capture=1
sweep=0
debug=0
want_y10=0
mclk_hz=19200000
mclk_hz_set=0
sysfs=${SL7_SYSFS:-/sys}
ir_addr=0010
rgb_addr=0036

usage() {
  sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 2
}

while (($#)); do
  case $1 in
    --frames) frames=${2:?}; shift ;;
    --out) out=${2:?}; shift ;;
    --no-capture) capture=0 ;;
    --sweep-mclk) sweep=1 ;;
    --mclk-hz) mclk_hz=${2:?}; mclk_hz_set=1; shift ;;
    --y10) want_y10=1 ;;
    --debug) debug=1 ;;
    -h | --help) usage ;;
    *) usage ;;
  esac
  shift
done
[[ $frames =~ ^[0-9]+$ && $mclk_hz =~ ^[0-9]+$ ]] || usage

if ((EUID != 0)) && [[ -z ${SL7_IR_NO_SUDO:-} ]]; then
  if command -v sudo >/dev/null 2>&1; then
    exec sudo --preserve-env=SL7_IR_OUT,SL7_SYSFS "$0" "$@"
  fi
  echo "sl7-ir-probe: not root and no sudo; dmesg and bind/unbind will be limited" >&2
fi

mkdir -p "$out" || { echo "sl7-ir-probe: cannot create $out" >&2; exit 1; }
if [[ -n ${SUDO_UID:-} ]]; then chown "$SUDO_UID:${SUDO_GID:-$SUDO_UID}" "$out" 2>/dev/null || true; fi
report=$out/probe-$(date +%Y%m%d-%H%M%S).txt

summary=()
rc=0
say() { printf '%s\n' "$*" | tee -a "$report"; }
note() { summary+=("$1  $2"); }
ok() { note PASS "$1"; }
bad() { note FAIL "$1"; rc=1; }
info() { note INFO "$1"; }
section() { say ""; say "== $1"; }

kdmesg() {
  dmesg 2>/dev/null || journalctl -k -b --no-pager 2>/dev/null || true
}

# ---------------------------------------------------------------- kernel
section "Kernel and device tree"
kernel=$(uname -r)
say "kernel: $kernel"
if [[ -f /usr/lib/modules/$kernel/pkgbase ]] && grep -qx linux-sl7 "/usr/lib/modules/$kernel/pkgbase"; then
  ok "running kernel is linux-sl7"
else
  bad "running kernel is not linux-sl7 (the camera patches live there)"
fi
compat=$(tr '\0' ' ' <"$sysfs/firmware/devicetree/base/compatible" 2>/dev/null || true)
say "compatible: ${compat:-<none>}"
case $compat in
  *microsoft,romulus13*) ok "device tree is romulus13 (13.8 inch, has the IR camera node)" ;;
  *microsoft,romulus15*) info "device tree is romulus15: no IR camera node in this release, only RGB" ;;
  *) bad "no romulus device tree (booted without the SL7 DTB?)" ;;
esac

# ---------------------------------------------------------------- modules
section "Modules and firmware"
mods=(qcom_camss phy_qcom_mipi_csi2 i2c_qcom_cci camcc_x1e80100 ov02c10 vd55g)
for m in "${mods[@]}"; do
  if [[ -d $sysfs/module/$m ]]; then
    say "module $m: loaded"
  else
    say "module $m: not loaded (try: sudo modprobe ${m//_/-})"
  fi
done
if [[ -d $sysfs/module/vd55g/parameters ]]; then
  say "vd55g mclk_index=$(cat "$sysfs/module/vd55g/parameters/mclk_index" 2>/dev/null) mclk_hz=$(cat "$sysfs/module/vd55g/parameters/mclk_hz" 2>/dev/null)"
fi
fw_found=0
for f in vd55g0-cut1.bin vd55g0-cut2.bin; do
  hit=""
  for c in /usr/lib/firmware/"$f" /usr/lib/firmware/"$f".* /lib/firmware/"$f"; do
    [[ -e $c ]] && { hit=$c; break; }
  done
  if [[ -n $hit ]]; then say "firmware $f: $hit"; fw_found=$((fw_found + 1)); else say "firmware $f: MISSING"; fi
done
if ((fw_found == 2)); then ok "VD55G0 patch firmware installed"; else bad "VD55G0 patch firmware missing (package linux-sl7 >= 7.2.8-3)"; fi

# ---------------------------------------------------------------- platform
section "CAMSS, CCI and CSIPHY probe state"
bound() { # device path -> driver name or empty
  local d=$1
  [[ -L $d/driver ]] && basename "$(readlink "$d/driver")"
}
check_dev() { # label, glob under bus/platform/devices
  local label=$1 pat=$2 dev drv found=0
  for dev in "$sysfs"/bus/platform/devices/$pat; do
    [[ -e $dev ]] || continue
    found=1
    drv=$(bound "$dev")
    if [[ -n $drv ]]; then
      say "$label: $(basename "$dev") bound to $drv"
      ok "$label probed"
    else
      say "$label: $(basename "$dev") present, NOT bound"
      bad "$label present but not bound"
    fi
  done
  if ((!found)); then
    say "$label: no platform device (not in the device tree, or status disabled)"
    bad "$label: no platform device"
  fi
}
check_dev "camcc" "ade0000.clock-controller"
check_dev "CCI0" "ac15000.cci"
check_dev "CCI1" "ac16000.cci"
check_dev "CSIPHY0 (IR)" "ace4000.phy"
check_dev "CSIPHY4 (RGB)" "acec000.phy"
check_dev "CAMSS" "acb7000.isp"

deferred=/sys/kernel/debug/devices_deferred
if [[ -r $deferred ]] && grep -E 'cci|camss|phy@|isp@|vd55g|ov02c10|0010|0036' "$deferred" >"$out/deferred.txt" 2>/dev/null && [[ -s $out/deferred.txt ]]; then
  say "deferred devices:"
  cat "$out/deferred.txt" | tee -a "$report"
  bad "camera devices are in the deferred probe list"
fi

# ---------------------------------------------------------------- i2c
section "I2C sensors"
find_i2c() { # address (4 hex digits) -> device dir on a CCI adapter, or empty
  local addr=$1 d
  for d in "$sysfs"/bus/i2c/devices/*-"$addr"; do
    [[ -e $d ]] || continue
    # only the CCI adapters (the camera buses), not the other buses' 0x10 devices
    if readlink -f "$d/.." | grep -q 'cci'; then echo "$d"; return 0; fi
  done
  return 1
}
ir_dev=$(find_i2c "$ir_addr" || true)
rgb_dev=$(find_i2c "$rgb_addr" || true)

report_i2c() { # label, dev
  local label=$1 dev=$2 drv
  if [[ -z $dev ]]; then
    say "$label: no i2c client (CCI bus not up or node missing)"
    return 1
  fi
  drv=$(bound "$dev")
  say "$label: $(basename "$dev") name=$(cat "$dev/name" 2>/dev/null) driver=${drv:-<none>}"
  [[ -n $drv ]]
}

dmesg_ir() { kdmesg | grep -iE 'vd55g|0x53354730|53354730|smo55f0|sensor detect|sensor boot|external firmware|failed to (load|apply|boot|get)|expected vd55g|clock lane|link-frequenc|cci' | tail -n 40; }

if report_i2c "IR (VD55G0 @ 0x10)" "$ir_dev"; then
  ok "IR sensor probed: the driver read model id 0x53354730 (VD55G0) and applied the firmware patch"
else
  if [[ -z $ir_dev ]]; then
    bad "IR sensor: no i2c client at 0x10 on CCI0 (CCI0 or the DT node is not up)"
  else
    bad "IR sensor: client present at 0x10 but the vd55g driver is not bound (no ack, wrong id, firmware or clock)"
  fi
fi
say "-- kernel messages about the IR sensor"
dmesg_ir | tee -a "$report"
kdmesg >"$out/dmesg.txt" 2>/dev/null || true

if report_i2c "RGB (OV02C10 @ 0x36)" "$rgb_dev"; then
  ok "RGB OV02C10 probed"
else
  bad "RGB OV02C10 not probed (this validates the camera stack first: fix it before the IR)"
fi
say "-- kernel messages about the RGB sensor"
kdmesg | grep -iE 'ov02c10|ovti|camss' | tail -n 20 | tee -a "$report"

# ---------------------------------------------------------------- sweep
ir_driver_dir=$sysfs/bus/i2c/drivers/vd55g
param=$sysfs/module/vd55g/parameters
ir_name=""
[[ -n $ir_dev ]] && ir_name=$(basename "$ir_dev")

rebind_ir() { # unbind and bind the sensor so the module parameters are read again at probe
  [[ -n $ir_name ]] && echo "$ir_name" >"$ir_driver_dir/unbind" 2>/dev/null
  sleep 1
  echo "$ir_name" >"$ir_driver_dir/bind" 2>/dev/null
  sleep 2
  [[ -L $sysfs/bus/i2c/devices/$ir_name/driver ]]
}

try_mclk() { # index -> 0 when the sensor is bound afterwards
  echo "$1" >"$param/mclk_index"
  echo "$mclk_hz" >"$param/mclk_hz"
  rebind_ir
}

if ((sweep)); then
  section "MCLK sweep (changes vd55g mclk_index; the emitter stays untouched)"
  if ((EUID != 0)); then
    bad "--sweep-mclk needs root"
  elif [[ ! -w $param/mclk_index ]]; then
    bad "vd55g mclk_index parameter missing: is the vd55g module from linux-sl7 7.2.8-3 loaded?"
  elif [[ -z $ir_name ]]; then
    bad "no IR i2c client to rebind"
  else
    found=""
    for idx in 0 1 2 3 -2; do
      say "trying mclk_index=$idx mclk_hz=$mclk_hz"
      if try_mclk "$idx"; then
        say "  -> bound with mclk_index=$idx"
        found=$idx
        break
      fi
      say "  -> not bound"
      kdmesg | grep -iE 'vd55g|sensor detect' | tail -n 3 | sed 's/^/     /' | tee -a "$report"
    done
    if [[ -n $found ]]; then
      case $found in
        -2) ok "IR sensor works WITHOUT a camera master clock (module oscillator): mclk_index=-2" ;;
        *) ok "IR sensor works with MCLK$found (gpio$((96 + found))) at $mclk_hz Hz: set the DT clock and pinctrl to MCLK$found" ;;
      esac
      ir_dev=$sysfs/bus/i2c/devices/$ir_name
    else
      echo -1 >"$param/mclk_index"
      echo "$ir_name" >"$ir_driver_dir/unbind" 2>/dev/null
      sleep 1
      echo "$ir_name" >"$ir_driver_dir/bind" 2>/dev/null
      bad "no MCLK candidate made the sensor answer (restored mclk_index=-1); check rails and reset in dmesg"
    fi
  fi
fi

if ((!sweep && mclk_hz_set)); then
  section "MCLK override (mclk_hz=$mclk_hz; the emitter stays untouched)"
  if ((EUID != 0)); then
    bad "--mclk-hz needs root"
  elif [[ ! -w $param/mclk_hz ]]; then
    bad "vd55g mclk_hz parameter missing: is the vd55g module from linux-sl7 7.2.8-3 or later loaded?"
  elif [[ -z $ir_name ]]; then
    bad "no IR i2c client to rebind"
  else
    echo "$mclk_hz" >"$param/mclk_hz"
    if rebind_ir; then
      say "sensor rebound with mclk_hz=$mclk_hz (mclk_index=$(cat "$param/mclk_index" 2>/dev/null))"
      ok "IR sensor bound with mclk_hz=$mclk_hz"
      ir_dev=$sysfs/bus/i2c/devices/$ir_name
    else
      bad "IR sensor did not bind with mclk_hz=$mclk_hz"
    fi
  fi
fi

# ---------------------------------------------------------------- topology
section "Media topology"
media_dev=""
if command -v media-ctl >/dev/null 2>&1; then
  for m in /dev/media*; do
    [[ -e $m ]] || continue
    if media-ctl -d "$m" -p 2>/dev/null | grep -q 'driver[[:space:]]*qcom-camss'; then
      media_dev=$m
      break
    fi
  done
  if [[ -n $media_dev ]]; then
    say "CAMSS media device: $media_dev"
    media-ctl -d "$media_dev" -p >"$out/media-ctl-p.txt" 2>&1
    say "topology saved to $out/media-ctl-p.txt"
    grep -E '^- entity [0-9]+:' "$out/media-ctl-p.txt" | tee -a "$report"
    ok "CAMSS media device present ($media_dev)"
  else
    say "no qcom-camss media device found"
    bad "no qcom-camss media device (CAMSS did not register)"
  fi
else
  say "media-ctl not installed (pacman -S v4l-utils)"
  info "media-ctl missing: install v4l-utils for topology and capture"
fi

# ---------------------------------------------------------------- capture
# Python helper: find a path sensor -> video node in the media-ctl -p text and
# print, for the first sensor entity whose name starts with <prefix>:
#   VIDEO <node>, SENSOR <subdev node>, RDI "entity":pad (last subdev source pad),
#   LINK "a":p->"b":q (only links that are not IMMUTABLE) and FMT "entity":pad lines.
# The optional third argument is a comma separated list of msm_csid*/msm_vfe*
# entity names the path may use (so IR and RGB take different CSID/VFE).
# No FMT is emitted for a video node: it has no subdev formats (media-ctl -V
# fails on it with "Inappropriate ioctl").
plan_path() { # media-ctl-p.txt sensor-prefix [allowed-entities]
  python3 - "$@" <<'PY'
import re, sys
from collections import deque
txt = open(sys.argv[1]).read()
prefix = sys.argv[2]
allowed = set(a for a in (sys.argv[3] if len(sys.argv) > 3 else '').split(',') if a)
ents = {}
immutable = set()
cur = pad = None


def name_of(c):
    return c['name']


for line in txt.splitlines():
    m = re.match(r'^- entity \d+: (.+?) \(\d+ pads?', line)
    if m:
        cur = {'dev': None, 'pads': {}, 'name': m.group(1)}
        ents[m.group(1)] = cur
        pad = None
        continue
    if cur is None:
        continue
    m = re.match(r'^\s+device node name (\S+)', line)
    if m:
        cur['dev'] = m.group(1)
        continue
    m = re.match(r'^\s+pad(\d+): (Sink|Source)', line, re.I)
    if m:
        pad = int(m.group(1))
        cur['pads'][pad] = (m.group(2).capitalize(), [])
        continue
    m = re.match(r'^\s+-> "(.+?)":(\d+) \[(.*)\]', line)
    if m and pad is not None:
        cur['pads'][pad][1].append((m.group(1), int(m.group(2))))
        if 'IMMUTABLE' in m.group(3):
            immutable.add((name_of(cur), pad, m.group(1), int(m.group(2))))


def is_video(name):
    dev = ents[name]['dev']
    return bool(dev and dev.startswith('/dev/video'))


def usable(name):
    if not allowed or is_video(name):
        return True
    if name.startswith('msm_csid') or name.startswith('msm_vfe'):
        return name in allowed
    return True


src = next((n for n in ents if n.startswith(prefix)), None)
if not src:
    print('ERR no entity starting with %r' % prefix)
    sys.exit(0)
# hops: (from entity, from source pad, to entity, to sink pad)
q = deque([(src, [])])
seen = {src}
found = None
while q:
    name, hops = q.popleft()
    if is_video(name):
        found = (name, hops)
        break
    for p, (direction, links) in sorted(ents[name]['pads'].items()):
        if direction != 'Source':
            continue
        for dn, dp in links:
            if dn in ents and dn not in seen and usable(dn):
                seen.add(dn)
                q.append((dn, hops + [(name, p, dn, dp)]))
if not found:
    print('ERR no path from %s to a video node%s' % (src, ' (allowed: %s)' % ','.join(sorted(allowed)) if allowed else ''))
    sys.exit(0)
name, hops = found
print('VIDEO %s' % ents[name]['dev'])
print('SENSOR %s' % ents[src]['dev'])
la, lap = hops[-1][0], hops[-1][1]
print('RDI "%s":%d' % (la, lap))
for (a, ap, b, bp) in hops:
    if (a, ap, b, bp) not in immutable:  # immutable links are always enabled
        print('LINK "%s":%d->"%s":%d' % (a, ap, b, bp))
done = set()
for (a, ap, b, bp) in hops:
    for ent, pd in ((a, ap), (b, bp)):
        if is_video(ent) or (ent, pd) in done:
            continue
        done.add((ent, pd))
        print('FMT "%s":%d' % (ent, pd))
PY
}

# Frame statistics. Rows are <stride> bytes, only <width> pixels per row are
# real; 8-bit formats are bytes, 10-bit packed formats are 5 bytes per 4 pixels.
stats_py() { # file width height stride sizeimage bits
  python3 - "$@" <<'PY'
import sys, statistics
f = sys.argv[1]
w, h, stride, size, bits = (int(x) for x in sys.argv[2:7])
data = open(f, 'rb').read()
n = len(data) // size
print('frames=%d bytes=%d (sizeimage %d, stride %d, remainder %d)' % (n, len(data), size, stride, len(data) - n * size))
if not n:
    sys.exit(0)
top = 255 if bits == 8 else 1023


def pixels(fr):
    if bits == 8:
        return b''.join(fr[r * stride:r * stride + w] for r in range(h))
    out = []
    for r in range(0, h, 4):  # every 4th row is plenty for statistics
        row = fr[r * stride:r * stride + stride]
        for i in range(0, (w // 4) * 5, 5):
            lsb = row[i + 4]
            out.append((row[i] << 2) | (lsb & 3))
            out.append((row[i + 1] << 2) | ((lsb >> 2) & 3))
            out.append((row[i + 2] << 2) | ((lsb >> 4) & 3))
            out.append((row[i + 3] << 2) | ((lsb >> 6) & 3))
    return out


means = []
for i in range(n):
    px = pixels(data[i * size:(i + 1) * size])
    cnt = len(px)
    mean = sum(px) / cnt
    means.append(mean)
    if i < 5 or i == n - 1:
        sat = (px.count(top) if bits == 8 else sum(1 for p in px if p == top)) / cnt
        zero = (px.count(0) if bits == 8 else sum(1 for p in px if p == 0)) / cnt
        print('frame %2d: min=%4d max=%4d mean=%7.2f saturated=%.3f%% zero=%.3f%%' % (
            i, min(px), max(px), mean, 100 * sat, 100 * zero))
print('mean of means=%.2f spread=%.2f (%d-bit)' % (statistics.mean(means), max(means) - min(means), bits))
if max(means) < 1.0:
    print('NOTE all frames are black: normal without the illuminator in a dark room; cover/uncover the sensor to check it responds')
elif min(means) > top - 1:
    print('NOTE all frames saturated')
PY
}

# Interrupt counter deltas between two /proc/interrupts snapshots.
irq_delta_py() { # before after
  python3 - "$@" <<'PY'
import sys


def load(p):
    d = {}
    for line in open(p):
        parts = line.split()
        if len(parts) < 2:
            continue
        irq = parts[0]
        cnt = 0
        i = 1
        while i < len(parts) and parts[i].isdigit():
            cnt += int(parts[i])
            i += 1
        d[irq + ' ' + ' '.join(parts[i:])] = cnt
    return d


a, b = load(sys.argv[1]), load(sys.argv[2])
if not b:
    print('  (no matching interrupt lines: csid/vfe/csiphy/ace4000 not registered)')
for k in sorted(b):
    print('  %-60s %10d -> %10d  delta %d' % (k[:60], a.get(k, 0), b[k], b[k] - a.get(k, 0)))
PY
}

# V4L2 media bus code (media-ctl spelling) -> pixel format fourcc of the RDI node
mbus_fourcc() {
  case $1 in
    Y8_1X8) echo GREY ;;
    Y10_1X10) echo Y10P ;;
    SBGGR8_1X8) echo BA81 ;;
    SGBRG8_1X8) echo GBRG ;;
    SGRBG8_1X8) echo GRBG ;;
    SRGGB8_1X8) echo RGGB ;;
    SBGGR10_1X10) echo pBAA ;;
    SGBRG10_1X10) echo pGAA ;;
    SGRBG10_1X10) echo pgAA ;;
    SRGGB10_1X10) echo pRAA ;;
    *) return 1 ;;
  esac
}
fourcc_bits() { case $1 in GREY | BA81 | GBRG | GRBG | RGGB) echo 8 ;; *) echo 10 ;; esac; }

sensor_codes() { # sensor subdev node -> mbus codes of pad 0, one per line, no MEDIA_BUS_FMT_ prefix
  v4l2-ctl -d "$1" --list-subdev-mbus-codes pad=0 2>&1 | grep -oE 'MEDIA_BUS_FMT_[A-Z0-9_]+' | sed 's/^MEDIA_BUS_FMT_//' || true
}

pick_code() { # kind codes -> chosen code (IR: Y8_1X8, else Y10_1X10, --y10 forces the latter; RGB: first Bayer code the sensor reports)
  local kind=$1 codes=$2 c
  if [[ $kind == ir ]]; then
    if ((want_y10)); then
      grep -qx Y10_1X10 <<<"$codes" && { echo Y10_1X10; return 0; }
      return 1
    fi
    for c in Y8_1X8 Y10_1X10; do
      grep -qx "$c" <<<"$codes" && { echo "$c"; return 0; }
    done
    return 1
  fi
  while IFS= read -r c; do
    [[ -n $c ]] && mbus_fourcc "$c" >/dev/null && { echo "$c"; return 0; }
  done <<<"$codes"
  return 1
}

cap_kind=ir
verdict() { # PASS|FAIL text. The RGB result is INFO only: libcamera already drives the RGB camera.
  if [[ $cap_kind == rgb ]]; then
    info "RGB raw path on CAMSS $1: $2"
  elif [[ $1 == PASS ]]; then
    ok "IR $2"
  else
    bad "IR $2"
  fi
}

debug_active=0
debug_on() {
  local ctl=$sysfs/kernel/debug/dynamic_debug/control l
  vb2_old=$(cat "$sysfs/module/videobuf2_common/parameters/debug" 2>/dev/null || echo 0)
  if [[ -w $ctl ]]; then
    for l in 'module qcom_camss +p' 'module phy_qcom_mipi_csi2 +p' 'module vd55g +p' 'file mc-entity.c +p' 'file v4l2-subdev.c +p'; do
      echo "$l" >"$ctl" 2>/dev/null || say "dynamic debug: '$l' failed"
    done
  else
    say "dynamic debug control not writable ($ctl): is debugfs mounted and CONFIG_DYNAMIC_DEBUG set?"
  fi
  echo 2 >"$sysfs/module/videobuf2_common/parameters/debug" 2>/dev/null || say "videobuf2_common debug parameter not writable"
  debug_active=1
}
debug_off() {
  local ctl=$sysfs/kernel/debug/dynamic_debug/control l
  ((debug_active)) || return 0
  debug_active=0
  if [[ -w $ctl ]]; then
    for l in 'module qcom_camss -p' 'module phy_qcom_mipi_csi2 -p' 'module vd55g -p' 'file mc-entity.c -p' 'file v4l2-subdev.c -p'; do
      echo "$l" >"$ctl" 2>/dev/null || true
    done
  fi
  echo "${vb2_old:-0}" >"$sysfs/module/videobuf2_common/parameters/debug" 2>/dev/null || true
}
irq_snap() { grep -E 'csid|vfe|csiphy|ace4000' /proc/interrupts >"$1" 2>/dev/null || : >"$1"; }

# capture_cam kind sensor-prefix sensor-i2c-dev csid-entity rdi-entity frames width height
capture_cam() {
  local kind=$1 prefix=$2 sdev=$3 csid=$4 rdi=$5 nframes=$6 w=$7 h=$8
  local label plan videodev sensordev rdipad codes code fourcc bits line cur curcode cursize
  local bpl size fmt_out log raw dm_mark sz need ok_stream=1
  cap_kind=$kind
  label=${kind^^}
  [[ -n $media_dev && -n $sdev ]] || { info "$label capture skipped: no sensor or media device"; return; }
  [[ -L $sdev/driver ]] || { info "$label capture skipped: sensor not probed"; return; }
  command -v v4l2-ctl >/dev/null 2>&1 || { info "$label capture skipped: v4l2-ctl missing"; return; }
  plan=$(plan_path "$out/media-ctl-p.txt" "$prefix" "$csid,$rdi")
  say "$plan"
  if grep -q '^ERR' <<<"$plan"; then
    verdict FAIL "$(grep '^ERR' <<<"$plan")"
    return
  fi
  videodev=$(sed -n 's/^VIDEO //p' <<<"$plan")
  sensordev=$(sed -n 's/^SENSOR //p' <<<"$plan")
  rdipad=$(sed -n 's/^RDI //p' <<<"$plan")

  # codes the sensor itself reports decide the format; nothing is hard-coded
  codes=$(sensor_codes "$sensordev")
  say "sensor $sensordev mbus codes on pad 0: $(tr '\n' ' ' <<<"$codes")"
  if [[ -z $codes ]]; then
    say "could not enumerate the sensor codes; falling back to the usual default"
    if [[ $kind == ir ]]; then codes=$( ((want_y10)) && echo Y10_1X10 || echo Y8_1X8); else codes=SGRBG10_1X10; fi
  fi
  if ! code=$(pick_code "$kind" "$codes"); then
    verdict FAIL "no usable media bus code among: $(tr '\n' ' ' <<<"$codes")$( ((want_y10)) && echo ' (--y10 needs Y10_1X10)')"
    return
  fi
  fourcc=$(mbus_fourcc "$code")
  bits=$(fourcc_bits "$fourcc")
  say "using $code -> $fourcc ${w}x${h}"

  media-ctl -d "$media_dev" -r >>"$report" 2>&1 || say "media-ctl -r (reset links) failed"
  while IFS= read -r line; do
    [[ $line == "LINK "* ]] || continue
    if ! media-ctl -d "$media_dev" -l "${line#LINK }[1]" >>"$report" 2>&1; then
      verdict FAIL "link failed: $line"
      return
    fi
  done <<<"$plan"
  while IFS= read -r line; do
    [[ $line == "FMT "* ]] || continue
    if ! media-ctl -d "$media_dev" -V "${line#FMT } [fmt:$code/${w}x${h}]" >>"$report" 2>&1; then
      verdict FAIL "set format failed on ${line#FMT } (codes offered: $(tr '\n' ' ' <<<"$codes"))"
      return
    fi
  done <<<"$plan"

  cur=$(media-ctl -d "$media_dev" --get-v4l2 "$rdipad" 2>&1)
  say "RDI source pad $rdipad: $cur"
  curcode=$(grep -oE 'fmt:[A-Z0-9_]+' <<<"$cur" | head -n1 | sed 's/^fmt://')
  cursize=$(grep -oE '/[0-9]+x[0-9]+' <<<"$cur" | head -n1 | sed 's|^/||')
  if [[ $curcode != "$code" || $cursize != "${w}x${h}" ]]; then
    verdict FAIL "format mismatch on $rdipad: wanted $code/${w}x${h}, got ${curcode:-?}/${cursize:-?}"
    return
  fi

  v4l2-ctl -d "$videodev" --set-fmt-video="width=$w,height=$h,pixelformat=$fourcc" >>"$report" 2>&1 \
    || say "set video format failed on $videodev"
  fmt_out=$(v4l2-ctl -d "$videodev" --get-fmt-video 2>&1)
  say "$fmt_out"
  bpl=$(sed -n 's/^[[:space:]]*Bytes per Line[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' <<<"$fmt_out" | head -n1)
  size=$(sed -n 's/^[[:space:]]*Size Image[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' <<<"$fmt_out" | head -n1)
  if [[ -z $bpl || -z $size ]] || ! grep -q "'$fourcc'" <<<"$fmt_out"; then
    verdict FAIL "$videodev did not accept $fourcc ${w}x${h} (bytesperline='${bpl:-}' sizeimage='${size:-}')"
    return
  fi

  log=$out/$kind-capture.log
  raw=$out/$kind.raw
  rm -f "$raw"
  say "capturing $nframes frames from $videodev as $fourcc, stride $bpl, sizeimage $size (no illuminator)"
  dm_mark=$(kdmesg | wc -l)
  if ((debug)); then irq_snap "$out/irq-$kind-before.txt"; fi
  if ! timeout 30 v4l2-ctl -d "$videodev" --stream-mmap --stream-count="$nframes" --stream-to="$raw" >"$log" 2>&1; then
    ok_stream=0
  fi
  cat "$log" >>"$report"
  # v4l2-ctl can exit 0 although STREAMON failed: judge by its messages too
  if grep -qiE 'returned -1|timeout|VIDIOC_' "$log"; then ok_stream=0; fi
  if ((debug)); then
    irq_snap "$out/irq-$kind-after.txt"
    say "-- interrupt deltas during the $label capture"
    irq_delta_py "$out/irq-$kind-before.txt" "$out/irq-$kind-after.txt" | tee -a "$report"
  fi
  say "-- kernel messages since the $label capture began"
  kdmesg | tail -n +$((dm_mark + 1)) | grep -iE 'csi2-phy|ace4000|acec000|phy-ace|vb2|Link|validat|camss|vd55g|csid|csiphy|vfe' | tail -n 60 | tee -a "$report"

  sz=0
  [[ -f $raw ]] && sz=$(stat -c %s "$raw")
  need=$((nframes * size))
  if ((sz > 0)); then
    say "-- frame statistics ($code/$fourcc ${w}x${h}, stride $bpl)"
    stats_py "$raw" "$w" "$h" "$bpl" "$size" "$bits" | tee -a "$report"
  fi
  if ((!ok_stream)); then
    verdict FAIL "stream failed ($videodev: STREAMON error or timeout, $sz of $need bytes); if frames time out try --mclk-hz 24000000 (Windows says MCLK 24 MHz)"
  elif ((sz >= need)); then
    verdict PASS "captured $nframes frames $code/$fourcc ${w}x${h} stride $bpl ($raw)"
  else
    verdict FAIL "capture short: $sz of $need bytes ($nframes x $size)"
  fi
}

if ((capture)); then
  section "IR capture"
  if ((debug)); then debug_on; trap debug_off EXIT; fi
  if [[ -n $media_dev ]]; then
    capture_cam ir vd55g "$ir_dev" msm_csid0 msm_vfe0_rdi0 "$frames" 644 604
  else
    info "IR capture skipped: no CAMSS media device"
  fi
  section "RGB raw capture (informational: libcamera already drives the RGB camera)"
  if [[ -n $media_dev ]]; then
    rgb_w=1928 rgb_h=1092
    if [[ -n $rgb_dev ]]; then
      rgb_ent=$(sed -n 's/^- entity [0-9]*: \(ov02c10[^(]*[^( ]\) (.*/\1/p' "$out/media-ctl-p.txt" | head -n1)
      rgb_cur=$(media-ctl -d "$media_dev" --get-v4l2 "\"$rgb_ent\":0" 2>/dev/null | grep -oE '/[0-9]+x[0-9]+' | head -n1 | tr -d /) || true
      if [[ $rgb_cur =~ ^([0-9]+)x([0-9]+)$ ]]; then rgb_w=${BASH_REMATCH[1]} rgb_h=${BASH_REMATCH[2]}; fi
    fi
    capture_cam rgb ov02c10 "$rgb_dev" msm_csid1 msm_vfe1_rdi0 10 "$rgb_w" "$rgb_h"
  else
    info "RGB capture skipped: no CAMSS media device"
  fi
  debug_off
fi

# ---------------------------------------------------------------- leds
section "Illuminator (not touched)"
leds=""
for l in "$sysfs"/class/leds/*; do
  [[ -e $l ]] || continue
  [[ ${l##*/} =~ [Ff]lash|[Ii][Rr]|[Tt]orch ]] && leds+="${l##*/} "
done
say "flash/IR-like LED class devices: ${leds:-none} (read only, nothing written)"
info "illuminator: not described in the device tree and not touched by this script"

# ---------------------------------------------------------------- summary
section "SUMMARY"
printf '%s\n' "${summary[@]}" | tee -a "$report"
say ""
say "report: $report"
say "files: $out"
if [[ -n ${SUDO_UID:-} ]]; then chown -R "$SUDO_UID:${SUDO_GID:-$SUDO_UID}" "$out" 2>/dev/null || true; fi
exit "$rc"
