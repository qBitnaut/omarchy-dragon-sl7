# SPDX-License-Identifier: GPL-2.0-only
# Maintainer: omarchy-dragon-sl7 <https://github.com/qBitnaut/omarchy-dragon-sl7>
#
# linux-sl7: Linux for the Microsoft Surface Laptop 7 (Snapdragon X Plus/Elite)
# running Arch Linux ARM + Omarchy.
#
# Derived from the Arch Linux ARM core/linux-aarch64 PKGBUILD and config
# (Kevin Mihelich, graysky), with a patch queue and a config fragment on top.
# Side-by-side design: this package never provides or conflicts with
# linux-aarch64 or linux, installs nothing into /boot, and keeps its DTBs in
# a private directory so linux-aarch64 stays installable as a rescue kernel.

pkgbase=linux-sl7
pkgname=("$pkgbase" "$pkgbase-headers")
_srcname=linux-7.2
_desc="Microsoft Surface Laptop 7"
pkgver=7.2.8
pkgrel=1
arch=('aarch64')
url="https://github.com/qBitnaut/omarchy-dragon-sl7"
license=('GPL-2.0-only')
makedepends=('bc' 'cpio' 'dtc' 'git' 'inetutils' 'kmod' 'pahole' 'perl' 'python' 'tar' 'xz')
options=('!strip')

# The two downloads are pinned to the kernel.org sha256sums.asc values. Files
# from this directory are covered by the repository's git history instead.
source=("https://www.kernel.org/pub/linux/kernel/v7.x/${_srcname}.tar.xz"
