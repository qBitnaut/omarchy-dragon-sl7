# linux-sl7 config fragment, merged over config.alarm (ALARM core/linux-aarch64)
# with scripts/kconfig/merge_config.sh, then resolved with `make olddefconfig`.
# scripts/check-config.sh asserts every option below after resolution.

# Internal keyboard (Surface Aggregator, incl. at the LUKS prompt), fan, profile
CONFIG_SURFACE_PLATFORMS=y
CONFIG_SURFACE_AGGREGATOR=m
CONFIG_SURFACE_AGGREGATOR_BUS=y
CONFIG_SURFACE_AGGREGATOR_REGISTRY=m
CONFIG_SURFACE_AGGREGATOR_HUB=m
CONFIG_SURFACE_HID=m
CONFIG_SURFACE_HID_CORE=m
CONFIG_SURFACE_PLATFORM_PROFILE=m
CONFIG_SENSORS_SURFACE_FAN=m

# Touchpad and SPI touchscreen (spi-hid v4 series, QSPI in spi-geni-qcom)
CONFIG_SPI_HID=m
CONFIG_SPI_HID_OF=m

# Battery life: schedutil, and SCMI cpufreq built in so no autoload series
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ARM_SCMI_CPUFREQ=y

# Read zstd-compressed firmware too (ALARM ships firmware uncompressed and only
# enables XZ; Arch and Arch Ports ship .zst, and on the recon stick ath12k
# amss.bin and the Romulus audio topology failed to load with -2 without it)
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Hardware video decode
CONFIG_VIDEO_QCOM_IRIS=m
CONFIG_SM_VIDEOCC_8550=m

# Cameras (Phase A of IR face unlock): X1E CAMSS with the standalone CSI2 DPHY
# driver and CCI, the front RGB OV02C10, the IR VD55G0 (vd55g replaces vd55g1)
# and the PMIC flash LED class. The flash LED is not described in the device
# tree yet, so nothing can fire the illuminator.
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_PHY_QCOM_MIPI_CSI2=m
CONFIG_I2C_QCOM_CCI=m
CONFIG_CLK_X1E80100_CAMCC=m
CONFIG_V4L2_FWNODE=m
CONFIG_V4L2_CCI_I2C=m
CONFIG_VIDEO_OV02C10=m
CONFIG_VIDEO_VD55G=m
CONFIG_LEDS_CLASS_FLASH=m
CONFIG_LEDS_QCOM_FLASH=m
CONFIG_V4L2_FLASH_LED_CLASS=m

# Read-only firmware power telemetry (CPU clusters, GPU, system, USB) via hwmon,
# patches 0082-0083; read by sl7-powermeter
CONFIG_SENSORS_QCOM_PLD_POWER=m

# No Qualcomm Crypto Engine. On 7.2 qcrypto (1dfa000.crypto) holds a permanent
# 393600 kBps ALWAYS-tagged crypto -> EBI1 interconnect vote with no runtime PM,
# which keeps DDR from collapsing in suspend. 7.3 marks it BROKEN (df373d39c6f0),
# and the ARMv8 Crypto Extensions cover the kernel's crypto needs.
# CONFIG_CRYPTO_DEV_QCE is not set

# Memory (synced from Omarchy's linux-omarchy-aarch64 config): zswap on at boot
# with its shrinker, zram defaulting to zstd (zstd and lz4 backends), MGLRU
# enabled, transparent huge pages always
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_SHRINKER_DEFAULT_ON=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_DEF_COMP="zstd"
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y
# CONFIG_TRANSPARENT_HUGEPAGE_MADVISE is not set

# Maximum ASLR entropy for 4K pages (39-bit VA gives 18, 48-bit gives 33)
CONFIG_ARCH_MMAP_RND_BITS=33

# Security modules: lockdown (off until requested), IMA with a readable and
# writable policy, BPF LSM; the LSM order matches Omarchy
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_BPF_LSM=y
CONFIG_INTEGRITY=y
CONFIG_IMA=y
CONFIG_IMA_READ_POLICY=y
CONFIG_IMA_WRITE_POLICY=y
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"

# BTF for BPF CO-RE (needs DWARF 5 debug info and pahole), no debug-preempt checks
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y
# CONFIG_DEBUG_PREEMPT is not set

# Signed modules (ephemeral per-build key, not forced), sha512 like Omarchy;
# the in-tree build of v4l2loopback is signed by modules_install as well
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_HASH="sha512"

# Kexec handover available, off unless kho=on is passed
CONFIG_KEXEC_HANDOVER=y
# CONFIG_KEXEC_HANDOVER_ENABLE_DEFAULT is not set
