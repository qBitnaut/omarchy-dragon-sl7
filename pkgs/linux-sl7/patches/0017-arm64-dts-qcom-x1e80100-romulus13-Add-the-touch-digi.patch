From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: omarchy-dragon-sl7 <noreply@users.noreply.github.com>
Date: Sat, 3 Oct 2026 22:01:34 -0500
Subject: [PATCH] arm64: dts: qcom: x1e80100-romulus13: Add the touch digitizer

Microsoft G6 HID over SPI digitizer (MSHW0460) on QUP1 SE2, four lane
transfers through GPI DMA. Surface Laptop 7 13.8 inch units with the
Surface Touch G6 module only; TBID 2/3 units use an I2C touchscreen
(MSHW0468) instead and are not covered here.

Device description comes from the GTCH device in the Windows SSDT:

  gpio 51        GpioInt (Edge, ActiveLow, PullUp)
  gpio 64        VDD enable (GI64)
  gpio 48        reset (GI48)
  40 MHz         SpiSerialBusV2 0x02625A00, mode 0, CS0
  addresses      _DSM functions 1 to 3
  opcodes        _DSM functions 4 and 5

The node mirrors the Surface Pro 11 digitizer from dwhinham/linux-sp11
(6080c70979, x1-microsoft-denali.dtsi) which has identical wiring, and
the controller side follows orvitpng's Nix flake (devicetree/hardware/
qspi.dtsi and touch/touchscreen.dtsi at commit b274dd722fb1).

Origin: https://github.com/dwhinham/linux-sp11 (6080c70979),
        https://github.com/orvitpng/nix1e (b274dd7)
Upstream-Status: Pending (depends on the spi-hid and QSPI series)

---
 .../dts/qcom/x1e80100-microsoft-romulus13.dts | 89 +++++++++++++++++++
 1 file changed, 89 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus13.dts b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus13.dts
index eb7580dd9..6b20de1ae 100644
--- a/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus13.dts
+++ b/arch/arm64/boot/dts/qcom/x1e80100-microsoft-romulus13.dts
@@ -5,9 +5,98 @@
 
 /dts-v1/;
 
+#include <dt-bindings/dma/qcom-gpi.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
 #include "x1e80100-microsoft-romulus.dtsi"
 
 / {
 	model = "Microsoft Surface Laptop 7 (13.8 inch)";
 	compatible = "microsoft,romulus13", "qcom,x1e80100";
+
+	vreg_ts: regulator-ts {
+		compatible = "regulator-fixed";
+
+		regulator-name = "VREG_TS";
+
+		gpio = <&tlmm 64 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+
+		startup-delay-us = <10000>;
+
+		pinctrl-0 = <&ts_reg_en>;
+		pinctrl-names = "default";
+	};
+};
+
+&gpi_dma1 {
+	status = "okay";
+};
+
+/*
+ * Touch digitizer (GTCH, MSHW0460 on units with a Surface Touch G6 module):
+ * HID over SPI in QSPI mode on QUP1 SE2. Wiring from the ACPI GTCH device:
+ * SpiSerialBusV2 40 MHz mode 0, IRQ GPIO51, reset GPIO48, VDD enable GPIO64.
+ */
+&spi10 {
+	compatible = "qcom,geni-spi-qspi";
+
+	dmas = <&gpi_dma1 0 2 QCOM_GPI_QSPI>,
+	       <&gpi_dma1 1 2 QCOM_GPI_QSPI>;
+
+	pinctrl-0 = <&qup_spi10_data_clk>, <&qup_spi10_data23>, <&qup_spi10_cs>;
+
+	status = "okay";
+
+	touchscreen@0 {
+		compatible = "microsoft,g6-touch-digitizer", "hid-over-spi";
+		reg = <0>;
+
+		interrupts-extended = <&tlmm 51 IRQ_TYPE_EDGE_FALLING>;
+		spi-max-frequency = <40000000>;
+
+		reset-gpios = <&tlmm 48 GPIO_ACTIVE_LOW>;
+
+		vdd-supply = <&vreg_ts>;
+
+		pinctrl-0 = <&ts_int_n>, <&ts_reset_n>;
+		pinctrl-names = "default";
+
+		input-report-header-address = <0x1000>;
+		input-report-body-address = <0x1004>;
+		output-report-address = <0x2000>;
+		read-opcode = <0xeb>;
+		write-opcode = <0xe2>;
+	};
+};
+
+&tlmm {
+	ts_reg_en: ts-reg-en-state {
+		pins = "gpio64";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	ts_reset_n: ts-reset-n-state {
+		pins = "gpio48";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	qup_spi10_data23: qup-spi10-data23-state {
+		/* IO2, IO3 */
+		pins = "gpio49", "gpio50";
+		function = "qup1_se2";
+		drive-strength = <6>;
+		bias-disable;
+	};
+
+	ts_int_n: ts-int-n-state {
+		pins = "gpio51";
+		function = "gpio";
+		bias-pull-up;
+	};
 };
