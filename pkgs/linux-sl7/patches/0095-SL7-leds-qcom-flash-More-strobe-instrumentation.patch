From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: omarchy-dragon-sl7 <noreply@users.noreply.github.com>
Date: Wed, 7 Oct 2026 15:01:00 -0500
Subject: [PATCH] SL7 local: leds: qcom-flash: More strobe instrumentation (0x4f, 0x55, 0x67, 0x68, +1 ms, STATUS3)

Extends the read-only strobe instrumentation of 0093 for IR stage C, after a
software strobe showed STATUS1 = 0x82 (channels 1 and 4 open circuit) and
INT_RT_STS = 0x49 (fault and ramp-down, ramp-up never) with no current:

 - four more registers in every full read: 0x4f, 0x55, 0x67, 0x68 (0x67 bit 0
   is the one Windows sets with the strobe configuration, 0x55 the one nobody
   writes)
 - a +1 ms moment, and a separate read of STATUS3 (0x09) at +15 ms before the
   full read, logged on its own line
 - the t0 and +1 ms moments read only the key registers (STATUS1-3, INT_RT_STS,
   INT_LATCHED_STS, MODULE_EN, CHAN_EN) so that the +1 ms read lands on time
   instead of behind a 27-register read; +3 ms and +15 ms stay full
 - the waits aim at an absolute time after t0 (they used to add up, so a slow
   read pushed the later ones back); every line now says when its read actually
   started and carries the monotonic time (t_mono, the clock of V4L2 frame
   timestamps), so a pulse can be placed against frame arrivals.

Still read-only, inactive unless the LED is an IR LED with ir_test=1. No pulse
width, current, timer or clamp changes.

Origin: ours
Upstream-Status: Not submitted
---
diff --git a/drivers/leds/flash/leds-qcom-flash.c b/drivers/leds/flash/leds-qcom-flash.c
index b9b2eb5b4db8..aa0604b0c642 100644
--- a/drivers/leds/flash/leds-qcom-flash.c
+++ b/drivers/leds/flash/leds-qcom-flash.c
@@ -155,11 +155,17 @@ MODULE_PARM_DESC(ir_max_ua,

 /*
  * Strobe instrumentation of the IR LED (ir_test=1 only, read-only): the flash
- * registers at five moments of one strobe, buffered and logged afterwards.
+ * registers at several moments of one strobe, buffered and logged afterwards.
+ * "key" moments read only the registers of sl7_snap_key[] so they land on time; "full"
+ * moments read every register in sl7_snap_regs[].
  */
-#define SL7_SNAP_MOMENTS		5
+#define SL7_SNAP_MOMENTS		6
+/* seconds and microseconds of a microsecond count, as s64 for %lld */
+#define SL7_SEC(us)			((s64)(us) / 1000000LL)
+#define SL7_USEC(us)			((s64)(us) % 1000000LL)
 #define SL7_SNAP_NREGS			ARRAY_SIZE(sl7_snap_regs)
 #define SL7_SNAP_FAILED			0xffff
+#define SL7_SNAP_SKIPPED		0xfffe

 static const u8 sl7_snap_regs[] = {
 	0x06, 0x07, 0x08, 0x09,		/* STATUS1-3 and the one after */
@@ -172,16 +178,15 @@ static const u8 sl7_snap_regs[] = {
 	0x49,				/* IRESOLUTION */
 	0x4a, 0x4d,			/* CHAN_STROBE ch1, ch4 */
 	0x4e,				/* CHAN_EN */
+	0x4f,
 	0x50, 0x51, 0x52, 0x53,
+	0x55,
+	0x67,
+	0x68,
 };

-static const char * const sl7_snap_names[SL7_SNAP_MOMENTS] = {
-	"idle before arm",
-	"t0, after CHAN_EN set",
-	"t0+3ms",
-	"t0+15ms",
-	"after strobe off",
-};
+/* Registers of the key moments: STATUS1-3, INT_RT_STS, INT_LATCHED_STS, MODULE_EN, CHAN_EN */
+static const u8 sl7_snap_key[] = { 0x06, 0x07, 0x09, 0x10, 0x18, 0x46, 0x4e };

 static bool ir_test;
 module_param(ir_test, bool, 0400);
@@ -306,7 +311,12 @@ struct qcom_flash_led {
 	bool				enabled;
 	bool				ir;	/* SL7 local: IR emitter, see SL7_IR_* */
 	u16				sl7_snap[SL7_SNAP_MOMENTS][SL7_SNAP_NREGS];
+	const char			*sl7_snap_label[SL7_SNAP_MOMENTS];
+	s64				sl7_snap_start_us[SL7_SNAP_MOMENTS];
 	s64				sl7_snap_us[SL7_SNAP_MOMENTS];
+	s64				sl7_snap_mono_us[SL7_SNAP_MOMENTS];
+	u16				sl7_s3_15;
+	s64				sl7_s3_15_us;
 };

 /*
@@ -755,13 +765,31 @@ static int qcom_flash_strobe_set_hw(struct qcom_flash_led *led, bool state)
 }

 /* SL7 local: read-only register reads for the strobe instrumentation */
-static void sl7_ir_snap(struct qcom_flash_led *led, int moment, ktime_t t0)
+static bool sl7_snap_is_key(u8 reg)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(sl7_snap_key); i++)
+		if (sl7_snap_key[i] == reg)
+			return true;
+	return false;
+}
+
+static void sl7_ir_snap(struct qcom_flash_led *led, int moment, ktime_t t0,
+			const char *label, bool full)
 {
 	struct qcom_flash_data *flash_data = led->flash_data;
 	unsigned int val;
 	int i;

+	led->sl7_snap_label[moment] = label;
+	led->sl7_snap_start_us[moment] = ktime_to_us(ktime_sub(ktime_get(), t0));
+	led->sl7_snap_mono_us[moment] = ktime_to_us(ktime_get());
 	for (i = 0; i < SL7_SNAP_NREGS; i++) {
+		if (!full && !sl7_snap_is_key(sl7_snap_regs[i])) {
+			led->sl7_snap[moment][i] = SL7_SNAP_SKIPPED;
+			continue;
+		}
 		if (regmap_read(flash_data->regmap,
 				flash_data->reg_base + sl7_snap_regs[i], &val))
 			val = SL7_SNAP_FAILED;
@@ -770,6 +798,15 @@ static void sl7_ir_snap(struct qcom_flash_led *led, int moment, ktime_t t0)
 	led->sl7_snap_us[moment] = ktime_to_us(ktime_sub(ktime_get(), t0));
 }

+/* Sleep until us microseconds after t0 (not at all when that is already past). */
+static void sl7_ir_sleep_until(ktime_t t0, s64 us)
+{
+	s64 rem = us - ktime_to_us(ktime_sub(ktime_get(), t0));
+
+	if (rem > 0)
+		usleep_range(rem, rem + 100);
+}
+
 /* One dev_info line for a buffered moment, printed after the strobe moment. */
 static void sl7_ir_snap_print(struct qcom_flash_led *led, int moment)
 {
@@ -777,6 +814,8 @@ static void sl7_ir_snap_print(struct qcom_flash_led *led, int moment)
 	int i, len = 0;

 	for (i = 0; i < SL7_SNAP_NREGS; i++) {
+		if (led->sl7_snap[moment][i] == SL7_SNAP_SKIPPED)
+			continue;
 		if (led->sl7_snap[moment][i] == SL7_SNAP_FAILED)
 			len += scnprintf(buf + len, sizeof(buf) - len,
 					 " %02x=--", sl7_snap_regs[i]);
@@ -787,14 +826,18 @@ static void sl7_ir_snap_print(struct qcom_flash_led *led, int moment)
 	}

 	dev_info(led->flash.led_cdev.dev,
-		 "SL7 IR strobe snapshot (%s, read done %lld us after its reference, offsets from %#x):%s\n",
-		 sl7_snap_names[moment], led->sl7_snap_us[moment],
+		 "SL7 IR strobe snapshot (%s, started %lld us, read done %lld us after its reference, t_mono %lld.%06lld, offsets from %#x):%s\n",
+		 led->sl7_snap_label[moment], led->sl7_snap_start_us[moment],
+		 led->sl7_snap_us[moment],
+		 SL7_SEC(led->sl7_snap_mono_us[moment]),
+		 SL7_USEC(led->sl7_snap_mono_us[moment]),
 		 led->flash_data->reg_base, buf);
 }

 static int qcom_flash_strobe_set(struct led_classdev_flash *fled_cdev, bool state)
 {
 	struct qcom_flash_led *led = flcdev_to_qcom_fled(fled_cdev);
+	unsigned int val;
 	ktime_t t0;
 	int rc, i;

@@ -805,8 +848,13 @@ static int qcom_flash_strobe_set(struct led_classdev_flash *fled_cdev, bool stat
 	 * the delays below, which end the pulse on their own, so the sleeps
 	 * only delay the return of this call, never the pulse. The values are
 	 * logged after the last read, never in between. References: t0 is the
-	 * return of the arming call for the first three moments, the start of
-	 * the disarm call for the last.
+	 * return of the arming call for the moments after the arm, the start of
+	 * the disarm call for the last. The sleeps aim at an absolute time after
+	 * t0, so a slow snapshot does not push the later ones back (the line
+	 * says when each read actually started).
+	 *
+	 * Moments: idle (full), t0 (key registers), +1 ms (key), +3 ms (full),
+	 * +15 ms (STATUS3 on its own first, then full), after strobe off (full).
 	 */
 	if (!led->ir || !ir_test || led->flash_data->hw_type != QCOM_MVFLASH_4CH)
 		return qcom_flash_strobe_set_hw(led, state);
@@ -814,26 +862,36 @@ static int qcom_flash_strobe_set(struct led_classdev_flash *fled_cdev, bool stat
 	if (!state) {
 		t0 = ktime_get();
 		rc = qcom_flash_strobe_set_hw(led, false);
-		sl7_ir_snap(led, 4, t0);
-		sl7_ir_snap_print(led, 4);
+		sl7_ir_snap(led, 5, t0, "after strobe off", true);
+		sl7_ir_snap_print(led, 5);
 		return rc;
 	}

 	t0 = ktime_get();
-	sl7_ir_snap(led, 0, t0);
+	sl7_ir_snap(led, 0, t0, "idle before arm", true);
 	rc = qcom_flash_strobe_set_hw(led, true);
 	if (rc)
 		return rc;

 	t0 = ktime_get();
-	sl7_ir_snap(led, 1, t0);
-	usleep_range(3000, 3100);
-	sl7_ir_snap(led, 2, t0);
-	usleep_range(11800, 12000);
-	sl7_ir_snap(led, 3, t0);
+	sl7_ir_snap(led, 1, t0, "t0, after CHAN_EN set", false);
+	sl7_ir_sleep_until(t0, 1000);
+	sl7_ir_snap(led, 2, t0, "t0+1ms", false);
+	sl7_ir_sleep_until(t0, 3000);
+	sl7_ir_snap(led, 3, t0, "t0+3ms", true);
+	sl7_ir_sleep_until(t0, 15000);
+	if (regmap_read(led->flash_data->regmap,
+			led->flash_data->reg_base + 0x09, &val))
+		val = SL7_SNAP_FAILED;
+	led->sl7_s3_15 = val;
+	led->sl7_s3_15_us = ktime_to_us(ktime_sub(ktime_get(), t0));
+	sl7_ir_snap(led, 4, t0, "t0+15ms", true);

-	for (i = 0; i < 4; i++)
+	for (i = 0; i < 5; i++)
 		sl7_ir_snap_print(led, i);
+	dev_info(led->flash.led_cdev.dev,
+		 "SL7 IR strobe snapshot STATUS3 at t0+15ms: 09=%02x (read %lld us after t0)\n",
+		 led->sl7_s3_15, led->sl7_s3_15_us);

 	return 0;
 }
