From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Johan Hovold <johan+linaro@kernel.org>
Date: Wed, 11 Sep 2024 10:50:36 +0200
Subject: [PATCH] pm_domain: defer disabling of unused domains, behind
 clk_unused_defer

Backport of commit b3f09e07cfbb79048ece5b798e54e85ea01a6880 in
jhovold/linux (not in mainline), "pm_domain: defer disabling of unused
domains".

Defer disabling of unused power domains for 30 seconds to allow modular
power domain providers and consumers to be probed.

SL7 change: opt-in under the same "clk_unused_defer" command line flag as the
previous patch (clk_unused_defer_requested()); without it the power-off stays
in the late_initcall as before. pd_ignore_unused still wins when present.

Signed-off-by: Johan Hovold <johan+linaro@kernel.org>
---
--- a/drivers/pmdomain/core.c
+++ b/drivers/pmdomain/core.c
@@ -6,6 +6,7 @@
  */
 #define pr_fmt(fmt) "PM: " fmt
 
+#include <linux/clk.h>
 #include <linux/delay.h>
 #include <linux/idr.h>
 #include <linux/kernel.h>
@@ -1432,9 +1433,9 @@
 __setup("pd_ignore_unused", pd_ignore_unused_setup);
 
 /**
- * genpd_power_off_unused - Power off all PM domains with no devices in use.
+ * genpd_power_off_unused_now - Power off all PM domains with no devices in use.
  */
-static int __init genpd_power_off_unused(void)
+static int genpd_power_off_unused_now(void)
 {
 	struct generic_pm_domain *genpd;
 
@@ -1454,6 +1455,30 @@
 
 	return 0;
 }
+
+static void genpd_init_complete_work_function(struct work_struct *work)
+{
+	genpd_power_off_unused_now();
+}
+
+static DECLARE_DELAYED_WORK(genpd_init_complete_work,
+			    genpd_init_complete_work_function);
+
+/*
+ * With "clk_unused_defer" on the command line (opt-in, see drivers/clk/clk.c)
+ * the power-off is postponed by 30 seconds so that modular power domain
+ * providers and consumers can probe first.
+ */
+static int __init genpd_power_off_unused(void)
+{
+	if (!clk_unused_defer_requested())
+		return genpd_power_off_unused_now();
+
+	pr_info("genpd: Deferring the disabling of unused power domains by 30 s\n");
+	schedule_delayed_work(&genpd_init_complete_work, msecs_to_jiffies(30000));
+
+	return 0;
+}
 late_initcall_sync(genpd_power_off_unused);
 
 #ifdef CONFIG_PM_SLEEP
