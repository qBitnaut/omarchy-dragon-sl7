# Maintainer: qBitnaut <19711592+qBitnaut@users.noreply.github.com>
#
# libcamera 0.7.2 for the Surface Laptop 7 (aarch64), rebuilt from the Arch
# Linux ARM PKGBUILD (extra/libcamera, pkgrel 4, Kevin Mihelich / David Runge /
# Carl Smedstad) with a camera sensor helper for the OV02C10 front camera
# (0001-...), without which the software ISP cannot run AGC for that sensor, and
# three software ISP fixes for it (0002-0004). Differences from the ALARM package:
#   - pkgrel 4.2 sorts above ALARM's 4, so the omarchy-sl7 repository wins
#   - 0001-ipa-libipa-camera_sensor_helper-add-ov02c10.patch
#   - 0002-ipa-simple-agc-converge-quickly-after-stream-start.patch
#   - 0003-libcamera-software_isp-debayer_egl-compute-stats-on-the-displayed-area.patch
#   - 0004-ipa-simple-adjust-read-default-gamma-contrast-saturation-from-tuning.patch
#   - -Dwerror=false: ALARM's GCC 16 reports a false -Warray-bounds in libcamera's
#     logger (std::make_shared<LogOutput>) that libcamera's -Werror turns fatal
#   - no libcamera-docs package (documentation disabled: it needs TeX Live),
#     tests not built or run (check() dropped)
#   - the python patch has its trailing whitespace stripped (CI lint)
# The package names, dependencies and the IPA module signing are unchanged: the
# build generates a fresh IPA signing key, libcamera.so embeds the public half
# and libcamera-ipa carries the signed modules, so the packages must come from
# the same build.

pkgbase=libcamera
pkgname=(
  libcamera
  libcamera-ipa
  libcamera-tools
  gst-plugin-libcamera
  python-libcamera
)
pkgver=0.7.2
pkgrel=4.2
pkgdesc="A complex camera support library for Linux, Android, and ChromeOS"
arch=(aarch64)
url="https://libcamera.org/"
_url=https://git.libcamera.org/libcamera/libcamera.git
makedepends=(
  cmake
  git
  glib2
  gst-plugins-base
  gtest
  libdrm
  libevent
  libgcc
  libjpeg-turbo
  libstdc++
  libpisp
  libtiff
  libyaml
  libyuv
  meson
  openssl
  pybind11
  python-jinja
  python-ply
  python-pyyaml
  qt6-base
  qt6-tools
  sdl2
  systemd
)
source=(
  "git+$_url#tag=v$pkgver"
  "$pkgbase-fix-python3.14-macro-redefinition.patch"
  "0001-ipa-libipa-camera_sensor_helper-add-ov02c10.patch"
  "0002-ipa-simple-agc-converge-quickly-after-stream-start.patch"
  "0003-libcamera-software_isp-debayer_egl-compute-stats-on-the-displayed-area.patch"
  "0004-ipa-simple-adjust-read-default-gamma-contrast-saturation-from-tuning.patch"
)
sha256sums=('SKIP'
            '8e8b99ff804ffd75d9bbc845dd4616edf0e0cea7c0eb175e47583b8488f33368'
            '9e01e2cb82c120b5140345e00527c1b9362b322f79e471ba42d1bda2b5d55a13'
            'd519f2180bf297357b5c56ea3d9152e3f96e35f976dc6e60ae1f20705722aaf9'
            '5e8ab7f0e4f373c9b7f296d89ecc72b6b0bd3a3e8c77b2a2aa4b5e6aff51c2e3'
            'efe0c1ca05644f1884cca210e292374b5e9a21cd3b5ae5af466b2a51041eda45')

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

prepare() {
  cd $pkgbase
  patch -Np1 < ../$pkgbase-fix-python3.14-macro-redefinition.patch
  patch -Np1 < ../0001-ipa-libipa-camera_sensor_helper-add-ov02c10.patch
  patch -Np1 < ../0002-ipa-simple-agc-converge-quickly-after-stream-start.patch
  patch -Np1 < ../0003-libcamera-software_isp-debayer_egl-compute-stats-on-the-displayed-area.patch
  patch -Np1 < ../0004-ipa-simple-adjust-read-default-gamma-contrast-saturation-from-tuning.patch

  # add version, so that utils/gen-version.sh may rely on it
  printf "%s\n" "$pkgver" > .tarball-version
}

build() {
  local meson_options=(
    -D v4l2=enabled
    -D tracing=disabled
    -D test=false
    -D documentation=disabled
    -D rpi-awb-nn=disabled
    -D werror=false
  )

  arch-meson $pkgbase build "${meson_options[@]}"
  meson compile -C build
}

package_libcamera() {
  license=(
    Apache-2.0
    CC0-1.0
    'GPL-2.0-only WITH Linux-syscall-note'
    GPL-2.0-or-later
    LGPL-2.1-or-later
    'GPL-2.0-or-later WITH Linux-syscall-note OR BSD-3-Clause'
    'GPL-2.0-or-later WITH Linux-syscall-note OR MIT'
  )
  depends=(
    glibc
    gnutls
    libcamera-ipa
    libelf
    libgcc
    libglvnd
    libpisp
    libstdc++
    libunwind
    libyaml
    libyuv
    sh
    systemd-libs libudev.so
  )
  optdepends=(
    'gst-plugin-libcamera: GStreamer plugin'
    'libcamera-tools: for applications'
  )
  provides=(libcamera.so libcamera-base.so)

  meson install -C build --destdir "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/{BSD-3-Clause,Linux-syscall-note,MIT}.txt -t "$pkgdir/usr/share/licenses/$pkgname/"

  (
    cd "$pkgdir"
    _pick $pkgbase-ipa usr/lib/libcamera/
    _pick $pkgbase-tools usr/bin/{cam,libcamera-bug-report,lc-compliance,qcam}
    _pick gst-plugin-$pkgbase usr/lib/gstreamer-*
    _pick python-$pkgbase usr/lib/python*
  )
}

package_libcamera-ipa() {
  pkgdesc+=" - signed IPA"
  license=(
    BSD-2-Clause
    CC-BY-SA-4.0
    CC0-1.0
    GPL-2.0-or-later
    LGPL-2.1-or-later
  )
  depends=(
    glibc
    libcamera libcamera.so libcamera-base.so
    libgcc
    libstdc++
  )
  # stripping requires re-signing of IPA libs, so we do it manually
  options=(!strip)

  strip $pkgname/usr/lib/libcamera/*{.so,proxy}
  for _lib in $pkgname/usr/lib/libcamera/*.so; do
    $pkgbase/src/ipa/ipa-sign.sh "$(find build -type f -iname "*ipa-priv-key.pem")" "$_lib" "$_lib.sign"
  done
  mv -v $pkgname/* "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_libcamera-tools() {
  pkgdesc+=" - tools"
  license=(
    BSD-2-Clause
    CC0-1.0
    GPL-2.0-or-later
    LGPL-2.1-or-later
  )
  depends=(
    glibc
    gtest
    libcamera libcamera.so libcamera-base.so
    libdrm
    libevent libevent-2.1.so libevent_pthreads-2.1.so
    libgcc
    libjpeg-turbo libjpeg.so
    libstdc++
    libtiff libtiff.so
    libyaml
    qt6-base
    sdl2
  )
  conflicts=("$pkgbase-tests<0.0.1-2")
  replaces=("$pkgbase-tests<0.0.1-2")

  mv -v $pkgname/* "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_gst-plugin-libcamera() {
  pkgdesc="Multimedia graph framework - libcamera plugin"
  license=(
    CC0-1.0
    LGPL-2.1-or-later
  )
  depends=(
    glib2 libg{lib,object}-2.0.so
    glibc
    gst-plugins-base-libs
    gstreamer
    libcamera libcamera.so libcamera-base.so
    libgcc
    libstdc++
  )

  mv -v $pkgname/* "$pkgdir"
}

package_python-libcamera() {
  pkgdesc+=" - Python integration"
  license=(
    CC0-1.0
    LGPL-2.1-or-later
  )
  depends=(
    glibc
    libcamera
    libgcc
    libstdc++
    python
  )

  mv -v $pkgname/* "$pkgdir"
}
