+/*
+ * A sample at or above this percentage of the full scale value is considered
+ * clipped. Right below the sensor saturation level the response is no longer
+ * linear, so such samples bias the white balance statistics.
+ */
+static constexpr unsigned int kClipPercent = 97;
+
+static constexpr uint16_t kClipLevel(unsigned int bitDepth)
+{
+	return (((1u << bitDepth) - 1) * kClipPercent) / 100;
+}
+
 static constexpr unsigned int kRedYMul = 77; /* 0.299 * 256 */
 static constexpr unsigned int kGreenYMul = 150; /* 0.587 * 256 */
 static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
@@ -177,22 +191,49 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
                                           \
 	uint64_t sumR = 0;                \
 	uint64_t sumG = 0;                \
-	uint64_t sumB = 0;
+	uint64_t sumB = 0;                \
+                                          \
+	bool clipped;                     \
+	uint32_t nBlocks = 0;             \
+	uint32_t nUnclipped = 0;          \
+	uint64_t sumUnclippedR = 0;       \
+	uint64_t sumUnclippedG = 0;       \
+	uint64_t sumUnclippedB = 0;
+
+/*
+ * Must be called before the two green samples are averaged. A 2x2 block is
+ * clipped when any of its four samples is at or above clipLevel_.
+ */
+#define SWSTATS_CHECK_CLIPPED() \
+	clipped = std::max({ r, g, g2, b }) >= clipLevel_;

 #define SWSTATS_ACCUMULATE_LINE_STATS(div) \
 	sumR += r;                         \
 	sumG += g;                         \
 	sumB += b;                         \
                                            \
+	nBlocks++;                         \
+	if (!clipped) {                    \
+		sumUnclippedR += r;        \
+		sumUnclippedG += g;        \
+		sumUnclippedB += b;        \
+		nUnclipped++;              \
+	}                                  \
+                                           \
 	yVal = r * kRedYMul;               \
 	yVal += g * kGreenYMul;            \
 	yVal += b * kBlueYMul;             \
 	stats.yHistogram[yVal * SwIspStats::kYHistogramSize / (256 * 256 * (div))]++;

-#define SWSTATS_FINISH_LINE_STATS() \
-	stats.sum_.r() += sumR;     \
-	stats.sum_.g() += sumG;     \
-	stats.sum_.b() += sumB;
+#define SWSTATS_FINISH_LINE_STATS()                    \
+	stats.sum_.r() += sumR;                        \
+	stats.sum_.g() += sumG;                        \
+	stats.sum_.b() += sumB;                        \
+	stats.sumUnclipped_.r() += sumUnclippedR;      \
+	stats.sumUnclipped_.g() += sumUnclippedG;      \
+	stats.sumUnclipped_.b() += sumUnclippedB;      \
+	stats.nBlocks += nBlocks;                      \
+	stats.nUnclipped += nUnclipped;

