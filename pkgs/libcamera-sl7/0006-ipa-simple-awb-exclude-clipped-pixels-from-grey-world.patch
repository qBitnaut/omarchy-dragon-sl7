 namespace ipa::soft::algorithms {

+/*
+ * Clipped samples carry no colour information, and in bright scenes the
+ * green channel clips well before red and blue, which biases a grey world
+ * estimate towards green. The statistics therefore also provide sums over the
+ * 2x2 blocks without any clipped sample. They are used when enough blocks
+ * remain: below kMinUnclippedRatio the estimate from all the blocks is used
+ * alone, above kFullUnclippedRatio the estimate from the unclipped blocks is
+ * used alone, and in between the two are blended, so that the gains do not
+ * jump when the clipped fraction crosses a threshold.
+ */
+static constexpr float kMinUnclippedRatio = 0.05;
+static constexpr float kFullUnclippedRatio = 0.15;
+
+/*
+ * Fraction of the distance to the new gains covered by each update, to
+ * avoid the gains hunting when the clipped blocks change with the exposure.
+ * The first update after configure() is applied in full.
+ */
+static constexpr float kGainsSmoothing = 0.5;
+
+/*
+ * Calculate the red and blue gains from the sums of the channels. The sums
+ * are at least minValid, while the black level offset is removed. The gains
+ * are clamped at 4.0, which also avoids 0 division.
+ */
+static RGB<float> greyWorldGains(const RGB<uint64_t> &sums, uint64_t offset)
+{
+	const uint64_t minValid = 1;
+	const RGB<uint64_t> sum = sums.max(offset + minValid) - offset;
+
+	return { {
+		sum.r() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.r(),
+		1.0,
+		sum.b() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.b(),
+	} };
+}
+
 int Awb::configure(IPAContext &context,
 		   [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
 	auto &gains = context.activeState.awb.gains;
 	gains = { { 1.0, 1.0, 1.0 } };
+	context.activeState.awb.updated = false;

 	return 0;
 }
@@ -66,23 +105,41 @@ void Awb::process(IPAContext &context,
 	const uint64_t nPixels = std::accumulate(
 		histogram.begin(), histogram.end(), uint64_t(0));
 	const uint64_t offset = blackLevel * nPixels;
-	const uint64_t minValid = 1;
-	/*
-	 * Make sure the sums are at least minValid, while preventing unsigned
-	 * integer underflow.
-	 */
-	const RGB<uint64_t> sum = stats->sum_.max(offset + minValid) - offset;

-	/*
-	 * Calculate red and blue gains for AWB.
-	 * Clamp max gain at 4.0, this also avoids 0 division.
-	 */
+	RGB<float> newGains = greyWorldGains(stats->sum_, offset);
+
+	if (stats->nBlocks && stats->nUnclipped) {
+		const float unclippedRatio =
+			static_cast<float>(stats->nUnclipped) / stats->nBlocks;
+		const float weight = std::clamp(
+			(unclippedRatio - kMinUnclippedRatio) /
+				(kFullUnclippedRatio - kMinUnclippedRatio),
+			0.0f, 1.0f);
+
+		if (weight > 0.0f) {
+			const RGB<float> unclippedGains = greyWorldGains(
+				stats->sumUnclipped_,
+				static_cast<uint64_t>(blackLevel) * stats->nUnclipped);
+
+			newGains = { {
+				weight * unclippedGains.r() + (1.0f - weight) * newGains.r(),
+				1.0,
+				weight * unclippedGains.b() + (1.0f - weight) * newGains.b(),
+			} };
+		}
+	}
+
 	auto &gains = context.activeState.awb.gains;
-	gains = { {
-		sum.r() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.r(),
-		1.0,
-		sum.b() <= sum.g() / 4 ? 4.0f : static_cast<float>(sum.g()) / sum.b(),
-	} };
+	if (context.activeState.awb.updated) {
+		gains = { {
+			gains.r() + kGainsSmoothing * (newGains.r() - gains.r()),
+			1.0,
+			gains.b() + kGainsSmoothing * (newGains.b() - gains.b()),
+		} };
+	} else {
+		gains = newGains;
+		context.activeState.awb.updated = true;
+	}

 	RGB<double> rgbGains{ { 1 / gains.r(), 1 / gains.g(), 1 / gains.b() } };
 	context.activeState.awb.temperatureK = estimateCCT(rgbGains);
