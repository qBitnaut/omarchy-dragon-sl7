From: Francois Roux <info@humanlearning.ch>
Subject: [PATCH] ipa: libipa: camera_sensor_helper: add ov02c10

Without an entry for ov02c10, the software ISP used by the simple pipeline
handler cannot run AGC for this sensor and logs "Failed to create camera
sensor helper for ov02c10". Analogue gain register values 0x10..0xf8 are
1/16 steps (unity at 0x10), and the 10-bit pedestal is 0x40, which is 4096 at
the 16-bit width blackLevel() expects.

Upstream submission: https://patchwork.libcamera.org/patch/28362/
(Signed-off-by: Francois Roux <info@humanlearning.ch>). Carried here
unmodified until it is merged and released.
---
diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index 9457d62b3..4b5c70f52 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -677,6 +677,18 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("ov01a10", CameraSensorHelperOv01a10)

+class CameraSensorHelperOv02c10 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperOv02c10()
+	{
+		/* From dark frame measurement: 0x40 at 10bits. */
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 16 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("ov02c10", CameraSensorHelperOv02c10)
+
 class CameraSensorHelperOv08x40 : public CameraSensorHelper
 {
 public:
