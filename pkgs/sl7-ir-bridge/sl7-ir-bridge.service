[Unit]
Description=SL7 IR camera bridge (CAMSS to v4l2loopback, on demand)
Documentation=file:///usr/share/doc/sl7-ir-bridge/README.md
After=systemd-modules-load.service systemd-udevd.service
Wants=systemd-modules-load.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-/etc/sl7-ir-bridge.conf
ExecStart=/usr/bin/sl7-ir-bridge
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
SyslogIdentifier=sl7-ir-bridge

# Sandbox: it only needs the media and video4linux character devices and
# read access to /sys. Root. The device nodes are root-owned, so ownership is
# enough for them. Two read-only capabilities let it list, when the IR path has
# been busy for 30 s, which process holds it (a scan of /proc/<pid>/fd of other
# users' processes, e.g. WirePlumber): CAP_SYS_PTRACE for the fd links and
# CAP_DAC_READ_SEARCH for the 0500 fd directories. The syscall filter below
# still has no ptrace and no open_by_handle_at.
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=char-media rw
DeviceAllow=char-video4linux rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=default
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources open_by_handle_at
UMask=0077
# /run/sl7-ir-bridge/ebusy: written when the IR path stays busy (read by
# sl7-doctor and omarchy-sl7-faceunlock), removed when the service stops.
# /run/sl7-ir-bridge/foreign-writer: another process holds the loopback (EBUSY).
RuntimeDirectory=sl7-ir-bridge
RuntimeDirectoryMode=0755
# keep the flag files across Restart=on-failure: a foreign writer that makes
# the bridge exit would otherwise erase its own report on the way
RuntimeDirectoryPreserve=restart
MemoryMax=64M

[Install]
WantedBy=multi-user.target
